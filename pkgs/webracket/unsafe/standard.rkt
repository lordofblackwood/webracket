#lang racket/base

;; Generated-style unsafe surface for `ffi/standard.ffi`.
;; Raw exports resolve to active `.ffi` primitive closures at compile time.

(require (only-in "../private/ffi.rkt" unsafe-ffi-primitive))

(define-syntax-rule (define-ffi name)
  (begin
    (provide name)
    (define name (unsafe-ffi-primitive 'name))))


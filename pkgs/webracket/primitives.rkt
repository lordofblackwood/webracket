  (webracket-uninterruptible-lock))

(define (unsafe-uninterruptible-lock-acquire lock)
  (unless (webracket-uninterruptible-lock? lock)
    (raise-argument-error 'unsafe-uninterruptible-lock-acquire
                          "uninterruptible-lock?"
                          lock))
  (void))

(define (unsafe-uninterruptible-lock-release lock)
  (unless (webracket-uninterruptible-lock? lock)
    (raise-argument-error 'unsafe-uninterruptible-lock-release
                          "uninterruptible-lock?"
                          lock))
  (void))

(define unsafe-make-struct-type-property/guard-calls-no-arguments
  (case-lambda
    [(name)
     (make-struct-type-property name)]
    [(name guard)
     (make-struct-type-property name guard)]
    [(name guard supers)
     (make-struct-type-property name guard supers)]
    [(name guard supers can-impersonate?)
     (make-struct-type-property name guard supers can-impersonate?)]
    [(name guard supers can-impersonate? accessor-name)
     (make-struct-type-property name guard supers can-impersonate? accessor-name)]
    [(name guard supers can-impersonate? accessor-name contract-str)
     (make-struct-type-property name guard supers can-impersonate? accessor-name contract-str)]
    [(name guard supers can-impersonate? accessor-name contract-str realm)
     (make-struct-type-property name guard supers can-impersonate? accessor-name contract-str realm)]))

(define (result-arity-count v)
  (cond
    [(integer? v) v]
    [(list? v)    (length v)]
    [else         1]))

(define (raise-result-arity-error/internal who expected args)
  (define expected-count (result-arity-count expected))
  (define received-count (result-arity-count args))
  (raise
   (exn:fail:contract:arity
    (format "~a: result arity mismatch;\n expected number of values not received\n  expected: ~a\n  received: ~a"
            who expected-count received-count)
    (current-continuation-marks))))

(define (raise-binding-result-arity-error expected args)
  (raise-result-arity-error/internal 'raise-binding-result-arity-error expected args))

(define (raise-definition-result-arity-error expected args)
  (raise-result-arity-error/internal 'raise-definition-result-arity-error expected args))

;; current-date : -> date*?
;;   Host-side wrapper that avoids depending on racket/date's generated
;;   contract helper bindings during no-stdlib expansion.
(define (current-date)
  (seconds->date (* 0.001 (current-inexact-milliseconds))))

(define (~r/precision x prec)
  (~r x #:precision prec))

;; Simple prefab utility fallbacks for host-side `#lang webracket` expansion on
;; Racket versions that do not provide the newer prefab helpers.
(define webracket-prefab-instance-keys (make-weak-hasheq))
(define webracket-prefab-type-info    (make-weak-hasheq))

(define (webracket-simple-prefab-auto-value? v)
  (or (boolean? v)
      (null? v)
      (void? v)
      (exact-integer? v)
      (char? v)
      (symbol? v)
      (string? v)
      (and (list? v)
           (andmap webracket-simple-prefab-auto-value? v))
      (and (vector? v)
           (for/and ([elem (in-vector v)])
             (webracket-simple-prefab-auto-value? elem)))))

(define (webracket-simple-prefab-public-key name init-count auto-count auto-value mutables)
  (if (and (zero? auto-count) (zero? (vector-length mutables)))
      name
      (list name
            init-count
            (list auto-count auto-value)
            mutables)))

(define (webracket-simple-prefab-key-info key init-field-count)
  (define (valid-count? v) (exact-nonnegative-integer? v))
  (define (valid-mutables? v total-count)
    (and (vector? v)
         (for/and ([m (in-vector v)]
                   [i (in-naturals)])
           (and (exact-nonnegative-integer? m)
                (or (not total-count) (< m total-count))
                (not (for/or ([seen (in-vector v 0 i)])
                       (= seen m)))))))
  (define (empty-mutables) #())
  (define (parent-info name init-count [mutables (empty-mutables)])
    (and (valid-count? init-count)
         (valid-mutables? mutables init-count)
         (info name init-count 0 #f mutables)))
  (define (inferred-child-count total parent-total)
    (and total (>= total parent-total) (- total parent-total)))
  (define (info name init-count auto-count auto-value mutables [parent-info #f])
    (list name
          init-count
          auto-count
          auto-value
          mutables
          parent-info
          (+ init-count auto-count)
          (if parent-info
              (append (list name init-count (list auto-count auto-value) mutables)
                      (list-ref parent-info 7))
              (webracket-simple-prefab-public-key name init-count auto-count auto-value mutables))))
  (cond
    [(symbol? key)
     (info key (or init-field-count 0) 0 #f #())]
    [(and (list? key)
          (= (length key) 3)
          (symbol? (car key))
          (symbol? (cadr key))
          (valid-count? (caddr key)))
     (define pinfo (parent-info (cadr key) (caddr key)))
     (define init-count (inferred-child-count init-field-count (list-ref pinfo 6)))
     (and pinfo
          (or (not init-field-count) init-count)
          (info (car key) (or init-count 0) 0 #f #() pinfo))]
    [(and (list? key)
          (= (length key) 4)
          (symbol? (car key))
          (valid-count? (cadr key))
          (symbol? (caddr key))
          (valid-count? (cadddr key))
          (or (not init-field-count)
              (= (+ (cadr key) (cadddr key)) init-field-count)))
     (define pinfo (parent-info (caddr key) (cadddr key)))
     (and pinfo
          (info (car key) (cadr key) 0 #f #() pinfo))]
    [(and (list? key)
          (= (length key) 5)
          (symbol? (car key))
          (symbol? (cadr key))
          (valid-count? (caddr key))
          (symbol? (list-ref key 3))
          (valid-count? (list-ref key 4)))
     (define pinfo
       (webracket-simple-prefab-key-info
        (list (cadr key) (caddr key) (list-ref key 3) (list-ref key 4))
        #f))
     (define init-count (and pinfo
                             (inferred-child-count init-field-count (list-ref pinfo 6))))
     (and pinfo
          (or (not init-field-count) init-count)
          (info (car key) (or init-count 0) 0 #f #() pinfo))]
    [(and (list? key)
          (= (length key) 6)
          (symbol? (car key))
          (valid-count? (cadr key))
          (symbol? (list-ref key 2))
          (valid-count? (list-ref key 3))
          (symbol? (list-ref key 4))
          (valid-count? (list-ref key 5))
          (or (not init-field-count)
              (= (+ (cadr key) (list-ref key 3) (list-ref key 5)) init-field-count)))
     (define pinfo
       (webracket-simple-prefab-key-info
        (list (list-ref key 2) (list-ref key 3) (list-ref key 4) (list-ref key 5))
        #f))
     (and pinfo
          (info (car key) (cadr key) 0 #f #() pinfo))]
    [(and (list? key)
          (= (length key) 5)
          (symbol? (car key))
          (symbol? (list-ref key 2))
          (valid-count? (list-ref key 3)))
     (define pinfo (parent-info (list-ref key 2)
                                (list-ref key 3)
                                (list-ref key 4)))
     (define init-count (and pinfo
                             (inferred-child-count init-field-count (list-ref pinfo 6))))
     (and pinfo
          (or (not init-field-count) init-count)
          (valid-mutables? (cadr key) init-count)
          (info (car key) (or init-count 0) 0 #f (cadr key) pinfo))]
    [(and (list? key)
          (= (length key) 6)
          (symbol? (car key))
          (valid-count? (cadr key))
          (symbol? (list-ref key 3))
          (valid-count? (list-ref key 4))
          (or (not init-field-count)
              (= (+ (cadr key) (list-ref key 4)) init-field-count)))
     (define pinfo (parent-info (list-ref key 3)
                                (list-ref key 4)
                                (list-ref key 5)))
     (and pinfo
          (valid-mutables? (list-ref key 2) (cadr key))
          (info (car key) (cadr key) 0 #f (list-ref key 2) pinfo))]
    [(and (list? key)
          (or (= (length key) 1)
              (= (length key) 2)
              (= (length key) 3)
              (= (length key) 4)
              (= (length key) 8))
          (symbol? (car key))
          (or (= (length key) 1)
              (valid-count? (cadr key)))
          (or (= (length key) 1)
              (not init-field-count)
              (= (cadr key) init-field-count))
          (or (< (length key) 3)
              (and (list? (caddr key))
                   (= (length (caddr key)) 2)
                   (valid-count? (car (caddr key)))
                   (webracket-simple-prefab-auto-value? (cadr (caddr key)))))
          (or (< (length key) 4)
              (vector? (cadddr key))))
     (define init-count (if (= (length key) 1) (or init-field-count 0) (cadr key)))
     (define auto-count (if (< (length key) 3) 0 (car (caddr key))))
     (define auto-value (if (< (length key) 3) #f (cadr (caddr key))))
     (define mutables (if (>= (length key) 4) (cadddr key) #()))
     (define parent-info
       (and (= (length key) 8)
            (webracket-simple-prefab-key-info (list (list-ref key 4)
                                                    (list-ref key 5)
                                                    (list-ref key 6)
                                                    (list-ref key 7))
                                              #f)))
     (and init-count
          (valid-mutables? mutables (+ init-count auto-count))
          (or (not (= (length key) 8)) parent-info)
          (info (car key) init-count auto-count auto-value mutables parent-info))]
    [else #f]))

(define (prefab-key? key)
  (and (webracket-simple-prefab-key-info key #f) #t))

(define (make-prefab-struct key . vals)
  (define info (webracket-simple-prefab-key-info key (length vals)))
  (unless info (raise-argument-error 'make-prefab-struct "supported simple prefab key" key))
  (define (std-from-info info)
    (define parent-info (list-ref info 5))
    (define parent-std (and parent-info (std-from-info parent-info)))
    (let-values ([(std make pred acc mut)
                  (make-struct-type (list-ref info 0)
                                    (or parent-std #f)
                                    (list-ref info 1)
                                    (list-ref info 2)
                                    (list-ref info 3)
                                    #f
                                    'prefab)])
      (hash-set! webracket-prefab-type-info std (cons (list-ref info 7) (list-ref info 6)))
      std))
  (define parent-info (list-ref info 5))
  (define parent-std (and parent-info (std-from-info parent-info)))
  (define-values (std make pred acc mut)
    (make-struct-type (list-ref info 0)
                      (or parent-std #f)
                      (list-ref info 1)
                      (list-ref info 2)
                      (list-ref info 3)
                      #f
                      'prefab))
  (define instance (racket:apply make vals))
  (hash-set! webracket-prefab-instance-keys instance (list-ref info 7))
  (hash-set! webracket-prefab-type-info std (cons (list-ref info 7) (list-ref info 6)))
  instance)

(define (prefab-struct-key v)
  (hash-ref webracket-prefab-instance-keys v #f))

(define (prefab-struct-type-key+field-count std)
  (unless (struct-type? std)
    (raise-argument-error 'prefab-struct-type-key+field-count "struct-type?" std))
  (hash-ref webracket-prefab-type-info std #f))




(define (inclusive-range-proc start end [step #f])
  ;; Step defaults to 1 or -1 depending on order of start and end.
  ;; Uses flonum defaults when either boundary is inexact.
  (define default-step
    (if (<= start end)
        (if (or (inexact? start) (inexact? end)) 1.0 1)
        (if (or (inexact? start) (inexact? end)) -1.0 -1)))
  (inclusive-range start end (if step step default-step)))

(define (range-proc start-or-end [end #f] [step #f])
  (cond [(eq? end  #f) (range start-or-end)]
        [(eq? step #f) (range start-or-end end)]
        [else          (range start-or-end end step)]))

(define (range start-or-end [end #f] [step #f]) 
  (cond [(eq? end  #f) (range 0 start-or-end 1)]
        [(eq? step #f) (range start-or-end end 1)]
        [else          (racket:range start-or-end end step)]))

;; Checkers

(define check-list-missing (gensym 'missing-list))

(define (check-list who-or-list [maybe-list check-list-missing])
  (define-values (who l)
    (if (eq? maybe-list check-list-missing)
        (values 'in-list who-or-list)
        (values who-or-list maybe-list)))
  (unless (list? l)
    (raise-argument-error who "list?" l)))

(define (check-vector v)
  (unless (vector? v)
    (raise-argument-error 'in-vector "vector?" v)))

(define (check-string l)
  (unless (string? l)
    (raise-argument-error 'in-string "string?" l)))

(define (check-mlist l)
  (unless (or (mpair? l) (null? l))
    (raise-argument-error 'in-mlist "(or/c mpair? null?)" l)))

(define (check-range a b step)
  (check-range-generic 'in-range a b step))

(define (check-range-generic who a b step)
  (unless (real? a) (raise-argument-error who "real?" a))
  (unless (real? b) (raise-argument-error who "real?" b))
  (unless (real? step) (raise-argument-error who "real?" step)))

(define (check-naturals n)
  (unless (and (integer? n)
               (exact? n)
               (n . >= . 0))
    (raise-argument-error 'in-naturals
                          "exact-nonnegative-integer?"
                          n)))

(require (prefix-in racket: racket/list))
(define (add-between xs v)   ; simplified version without keyword arguments.
  (racket:add-between xs v))


; A simplified no-keywords version of string-join.
(define (string-join strs [maybe-sep " "])
  (define xs (add-between strs maybe-sep))
  (string-append* xs))

(require (prefix-in racket: racket/string))

; A simplified no-keywords version 
(define (string-replace str from to [all? #t])
  (racket:string-replace str from to all?))

; Host-side mirror for WebRacket's primitive sort. The compiler/runtime
; supports the keyword-expanded shapes used by module-language programs.
(define sort
  (make-keyword-procedure
   (lambda (kws kw-args xs less-than?)
     (define key
       (let loop ([kws kws] [kw-args kw-args])
         (cond
           [(null? kws) #f]
           [(eq? (car kws) '#:key) (car kw-args)]
           [else (loop (cdr kws) (cdr kw-args))])))
     (define cache-keys?
       (let loop ([kws kws] [kw-args kw-args])
         (cond
           [(null? kws) #f]
           [(eq? (car kws) '#:cache-keys?) (car kw-args)]
           [else (loop (cdr kws) (cdr kw-args))])))
     (racket:sort xs less-than? #:key key #:cache-keys? cache-keys?))
   (lambda (xs less-than?)
     (racket:sort xs less-than?))))

;; sort/expanded-keywords : list? procedure? any/c procedure? any/c any/c -> list?
;;   Host mirror for the fixed-shape runtime keyword helper.
(define (sort/expanded-keywords xs less-than? _kw-key key _kw-cache cache-keys?)
  (racket:sort xs less-than? #:key key #:cache-keys? cache-keys?))


; Added in version Racket 8.12.
(define (vector-extend vec new-size [val 0])
  (unless (vector? vec)
    (raise-argument-error 'vector-extend "vector?" vec))
  (unless (exact-nonnegative-integer? new-size)
    (raise-argument-error 'vector-extend "exact-nonnegative-integer?" new-size))
  (define old-size (vector-length vec))
  (when (< new-size old-size)
    (raise-arguments-error 'vector-extend
                           "new length is shorter than existing length"
                           "new length" new-size
                           "existing length" old-size))
  (define new-vec (make-vector new-size val))
  (for ([i (in-range old-size)])
    (vector-set! new-vec i (vector-ref vec i)))
  new-vec)

(define (dynamic-require/false mod sym)
  (with-handlers ([exn:fail? (lambda (_) #f)])
    (dynamic-require mod sym)))

;; module-fixup/do : any/c list? boolean? -> any/c
;;   Host mirror of `syntax/location`'s runtime module-name/path helpers.
(define (module-fixup/do src path as-modpath?)
  (define (last-pass src)
    (cond
      [(path? src) src]
      [(symbol? src)
       (if as-modpath?
           `(quote ,src)
           src)]
      [(list? src)
       (define base (last-pass (car src)))
       (define sm   (cdr src))
       (if as-modpath?
           `(submod ,base ,@sm)
           (cons base sm))]
      [else 'top-level]))
  (last-pass
   (cond
     [(null? path) src]
     [(pair? src) (append src path)]
     [else (cons src path)])))

;; module-name-fixup : any/c list? -> any/c
;;   Host mirror used by `quote-module-name` bootstrap expansions.
(define (module-name-fixup src path)
  (module-fixup/do src path #f))

;; module-path-fixup : any/c list? -> any/c
;;   Host mirror used by `quote-module-path` bootstrap expansions.
(define (module-path-fixup src path)
  (module-fixup/do src path #t))

;; variable-reference->module-source/submod : variable-reference? -> any/c
;;   Host mirror of `syntax/location`'s helper for `module-source`.
(define (variable-reference->module-source/submod vr)
  (define src   (variable-reference->module-source vr))
  (define rname (variable-reference->resolved-module-path vr))
  (define name  (and rname (resolved-module-path-name rname)))
  (if (pair? name)
      (cons src (cdr name))
      src))

(define has-racket-treelist?
  (and (dynamic-require/false 'racket/treelist 'treelist?) #t))

(define-values (empty-treelist
                treelist?
                treelist
                make-treelist
                treelist-empty?
                treelist-length
                treelist-ref
                treelist-first
                treelist-last
                treelist-add
                treelist-set
                treelist-take
                treelist-drop
                treelist-split-at
                treelist-append
                treelist-cons
                treelist-insert
                treelist-delete
                treelist-take-right
                treelist-drop-right
                treelist-sublist
                treelist-reverse
                treelist-rest
                treelist-append*
                treelist-flatten
                treelist-sort
                treelist-map
                treelist-for-each
                treelist-filter
                treelist-find
                treelist-member?
                treelist-index-of
                vector->treelist
                treelist->vector
                list->treelist
                treelist->list)
  (if has-racket-treelist?
      (let ([real-treelist-sort
             (dynamic-require 'racket/treelist 'treelist-sort)]
            [real-treelist-take
             (dynamic-require 'racket/treelist 'treelist-take)]
            [real-treelist-drop
             (dynamic-require 'racket/treelist 'treelist-drop)])
        ;; Intentionally mirror compiled WebRacket: expose only the
        ;; positional two-argument treelist-sort form on the host side.
        (define (treelist-sort tl less-than?)
          (real-treelist-sort tl less-than?))
        ;; Some Racket snapshots provide `racket/treelist` without
        ;; `treelist-split-at`; keep the #lang webracket surface stable.
        (define real-treelist-split-at
          (or (dynamic-require/false 'racket/treelist 'treelist-split-at)
              (lambda (tl i)
                (values (real-treelist-take tl i)
                        (real-treelist-drop tl i)))))
        (values (dynamic-require 'racket/treelist 'empty-treelist)
                (dynamic-require 'racket/treelist 'treelist?)
                (dynamic-require 'racket/treelist 'treelist)
                (dynamic-require 'racket/treelist 'make-treelist)
                (dynamic-require 'racket/treelist 'treelist-empty?)
                (dynamic-require 'racket/treelist 'treelist-length)
                (dynamic-require 'racket/treelist 'treelist-ref)
                (dynamic-require 'racket/treelist 'treelist-first)
                (dynamic-require 'racket/treelist 'treelist-last)
                (dynamic-require 'racket/treelist 'treelist-add)
                (dynamic-require 'racket/treelist 'treelist-set)
                real-treelist-take
                real-treelist-drop
                real-treelist-split-at
                (dynamic-require 'racket/treelist 'treelist-append)
                (dynamic-require 'racket/treelist 'treelist-cons)
                (dynamic-require 'racket/treelist 'treelist-insert)
                (dynamic-require 'racket/treelist 'treelist-delete)
                (dynamic-require 'racket/treelist 'treelist-take-right)
                (dynamic-require 'racket/treelist 'treelist-drop-right)
                (dynamic-require 'racket/treelist 'treelist-sublist)
                (dynamic-require 'racket/treelist 'treelist-reverse)
                (dynamic-require 'racket/treelist 'treelist-rest)
                (dynamic-require 'racket/treelist 'treelist-append*)
                (dynamic-require 'racket/treelist 'treelist-flatten)
                treelist-sort
                (dynamic-require 'racket/treelist 'treelist-map)
                (dynamic-require 'racket/treelist 'treelist-for-each)
                (dynamic-require 'racket/treelist 'treelist-filter)
                (dynamic-require 'racket/treelist 'treelist-find)
                (dynamic-require 'racket/treelist 'treelist-member?)
                (dynamic-require 'racket/treelist 'treelist-index-of)
                (dynamic-require 'racket/treelist 'vector->treelist)
                (dynamic-require 'racket/treelist 'treelist->vector)
                (dynamic-require 'racket/treelist 'list->treelist)
                (dynamic-require 'racket/treelist 'treelist->list)))
      (let ()
        (struct host-treelist (vec) #:transparent)

        ;; Host fallback for Racket versions without `racket/treelist`.
        ;; Keep this subset aligned with compiled WebRacket, including the
        ;; simplified positional treelist-sort API.
        (define empty-treelist (host-treelist '#()))

        (define (treelist? v)
          (host-treelist? v))

        (define (treelist . xs)
          (host-treelist (list->vector xs)))

        (define (make-treelist k [val #f])
          (unless (exact-nonnegative-integer? k)
            (raise-argument-error 'make-treelist "exact-nonnegative-integer?" k))
          (host-treelist (make-vector k val)))

        (define (treelist-empty? tl)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-empty? "treelist?" tl))
          (zero? (vector-length (host-treelist-vec tl))))

        (define (treelist-length tl)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-length "treelist?" tl))
          (vector-length (host-treelist-vec tl)))

        (define (treelist-ref tl i)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-ref "treelist?" tl))
          (unless (exact-nonnegative-integer? i)
            (raise-argument-error 'treelist-ref "exact-nonnegative-integer?" i))
          (define vec (host-treelist-vec tl))
          (when (>= i (vector-length vec))
            (raise-arguments-error 'treelist-ref
                                   "index is out of range"
                                   "index" i
                                   "length" (vector-length vec)))
          (vector-ref vec i))

        (define (treelist-first tl)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-first "treelist?" tl))
          (define vec (host-treelist-vec tl))
          (when (zero? (vector-length vec))
            (raise-arguments-error 'treelist-first "treelist is empty"))
          (vector-ref vec 0))

        (define (treelist-last tl)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-last "treelist?" tl))
          (define vec (host-treelist-vec tl))
          (when (zero? (vector-length vec))
            (raise-arguments-error 'treelist-last "treelist is empty"))
          (vector-ref vec (sub1 (vector-length vec))))

        (define (treelist-add tl v)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-add "treelist?" tl))
          (define vec (host-treelist-vec tl))
          (define len (vector-length vec))
          (define new-vec (make-vector (add1 len) v))
          (for ([i (in-range len)])
            (vector-set! new-vec i (vector-ref vec i)))
          (host-treelist new-vec))

        (define (treelist-set tl i v)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-set "treelist?" tl))
          (unless (exact-nonnegative-integer? i)
            (raise-argument-error 'treelist-set "exact-nonnegative-integer?" i))
          (define vec (host-treelist-vec tl))
          (when (>= i (vector-length vec))
            (raise-arguments-error 'treelist-set
                                   "index is out of range"
                                   "index" i
                                   "length" (vector-length vec)))
          (define new-vec (vector-copy vec))
          (vector-set! new-vec i v)
          (host-treelist new-vec))

        (define (treelist-take tl i)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-take "treelist?" tl))
          (unless (exact-nonnegative-integer? i)
            (raise-argument-error 'treelist-take "exact-nonnegative-integer?" i))
          (define vec (host-treelist-vec tl))
          (define len (vector-length vec))
          (when (> i len)
            (raise-arguments-error 'treelist-take
                                   "index is out of range"
                                   "index" i
                                   "length" len))
          (host-treelist (vector-copy vec 0 i)))

        (define (treelist-drop tl i)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-drop "treelist?" tl))
          (unless (exact-nonnegative-integer? i)
            (raise-argument-error 'treelist-drop "exact-nonnegative-integer?" i))
          (define vec (host-treelist-vec tl))
          (define len (vector-length vec))
          (when (> i len)
            (raise-arguments-error 'treelist-drop
                                   "index is out of range"
                                   "index" i
                                   "length" len))
          (host-treelist (vector-copy vec i len)))

        (define (treelist-split-at tl i)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-split-at "treelist?" tl))
          (unless (exact-nonnegative-integer? i)
            (raise-argument-error 'treelist-split-at "exact-nonnegative-integer?" i))
          (define vec (host-treelist-vec tl))
          (define len (vector-length vec))
          (when (> i len)
            (raise-arguments-error 'treelist-split-at
                                   "index is out of range"
                                   "index" i
                                   "length" len))
          (values (host-treelist (vector-copy vec 0 i))
                  (host-treelist (vector-copy vec i len))))

        (define (treelist-append . tls)
          (for-each (lambda (tl)
                      (unless (treelist? tl)
                        (raise-argument-error 'treelist-append "treelist?" tl)))
                    tls)
          (host-treelist
           (list->vector
            (apply append (map treelist->list tls)))))

        (define (treelist-cons tl v)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-cons "treelist?" tl))
          (host-treelist
           (list->vector (cons v (treelist->list tl)))))

        (define (treelist-insert tl i v)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-insert "treelist?" tl))
          (unless (exact-nonnegative-integer? i)
            (raise-argument-error 'treelist-insert "exact-nonnegative-integer?" i))
          (define xs (treelist->list tl))
          (define len (length xs))
          (when (> i len)
            (raise-arguments-error 'treelist-insert
                                   "index is out of range"
                                   "index" i
                                   "length" len))
          (host-treelist
           (list->vector
            (append (take xs i) (list v) (drop xs i)))))

        (define (treelist-delete tl i)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-delete "treelist?" tl))
          (unless (exact-nonnegative-integer? i)
            (raise-argument-error 'treelist-delete "exact-nonnegative-integer?" i))
          (define xs (treelist->list tl))
          (define len (length xs))
          (when (>= i len)
            (raise-arguments-error 'treelist-delete
                                   "index is out of range"
                                   "index" i
                                   "length" len))
          (host-treelist
           (list->vector
            (append (take xs i) (drop xs (add1 i))))))

        (define (treelist-take-right tl n)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-take-right "treelist?" tl))
          (unless (exact-nonnegative-integer? n)
            (raise-argument-error 'treelist-take-right "exact-nonnegative-integer?" n))
          (define xs (treelist->list tl))
          (define len (length xs))
          (when (> n len)
            (raise-arguments-error 'treelist-take-right
                                   "index is out of range"
                                   "index" n
                                   "length" len))
          (host-treelist (list->vector (drop xs (- len n)))))

        (define (treelist-drop-right tl n)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-drop-right "treelist?" tl))
          (unless (exact-nonnegative-integer? n)
            (raise-argument-error 'treelist-drop-right "exact-nonnegative-integer?" n))
          (define xs (treelist->list tl))
          (define len (length xs))
          (when (> n len)
            (raise-arguments-error 'treelist-drop-right
                                   "index is out of range"
                                   "index" n
                                   "length" len))
          (host-treelist (list->vector (take xs (- len n)))))

        (define (treelist-sublist tl start end)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-sublist "treelist?" tl))
          (unless (exact-nonnegative-integer? start)
            (raise-argument-error 'treelist-sublist "exact-nonnegative-integer?" start))
          (unless (exact-nonnegative-integer? end)
            (raise-argument-error 'treelist-sublist "exact-nonnegative-integer?" end))
          (define xs (treelist->list tl))
          (define len (length xs))
          (when (or (> start end) (> end len))
            (raise-arguments-error 'treelist-sublist
                                   "indices are out of range"
                                   "start" start
                                   "end" end
                                   "length" len))
          (host-treelist (list->vector (take (drop xs start) (- end start)))))

        (define (treelist-reverse tl)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-reverse "treelist?" tl))
          (host-treelist (list->vector (reverse (treelist->list tl)))))

        (define (treelist-rest tl)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-rest "treelist?" tl))
          (define xs (treelist->list tl))
          (when (null? xs)
            (raise-arguments-error 'treelist-rest "treelist is empty"))
          (host-treelist (list->vector (cdr xs))))

        (define (treelist-append* tlotl)
          (unless (treelist? tlotl)
            (raise-argument-error 'treelist-append* "treelist?" tlotl))
          (apply treelist-append (treelist->list tlotl)))

        (define (treelist-flatten v)
          (define (flatten-one x)
            (if (treelist? x)
                (apply append (map flatten-one (treelist->list x)))
                (list x)))
          (host-treelist (list->vector (flatten-one v))))

        ;; Simplified host fallback: only the positional two-argument form is supported.
        (define (treelist-sort tl less-than?)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-sort "treelist?" tl))
          (unless (procedure? less-than?)
            (raise-argument-error 'treelist-sort "procedure?" less-than?))
          (host-treelist
           (list->vector (sort (treelist->list tl) less-than?))))

        (define (treelist-map tl proc)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-map "treelist?" tl))
          (unless (procedure? proc)
            (raise-argument-error 'treelist-map "procedure?" proc))
          (host-treelist (list->vector (map proc (treelist->list tl)))))

        (define (treelist-for-each tl proc)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-for-each "treelist?" tl))
          (unless (procedure? proc)
            (raise-argument-error 'treelist-for-each "procedure?" proc))
          (for-each proc (treelist->list tl)))

        (define (treelist-filter keep tl)
          (unless (procedure? keep)
            (raise-argument-error 'treelist-filter "procedure?" keep))
          (unless (treelist? tl)
            (raise-argument-error 'treelist-filter "treelist?" tl))
          (host-treelist (list->vector (filter keep (treelist->list tl)))))

        (define (treelist-find tl pred)
          (unless (treelist? tl)
            (raise-argument-error 'treelist-find "treelist?" tl))
          (unless (procedure? pred)
            (raise-argument-error 'treelist-find "procedure?" pred))
          (findf pred (treelist->list tl)))

        (define (treelist-member? tl v [eql? equal?])
          (unless (treelist? tl)
            (raise-argument-error 'treelist-member? "treelist?" tl))
          (unless (procedure? eql?)
            (raise-argument-error 'treelist-member? "procedure?" eql?))
          (and (for/or ([elem (in-list (treelist->list tl))])
                 (eql? v elem))
               #t))

        (define (treelist-index-of tl v [eql? equal?])
          (unless (treelist? tl)
            (raise-argument-error 'treelist-index-of "treelist?" tl))
          (unless (procedure? eql?)
            (raise-argument-error 'treelist-index-of "procedure?" eql?))
          (let loop ([xs (treelist->list tl)] [i 0])
            (cond
              [(null? xs) #f]
              [(eql? v (car xs)) i]
              [else (loop (cdr xs) (add1 i))])))

        (define (vector->treelist vec)
          (unless (vector? vec)
            (raise-argument-error 'vector->treelist "vector?" vec))
          (host-treelist (vector-copy vec)))

        (define (treelist->vector tl)
          (unless (treelist? tl)
            (raise-argument-error 'treelist->vector "treelist?" tl))
          (vector-copy (host-treelist-vec tl)))

        (define (list->treelist xs)
          (host-treelist (list->vector xs)))

        (define (treelist->list tl)
          (unless (treelist? tl)
            (raise-argument-error 'treelist->list "treelist?" tl))
          (vector->list (host-treelist-vec tl)))

        (values empty-treelist
                treelist?
                treelist
                make-treelist
                treelist-empty?
                treelist-length
                treelist-ref
                treelist-first
                treelist-last
                treelist-add
                treelist-set
                treelist-take
                treelist-drop
                treelist-split-at
                treelist-append
                treelist-cons
                treelist-insert
                treelist-delete
                treelist-take-right
                treelist-drop-right
                treelist-sublist
                treelist-reverse
                treelist-rest
                treelist-append*
                treelist-flatten
                treelist-sort
                treelist-map
                treelist-for-each
                treelist-filter
                treelist-find
                treelist-member?
                treelist-index-of
                vector->treelist
                treelist->vector
                list->treelist
                treelist->list))))


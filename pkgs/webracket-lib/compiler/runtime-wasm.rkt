               (local $handler-tail (ref eq))
               (local $pred-proc    (ref $Procedure))
               (local $handler-proc (ref $Procedure))
               (local $pred-inv     (ref $ProcedureInvoker))
               (local $handler-inv  (ref $ProcedureInvoker))

                   (gencmp '$</2  '$fx</2  '$fl<)
                   (gencmp '$>/2  '$fx>/2  '$fl>)
                   (gencmp '$<=/2 '$fx<=/2 '$fl<=)
                   (gencmp '$>=/2 '$fx>=/2 '$fl>=)))


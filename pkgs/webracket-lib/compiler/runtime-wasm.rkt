                                     (local.get $index)))
               (if (ref.test (ref $StencilVector) (local.get $slot))
                   (then
                    (local.set $newslot
                               (call $immutable-hamt-node-set/kind
                                     (local.get $kind)
                                     (local.get $slot)
                                     (local.get $entry)
                                     (local.get $key)
                                     (local.get $hash)

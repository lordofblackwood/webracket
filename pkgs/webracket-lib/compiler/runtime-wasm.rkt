               (local.set $table
                          (ref.cast (ref $HashEqMutable)
                                    (call $make-empty-hasheq)))
               ,@(for/list ([pr (in-list (active-described-primitives-sorted))])
                   `(call $hasheq-set!/mutable/checked
                          (local.get $table)
                          (global.get ,($ (string->symbol (~a "symbol:" pr))))
                          (global.get ,($ (prim: pr)))))

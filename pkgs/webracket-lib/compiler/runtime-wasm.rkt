                  (then (call $raise-check-fixnum (local.get $v))
                        (unreachable)))
              (local.set $v/i32 (i31.get_s (ref.cast (ref i31) (local.get $v))))
              (if (i32.and (local.get $v/i32) (i32.const 1))
                  (then (call $raise-check-fixnum (local.get $v))
                        (unreachable)))

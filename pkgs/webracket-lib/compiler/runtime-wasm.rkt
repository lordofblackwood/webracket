               (param $v        (ref eq)) ;; system stencil vector
               (param $remove-v (ref eq)) ;; removal mask
               (param $add-v    (ref eq)) ;; addition mask
               (param $vals     (ref eq)) ;; replacement values
               (result          (ref eq))
               (local $sv          (ref $StencilVector))
               (local $remove-mask i32)
               (local $add-mask    i32)

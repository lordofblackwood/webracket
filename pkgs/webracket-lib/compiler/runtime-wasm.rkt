                                                   (global.get $symbol:build-path/convention-type)
                                                   (local.get $type-raw)
                                                   (local.get $result)
                                                   (local.get $next)))
                                  (local.set $rest (struct.get $Pair $d (local.get $node)))
                                  (br $loop)))
                     (local.get $result))

               ;; find-system-path : symbol? -> path?
               ;;   Return stable complete paths in WebRacket's virtual filesystem.
               (func $find-system-path (type $Prim1)
                     (param $kind-raw (ref eq)) ;; symbol?
                     (result          (ref eq))

                     (local $kind (ref $Symbol))

                     (if (i32.eqz (ref.test (ref $Symbol) (local.get $kind-raw)))
                         (then (call $raise-argument-error1
                                     (global.get $symbol:find-system-path)
                                     (global.get $string:symbol?)
                                     (local.get $kind-raw))
                               (unreachable)))
                     (local.set $kind (ref.cast (ref $Symbol) (local.get $kind-raw)))
                     (if (ref.eq (local.get $kind) (global.get $symbol:home-dir))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-home-dir)
                                             (global.get $missing)))))
                     (if (ref.eq (local.get $kind) (global.get $symbol:pref-dir))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-pref-dir)
                                             (global.get $missing)))))
                     (if (ref.eq (local.get $kind) (global.get $symbol:pref-file))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-pref-file)
                                             (global.get $missing)))))
                     (if (ref.eq (local.get $kind) (global.get $symbol:temp-dir))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-temp-dir)
                                             (global.get $missing)))))
                     (if (ref.eq (local.get $kind) (global.get $symbol:init-dir))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-home-dir)
                                             (global.get $missing)))))
                     (if (ref.eq (local.get $kind) (global.get $symbol:init-file))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-init-file)
                                             (global.get $missing)))))
                     (if (i32.or (ref.eq (local.get $kind) (global.get $symbol:config-dir))
                                 (ref.eq (local.get $kind) (global.get $symbol:host-config-dir)))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-config-dir)
                                             (global.get $missing)))))
                     (if (i32.or (ref.eq (local.get $kind) (global.get $symbol:addon-dir))
                                 (ref.eq (local.get $kind) (global.get $symbol:host-addon-dir)))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-addon-dir)
                                             (global.get $missing)))))
                     (if (ref.eq (local.get $kind) (global.get $symbol:cache-dir))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-cache-dir)
                                             (global.get $missing)))))
                     (if (i32.or (ref.eq (local.get $kind) (global.get $symbol:doc-dir))
                                 (ref.eq (local.get $kind) (global.get $symbol:desk-dir)))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-home-dir)
                                             (global.get $missing)))))
                     (if (ref.eq (local.get $kind) (global.get $symbol:sys-dir))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-root)
                                             (global.get $missing)))))
                     (if (ref.eq (local.get $kind) (global.get $symbol:exec-file))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-exec-file)
                                             (global.get $missing)))))
                     (if (ref.eq (local.get $kind) (global.get $symbol:run-file))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-run-file)
                                             (global.get $missing)))))
                     (if (i32.or (ref.eq (local.get $kind) (global.get $symbol:collects-dir))
                                 (ref.eq (local.get $kind) (global.get $symbol:host-collects-dir)))
                         (then (return (call $bytes->path
                                             (global.get $bytes:vfs-collects-dir)
                                             (global.get $missing)))))
                     (if (ref.eq (local.get $kind) (global.get $symbol:orig-dir))
                         (then (return (call $bytes->path
                                             (global.get $bytes:app-dir)
                                             (global.get $missing)))))
                     (call $raise-argument-error1
                           (global.get $symbol:find-system-path)
                           (global.get $string:system-path-kind)
                           (local.get $kind-raw))
                     (unreachable))

               ;; find-executable-path : path-string? [(or/c path-string? #f)] [any/c] -> (or/c path? #f)
               ;;   WebRacket has no host executable search path, so this validates inputs
               ;;   and reports that no executable can be found. The optional `related`
               ;;   argument defaults to #f and must be a relative path string when present.
               (func $find-executable-path (type $Prim13)
                     (param $program-raw (ref eq)) ;; path-string?
                     (param $related-raw (ref eq)) ;; optional (or/c #f relative-path-string?), default = #f
                     (param $deepest-raw (ref eq)) ;; optional any/c, default = #f
                     (result             (ref eq))

                     (if (i32.eqz (ref.eq (call $path-string? (local.get $program-raw))
                                          (global.get $true)))
                         (then (call $raise-argument-error1
                                     (global.get $symbol:find-executable-path)
                                     (global.get $string:path-string?)
                                     (local.get $program-raw))
                               (unreachable)))
                     (if (i32.eqz (ref.eq (local.get $related-raw) (global.get $missing)))
                         (then
                          (if (i32.eqz (ref.eq (local.get $related-raw) (global.get $false)))
                              (then
                               (if (i32.eqz
                                    (i32.and
                                     (ref.eq (call $path-string? (local.get $related-raw))
                                             (global.get $true))
                                     (ref.eq (call $relative-path? (local.get $related-raw))
                                             (global.get $true))))
                                   (then (call $raise-argument-error1
                                               (global.get $symbol:find-executable-path)
                                               (global.get $string:relative-path-string-or-false)
                                               (local.get $related-raw))
                                         (unreachable)))))))
                     (global.get $false))

               ;; current-drive : -> path?
               ;;   Return the current VFS drive/root for WebRacket's Unix-style paths.
               (func $current-drive (type $Prim0)
                     (result (ref eq))
                     (call $bytes->path
                           (global.get $bytes:vfs-root)
                           (global.get $missing)))

               ;; environment-variables? : any/c -> boolean?
               ;;   Check whether a value is WebRacket's environment-variable set.
               (func $environment-variables? (type $Prim1)
                     ,@(make-predicate-body '$EnvironmentVariables))

               ;; current-environment-variables : [environment-variables?] -> environment-variables?
               ;;   Get or set the current environment-variable set. WebRacket
               ;;   starts with an empty set instead of host OS variables.
               (func $current-environment-variables (type $Prim01)
                     (param $env-raw (ref eq)) ;; optional environment-variables?, default current set
                     (result (ref eq))
                     (if (ref.eq (local.get $env-raw) (global.get $missing))
                         (then (return (global.get $current-environment-variables-value))))
                     (if (i32.eqz (ref.test (ref $EnvironmentVariables) (local.get $env-raw)))
                         (then (return (global.get $error))))
                     (global.set $current-environment-variables-value (local.get $env-raw))
                     (global.get $void))

               ;; environment-variables-ref : environment-variables? bytes? -> (or/c bytes? #f)
               ;;   Look up a variable in WebRacket's empty environment.
               (func $environment-variables-ref (type $Prim2)
                     (param $env-raw  (ref eq)) ;; environment-variable set
                     (param $name-raw (ref eq)) ;; byte string name
                     (result (ref eq))
                     (if (i32.eqz (ref.test (ref $EnvironmentVariables) (local.get $env-raw)))
                         (then (return (global.get $error))))
                     (if (i32.eqz (ref.test (ref $Bytes) (local.get $name-raw)))
                         (then (return (global.get $error))))
                     (global.get $false))

               ;; current-print : [procedure?] -> procedure?
               ;;   Get or set the top-level printer. The default printer logs
               ;;   the value through `js-log`, which is sufficient for probes.
               (func $current-print (type $Prim01)
                     (param $printer-raw (ref eq)) ;; optional procedure?, default current printer
                     (result (ref eq))
                     (if (ref.eq (local.get $printer-raw) (global.get $missing))
                         (then
                          (if (ref.eq (global.get $current-print-value) (global.get $false))
                              (then (return (global.get $prim:js-log)))
                              (else (return (global.get $current-print-value))))))
                     (if (i32.eqz (ref.test (ref $Procedure) (local.get $printer-raw)))
                         (then (return (global.get $error))))
                     (global.set $current-print-value (local.get $printer-raw))
                     (global.get $void))

               ;; print-values : any/c ... -> any/c ...
               ;;   Module-begin helper from racket/private/modbeg. It prints
               ;;   each result through current-print and returns the original
               ;;   values unchanged.
               (func $print-values (type $Prim>=0)
                     (param $args-raw (ref eq)) ;; rest arguments as $Args
                     (result          (ref eq))

                     (local $args    (ref $Args))
                     (local $arr     (ref $Array))
                     (local $printer (ref $Procedure))
                     (local $inv     (ref $ProcedureInvoker))
                     (local $one     (ref $Args))
                     (local $len     i32)
                     (local $i       i32)
                     (local $v       (ref eq))

                     (local.set $args (array.new $Args (global.get $null) (i32.const 0)))
                     (local.set $arr  (call $make-array (i32.const 0) (global.get $null)))
                     (if (ref.test (ref $Args) (local.get $args-raw))
                         (then
                          (local.set $args (ref.cast (ref $Args) (local.get $args-raw)))
                          (local.set $len  (array.len (local.get $args)))
                          (local.set $arr  (call $make-array (local.get $len) (global.get $null)))
                          (array.copy $Array $Args
                                      (local.get $arr) (i32.const 0)
                                      (local.get $args) (i32.const 0)
                                      (local.get $len)))
                         (else
                          (local.set $arr (call $list->array (local.get $args-raw)))
                          (local.set $len (array.len (local.get $arr)))))
                     (local.set $printer
                                (ref.cast (ref $Procedure)
                                          (call $current-print (global.get $missing))))
                     (local.set $inv (struct.get $Procedure $invoke (local.get $printer)))
                     (local.set $i   (i32.const 0))
                     (block $done
                            (loop $loop
                                  (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
                                  (local.set $v (array.get $Array (local.get $arr) (local.get $i)))
                                  (local.set $one (array.new_fixed $Args 1 (local.get $v)))
                                  (drop (call_ref $ProcedureInvoker
                                                  (local.get $printer)
                                                  (local.get $one)
                                                  (local.get $inv)))
                                  (local.set $i (i32.add (local.get $i) (i32.const 1)))
                                  (br $loop)))

                     (call $values (local.get $args-raw)))

               ;; default-current-read-interaction : any/c input-port? -> eof-object?
               ;;   Bootstrap reader used by current-read-interaction. The
               ;;   full interactive reader is outside the current WebRacket
               ;;   startup bridge; returning EOF lets expander boot code
               ;;   install the parameter without attempting REPL reads.
               (func $default-current-read-interaction (type $Prim2)
                     (param $source-name (ref eq)) ;; source name, currently ignored
                     (param $in          (ref eq)) ;; input-port?, currently ignored
                     (result             (ref eq))
                     (global.get $eof))

               ;; default-port-read-handler : input-port? [any/c] -> eof-object?
               ;;   Bootstrap port reader used until WebRacket has its own
               ;;   reader. This unblocks expander code that expects a valid
               ;;   port-read-handler protocol; it intentionally does not parse.
               (func $default-port-read-handler (type $Prim12)
                     (param $in     (ref eq)) ;; input-port?
                     (param $source (ref eq)) ;; optional source name, ignored
                     (result        (ref eq))
                     (global.get $eof))

               (func $default-port-read-handler/1 (type $Prim1)
                     (param $in (ref eq)) ;; input-port?
                     (result    (ref eq))
                     (global.get $eof))

               ;; read : [input-port?] -> any/c
               ;;   Full `read` parses Racket datums from a port. WebRacket has
               ;;   byte/string input helpers, but not the Racket reader yet.
               ;;   Keep this as a loud link-time bridge for provider code that
               ;;   imports `read` without calling it.
               (func $read (type $Prim01)
                     (param $in (ref eq)) ;; optional input-port?, default = current-input-port
                     (result    (ref eq))
                     (call $raise-argument-error1
                           (global.get $symbol:read)
                           (global.get $string:reader-unsupported)
                           (local.get $in))
                     (unreachable))

               ;; read-syntax : [any/c] [input-port?] -> syntax?
               ;;   See `read`: syntax-producing reader support is intentionally
               ;;   absent until the reader subsystem is implemented.
               (func $read-syntax (type $Prim02)
                     (param $source-name (ref eq)) ;; optional source name
                     (param $in          (ref eq)) ;; optional input-port?, default = current-input-port
                     (result             (ref eq))
                     (call $raise-argument-error1
                           (global.get $symbol:read-syntax)
                           (global.get $string:reader-unsupported)
                           (local.get $in))
                     (unreachable))

               ;; current-readtable : [(or/c readtable? #f)] -> (or/c readtable? #f) or void?
               ;;   WebRacket has no readtable values yet, so #f is the only
               ;;   supported setting. This keeps provider code linkable while
               ;;   making real custom-readtable use fail clearly.
               (func $current-readtable (type $Prim01)
                     (param $v (ref eq)) ;; optional (or/c readtable? #f), default = current value
                     (result   (ref eq))
                     (if (ref.eq (local.get $v) (global.get $missing))
                         (then (return (call $parameter-value-or-global
                                             (global.get $prim:current-readtable)
                                             (global.get $current-readtable-value)))))
                     (if (i32.eqz (ref.eq (local.get $v) (global.get $false)))
                         (then
                          (call $raise-argument-error1
                                (global.get $symbol:current-readtable)
                                (global.get $string:readtable-or-false)
                                (local.get $v))
                          (unreachable)))
                     (if (i32.eqz (ref.eq (global.get $current-parameterization-value)
                                          (global.get $false)))
                         (then (return (call $extend-current-parameterization!
                                             (global.get $prim:current-readtable)
                                             (local.get $v)))))
                     (global.set $current-readtable-value (local.get $v))
                     (global.get $void))

               ;; port-read-handler : input-port? -> procedure?
               ;;   Get the Racket-level read handler attached to an input
               ;;   port. The setter form is deferred until WebRacket has a
               ;;   robust optional-argument primitive path for [1 2] arities.
               ;;   File/device substrate may later come from rktio-like host
               ;;   support, but this hook belongs to the Racket port layer.
               (func $port-read-handler (type $Prim1)
                     (param $in-raw (ref eq)) ;; input-port?
                     (result        (ref eq))

                     (local $in      (ref $InputPort))
                     (local $handler (ref eq))

                     (if (i32.eqz (ref.test (ref $InputPort) (local.get $in-raw)))
                         (then (call $raise-argument-error1
                                     (global.get $symbol:port-read-handler)
                                     (global.get $string:input-port?)
                                     (local.get $in-raw))
                               (unreachable)))
                     (local.set $in (ref.cast (ref $InputPort) (local.get $in-raw)))
                     (local.set $handler
                                (struct.get $InputPort $read-handler (local.get $in)))
                     (if (ref.eq (local.get $handler) (global.get $false))
                         (then (return (global.get $default-port-read-handler-value)))
                         (else (return (local.get $handler))))
                     (unreachable))

               ;; default-port-write-handler : any/c output-port? -> void?
               ;;   Minimal default write handler. It uses WebRacket's narrow
               ;;   write-mode formatter so strings are quoted for `~s` and
               ;;   other write-through-handler paths.
               (func $default-port-write-handler (type $Prim2)
                     (param $v   (ref eq)) ;; any/c
                     (param $out (ref eq)) ;; output-port?
                     (result     (ref eq))
                     (drop (call $write-string
                                 (call $format/write (local.get $v))
                                 (local.get $out)
                                 (global.get $missing)
                                 (global.get $missing)))
                     (global.get $void))

               ;; default-port-display-handler : any/c output-port? -> void?
               ;;   Minimal default display handler using WebRacket's existing
               ;;   generic value renderer. Despite the helper name, that
               ;;   renderer is not a complete implementation of Racket display.
               (func $default-port-display-handler (type $Prim2)
                     (param $v   (ref eq)) ;; any/c
                     (param $out (ref eq)) ;; output-port?
                     (result     (ref eq))
                     (drop (call $write-string
                                 (call $format/display (local.get $v))
                                 (local.get $out)
                                 (global.get $missing)
                                 (global.get $missing)))
                     (global.get $void))

               ;; default-port-print-handler : any/c output-port? [0-or-1] -> void?
               ;;   Minimal default print handler. The optional quote-depth
               ;;   argument is accepted for Racket's port-print-handler shape.
               ;;   The current formatter handles the first print-as-expression
               ;;   quoting step and otherwise falls back to write mode.
               (func $default-port-print-handler (type $Prim23)
                     (param $v           (ref eq)) ;; any/c
                     (param $out         (ref eq)) ;; output-port?
                     (param $quote-depth (ref eq)) ;; optional (or/c 0 1), ignored
                     (result             (ref eq))
                     (drop (call $write-string
                                 (call $format/print
                                       (local.get $v)
                                       (local.get $quote-depth))
                                 (local.get $out)
                                 (global.get $missing)
                                 (global.get $missing)))
                     (global.get $void))

               ;; port-write-handler : output-port? [procedure?] -> procedure? or void?
               ;;   WebRacket accepts the setter protocol but currently keeps
               ;;   string ports on the default handler. This is enough for
               ;;   libraries that copy handlers while constructing ports. A
               ;;   prop:output-port wrapper is accepted when it resolves to an
               ;;   underlying native output port; full per-port handler storage
               ;;   should be added with richer ports.
               (func $port-write-handler (type $Prim12)
                     (param $out-raw     (ref eq)) ;; output-port?
                     (param $handler-raw (ref eq)) ;; optional procedure?
                     (result             (ref eq))
                     (local $out (ref eq))
                     (local.set $out
                                (if (result (ref eq))
                                    (ref.test (ref $OutputPort) (local.get $out-raw))
                                    (then (local.get $out-raw))
                                    (else (call $prop-output-port-target
                                                (local.get $out-raw)))))
                     (if (i32.eqz (ref.test (ref $OutputPort) (local.get $out)))
                         (then (call $raise-argument-error1
                                     (global.get $symbol:port-write-handler)
                                     (global.get $string:output-port?)
                                     (local.get $out-raw))
                               (unreachable)))
                     (if (ref.eq (local.get $handler-raw) (global.get $missing))
                         (then (return (global.get $default-port-write-handler-value))))
                     (if (i32.eqz (ref.test (ref $Procedure) (local.get $handler-raw)))
                         (then (call $raise-argument-error1
                                     (global.get $symbol:port-write-handler)
                                     (global.get $string:procedure?)
                                     (local.get $handler-raw))
                               (unreachable)))
                     (global.get $void))

               ;; port-display-handler : output-port? [procedure?] -> procedure? or void?
               ;;   See port-write-handler for the current setter limitation.
               (func $port-display-handler (type $Prim12)
                     (param $out-raw     (ref eq)) ;; output-port?
                     (param $handler-raw (ref eq)) ;; optional procedure?
                     (result             (ref eq))
                     (local $out (ref eq))
                     (local.set $out
                                (if (result (ref eq))
                                    (ref.test (ref $OutputPort) (local.get $out-raw))
                                    (then (local.get $out-raw))
                                    (else (call $prop-output-port-target
                                                (local.get $out-raw)))))
                     (if (i32.eqz (ref.test (ref $OutputPort) (local.get $out)))
                         (then (call $raise-argument-error1
                                     (global.get $symbol:port-display-handler)
                                     (global.get $string:output-port?)
                                     (local.get $out-raw))
                               (unreachable)))
                     (if (ref.eq (local.get $handler-raw) (global.get $missing))
                         (then (return (global.get $default-port-display-handler-value))))
                     (if (i32.eqz (ref.test (ref $Procedure) (local.get $handler-raw)))
                         (then (call $raise-argument-error1
                                     (global.get $symbol:port-display-handler)
                                     (global.get $string:procedure?)
                                     (local.get $handler-raw))
                               (unreachable)))
                     (global.get $void))

               ;; port-print-handler : output-port? [procedure?] -> procedure? or void?
               ;;   WebRacket does not yet store handlers per port. The setter
               ;;   updates the process-wide print handler, which is enough for
               ;;   the staged io/format `~v` path to honor print handling.
               (func $port-print-handler (type $Prim12)
                     (param $out-raw     (ref eq)) ;; output-port?
                     (param $handler-raw (ref eq)) ;; optional procedure?
                     (result             (ref eq))
                     (local $out (ref eq))
                     (local.set $out
                                (if (result (ref eq))
                                    (ref.test (ref $OutputPort) (local.get $out-raw))
                                    (then (local.get $out-raw))
                                    (else (call $prop-output-port-target
                                                (local.get $out-raw)))))
                     (if (i32.eqz (ref.test (ref $OutputPort) (local.get $out)))
                         (then (call $raise-argument-error1
                                     (global.get $symbol:port-print-handler)
                                     (global.get $string:output-port?)
                                     (local.get $out-raw))
                               (unreachable)))
                     (if (ref.eq (local.get $handler-raw) (global.get $missing))
                         (then (return (global.get $default-port-print-handler-value))))
                     (if (i32.eqz (ref.test (ref $Procedure) (local.get $handler-raw)))
                         (then (call $raise-argument-error1
                                     (global.get $symbol:port-print-handler)
                                     (global.get $string:procedure?)
                                     (local.get $handler-raw))
                               (unreachable)))
                     (global.set $default-port-print-handler-value
                                 (local.get $handler-raw))
                     (global.get $void))

               ;; current-read-interaction : [procedure?] -> procedure? or void?
               ;;   Parameter for the interactive reader. The default returns
               ;;   EOF, which is enough for expander startup probes that only
               ;;   need the binding to exist.
               (func $current-read-interaction (type $Prim01)
                     (param $reader-raw (ref eq)) ;; optional procedure?, default current reader
                     (result (ref eq))
                     (if (ref.eq (local.get $reader-raw) (global.get $missing))
                         (then (return (global.get $current-read-interaction-value))))
                     (if (i32.eqz (ref.test (ref $Procedure) (local.get $reader-raw)))
                         (then (call $raise-argument-error1
                                     (global.get $symbol:current-read-interaction)
                                     (global.get $string:procedure?)
                                     (local.get $reader-raw))
                               (unreachable)))
                     (global.set $current-read-interaction-value (local.get $reader-raw))
                     (global.get $void))

               ;; load-on-demand-enabled/use-user-specific-search-paths/read-accept-* : [boolean?] -> boolean? or void?
               ;;   Bootstrap reader policy parameters. The Reference gives
               ;;   load-on-demand-enabled a default of #t; WebRacket exposes
               ;;   the parameter now, while delayed source loading is deferred
               ;;   until the reader/load layer is richer.
               ,@(for/list ([name '($load-on-demand-enabled
                                    $use-user-specific-search-paths
                                    $read-square-bracket-as-paren
                                    $read-curly-brace-as-paren
                                    $read-square-bracket-with-tag
                                    $read-curly-brace-with-tag
                                    $read-accept-reader
                                    $read-accept-lang
                                    $read-accept-compiled
                                    $read-accept-box
                                    $read-accept-bar-quote
                                    $read-accept-graph
                                    $read-syntax-accept-graph
                                    $read-accept-dot
                                    $read-accept-infix-dot
                                    $read-accept-quasiquote

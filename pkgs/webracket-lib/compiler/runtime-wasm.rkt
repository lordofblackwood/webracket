         ;;   Check whether mask is in [0, 2^26).
         (func $$stencil-vector-mask-valid?/i32
               (param $mask i32)
               (result i32)
               (i32.and (i32.ge_s (local.get $mask) (i32.const 0))
                        (i32.lt_s (local.get $mask) (i32.const 67108864))))


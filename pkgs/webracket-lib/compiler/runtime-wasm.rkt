               (if (ref.test (ref $HashEqMutable) (local.get $ht))
                   (then (return (call $hasheq-ref
                                       (local.get $ht) (local.get $key) (local.get $failure)))))
               (if (ref.test (ref $HashEqvMutable) (local.get $ht))
                   (then (return (call $hasheqv-ref
                                       (local.get $ht) (local.get $key) (local.get $failure)))))

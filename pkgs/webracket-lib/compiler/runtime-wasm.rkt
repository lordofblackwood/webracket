                           (local.set $nvecs (i32.add (local.get $nvecs) (i32.const 1)))
                           (local.set $cur (struct.get $Pair $d (local.get $pair)))
                           (br $count)))

              ;; 4) Allocate arrays and seed
              (local.set $vectors (array.new $Args (global.get $null) (local.get $nvecs)))

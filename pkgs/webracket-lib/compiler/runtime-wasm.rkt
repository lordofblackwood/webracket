         (func $immutable-box? (type $Prim1) (param $v (ref eq)) (result (ref eq))
               (if (result (ref eq))
                   (ref.test (ref $Box) (local.get $v))
                   (then (if (result (ref eq))
                             (i32.eq (struct.get $Box $immutable
                                                 (ref.cast (ref $Box) (local.get $v)))

                     (local.set $len (call $copy-bytes-to-memory
                                           (local.get $bytes)
                                           (global.get $memory-map:vfs-path-buffer-base)))
                     (local.set $mtime
                                (call $js-vfs-modify-seconds
                                      (global.get $memory-map:vfs-path-buffer-base)
                                      (local.get $len)
                                     (local.get $has-secs)
                                     (local.get $secs)))
                     (if (i32.lt_s (local.get $mtime) (i32.const 0))

                    (return (call $immutable-hashalw-ref
                                  (local.get $ht)
                                  (local.get $key)
                                  (local.get $failure)))))
               (if (ref.test (ref $HashEqualAlwaysMutable) (local.get $ht))
                   (then (return (call $hashalw-ref
                                       (local.get $ht) (local.get $key) (local.get $failure)))))
               (unreachable))


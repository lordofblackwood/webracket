                                (call $bytes-index-of-byte/checked
                                      (local.get $b)
                                      (i32.const 61))
                                (i32.const 0)))
                              (then (global.get $true))
                              (else (global.get $false))))))
               (return_call $bytes-contains?/checked
                            (local.get $b)
                            (local.get $pattern)))


                   (i32.or
                    (ref.eq (local.get $import-keys) (global.get $false))
                    (ref.eq (local.get $import-keys) (global.get $missing)))
                   (then (local.get $compiled))
                   (else (array.new_fixed $Values 2
                                          (local.get $compiled)
                                          (local.get $import-keys)))))


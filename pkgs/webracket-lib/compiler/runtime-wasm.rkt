    (define (make-predicate-body ref-type)
      `((param $v (ref eq))
        (result   (ref eq))
        (if (result (ref eq))
            (ref.test (ref ,ref-type) (local.get $v))
            (then (global.get $true))
            (else (global.get $false)))))


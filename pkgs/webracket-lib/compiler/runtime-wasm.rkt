               (local $left       (ref eq))
               (local $right      (ref eq))
               (local $idx-fx     (ref eq))
               (local $after-fx   (ref eq))

               (local.set $idx (call $bytes-index-of-byte/checked
                                     (local.get $b)
                                     (local.get $sep)))

                                 (i32.const 0)        ;; $hash
                                 (local.get $path)    ;; $name
                                 (i32.const 0)        ;; $closed
                                 (local.get $bs)      ;; $bytes
                                 (local.get $capacity) ;; $len
                                 (local.get $idx)     ;; $idx
                                 (local.get $loc)     ;; $loc

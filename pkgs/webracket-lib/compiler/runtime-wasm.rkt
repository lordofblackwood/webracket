                                       (local.get $arr)
                                       (local.get $i)
                                       (array.get $Array (local.get $init-arr) (local.get $src)))
                            (local.set $i (i32.add (local.get $i) (i32.const 1)))
                            (local.set $src (i32.add (local.get $src) (i32.const 1)))
                            (br $copy-child-init)))

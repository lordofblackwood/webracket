               ;; Keep the original procedure as payload. The reduced wrapper
               ;; checks its new arity, then forwards the original user args.
               (local.set $free (array.new_fixed $Free 1 (local.get $p)))
               (struct.new $Closure
                           (i32.const 0)
                           (local.get $new-name)
                           (local.get $new-arity)
                           (local.get $new-realm)
                           (ref.func $invoke-reduced-procedure)
                           (local.get $new-name)
                           (ref.func $dummy-code)
                           (local.get $free)))


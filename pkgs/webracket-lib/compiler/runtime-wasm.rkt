                                 (local.get $pattern)
                                 (ref.cast (ref $Bytes) (global.get $bytes:rx-id-colon-or-end)))
                           (global.get $true))
                   (then
                    (if (i32.eqz (call $bytes-prefix?/i32/checked
                                       (local.get $b)
                                       (ref.cast (ref $Bytes) (global.get $bytes:id))))
                        (then (return (global.get $false))))

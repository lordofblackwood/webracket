               (local.set $fmt-arr (struct.get $String $codepoints (local.get $fmt)))
               (local.set $len     (array.len (local.get $fmt-arr)))
               (local.set $out     (call $make-i32growable-array (local.get $len)))
               (local.set $args*   (local.get $args))

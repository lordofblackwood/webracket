                  (then (return (global.get $true))))
              (if (i32.eq (local.get $cp) (i32.const ,(char->integer #\u205F)))
                  (then (return (global.get $true))))
              (if (i32.eq (local.get $cp) (i32.const ,(char->integer #\u3000)))
                  (then (return (global.get $true))))

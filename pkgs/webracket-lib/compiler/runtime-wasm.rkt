         ;;   returns #t for choice events that contain handled events; WebRacket
         ;;   does not model choice events yet.
         (func $handle-evt? (type $Prim1)
               (param $v (ref eq)) ;; evt?
               (result   (ref eq))
               (if (ref.eq (call $evt? (local.get $v)) (global.get $false))
                   (then (call $raise-argument-error1
                               (global.get $symbol:handle-evt?)
                               (global.get $string:evt?)
                               (local.get $v))
                         (unreachable)))
               (if (result (ref eq))
                   (ref.test (ref $HandleEvt) (local.get $v))
                   (then (global.get $true))
                   (else (global.get $false))))

         ;; evt? : any/c -> boolean?
         ;;   Recognize the synchronizable event values implemented by the
         ;;   current single-threaded substrate.
         (func $evt? (type $Prim1)
               (param $v (ref eq)) ;; any/c
               (result   (ref eq))
               (if (ref.test (ref $AlwaysEvt) (local.get $v))
                   (then (return (global.get $true))))
               (if (ref.test (ref $NeverEvt) (local.get $v))
                   (then (return (global.get $true))))
               (if (ref.test (ref $Thread) (local.get $v))
                   (then (return (global.get $true))))
               (if (ref.test (ref $Semaphore) (local.get $v))
                   (then (return (global.get $true))))
               (if (ref.test (ref $SemaphorePeekEvt) (local.get $v))
                   (then (return (global.get $true))))
               (if (ref.test (ref $Channel) (local.get $v))
                   (then (return (global.get $true))))
               (if (ref.test (ref $ChannelPutEvt) (local.get $v))
                   (then (return (global.get $true))))
               (if (ref.test (ref $HandleEvt) (local.get $v))
                   (then (return (global.get $true))))
               (if (ref.test (ref $WillExecutor) (local.get $v))
                   (then (return (global.get $true))))
               (if (ref.test (ref $LogReceiver) (local.get $v))
                   (then (return (global.get $true))))
               (if (ref.test (ref $CustodianBox) (local.get $v))
                   (then (return (global.get $true))))
               (global.get $false))

         ;; channel-put : channel? any/c -> void?
         ;;   Store one pending value. Without a scheduler this does not block
         ;;   waiting for a receiver; later puts overwrite the pending slot.
         (func $channel-put (type $Prim2)
               (param $ch-raw (ref eq)) ;; channel?
               (param $v      (ref eq)) ;; any/c
               (result        (ref eq))
               (if (i32.eqz (ref.test (ref $Channel) (local.get $ch-raw)))
                   (then (call $raise-argument-error1
                               (global.get $symbol:channel-put)
                               (global.get $string:channel?)
                               (local.get $ch-raw))
                         (unreachable)))
               (struct.set $Channel $value
                           (ref.cast (ref $Channel) (local.get $ch-raw))
                           (local.get $v))
               (struct.set $Channel $ready
                           (ref.cast (ref $Channel) (local.get $ch-raw))
                           (i32.const 1))
               (global.get $void))

         ;; channel-try-get : channel? -> any/c
         ;;   Return a pending value if one is available, otherwise #f.
         (func $channel-try-get (type $Prim1)
               (param $ch-raw (ref eq)) ;; channel?
               (result        (ref eq))
               (local $ch (ref $Channel))
               (if (i32.eqz (ref.test (ref $Channel) (local.get $ch-raw)))
                   (then (call $raise-argument-error1
                               (global.get $symbol:channel-try-get)
                               (global.get $string:channel?)
                               (local.get $ch-raw))
                         (unreachable)))
               (local.set $ch (ref.cast (ref $Channel) (local.get $ch-raw)))
               (if (i32.eqz (struct.get $Channel $ready (local.get $ch)))
                   (then (return (global.get $false))))
               (struct.set $Channel $ready (local.get $ch) (i32.const 0))
               (struct.get $Channel $value (local.get $ch)))

         ;; channel-get : channel? -> any/c
         ;;   Single-threaded approximation: consume a pending value or return
         ;;   #f instead of blocking forever.
         (func $channel-get (type $Prim1)
               (param $ch-raw (ref eq)) ;; channel?
               (result        (ref eq))
               (return_call $channel-try-get (local.get $ch-raw)))

         ;; channel-put-evt : channel? any/c -> channel-put-evt?
         ;;   Build a synchronizable put event. In the current single-threaded
         ;;   sync approximation it becomes ready immediately.
         (func $channel-put-evt (type $Prim2)
               (param $ch-raw (ref eq)) ;; channel?
               (param $v      (ref eq)) ;; any/c
               (result        (ref eq))
               (if (i32.eqz (ref.test (ref $Channel) (local.get $ch-raw)))
                   (then (call $raise-argument-error1
                               (global.get $symbol:channel-put-evt)
                               (global.get $string:channel?)
                               (local.get $ch-raw))
                         (unreachable)))
               (struct.new $ChannelPutEvt
                           (i32.const 0)
                           (ref.cast (ref $Channel) (local.get $ch-raw))
                           (local.get $v)))

         ;; handle-evt : evt? procedure? -> handle-evt?
         ;;   Wrap an event with a handler to apply to its synchronization
         ;;   result. This single-threaded approximation supports one-value
         ;;   event results from the currently implemented event substrate.
         (func $handle-evt (type $Prim2)
               (param $evt-raw  (ref eq)) ;; evt?
               (param $proc-raw (ref eq)) ;; procedure?
               (result          (ref eq))
               (if (ref.eq (call $evt? (local.get $evt-raw)) (global.get $false))
                   (then (call $raise-argument-error1
                               (global.get $symbol:handle-evt)
                               (global.get $string:evt?)
                               (local.get $evt-raw))
                         (unreachable)))
               (if (i32.eqz (ref.test (ref $Procedure) (local.get $proc-raw)))
                   (then (call $raise-argument-error:procedure-expected
                               (local.get $proc-raw))
                         (unreachable)))
               (struct.new $HandleEvt
                           (i32.const 0)
                           (local.get $evt-raw)
                           (ref.cast (ref $Procedure) (local.get $proc-raw))))

         ;; make-semaphore : [exact-nonnegative-integer? = 0] -> semaphore?
         ;;   Create a lightweight single-threaded semaphore.
         (func $make-semaphore (type $Prim01)
               (param $count-raw (ref eq)) ;; optional initial count, default = 0
               (result           (ref eq))

               (local $count i32)
               (if (ref.eq (local.get $count-raw) (global.get $missing))
                   (then (local.set $count (i32.const 0)))
                   (else
                    (if (ref.eq (call $exact-nonnegative-integer? (local.get $count-raw))
                                (global.get $false))
                        (then
                         (call $raise-argument-error1
                               (global.get $symbol:make-semaphore)
                               (global.get $string:exact-nonnegative-integer?)
                               (local.get $count-raw))
                         (unreachable)))
                    (local.set $count
                               (i32.shr_s
                                (i31.get_s (ref.cast (ref i31) (local.get $count-raw)))
                                (i32.const 1)))))
               (struct.new $Semaphore
                           (i32.const 0)
                           (local.get $count)))

         ;; semaphore? : any/c -> boolean?
         ;;   Check whether a value is a lightweight semaphore.
         (func $semaphore? (type $Prim1)
               ,@(make-predicate-body '$Semaphore))

         ;; semaphore-peek-evt? : any/c -> boolean?
         ;;   Check whether a value is a semaphore peek event.
         (func $semaphore-peek-evt? (type $Prim1)
               ,@(make-predicate-body '$SemaphorePeekEvt))

         ;; semaphore-post : semaphore? -> void?
         ;;   Increment a lightweight semaphore's ready count.
         (func $semaphore-post (type $Prim1)
               (param $sema-raw (ref eq)) ;; semaphore?
               (result          (ref eq))

               (local $sema (ref $Semaphore))
               (if (i32.eqz (ref.test (ref $Semaphore) (local.get $sema-raw)))
                   (then
                    (call $raise-argument-error1
                          (global.get $symbol:semaphore-post)
                          (global.get $string:semaphore?)
                          (local.get $sema-raw))
                    (unreachable)))
               (local.set $sema (ref.cast (ref $Semaphore) (local.get $sema-raw)))
               (struct.set $Semaphore $count
                           (local.get $sema)
                           (i32.add (struct.get $Semaphore $count (local.get $sema))
                                    (i32.const 1)))
               (global.get $void))

         ;; semaphore-try-wait? : semaphore? -> boolean?
         ;;   Non-blocking wait: decrement and return #t when a count is
         ;;   available; otherwise return #f without changing the semaphore.
         (func $semaphore-try-wait? (type $Prim1)
               (param $sema-raw (ref eq)) ;; semaphore?
               (result          (ref eq))

               (local $sema (ref $Semaphore))
               (if (i32.eqz (ref.test (ref $Semaphore) (local.get $sema-raw)))
                   (then
                    (call $raise-argument-error1
                          (global.get $symbol:semaphore-try-wait?)
                          (global.get $string:semaphore?)
                          (local.get $sema-raw))
                    (unreachable)))
               (local.set $sema (ref.cast (ref $Semaphore) (local.get $sema-raw)))
               (if (i32.le_s (struct.get $Semaphore $count (local.get $sema))
                             (i32.const 0))
                   (then (return (global.get $false))))
               (struct.set $Semaphore $count
                           (local.get $sema)
                           (i32.sub (struct.get $Semaphore $count (local.get $sema))
                                    (i32.const 1)))
               (global.get $true))

         ;; call-with-semaphore : semaphore? procedure? [try-fail-thunk] arg ... -> any/c
         ;;   Single-threaded approximation of Racket's semaphore protocol:
         ;;   consume a ready semaphore count, invoke proc with args, and post
         ;;   afterward, including on exceptions. Blocking waits cannot suspend
         ;;   yet, so a zero-count semaphore behaves like try-fail when a
         ;;   try-fail thunk is provided.
         (func $call-with-semaphore (type $Prim>=2)
               (param $sema-raw (ref eq)) ;; semaphore?
               (param $proc-raw (ref eq)) ;; procedure?
               (param $rest     (ref eq)) ;; optional try-fail-thunk followed by args
               (result          (ref eq))

               (local $sema      (ref $Semaphore))
               (local $proc      (ref $Procedure))
               (local $inv       (ref $ProcedureInvoker))
               (local $pair      (ref $Pair))
               (local $try-fail  (ref eq))
               (local $args-list (ref eq))
               (local $args      (ref $Args))
               (local $node      (ref eq))
               (local $len       i32)
               (local $i         i32)
               (local $res       (ref eq))
               (local $exn-val   (ref eq))

               (if (i32.eqz (ref.test (ref $Semaphore) (local.get $sema-raw)))
                   (then
                    (call $raise-argument-error1
                          (global.get $symbol:call-with-semaphore)
                          (global.get $string:semaphore?)
                          (local.get $sema-raw))
                    (unreachable)))
               (if (i32.eqz (ref.test (ref $Procedure) (local.get $proc-raw)))
                   (then (call $raise-argument-error:procedure-expected
                               (local.get $proc-raw))
                         (unreachable)))
               (local.set $sema (ref.cast (ref $Semaphore) (local.get $sema-raw)))
               (local.set $proc (ref.cast (ref $Procedure) (local.get $proc-raw)))
               (local.set $try-fail (global.get $false))
               (local.set $args-list (global.get $null))
               (if (i32.eqz (ref.eq (local.get $rest) (global.get $null)))
                   (then
                    (if (i32.eqz (ref.test (ref $Pair) (local.get $rest)))
                        (then (call $raise-pair-expected (local.get $rest))
                              (unreachable)))
                    (local.set $pair (ref.cast (ref $Pair) (local.get $rest)))
                    (local.set $try-fail (struct.get $Pair $a (local.get $pair)))
                    (local.set $args-list (struct.get $Pair $d (local.get $pair)))))
               (if (i32.le_s (struct.get $Semaphore $count (local.get $sema))
                             (i32.const 0))
                   (then
                    (if (i32.and
                         (i32.and
                          (i32.eqz (ref.eq (local.get $try-fail) (global.get $false)))
                          (i32.eqz (ref.eq (local.get $try-fail) (global.get $undefined))))
                         (i32.eqz (ref.eq (local.get $try-fail) (global.get $unsafe-undefined))))
                        (then (return (call $call-thunk (local.get $try-fail)))))))
               (if (i32.gt_s (struct.get $Semaphore $count (local.get $sema))
                             (i32.const 0))
                   (then
                    (struct.set $Semaphore $count
                                (local.get $sema)
                                (i32.sub
                                 (struct.get $Semaphore $count (local.get $sema))
                                 (i32.const 1)))))
               (local.set $len (call $length/i32 (local.get $args-list)))
               (local.set $args (array.new $Args (global.get $null) (local.get $len)))
               (local.set $node (local.get $args-list))
               (local.set $i (i32.const 0))
               (block $args-done
                      (loop $args-loop
                            (br_if $args-done (i32.ge_u (local.get $i) (local.get $len)))
                            (local.set $pair (ref.cast (ref $Pair) (local.get $node)))
                            (array.set $Args
                                       (local.get $args)
                                       (local.get $i)
                                       (struct.get $Pair $a (local.get $pair)))
                            (local.set $node (struct.get $Pair $d (local.get $pair)))
                            (local.set $i (i32.add (local.get $i) (i32.const 1)))
                            (br $args-loop)))
               (local.set $inv (struct.get $Procedure $invoke (local.get $proc)))
               (local.set $res
                          (block $done (result (ref eq))
                                 (block $handler-block (result (ref eq))
                                        (try_table (result (ref eq))
                                                   (catch $exn $handler-block)
                                                   (call_ref $ProcedureInvoker
                                                             (local.get $proc)
                                                             (local.get $args)
                                                             (local.get $inv))
                                                   (br $done)))
                                 (local.set $exn-val)
                                 (drop (call $semaphore-post (local.get $sema)))
                                 (throw $exn (local.get $exn-val))
                                 (unreachable)))
               (drop (call $semaphore-post (local.get $sema)))
               (local.get $res))

         ;; semaphore-peek-evt : semaphore? -> semaphore-peek-evt?
         ;;   Create an event that becomes ready when the semaphore is ready
         ;;   without consuming the semaphore count.
         (func $semaphore-peek-evt (type $Prim1)
               (param $sema-raw (ref eq)) ;; semaphore?
               (result          (ref eq))

               (if (i32.eqz (ref.test (ref $Semaphore) (local.get $sema-raw)))
                   (then
                    (call $raise-argument-error1
                          (global.get $symbol:semaphore-peek-evt)
                          (global.get $string:semaphore?)
                          (local.get $sema-raw))
                    (unreachable)))
               (struct.new $SemaphorePeekEvt
                           (i32.const 0)
                           (ref.cast (ref $Semaphore) (local.get $sema-raw))))

         ;; make-will-executor : -> will-executor?
         ;;   Create an inert will executor. Registrations are retained, but
         ;;   WebRacket has no GC finalization hook to make wills ready.
         (func $make-will-executor (type $Prim0)
               (result (ref eq))
               (struct.new $WillExecutor
                           (i32.const 0)
                           (global.get $null)))

         ;; will-executor? : any/c -> boolean?
         ;;   Recognize WebRacket's minimal will executor records.
         (func $will-executor? (type $Prim1)
               ,@(make-predicate-body '$WillExecutor))

         ;; will-register : will-executor? any/c procedure? -> void?
         ;;   Retain the registration so the will procedure remains strongly
         ;;   referenced. No registration becomes ready until finalization is
         ;;   implemented.
         (func $will-register (type $Prim3)
               (param $executor-raw (ref eq)) ;; will-executor?
               (param $v            (ref eq)) ;; registered value
               (param $proc-raw     (ref eq)) ;; procedure accepting 1 arg
               (result              (ref eq))
               (local $executor (ref $WillExecutor))
               (local $proc     (ref $Procedure))

               (if (i32.eqz (ref.test (ref $WillExecutor) (local.get $executor-raw)))
                   (then (call $raise-argument-error1
                               (global.get $symbol:will-register)
                               (global.get $string:will-executor?)
                               (local.get $executor-raw))
                         (unreachable)))
               (if (i32.eqz (ref.test (ref $Procedure) (local.get $proc-raw)))
                   (then (call $raise-argument-error1
                               (global.get $symbol:will-register)
                               (global.get $string:procedure?)
                               (local.get $proc-raw))
                         (unreachable)))
               (local.set $proc (ref.cast (ref $Procedure) (local.get $proc-raw)))
               (if (i32.eqz (call $procedure-arity-includes?/checked/i32
                                  (local.get $proc)
                                  (i32.const 1)))
                   (then (call $raise-argument-error1
                               (global.get $symbol:will-register)
                               (global.get $string:procedure?)
                               (local.get $proc-raw))
                         (unreachable)))
               (local.set $executor
                          (ref.cast (ref $WillExecutor) (local.get $executor-raw)))
               (struct.set $WillExecutor $registrations
                           (local.get $executor)
                           (call $cons
                                 (call $cons (local.get $v) (local.get $proc-raw))
                                 (struct.get $WillExecutor $registrations
                                             (local.get $executor))))
               (global.get $void))

         ;; will-try-execute : will-executor? [any/c = #f] -> any/c
         ;;   Return the default because no GC-discovered wills are ready in
         ;;   the current runtime.
         (func $will-try-execute (type $Prim12)
               (param $executor-raw (ref eq)) ;; will-executor?
               (param $default      (ref eq)) ;; optional default, default = #f
               (result              (ref eq))
               (if (i32.eqz (ref.test (ref $WillExecutor) (local.get $executor-raw)))
                   (then (call $raise-argument-error1
                               (global.get $symbol:will-try-execute)
                               (global.get $string:will-executor?)
                               (local.get $executor-raw))
                         (unreachable)))
               (if (result (ref eq))
                   (ref.eq (local.get $default) (global.get $missing))
                   (then (global.get $false))
                   (else (local.get $default))))

         ;; will-execute : will-executor? -> any/c
         ;;   Blocking is unavailable without a scheduler/finalizer queue, so
         ;;   this behaves like an immediate unsuccessful poll.
         (func $will-execute (type $Prim1)
               (param $executor-raw (ref eq)) ;; will-executor?
               (result              (ref eq))
               (call $will-try-execute
                     (local.get $executor-raw)
                     (global.get $false)))

         ;; $sync-one : evt? boolean? -> any/c
         ;;   Return the selected event value, or #f when it is not ready.
         ;;   Semaphore events consume when requested; peek events do not.
         (func $sync-one
               (param $evt      (ref eq)) ;; event candidate
               (param $consume? i32)      ;; non-zero consumes semaphore counts
               (result          (ref eq))

               (local $sema (ref $Semaphore))
               (local $peek (ref $SemaphorePeekEvt))
               (local $ch   (ref $Channel))
               (local $put  (ref $ChannelPutEvt))
               (local $handle (ref $HandleEvt))
               (local $proc   (ref $Procedure))
               (local $inv    (ref $ProcedureInvoker))
               (local $r      (ref eq))

               (if (ref.test (ref $AlwaysEvt) (local.get $evt))
                   (then (return (local.get $evt))))
               (if (ref.test (ref $NeverEvt) (local.get $evt))
                   (then (return (global.get $false))))
               ;; Threads are synchronizable in Racket when they terminate. The
               ;; single WebRacket thread never terminates while user code runs.
               (if (ref.test (ref $Thread) (local.get $evt))
                   (then (return (global.get $false))))
               (if (ref.test (ref $Semaphore) (local.get $evt))
                   (then
                    (local.set $sema (ref.cast (ref $Semaphore) (local.get $evt)))
                    (if (i32.gt_s (struct.get $Semaphore $count (local.get $sema))
                                  (i32.const 0))
                        (then
                         (if (local.get $consume?)
                             (then
                              (struct.set $Semaphore $count
                                          (local.get $sema)
                                          (i32.sub
                                           (struct.get $Semaphore $count (local.get $sema))
                                           (i32.const 1)))))
                         (return (local.get $evt))))
                    (return (global.get $false))))
               (if (ref.test (ref $SemaphorePeekEvt) (local.get $evt))
                   (then
                    (local.set $peek (ref.cast (ref $SemaphorePeekEvt) (local.get $evt)))
                    (local.set $sema (struct.get $SemaphorePeekEvt $sema (local.get $peek)))
                    (if (i32.gt_s (struct.get $Semaphore $count (local.get $sema))
                                  (i32.const 0))
                        (then (return (local.get $evt))))
                    (return (global.get $false))))
               (if (ref.test (ref $Channel) (local.get $evt))
                   (then
                    (local.set $ch (ref.cast (ref $Channel) (local.get $evt)))
                    (if (i32.eqz (struct.get $Channel $ready (local.get $ch)))
                        (then (return (global.get $false))))
                    (if (local.get $consume?)
                        (then (struct.set $Channel $ready
                                          (local.get $ch)
                                          (i32.const 0))))
                    (return (struct.get $Channel $value (local.get $ch)))))
               (if (ref.test (ref $ChannelPutEvt) (local.get $evt))
                   (then
                    (local.set $put (ref.cast (ref $ChannelPutEvt) (local.get $evt)))
                    (if (local.get $consume?)
                        (then
                         (drop (call $channel-put
                                     (struct.get $ChannelPutEvt $ch (local.get $put))
                                     (struct.get $ChannelPutEvt $v (local.get $put))))))
                    (return (local.get $evt))))
               (if (ref.test (ref $HandleEvt) (local.get $evt))
                   (then
                    (local.set $handle (ref.cast (ref $HandleEvt) (local.get $evt)))
                    (local.set $r
                               (call $sync-one
                                     (struct.get $HandleEvt $evt (local.get $handle))
                                     (local.get $consume?)))
                    (if (ref.eq (local.get $r) (global.get $false))
                        (then (return (global.get $false))))
                    (local.set $proc (struct.get $HandleEvt $proc (local.get $handle)))
                    (local.set $inv  (struct.get $Procedure $invoke (local.get $proc)))
                    (return_call_ref $ProcedureInvoker
                                     (local.get $proc)
                                     (array.new_fixed $Args 1 (local.get $r))
                                     (local.get $inv))))
               ;; Log receivers are synchronizable events, but the current
               ;; inert logger substrate never queues events.
               (if (ref.test (ref $LogReceiver) (local.get $evt))
                   (then (return (global.get $false))))
               ;; Will executors are events when a GC-discovered will is ready.
               ;; WebRacket does not expose finalization yet.
               (if (ref.test (ref $WillExecutor) (local.get $evt))
                   (then (return (global.get $false))))
               ;; Keep the first event layer permissive: other event kinds from
               ;; imported linklets can be added here as they become reachable.
               (global.get $false))

         ;; sync : evt? evt? ... -> any/c
         ;;   Select the first ready event. WebRacket has no scheduler yet, so
         ;;   an otherwise-blocking sync currently returns #f instead of waiting.
         (func $sync (type $Prim>=0)
               (param $events (ref eq)) ;; event candidates
               (result        (ref eq))

               (local $r    (ref eq))
               (local $node (ref eq))
               (local $p    (ref $Pair))

               (local.set $node (local.get $events))
               (loop $again
                 (if (ref.test (ref $Pair) (local.get $node))
                     (then
                      (local.set $p (ref.cast (ref $Pair) (local.get $node)))
                      (local.set $r
                                 (call $sync-one
                                       (struct.get $Pair $a (local.get $p))
                                       (i32.const 1)))
                      (if (i32.eqz (ref.eq (local.get $r) (global.get $false)))
                          (then (return (local.get $r))))
                      (local.set $node (struct.get $Pair $d (local.get $p)))
                      (br $again))))
               (global.get $false))

         ;; sync/timeout : (or/c real? #f) evt? ... -> any/c
         ;;   Poll ready events. The timeout value is accepted but not used
         ;;   until WebRacket has a scheduler/timer queue.
         (func $sync/timeout (type $Prim>=1)
               (param $timeout (ref eq)) ;; timeout or #f
               (param $events  (ref eq)) ;; rest event candidates
               (result         (ref eq))

               (local $r    (ref eq))
               (local $node (ref eq))
               (local $p    (ref $Pair))

               (local.set $node (local.get $events))
               (loop $again
                 (if (ref.test (ref $Pair) (local.get $node))
                     (then
                      (local.set $p (ref.cast (ref $Pair) (local.get $node)))
                      (local.set $r
                                 (call $sync-one
                                       (struct.get $Pair $a (local.get $p))
                                       (i32.const 1)))
                      (if (i32.eqz (ref.eq (local.get $r) (global.get $false)))
                          (then (return (local.get $r))))
                      (local.set $node (struct.get $Pair $d (local.get $p)))
                      (br $again))))
               (global.get $false))

         ;; unsafe-make-uninterruptible-lock : -> lock?
         ;;   Create an opaque single-threaded lock token.
         (func $unsafe-make-uninterruptible-lock (type $Prim0)
               (result (ref eq))
               (struct.new $UninterruptibleLock (i32.const 0)))

         ;; unsafe-uninterruptible-lock-acquire : lock? -> void?
         ;;   No-op acquire for WebRacket's current single-threaded runtime.
         (func $unsafe-uninterruptible-lock-acquire (type $Prim1)
               (param $lock (ref eq)) ;; uninterruptible lock
               (result      (ref eq))
               (if (i32.eqz (ref.test (ref $UninterruptibleLock) (local.get $lock)))
                   (then (unreachable)))
               (global.get $void))

         ;; unsafe-uninterruptible-lock-release : lock? -> void?
         ;;   No-op release for WebRacket's current single-threaded runtime.
         (func $unsafe-uninterruptible-lock-release (type $Prim1)
               (param $lock (ref eq)) ;; uninterruptible lock
               (result      (ref eq))
               (if (i32.eqz (ref.test (ref $UninterruptibleLock) (local.get $lock)))
                   (then (unreachable)))
               (global.get $void))




         ;;;
         ;;; Memory Map
         ;;;

         ;; Currently (June 2005) the proposal for multiple memories aren't supported
         ;; by Safari (WebKit). Therefore, we are forced to using a single memory only.

         ;; The following memory map is used to segment the linear memory.

         ;; Static host bridge scratch map:
         ;;   0..1MiB        VFS file transfer buffer
         ;;   +4KiB          VFS path buffer
         ;;   +64KiB         callback/FASL/string scratch buffer
         (global $memory-map:vfs-file-buffer-base   (mut i32) (i32.const 0))
         (global $memory-map:vfs-file-buffer-length (mut i32) (i32.const 1048576))
         (global $memory-map:vfs-path-buffer-base   (mut i32) (i32.const 1048576))
         (global $memory-map:vfs-path-buffer-length (mut i32) (i32.const 4096))
         (global $memory-map:callback-buffer-base   (mut i32) (i32.const 1052672))
         (global $memory-map:callback-buffer-length (mut i32) (i32.const 65536))
         (global $memory-map:string-buffer-base     (mut i32) (i32.const 1052672))
         (global $memory-map:string-buffer-length   (mut i32) (i32.const 4096))


         ;;;
         ;;; Data segment strings
         ;;;

         ;; The current (June 2005) support for strings in WebAssembly is *very* limited.
         ;; The data segment can be used to embed byte sequences in the source.
         ;; However in order to access the data, one must copy them to the linear memory first.

         (func $raise-string-buffer-overflow (unreachable))

         ; Turns out that the `memory.init` instruction requires a fixed
         ; segment number. So since we can't pass the segment number as an argument,
         ; we can't use these functions. Sigh.

         #;(func $data:codepoints->string
               (param $segment   i32)  ;; index of the passive data segment
               (param $count     i32)  ;; number of UTF-32 codepoints
               (result           (ref $String))

               (local $base      i32)
               (local $i         i32)
               (local $arr       (ref $I32Array))
               (local $str       (ref $String))
               (local $byte-size i32)

               ;; 1. Get base address for string buffer
               (local.set $base (global.get $memory-map:string-buffer-base))
               ;; 2. Compute byte size = count * 4
               (local.set $byte-size (i32.mul (local.get $count) (i32.const 4)))
               ;; 3. Bounds check (optional but recommended)
               (if (i32.gt_u (local.get $byte-size)
                             (global.get $memory-map:string-buffer-length))
                   (then (call $raise-string-buffer-overflow)))
               ;; 4. Copy data segment to string buffer
               (memory.init (local.get $segment)
                            (local.get $base)
                            (i32.const 0)
                            (local.get $byte-size))
               ;; 5. Allocate I32Array
               (local.set $arr (array.new_default $I32Array (local.get $count)))
               ;; 6. Copy from memory buffer into array
               (local.set $i (i32.const 0))
               (loop $copy (array.set $I32Array
                                      (local.get $arr)
                                      (local.get $i)
                                      (i32.load
                                       (i32.add
                                        (local.get $base)
                                        (i32.mul (local.get $i) (i32.const 4)))))
                     (local.set $i (i32.add (local.get $i) (i32.const 1)))
                     (br_if $copy (i32.lt_u (local.get $i) (local.get $count))))

               ;; 7. Convert to string
               (local.set $str (call $i32array->string (local.get $arr)))
               (local.get $str))

         #;(func $data:bytes->string
               (param $segment    i32) ;; passive data segment index
               (param $byte-count i32) ;; number of UTF-8 bytes
               (result            (ref $String))

               (local $base  i32)
               (local $i     i32)
               (local $arr   (ref $I8Array))
               (local $bs    (ref $Bytes))
               (local $str   (ref $String))
               ;; 1. Get base address for string buffer
               (local.set $base (global.get $memory-map:string-buffer-base))
               ;; 2. Bounds check
               (if (i32.gt_u (local.get $byte-count)
                             (global.get $memory-map:string-buffer-length))
                   (then (call $raise-string-buffer-overflow)))
               ;; 3. Copy from data segment into memory buffer
               (memory.init (local.get $segment)
                            (local.get $base)
                            (i32.const 0)
                            (local.get $byte-count))
               ;; 4. Allocate and fill I8Array
               (local.set $arr (array.new_default $I8Array (local.get $byte-count)))
               (local.set $i (i32.const 0))
               (loop $copy
                     (array.set $I8Array (local.get $arr) (local.get $i)
                                (i32.load8_u
                                 (i32.add (local.get $base)
                                          (local.get $i))))
                     (local.set $i (i32.add (local.get $i) (i32.const 1)))
                     (br_if $copy (i32.lt_u (local.get $i) (local.get $byte-count))))
               ;; 5. Wrap I8Array in Bytes struct
               (local.set $bs (struct.new $Bytes
                                          (i32.const 0)         ;; hash = 0 (unset)
                                          (local.get $byte-count)
                                          (local.get $arr)))
               ;; 6. Decode UTF-8
               (local.set $str (call $bytes->string/utf-8/checked
                                     (local.get $bs)))
               (local.get $str))


         ;;;
         ;;; HASH TABLES
         ;;;

         ;; Racket contains quite a few types of hash tables.
         ;;
         ;;   eq?/eqv?/equal?/equal-always?    mutable/immutable    strong/weak/ephemerons
         ;;
         ;; Currently `webracket` supports mutable, strong hash tables only.


         (func $hash? (type $Prim1)
               (param $v (ref eq))
               (result   (ref eq))

               (if (result (ref eq))
                   (call $hash-leaf?/i32 (local.get $v))
                   (then (global.get $true))
                   (else (global.get $false))))

         ,@(for/list ([pred '($hash-eq? $hash-eqv? $hash-equal? $hash-equal-always?)]
                      [mutable-type '($HashEqMutable
                                      $HashEqvMutable
                                      $HashEqualMutable
                                      $HashEqualAlwaysMutable)]
                      [immutable-type '($HashEqImmutable
                                        $HashEqvImmutable
                                        $HashEqualImmutable
                                        $HashEqualAlwaysImmutable)])
             `(func ,pred (type $Prim1)
                    (param $ht (ref eq)) ;; hash table
                    (result    (ref eq))
                    ;; Validate argument is a hash table
                    (if (i32.eqz (call $hash-leaf?/i32 (local.get $ht)))
                        (then (call $raise-argument-error:hash-expected)
                              (unreachable)))
                    (if (result (ref eq))
                        (i32.or (ref.test (ref ,mutable-type) (local.get $ht))
                                (ref.test (ref ,immutable-type) (local.get $ht)))
                        (then (global.get $true))
                        (else (global.get $false)))))


         ;;;
         ;;; MUTABLE HASHEQ
         ;;;

         ; We'll use an open-addressing hash table with linear probing for simplicity.
         ; A load of 50% leads to fast lookup - but uses some more memory.

         ; Theory: https://thenumb.at/Hashtables/

         ,@(for/list ([name   '($make-empty-hasheq
                                $make-empty-hasheqv
                                $make-empty-hash
                                $make-empty-hashalw)]
                      [type   '($HashEqMutable
                                $HashEqvMutable
                                $HashEqualMutable
                                $HashEqualAlwaysMutable)])
             `(func ,name (type $Prim0)
                    (result (ref eq))  ; an (ref $HashEqMutable)

                    (local $entries (ref $Array))
                    ;; Step 1: Allocate an array with 2 × capacity (key/value pairs)
                    ;; Capacity = 16 entries → 32 elements
                    (local.set $entries
                               (array.new $Array (global.get $missing) (i32.const 32)))
                    ;; Step 2: Construct and return the hashtable struct
                    (struct.new ,type
                                (i32.const 0)                 ;; hash = 0 (placeholder or unused)
                                (global.get $true)            ;; mutable? = #t
                                (local.get $entries)          ;; entries array
                                (i32.const 0))))              ;; count = 0

         (func $raise-argument-error:pair-expected  (unreachable))
         (func $raise-argument-error:pair-expected1 (unreachable))
         (func $raise-argument-error:pair-expected2 (unreachable))


         ,@(for/list ([make-hash     '($make-hasheq
                                       $make-hasheqv
                                       $make-hash
                                       $make-hashalw)]
                      [make-empty    '($make-empty-hasheq
                                       $make-empty-hasheqv
                                       $make-empty-hash
                                       $make-empty-hashalw)]
                      [type          '($HashEqMutable
                                       $HashEqvMutable
                                       $HashEqualMutable
                                       $HashEqualAlwaysMutable)]
                      [set!/checked  '($hasheq-set!/mutable/checked
                                       $hasheqv-set!/mutable/checked
                                       $hash-set!/mutable/checked
                                       $hashalw-set!/mutable/checked)])
             `(func ,make-hash (type $Prim01) ; (make-hasheq [assocs])   - optional default null
                    (param $assocs (ref eq))   ;; Either $missing or an alist of key/value pairs
                    (result        (ref eq))   ;; an (ref $HashEqMutable)

                    (local $alist (ref eq))
                    (local $pair  (ref $Pair))
                    (local $key   (ref eq))
                    (local $val   (ref eq))
                    (local $first (ref eq)) ; of the alist
                    (local $rest  (ref eq)) ; of the alist
                    (local $ht    (ref ,type))

                    ;; Case 1: No argument => make empty table
                    (if (ref.eq (local.get $assocs) (global.get $missing))
                        (then (return (call ,make-empty))))
                    ;; Case 2: Provided association list
                    (local.set $ht    (ref.cast (ref ,type)
                                                (call ,make-empty)))
                    (local.set $alist (local.get $assocs))

                    (block $done
                           (loop $walk
                                 ;; Stop when list is null
                                 (br_if $done (ref.eq (local.get $alist) (global.get $null)))
                                 ;; Must be a pair
                                 (if (i32.eqz (ref.test (ref $Pair) (local.get $alist)))
                                     (then (call $raise-argument-error:pair-expected1 (local.get $alist)) (unreachable)))
                                 (local.set $pair (ref.cast (ref $Pair) (local.get $alist)))
                                 ;; Extract car and cdr of current pair
                                 (local.set $first (struct.get $Pair $a (local.get $pair))) ;; first = key/value pair
                                 (local.set $rest  (struct.get $Pair $d (local.get $pair))) ;; rest  = remaining pairings
                                 ;; Validate first is a pair (key . value)
                                 (if (i32.eqz (ref.test (ref $Pair) (local.get $first)))
                                     (then (call $raise-argument-error:pair-expected2 (local.get $first)) (unreachable)))
                                 ;; Extract key and value from nested pair
                                 (local.set $pair (ref.cast (ref $Pair) (local.get $first)))
                                 (local.set $key  (struct.get $Pair $a (local.get $pair))) ;; key
                                 (local.set $val  (struct.get $Pair $d (local.get $pair))) ;; value
                                 ;; Insert into table
                                 (call ,set!/checked (local.get $ht) (local.get $key) (local.get $val))
                                 ;; Move to next element in alist
                                 (local.set $alist (local.get $rest))
                                 (br $walk)))
                    (local.get $ht)))

         ;;;
         ;;; IMMUTABLE HASHEQV
         ;;;

         (func $make-empty-immutable-hasheq (type $Prim0)
               (result (ref eq))
               (struct.new $HashEqImmutable
                           (i32.const 0)
                           (global.get $false)
                           (global.get $missing)
                           (i32.const 0)))

         (func $make-empty-immutable-hasheqv (type $Prim0)
               (result (ref eq))
               (struct.new $HashEqvImmutable
                           (i32.const 0)      ;; hash
                           (global.get $false) ;; mutable? = #f
                           (global.get $missing)
                           (i32.const 0)))

         (func $make-empty-immutable-hash (type $Prim0)
               (result (ref eq))
               (struct.new $HashEqualImmutable
                           (i32.const 0)
                           (global.get $false)
                           (global.get $missing)
                           (i32.const 0)))

         (func $make-empty-immutable-hashalw (type $Prim0)
               (result (ref eq))
               (struct.new $HashEqualAlwaysImmutable
                           (i32.const 0)
                           (global.get $false)
                           (global.get $missing)
                           (i32.const 0)))

         ;; hash-placeholder? : any/c -> boolean?
         ;;   Recognize hash placeholders produced by make-hash-placeholder
         ;;   and its comparison-kind variants.
         (func $hash-placeholder? (type $Prim1)
               (param $v (ref eq)) ;; any value
               (result   (ref eq))
               (if (result (ref eq))
                   (ref.test (ref $HashPlaceholder) (local.get $v))
                   (then (global.get $true))
                   (else (global.get $false))))

         ;; placeholder? : any/c -> boolean?
         ;;   Recognize reader-graph placeholders created by make-placeholder.
         (func $placeholder? (type $Prim1)
               (param $v (ref eq)) ;; any value
               (result   (ref eq))
               (if (result (ref eq))
                   (ref.test (ref $Placeholder) (local.get $v))
                   (then (global.get $true))
                   (else (global.get $false))))

         ;; make-placeholder : any/c -> placeholder?
         ;;   Create a mutable reader-graph placeholder cell.
         (func $make-placeholder (type $Prim1)
               (param $v (ref eq)) ;; initial value
               (result   (ref eq))
               (struct.new $Placeholder
                           (i32.const 0)
                           (local.get $v)))

         ;; placeholder-set! : placeholder? any/c -> void?
         ;;   Replace the value stored in a reader-graph placeholder.
         (func $placeholder-set! (type $Prim2)
               (param $ph-raw (ref eq)) ;; placeholder?
               (param $v      (ref eq)) ;; new value
               (result        (ref eq))

               (if (i32.eqz (ref.test (ref $Placeholder) (local.get $ph-raw)))
                   (then (call $raise-argument-error1
                               (global.get $symbol:placeholder-set!)
                               (global.get $string:placeholder?)
                               (local.get $ph-raw))
                         (unreachable)))
               (struct.set $Placeholder $value
                           (ref.cast (ref $Placeholder) (local.get $ph-raw))
                           (local.get $v))
               (global.get $void))

         ;; placeholder-get : placeholder? -> any/c
         ;;   Return the current value stored in a reader-graph placeholder.
         (func $placeholder-get (type $Prim1)
               (param $ph-raw (ref eq)) ;; placeholder?
               (result        (ref eq))

               (if (i32.eqz (ref.test (ref $Placeholder) (local.get $ph-raw)))
                   (then (call $raise-argument-error1
                               (global.get $symbol:placeholder-get)
                               (global.get $string:placeholder?)
                               (local.get $ph-raw))
                         (unreachable)))
               (struct.get $Placeholder $value
                           (ref.cast (ref $Placeholder) (local.get $ph-raw))))

         ;; $reader-graph-resolve : any/c exact-nonnegative-integer? -> any/c
         ;;   Resolve the acyclic placeholder/pair subset used by simple
         ;;   `shared` expansions. Full reader graph support needs sharing
         ;;   preservation plus hash-placeholder reconstruction.
         (func $reader-graph-resolve
               (param $v    (ref eq)) ;; graph fragment
               (param $fuel i32)      ;; recursion budget
               (result     (ref eq))

               (local $ph     (ref $Placeholder))
               (local $pair   (ref $Pair))
               (local $vec    (ref $Vector))
               (local $box    (ref $Box))
               (local $arr    (ref $Array))
               (local $out    (ref $Array))
               (local $len    i32)
               (local $i      i32)
               (local $fuel-1 i32)

               (if (i32.le_s (local.get $fuel) (i32.const 0))
                   (then
                    (call $raise-arguments-error
                          (global.get $symbol:make-reader-graph)
                          (global.get $string:reader-graph-unsupported)
                          (array.new_fixed $Args 0))
                    (unreachable)))
               (if (ref.test (ref $HashPlaceholder) (local.get $v))
                   (then
                    (call $raise-arguments-error
                          (global.get $symbol:make-reader-graph)
                          (global.get $string:reader-graph-unsupported)
                          (array.new_fixed $Args 0))
                    (unreachable)))
               (local.set $fuel-1 (i32.sub (local.get $fuel) (i32.const 1)))
               (if (ref.test (ref $Placeholder) (local.get $v))
                   (then
                    (local.set $ph (ref.cast (ref $Placeholder) (local.get $v)))
                    (return
                     (call $reader-graph-resolve
                           (struct.get $Placeholder $value (local.get $ph))
                           (local.get $fuel-1)))))
               (if (ref.test (ref $Pair) (local.get $v))
                   (then
                    (local.set $pair (ref.cast (ref $Pair) (local.get $v)))
                    (return
                     (struct.new $Pair
                                 (i32.const 0)
                                 (call $reader-graph-resolve
                                       (struct.get $Pair $a (local.get $pair))
                                       (local.get $fuel-1))
                                 (call $reader-graph-resolve
                                       (struct.get $Pair $d (local.get $pair))
                                       (local.get $fuel-1))))))
               (if (ref.test (ref $Vector) (local.get $v))
                   (then
                    (local.set $vec (ref.cast (ref $Vector) (local.get $v)))
                    (local.set $arr (struct.get $Vector $arr (local.get $vec)))
                    (local.set $len (array.len (local.get $arr)))
                    (local.set $out (array.new $Array (global.get $void) (local.get $len)))
                    (local.set $i (i32.const 0))
                    (block $done
                           (loop $loop
                                 (br_if $done (i32.ge_u (local.get $i) (local.get $len)))
                                 (array.set $Array
                                            (local.get $out)
                                            (local.get $i)
                                            (call $reader-graph-resolve
                                                  (array.get $Array (local.get $arr) (local.get $i))
                                                  (local.get $fuel-1)))
                                 (local.set $i (i32.add (local.get $i) (i32.const 1)))
                                 (br $loop)))
                    (return
                     (struct.new $Vector
                                 (i32.const 0)
                                 (i32.const 1)
                                 (local.get $out)))))
               (if (ref.test (ref $Box) (local.get $v))
                   (then
                    (local.set $box (ref.cast (ref $Box) (local.get $v)))
                    (return
                     (struct.new $Box
                                 (i32.const 0)
                                 (i32.const 1)
                                 (call $reader-graph-resolve
                                       (struct.get $Box $v (local.get $box))
                                       (local.get $fuel-1))))))
               (local.get $v))

         ;; make-reader-graph : any/c -> any/c
         ;;   First slice for `racket/shared`: resolve acyclic placeholder/pair
         ;;   graphs, vectors, and boxes. Cyclic graphs, prefab structs, and
         ;;   hash placeholders need the later sharing-preserving implementation.
         (func $make-reader-graph (type $Prim1)
               (param $v (ref eq)) ;; graph root
               (result   (ref eq))
               (call $reader-graph-resolve (local.get $v) (i32.const 100000)))

         ;; hash-weak? : hash? -> boolean?

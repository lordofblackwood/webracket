         ;;   accessors, and struct-info. WebRacket has no chaperone wrappers
         ;;   yet; for Goal 1, preserve identity and ignore interposition so
         ;;   contract-heavy libraries can instantiate their helper structs.
         (func $chaperone-struct (type $Prim>=1)
               (param $v    (ref eq)) ;; value to chaperone
               (param $args (ref eq)) ;; ignored struct/type/proc/property args
               (result      (ref eq))

               (local.get $v))

         ;; chaperone-vector : vector? (or/c procedure? #f) (or/c procedure? #f) any/c ... -> vector?
         ;;   Goal-1 identity bridge. Full Racket interposes on vector ref/set;
         ;;   WebRacket currently has no chaperone wrapper representation.
         (func $chaperone-vector (type $Prim>=3)
               (param $vec      (ref eq)) ;; vector?
               (param $ref-proc (ref eq)) ;; ignored ref interposer
               (param $set-proc (ref eq)) ;; ignored set interposer
               (param $props    (ref eq)) ;; ignored property/value list
               (result          (ref eq))

               (if (i32.eqz (ref.test (ref $Vector) (local.get $vec)))
                   (then (call $raise-argument-error1
                               (global.get $symbol:chaperone-vector)
                               (global.get $string:vector?)
                               (local.get $vec))
                         (unreachable)))
               (local.get $vec))

         ;; chaperone-box : box? procedure? procedure? any/c ... -> box?
         ;;   Goal-1 identity bridge. Full Racket interposes on unbox/set-box!;
         ;;   WebRacket currently has no chaperone wrapper representation.
         (func $chaperone-box (type $Prim>=3)
               (param $box        (ref eq)) ;; box?
               (param $unbox-proc (ref eq)) ;; ignored unbox interposer
               (param $set-proc   (ref eq)) ;; ignored set interposer
               (param $props      (ref eq)) ;; ignored property/value list
               (result            (ref eq))

               (if (i32.eqz (ref.test (ref $Box) (local.get $box)))
                   (then (call $raise-argument-error1
                               (global.get $symbol:chaperone-box)
                               (global.get $string:box?)
                               (local.get $box))
                         (unreachable)))
               (local.get $box))

         ;; chaperone-hash : hash? procedure? procedure? procedure? procedure? any/c ... -> hash?
         ;;   Goal-1 identity bridge. Full Racket interposes on hash access,
         ;;   update, remove, key extraction, and optional clear/equal-key
         ;;   operations; WebRacket currently keeps the original hash.
         (func $chaperone-hash (type $Prim>=3)
               (param $hash     (ref eq)) ;; hash?
               (param $ref-proc (ref eq)) ;; ignored ref interposer
               (param $set-proc (ref eq)) ;; ignored set interposer
               (param $rest     (ref eq)) ;; remove/key/optional/properties
               (result          (ref eq))

               (if (ref.eq (call $hash? (local.get $hash)) (global.get $false))
                   (then (call $raise-argument-error1
                               (global.get $symbol:chaperone-hash)
                               (global.get $string:hash?)
                               (local.get $hash))
                         (unreachable)))
               (local.get $hash))

         ;; unsafe-chaperone-procedure : procedure? procedure? any/c ... -> procedure?
         ;;   WebRacket does not implement chaperones yet. Preserve the useful
         ;;   contract-wrapper behavior by returning the wrapper procedure,
         ;;   which is responsible for delegating to the original procedure.
         (func $unsafe-chaperone-procedure (type $Prim>=2)
               (param $proc    (ref eq)) ;; original procedure
               (param $wrapper (ref eq)) ;; replacement/wrapper procedure
               (param $props   (ref eq)) ;; ignored property/value list
               (result         (ref eq))

               (if (ref.eq (call $procedure? (local.get $proc)) (global.get $false))
                   (then (call $raise-argument-error:procedure-expected (local.get $proc))
                         (unreachable)))
               (if (ref.eq (call $procedure? (local.get $wrapper)) (global.get $false))
                   (then (call $raise-argument-error:procedure-expected (local.get $wrapper))
                         (unreachable)))
               (local.get $wrapper))

         ;; unsafe-impersonate-procedure : procedure? procedure? any/c ... -> procedure?
         ;;   Same temporary representation as unsafe-chaperone-procedure.
         (func $unsafe-impersonate-procedure (type $Prim>=2)
               (param $proc    (ref eq)) ;; original procedure
               (param $wrapper (ref eq)) ;; replacement procedure
               (param $props   (ref eq)) ;; ignored property/value list
               (result         (ref eq))

               (return_call $unsafe-chaperone-procedure
                            (local.get $proc)
                            (local.get $wrapper)
                            (local.get $props)))





         (func $procedure-arity-mask (type $Prim1)
               ; TODO: Only tested with closures.
               ;       Also test with primitives and case-lambda
               (param $proc (ref eq))
               (result (ref eq))

               (local $p     (ref null $Procedure))
               (local $mask  i32)

              ;; Step 1: type check and cast. Use semantic procedure-ness so
              ;; plain structs do not expose their internal application fields.
              (if (ref.eq (call $procedure? (local.get $proc)) (global.get $false))
                  (then (call $raise-argument-error:procedure-expected (local.get $proc))
                        (unreachable)))
              (local.set $p (ref.cast (ref $Procedure) (local.get $proc)))
               ;; Step 2: compute mask in checked helper
               (local.set $mask
                          (call $procedure-arity-mask/checked/i32
                                (ref.cast (ref $Procedure) (local.get $p))))
               ;; Step 4: return as fixnum
               (ref.i31 (i32.shl (local.get $mask) (i32.const 1))))

         (func $procedure-arity-mask/checked/i32
               ; TODO: Only tested with closures.
               ;       Also test with primitives and case-lambda
               (param $proc (ref $Procedure))
               (result      i32)

               (local $a     (ref eq))
               (local $arr   (ref $I32Array))
               (local $i     i32)
               (local $n     i32)
               (local $m     i32)
               (local $arity i32)
               (local $mask  i32)
               (local $start i32)
               (local $delegate (ref eq))

               (local.set $delegate (global.get $false))
               (if (ref.test (ref $Struct) (local.get $proc))
                   (then
                    (local.set $delegate (call $struct-procedure-delegate
                                               (local.get $proc)))
                    (if (ref.test (ref $Procedure) (local.get $delegate))
                        (then (return_call $procedure-arity-mask/checked/i32
                                           (ref.cast (ref $Procedure)
                                                     (local.get $delegate)))))))

               ;; Step 1: inspect the procedure arity representation
               (local.set $a (struct.get $Procedure $arity (local.get $proc)))

               ;; Step 2: single arity marker stored as fixnum
               (if (ref.test (ref i31) (local.get $a))
                   (then
                    (local.set $arity (i32.shr_s
                                       (i31.get_s
                                        (ref.cast (ref i31) (local.get $a)))
                                       (i32.const 1)))
                    (local.set $mask
                               (if (result i32)
                                   (i32.ge_s (local.get $arity) (i32.const 0))
                                   ;; If arity ≥ 0, mask = 1 << arity
                                   (then (i32.shl (i32.const 1) (local.get $arity)))
                                   ;; If arity < 0, mask = -1 << (-1 - arity)
                                   (else (i32.shl (i32.const -1)
                                                  (i32.sub (i32.const -1) (local.get $arity))))))
                    (return (local.get $mask))))

               ;; Step 3: arity set stored as $I32Array of markers
               (local.set $arr (ref.cast (ref $I32Array) (local.get $a)))
               (local.set $n   (array.len (local.get $arr)))
               (local.set $i   (i32.const 0))
               (local.set $mask (i32.const 0))

               (block $done
                      (loop $loop
                            (br_if $done (i32.ge_u (local.get $i) (local.get $n)))
                            (local.set $m
                                       (array.get $I32Array (local.get $arr) (local.get $i)))
                            (if (i32.ge_s (local.get $m) (i32.const 0))
                                (then
                                 (local.set $mask
                                            (i32.or
                                             (local.get $mask)
                                             (i32.shl (i32.const 1) (local.get $m)))))
                                (else
                                 (local.set $start
                                            (i32.sub (i32.const -1) (local.get $m)))
                                 (local.set $mask
                                            (i32.or
                                             (local.get $mask)
                                             (i32.shl (i32.const -1) (local.get $start))))))
                            (local.set $i (i32.add (local.get $i) (i32.const 1)))
                            (br $loop)))
               (local.get $mask))


         (func $raise-argument-error:fixnum-expected (unreachable))

         (func $procedure-arity-includes?
               (param $proc    (ref eq))
               (param $k       (ref eq))    ;; fixnum
               (param $kws-ok? (ref eq))    ;; fixnum or #f
               (result         (ref eq))    ;; returns #true or #false

               (local $k-fx    (ref i31))
               (local $k-i32   i32)
               (local $mask-fx (ref i31))
               (local $mask    i32)

               ;; Step 1: type check and decode k
               (if (ref.test (ref i31) (local.get $k))
                   (then
                    (local.set $k-fx (ref.cast (ref i31) (local.get $k)))
                    (local.set $k-i32 (i32.shr_u (i31.get_u (local.get $k-fx)) (i32.const 1))))
                   (else
                    (call $raise-argument-error:fixnum-expected)
                    (unreachable)))
               ;; Step 2: call procedure-arity-mask
               (local.set $mask-fx (ref.cast (ref i31)
                                             (call $procedure-arity-mask (local.get $proc))))
               (local.set $mask    (i32.shr_u (i31.get_u (local.get $mask-fx)) (i32.const 1)))
               ;; Step 3: check if bit $k-i32 is set in $mask
               (if (i32.ne (i32.and (local.get $mask)
                                    (i32.shl (i32.const 1) (local.get $k-i32)))
                           (i32.const 0))
                   (then (return (global.get $true)))
                   (else (return (global.get $false))))
               (unreachable))


         (func $procedure-arity-includes?/checked/i32
               (param $proc    (ref $Procedure))
               (param $k-i32   i32)
               ; (param $kws-ok? (ref eq))          ;; we don't use this yet
               (result         i32)

               (local $mask i32)

               ;; Step 1: get the arity mask
               (local.set $mask (call $procedure-arity-mask/checked/i32
                                      (local.get $proc)))
               ;; Step 2: check if bit $k-i32 is set in $mask
               (i32.ne (i32.and (local.get $mask)
                                (i32.shl (i32.const 1) (local.get $k-i32)))
                       (i32.const 0)))


         ;;;
         ;;; PRIMITIVES
         ;;;

         ; https://docs.racket-lang.org/reference/procedures.html

         ; 4.20.2 Reflecting on Primitives

         (func $raise-argument-error:primitive-procedure-expected (unreachable))

         (func $primitive? (type $Prim1)
               ,@(make-predicate-body '$PrimitiveProcedure))

         (func $primitive-result-arity (type $Prim1)
               (param $v (ref eq))
               (result (ref eq))

               (local $p (ref $PrimitiveProcedure))
               ;; Step 1: Validate type
               (if (i32.eqz (ref.test (ref $PrimitiveProcedure) (local.get $v)))
                   (then (call $raise-argument-error:primitive-procedure-expected)))
               ;; Step 2: Cast after validation
               (local.set $p (ref.cast (ref $PrimitiveProcedure) (local.get $v)))
               ;; Step 3: Return result-arity field
               (struct.get $PrimitiveProcedure $result-arity (local.get $p)))


         (func $primitive-closure? (type $Prim1)
               ,@(make-predicate-body '$PrimitiveClosure))

         ;;;
         ;;;  4.21 Void
         ;;;

         ;; https://docs.racket-lang.org/reference/void.html

         (func $void? (type $Prim1)
               (param $v (ref eq))
               (result   (ref eq))

               (if (result (ref eq))
                   (ref.eq (local.get $v) (global.get $void))
                   (then (global.get $true))
                   (else (global.get $false))))

         (func $void (type $Prim>=0)
               (param $xs (ref eq))
               (result    (ref eq))

               (global.get $void))

         (func $make-void (type $Prim0) (result (ref eq)) ; no arguments
               (return (global.get $void)))


         ;;;
         ;;; 10. CONTROL FLOW
         ;;;

         ;; 10.1 Multiple Values

         (func $values (type $Prim>=0)
               (param $args (ref eq))
               (result      (ref eq))

               (local $use-args? i32)
               (local $as        (ref $Args))
               (local $arr       (ref $Array))
               (local $len       i32)
               (local $vals      (ref $Values))

               ;; Initialize non-defaultable locals.
               (local.set $as   (array.new $Args (global.get $null) (i32.const 0)))
               (local.set $arr  (call $make-array (i32.const 0) (global.get $null)))
               (local.set $vals (array.new $Values (global.get $null) (i32.const 0)))
               (local.set $len  (i32.const 0))

               ;; Determine whether the rest arguments are in an $Args array or a list.
               (local.set $use-args? (ref.test (ref $Args) (local.get $args)))
               (if (local.get $use-args?)
                   ;; -- $Args case --
                   (then
                    (local.set $as  (ref.cast (ref $Args) (local.get $args)))
                    (local.set $len (array.len (local.get $as)))
                    ;; Single argument -> return it directly.
                    (if (i32.eq (local.get $len) (i32.const 1))
                        (then (return (array.get $Args (local.get $as) (i32.const 0)))))
                    ;; No arguments -> return an empty $Values array (zero values).
                    (if (i32.eqz (local.get $len))
                        (then (return (local.get $vals))))
                    ;; Multiple arguments -> pack them into a new $Values array.
                    (local.set $vals (array.new $Values (global.get $null) (local.get $len)))
                    (array.copy $Values $Args
                                (local.get $vals) (i32.const 0)
                                (local.get $as)  (i32.const 0)
                                (local.get $len)))
                   ;; -- list case --
                   (else
                    (local.set $arr (call $list->array (local.get $args)))
                    (local.set $len (array.len (local.get $arr)))
                    ;; Single argument -> return it directly.
                    (if (i32.eq (local.get $len) (i32.const 1))
                        (then (return (array.get $Array (local.get $arr) (i32.const 0)))))
                    ;; No arguments -> return an empty $Values array (zero values).
                    (if (i32.eqz (local.get $len))
                        (then (return (local.get $vals))))
                    ;; Multiple arguments -> pack them into a new $Values array.
                    (local.set $vals (array.new $Values (global.get $null) (local.get $len)))
                    (array.copy $Values $Array
                                (local.get $vals) (i32.const 0)
                                (local.get $arr) (i32.const 0)
                                (local.get $len))))

               (local.get $vals))


         (func $call-with-values (type $Prim2)
               (param $gen (ref eq))
               (param $rec (ref eq))
               (result     (ref eq))

               (local $g     (ref $Procedure))
               (local $r     (ref $Procedure))
               (local $ginv  (ref $ProcedureInvoker))
               (local $rinv  (ref $ProcedureInvoker))
               (local $vals  (ref eq))
               (local $vals* (ref $Values))
               (local $args  (ref $Args))
               (local $n     i32)

               ;; initialize $args to satisfy the validator; overwritten later
               (local.set $args (array.new $Args (global.get $null) (i32.const 0)))

               ;; Step 1: type check generator
               (if (i32.eqz (ref.test (ref $Procedure) (local.get $gen)))
                   (then (call $raise-argument-error:procedure-expected (local.get $gen))
                         (unreachable)))
               (local.set $g    (ref.cast (ref $Procedure) (local.get $gen)))

               ;; Step 2: type check receiver
               (if (i32.eqz (ref.test (ref $Procedure) (local.get $rec)))
                   (then (call $raise-argument-error:procedure-expected (local.get $rec))
                         (unreachable)))
               (local.set $r    (ref.cast (ref $Procedure) (local.get $rec)))

               ;; Step 3: call generator with zero arguments
               (local.set $ginv (struct.get $Procedure $invoke (local.get $g)))
               (local.set $vals
                          (call_ref $ProcedureInvoker
                                    (local.get $g)
                                    (array.new $Args (global.get $null) (i32.const 0))
                                    (local.get $ginv)))

               ;; Step 4: unpack returned values into argument array
               (if (ref.test (ref $Values) (local.get $vals))
                   (then (local.set $vals* (ref.cast (ref $Values) (local.get $vals)))
                         (local.set $n     (array.len (local.get $vals*)))
                         (local.set $args  (array.new $Args (global.get $null) (local.get $n)))
                         (array.copy $Args $Values
                                     (local.get $args) (i32.const 0)
                                     (local.get $vals*) (i32.const 0)
                                     (local.get $n)))
                   (else (local.set $args (array.new_fixed $Args 1 (local.get $vals)))))

               ;; Step 5: call receiver in tail position
               (local.set $rinv (struct.get $Procedure $invoke (local.get $r)))
               (return_call_ref $ProcedureInvoker
                                (local.get $r)
                                (local.get $args)
                                (local.get $rinv)))



         ;; 10.2 Exceptions

         ;; 10.3 Delayed Evaluation
         ;; 10.4 Continuations

         ;; invoke-escape-continuation : procedure-invoker
         ;;   Throw a private payload that call-with-escape-continuation catches.
         (func $invoke-escape-continuation (type $ProcedureInvoker)
               (param $proc (ref $Procedure))
               (param $args (ref $Args))
               (result      (ref eq))
               (throw $exn
                      (struct.new $EscapeContinuationJump
                                  (i32.const 0)
                                  (call $values (local.get $args))))
               (unreachable))

         ;; $call-thunk : procedure? -> any/c
         ;;   Invoke a zero-argument procedure.
         (func $call-thunk
               (param $thunk-raw (ref eq)) ;; procedure?
               (result           (ref eq))

               (local $thunk (ref $Procedure))
               (local $inv   (ref $ProcedureInvoker))

               (if (i32.eqz (ref.test (ref $Procedure) (local.get $thunk-raw)))
                   (then (call $raise-argument-error:procedure-expected (local.get $thunk-raw))
                         (unreachable)))
               (local.set $thunk (ref.cast (ref $Procedure) (local.get $thunk-raw)))
               (local.set $inv   (struct.get $Procedure $invoke (local.get $thunk)))
               (call_ref $ProcedureInvoker
                         (local.get $thunk)
                         (array.new $Args (global.get $null) (i32.const 0))
                         (local.get $inv)))

         ;; dynamic-wind : (-> any/c) (-> any/c) (-> any/c) -> any/c
         ;;   Run before/body/after with exception-safe cleanup. This first
         ;;   WebRacket slice does not model continuation jumps, but it covers
         ;;   the expander namespace registry's lock discipline.
         (func $dynamic-wind (type $Prim3)
               (param $before (ref eq)) ;; before thunk
               (param $body   (ref eq)) ;; body thunk
               (param $after  (ref eq)) ;; after thunk
               (result        (ref eq))

               (local $res     (ref eq))
               (local $exn-val (ref eq))

               (drop (call $call-thunk (local.get $before)))
               (local.set $res
                          (block $done (result (ref eq))
                            (block $handler-block (result (ref eq))
                              (try_table (result (ref eq))
                                         (catch $exn $handler-block)
                                         (call $call-thunk (local.get $body))
                                         (br $done)))
                            (local.set $exn-val)
                            (drop (call $call-thunk (local.get $after)))
                            (throw $exn (local.get $exn-val))
                            (unreachable)))
               (drop (call $call-thunk (local.get $after)))
               (local.get $res))

         ;; dynamic-require : module-path? (or/c symbol? #f 0) [(-> any/c)] -> any/c
         ;;   WebRacket does not support runtime dynamic module loading yet.
         ;;   When callers supply the optional failure thunk, use it as the
         ;;   documented fallback; otherwise raise an unsupported-operation
         ;;   error. The module path and requested name are intentionally not
         ;;   interpreted in this bootstrap primitive.
         (func $dynamic-require (type $Prim23)
               (param $mod-path      (ref eq)) ;; module-path?; currently ignored
               (param $name          (ref eq)) ;; symbol?, #f, or 0; currently ignored
               (param $failure-thunk (ref eq)) ;; optional thunk, default = #f
               (result               (ref eq))

               (if (ref.eq (local.get $failure-thunk) (global.get $missing))
                   (then (local.set $failure-thunk (global.get $false))))
               (if (ref.eq (local.get $failure-thunk) (global.get $false))
                   (then
                    (call $raise-argument-error1
                          (global.get $symbol:dynamic-require)
                          (global.get $string:dynamic-require-unsupported)
                          (local.get $mod-path))
                    (unreachable)))
               (if (result (ref eq))
                   (ref.eq (call $procedure? (local.get $failure-thunk)) (global.get $true))
                   (then
                    (call $call-thunk (local.get $failure-thunk)))
                   (else
                    (call $raise-argument-error1
                          (global.get $symbol:dynamic-require)
                          (global.get $string:procedure?)
                          (local.get $failure-thunk))
                    (unreachable))))

         ;; call-with-continuation-barrier : (-> any/c) -> any/c
         ;;   Bootstrap approximation for the expander: WebRacket currently
         ;;   has no first-class continuation jumps, so there is no barrier to
         ;;   enforce yet. If call/cc or prompt abort support is reinstated,
         ;;   this must become a real delimiter for continuation jumps.
         (func $call-with-continuation-barrier (type $Prim1)
               (param $thunk (ref eq)) ;; procedure?
               (result       (ref eq))
               (call $call-thunk (local.get $thunk)))

         ;; call-with-escape-continuation : ((procedure? -> any/c) -> any/c) -> any/c
         ;;   Bootstrap implementation using a private Wasm exception. This
         ;;   supports the expander's `let/ec` patterns, including early return
         ;;   through the current call. It is still not a full Racket escape
         ;;   continuation: the escape procedure is not dynamically invalidated
         ;;   after return, and real continuation prompts/barriers are deferred.
         (func $call-with-escape-continuation (type $Prim1)
               (param $proc-raw (ref eq)) ;; procedure?
               (result          (ref eq))

               (local $proc    (ref $Procedure))
               (local $inv     (ref $ProcedureInvoker))
               (local $exn-val (ref eq))
               (local $jump    (ref $EscapeContinuationJump))

               (local.set $proc (global.get $dummy-closure))
               (local.set $inv  (ref.func $invoke-closure))
               (local.set $exn-val (global.get $false))
               (local.set $jump
                          (struct.new $EscapeContinuationJump
                                      (i32.const 0)
                                      (global.get $false)))

               (if (i32.eqz (ref.test (ref $Procedure) (local.get $proc-raw)))
                   (then (call $raise-argument-error:procedure-expected (local.get $proc-raw))
                         (unreachable)))
               (local.set $proc (ref.cast (ref $Procedure) (local.get $proc-raw)))
               (local.set $inv  (struct.get $Procedure $invoke (local.get $proc)))
               (block $done (result (ref eq))
                 (block $handler-block (result (ref eq))
                   (try_table (result (ref eq))
                              (catch $exn $handler-block)
                              (call_ref $ProcedureInvoker
                                        (local.get $proc)
                                        (array.new_fixed $Args
                                                         1
                                                         (global.get $escape-continuation-closure))
                                        (local.get $inv))
                              (br $done)))
                 (local.set $exn-val)
                 (if (ref.test (ref $EscapeContinuationJump) (local.get $exn-val))
                     (then
                      (local.set $jump
                                 (ref.cast (ref $EscapeContinuationJump)
                                           (local.get $exn-val)))
                      (return (struct.get $EscapeContinuationJump $value (local.get $jump)))))
                 (throw $exn (local.get $exn-val))
                 (unreachable)))

         ;; unsafe-root-continuation-prompt-tag : -> any/c
         ;;   Stable root prompt-tag placeholder. WebRacket does not implement
         ;;   continuation prompts yet, but expander startup code can obtain and
         ;;   compare this value without exercising prompt control behavior.
         (func $unsafe-root-continuation-prompt-tag (type $Prim0)
               (result (ref eq))
               (global.get $symbol:root-continuation-prompt-tag))

         ;; 10.5 Continuation Marks

         ;; call-with-immediate-continuation-mark : any/c (any/c -> any/c) [any/c] -> any/c
         ;;   WebRacket currently erases with-continuation-mark frames, so the
         ;;   current frame has no mark to inspect. Follow the Reference's
         ;;   "not found" behavior and tail-call proc with default-v, whose
         ;;   optional default is #f.
         (func $call-with-immediate-continuation-mark (type $Prim23)
               (param $key       (ref eq)) ;; any/c, ignored until real marks exist
               (param $proc-raw  (ref eq)) ;; procedure?
               (param $default-v (ref eq)) ;; optional any/c, default = #f
               (result           (ref eq))

               (local $proc (ref $Procedure))
               (local $inv  (ref $ProcedureInvoker))
               (local $arg  (ref eq))

               (if (i32.eqz (ref.test (ref $Procedure) (local.get $proc-raw)))
                   (then (call $raise-argument-error:procedure-expected
                               (local.get $proc-raw))
                         (unreachable)))
               (local.set $proc (ref.cast (ref $Procedure) (local.get $proc-raw)))
               (local.set $inv  (struct.get $Procedure $invoke (local.get $proc)))
               (local.set $arg
                          (if (result (ref eq))
                              (ref.eq (local.get $default-v) (global.get $missing))
                              (then (global.get $false))
                              (else (local.get $default-v))))
               (return_call_ref $ProcedureInvoker
                                (local.get $proc)
                                (array.new_fixed $Args 1 (local.get $arg))
                                (local.get $inv)))

         ;; make-continuation-mark-key : [symbol?] -> continuation-mark-key?
         ;;   Allocate a fresh opaque key. The optional symbol defaults to #f
         ;;   in WebRacket for now; Racket uses it only for printing.
         (func $make-continuation-mark-key (type $Prim01)
               (param $name-raw (ref eq)) ;; optional symbol?, default = fresh print name
               (result          (ref eq))
               (if (i32.and
                    (i32.eqz (ref.eq (local.get $name-raw) (global.get $missing)))
                    (i32.eqz (ref.test (ref $Symbol) (local.get $name-raw))))
                   (then (call $raise-argument-error1
                               (global.get $symbol:make-continuation-mark-key)
                               (global.get $string:symbol?)
                               (local.get $name-raw))
                         (unreachable)))
               (struct.new $ContinuationMarkKey
                           (i32.const 0)
                           (if (result (ref eq))
                               (ref.eq (local.get $name-raw) (global.get $missing))
                               (then (global.get $false))
                               (else (local.get $name-raw)))))

         ;; continuation-mark-key? : any/c -> boolean?
         ;;   Recognize keys allocated by make-continuation-mark-key.
         (func $continuation-mark-key? (type $Prim1)
               ,@(make-predicate-body '$ContinuationMarkKey))

         ;; current-continuation-marks : [continuation-prompt-tag?] -> continuation-mark-set?
         (func $current-continuation-marks (type $Prim01)
               ;; prompt-tag : continuation-prompt-tag? (optional, default = (default-continuation-prompt-tag))
               ;; NOTE: WebRacket currently lacks continuation marks, so this
               ;; stub returns a fresh empty mark set. Reinstating real marks
               ;; matters for mark-sensitive error reporting and protocols.
               (param $prompt-tag (ref eq))
               (result            (ref eq))
               (struct.new $ContinuationMarkSet (i32.const 0)))

         ;; continuation-mark-set? : any/c -> boolean?
         ;;   Recognize WebRacket's opaque empty mark-set placeholder.
         (func $continuation-mark-set? (type $Prim1)
               ,@(make-predicate-body '$ContinuationMarkSet))

         ;; continuation-prompt-available? : continuation-prompt-tag? [continuation?] -> boolean?
         ;;   WebRacket does not implement prompt control yet. Returning #t is
         ;;   the permissive bootstrap choice for libraries that merely check
         ;;   whether an exception/control prompt is installed before raising.
         (func $continuation-prompt-available? (type $Prim12)
               (param $prompt-tag (ref eq)) ;; continuation-prompt-tag?, currently unchecked
               (param $cont       (ref eq)) ;; optional continuation?, currently ignored
               (result            (ref eq))
               (global.get $true))

         ;; continuation-prompt-tag? : any/c -> boolean?
         ;;   Recognize WebRacket's stable root prompt placeholder. Full prompt
         ;;   tag allocation should introduce a distinct prompt-tag type later.
         (func $continuation-prompt-tag? (type $Prim1)
               (param $v (ref eq))
               (result   (ref eq))
               (if (result (ref eq))
                   (ref.eq (local.get $v) (global.get $symbol:root-continuation-prompt-tag))
                   (then (global.get $true))
                   (else (global.get $false))))

         ;; continuation? : any/c -> boolean?
         ;;   WebRacket does not expose first-class continuations yet.
         (func $continuation? (type $Prim1)
               (param $v (ref eq))
               (result   (ref eq))
               (global.get $false))

         ;; continuation-mark-set-first : continuation-mark-set? any/c [any/c] [continuation-prompt-tag?] -> any/c
         ;;   Bootstrap-only approximation used while bringing up the Racket
         ;;   expander. Since `with-continuation-mark*` is currently erased by
         ;;   Webify, there is no mark stack to inspect. Returning the
         ;;   caller's `none-v` value (default #f) matches Racket's "not found"
         ;;   convention closely enough for startup probes, but real
         ;;   continuation marks should replace this before relying on
         ;;   mark-sensitive error reporting or dynamic protocols.
         (func $continuation-mark-set-first (type $Prim24)
               (param $marks      (ref eq)) ;; continuation-mark-set? or #f
               (param $key        (ref eq)) ;; any/c
               (param $none-v     (ref eq)) ;; optional any/c, default = #f
               (param $prompt-tag (ref eq)) ;; optional continuation-prompt-tag?
               (result            (ref eq))
               (if (ref.eq (local.get $key) (global.get $parameterization-key))
                   (then (return (global.get $current-parameterization-value))))
               (if (result (ref eq))
                   (ref.eq (local.get $none-v) (global.get $missing))
                   (then (global.get $false))
                   (else (local.get $none-v))))

         ;; current-parameterization : -> parameterization?
         ;;   Return the current poor-man parameterization overlay.
         (func $current-parameterization (type $Prim0)
               (result (ref eq))
               (global.get $current-parameterization-value))

         ;; parameterization? : any/c -> boolean?
         ;;   Recognize WebRacket's lightweight parameterization overlays.
         (func $parameterization? (type $Prim1)
               ,@(make-predicate-body '$Parameterization))

         ;; parameter? : any/c -> boolean?
         ;;   Recognize the built-in parameter procedures currently modeled by
         ;;   WebRacket. User-created parameters need make-parameter support.
         (func $parameter? (type $Prim1)
               (param $v (ref eq)) ;; any/c
               (result   (ref eq))

               (if (ref.eq (local.get $v) (global.get $prim:current-input-port))
                   (then (return (global.get $true))))
               (if (ref.eq (local.get $v) (global.get $prim:current-output-port))
                   (then (return (global.get $true))))

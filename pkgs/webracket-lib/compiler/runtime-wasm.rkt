         ;;   Raise an exn:fail for an operation on a closed input port.
         (func $raise-input-port-closed
               (param $message (ref eq))

               (drop (call $raise
                           (call $make-exn:fail
                                 (local.get $message)
                                 (call $current-continuation-marks
                                       (global.get $missing)))
                           (global.get $true)))
               (unreachable))


              ;; Type check
              (if (i32.eqz (ref.test (ref i31) (local.get $c)))
                  (then (call $raise-check-char (local.get $c))))
              (local.set $i31   (ref.cast (ref i31) (local.get $c)))
              (local.set $c/tag (i31.get_u (local.get $i31)))
              ;; Decode codepoint
              (if (i32.ne (i32.and (local.get $c/tag)
                                   (i32.const ,char-mask))
                          (i32.const ,char-tag))
                  (then (call $raise-check-char (local.get $c))))

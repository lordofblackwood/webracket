                   (then (return (global.get $false))))
               (local.set $idx-fx (ref.i31 (i32.shl (local.get $idx) (i32.const 1))))
               (local.set $after-fx
                          (ref.i31 (i32.shl (i32.add (local.get $idx) (i32.const 1))
                                            (i32.const 1))))

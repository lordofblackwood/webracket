         (func $read-bytes-avail!* (type $Prim14)
               (param $bstr  (ref eq)) ;; bytes?
               (param $in    (ref eq)) ;; input-port?                (optional, default = (current-input-port))
               (param $start (ref eq)) ;; exact-nonnegative-integer? (optional, default = 0)

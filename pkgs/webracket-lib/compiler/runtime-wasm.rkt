               (param $b (ref eq)) (param $v (ref eq))
               (result (ref eq))
               (local $B (ref $Boxed))
               (local.set $B
                          (block $ok (result (ref $Boxed))
                                 (br_on_cast $ok (ref eq) (ref $Boxed) (local.get $b))
                                 (return (global.get $error))))
               (struct.set $Boxed $v (local.get $B) (local.get $v))
               (global.get $void))



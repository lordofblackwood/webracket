                           (i32.const 0)  ;; hash
                           (i32.const 0)  ;; immutable = false
                           (call $i8make-array (local.get $len) (local.get $val))))


         (func $bytes (type $Prim>=0) ; handles both $Args and list rest arguments
               (param $args (ref eq))
               (result      (ref eq))

               (local $as        (ref $Args))
               (local $len       i32)
               (local $arr       (ref $I8Array))
               (local $i         i32)
               (local $x         (ref eq))
               (local $v         i32)
               (local $use-args? i32)
               (local $list      (ref eq))
               (local $node      (ref eq))
               (local $pair      (ref $Pair))


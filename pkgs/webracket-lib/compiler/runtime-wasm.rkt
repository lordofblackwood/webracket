               (param $assocs (ref eq)) ;; optional association list, default null
               (result        (ref eq))
               (local $ht    (ref eq))
               (local $alist (ref eq))
               (local $pair  (ref $Pair))
               (local $kv    (ref eq))
               (local $kvp   (ref $Pair))

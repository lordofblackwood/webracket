                                                 (local.get $ht)
                                                 (struct.get $Pair $a (local.get $kvp))
                                                 (struct.get $Pair $d (local.get $kvp))))
                            (local.set $alist (struct.get $Pair $d (local.get $pair)))
                            (br $walk)))

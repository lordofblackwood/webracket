         analyze-and-prune-runtime-module
         analyzed-runtime-module?
         analyzed-runtime-module-module
         analyzed-runtime-module-runtime-forms
         analyzed-runtime-module-program-forms
         analyzed-runtime-module-stable-runtime-cache-fingerprint
         analyze-stable-runtime/cached
         analyze-stable-runtime
         list->eq-set
         primitive-graph-ref
         primitive-refs-for-functions
         primitive-retained-set
         program-driver-function-names
         prune-runtime-module
         read-stable-runtime-analysis-cache
         retained-function-set
         retained-runtime-sets
         split-module-forms
         split-runtime-request-cache-fingerprint
         stable-runtime-analysis-cache-fingerprint
         stable-runtime-analysis-cache-path
         stable-runtime-analysis-module
         write-runtime-primitive-report!
         write-stable-runtime-analysis-cache!)

(require (only-in "../private/parameters.rkt"
                  current-browser?
                  current-runtime-cache-dir
                  current-runtime-primitive-report-path
                  current-split-runtime?
                  current-tree-shake?)
         "../private/structs.rkt"
         "../private/wasm-utils.rkt"
         "constants.rkt"
         "module-forms.rkt"
         (only-in "runtime-metrics.rkt"
                  runtime-metric-add!
                  runtime-record-built-module-metrics!
                  runtime-record-split-module-metrics!
                  runtime-record-tree-shake-final-metrics!
                  runtime-record-tree-shake-retention-metrics!)
         (only-in "runtime-source.rkt"
                  runtime-source-fingerprint)
         (only-in "split-runtime-cache.rkt"
                  split-runtime-request-cache-fingerprint)
         racket/fasl
         racket/file)

;; analyzed-runtime-module :
;;   list? (listof datum?) (listof datum?) any/c -> analyzed-runtime-module?
;;   Carries a pruned module plus classified pruned forms for split mode.
(struct analyzed-runtime-module
  (module
   runtime-forms
   program-forms
   stable-runtime-cache-fingerprint)
  #:transparent)

;; default-time-runtime-step : string? (-> any/c) -> any/c
;;   Run a timed analysis thunk when the caller does not supply timing.
(define (default-time-runtime-step _label thunk)
  (thunk))

;; list->eq-set : list? -> hasheq?
;;   Build an eq?-keyed set represented as a mutable hash table.
(define (list->eq-set xs)
  (define ht (make-hasheq))
  (eq-set-add-all! ht xs)
  ht)

;; eq-set-add-all! : hasheq? list? -> void?
;;   Add all values to an eq?-keyed set.
(define (eq-set-add-all! ht xs)
  (for ([x (in-list xs)])
    (hash-set! ht x #t)))

;; eq-set-keys : hasheq? -> list?
;;   Return keys from an eq?-keyed set.
(define (eq-set-keys ht)
  (hash-keys ht))

;; eq-set-keys/sorted : hasheq? -> (listof symbol?)
;;   Return sorted symbol keys from an eq?-keyed set.
(define (eq-set-keys/sorted ht)
  (sort (hash-keys ht) symbol<?))

;; program-driver-function-names : (listof symbol?)
;;   Functions generated by runtime-wasm.rkt that belong to the program side.
(define program-driver-function-names
  '($entry
    $entry-uncaught-exception
    $entry-uncaught-exception1
    $entry-uncaught-exception2))

;; make-program-module-form? :
;;   #:program-function-names list? #:result-global symbol?
;;   #:top-level-variable-declarations list? #:string-constants list?
;;   #:bytes-constants list? #:symbol-constants list?
;;   [#:runtime-owned-constant-global-names list?]
;;   [#:runtime-owned-constant-data-names list?]
;;   [#:extra-program-function-names list?] [#:extra-program-global-names list?]
;;   -> (datum? -> boolean?)
;;   Build a classifier for program-specific generated module forms.
(define (make-program-module-form?
         #:program-function-names program-function-names
         #:result-global result
         #:top-level-variable-declarations top-level-variable-declarations
         #:string-constants string-constants
         #:bytes-constants bytes-constants
         #:symbol-constants symbol-constants
         #:runtime-owned-constant-global-names
         [runtime-owned-constant-global-names '()]
         #:runtime-owned-constant-data-names
         [runtime-owned-constant-data-names '()]
         #:extra-program-function-names [extra-program-function-names '()]
         #:extra-program-global-names [extra-program-global-names '()])
  (define runtime-owned-constant-global-name-set
    (list->eq-set runtime-owned-constant-global-names))
  (define runtime-owned-constant-data-name-set
    (list->eq-set runtime-owned-constant-data-names))
  (define program-function-name-set
    (list->eq-set
     (append program-function-names
             extra-program-function-names
             program-driver-function-names)))
  (define program-global-name-set
    (list->eq-set
     (append
      (list result)
      extra-program-global-names
      (for/list ([form (in-list top-level-variable-declarations)]
                 #:do [(define name (module-global-name form))]
                 #:when name)
        name)
      (for/list ([name (in-list (program-constant-global-names
                                  string-constants
                                  bytes-constants
                                  symbol-constants))]
                 #:unless (hash-ref runtime-owned-constant-global-name-set
                                     name
                                     #f))
        name))))
  (define program-data-name-set
    (list->eq-set
     (for/list ([name (in-list (program-constant-data-names
                                 string-constants
                                 bytes-constants
                                 symbol-constants))]
                #:unless (hash-ref runtime-owned-constant-data-name-set
                                    name
                                    #f))
       name)))
  (lambda (form)
    (define func-name (module-func-name form))
    (define global-name (module-global-name form))
    (define data-name (module-data-name form))
    (or (and func-name
             (hash-ref program-function-name-set func-name #f))
        (and global-name
             (hash-ref program-global-name-set global-name #f))
        (and data-name
             (hash-ref program-data-name-set data-name #f)))))

;; split-module-forms :
;;   list? #:program-function-names list? #:result-global symbol?
;;         #:top-level-variable-declarations list? #:string-constants list?
;;         #:bytes-constants list? #:symbol-constants list?
;;         [#:runtime-owned-constant-global-names list?]
;;         [#:runtime-owned-constant-data-names list?]
;;         [#:extra-program-function-names list?] [#:extra-program-global-names list?]
;;         -> (values list? list?)
;;   Split a module body into runtime-specific and program-specific forms.
(define (split-module-forms
         module
         #:program-function-names program-function-names
         #:result-global result
         #:top-level-variable-declarations top-level-variable-declarations
         #:string-constants string-constants
         #:bytes-constants bytes-constants
         #:symbol-constants symbol-constants
         #:runtime-owned-constant-global-names
         [runtime-owned-constant-global-names '()]
         #:runtime-owned-constant-data-names
         [runtime-owned-constant-data-names '()]
         #:extra-program-function-names [extra-program-function-names '()]
         #:extra-program-global-names [extra-program-global-names '()])
  (define program-module-form?
    (make-program-module-form?
     #:program-function-names program-function-names
     #:result-global result
     #:top-level-variable-declarations top-level-variable-declarations
     #:string-constants string-constants
     #:bytes-constants bytes-constants
     #:symbol-constants symbol-constants
     #:runtime-owned-constant-global-names runtime-owned-constant-global-names
     #:runtime-owned-constant-data-names runtime-owned-constant-data-names
     #:extra-program-function-names extra-program-function-names
     #:extra-program-global-names extra-program-global-names))
  (for/fold ([runtime-forms '()]
             [program-forms '()])
            ([form (in-list (cdr module))])
    (if (program-module-form? form)
        (values runtime-forms (cons form program-forms))
        (values (cons form runtime-forms) program-forms))))

;; named-symbol-form-signature : symbol? any/c -> (or/c list? #f)
;;   Return a top-level shape signature for a form with a symbolic name.
(define (named-symbol-form-signature kind form)
  (and (pair? form)
       (pair? (cdr form))
       (symbol? (cadr form))
       (list kind (cadr form))))

;; rec-type-signature : any/c -> list?
;;   Return named type declarations inside a recursive type group.
(define (rec-type-signature form)
  `(rec ,@(for/list ([part (in-list (cdr form))]
                     #:when (and (pair? part)
                                  (eq? (car part) 'type)
                                  (pair? (cdr part))
                                  (symbol? (cadr part))))
            (cadr part))))

;; stable-runtime-form-signature : any/c -> datum?
;;   Return a cheap cache-key signature for a stable runtime top-level form.
(define (stable-runtime-form-signature form)
  (cond
    [(module-func-name form)   => (lambda (name) `(func ,name))]
    [(module-global-name form) => (lambda (name) `(global ,name))]
    [(module-data-name form)   => (lambda (name) `(data ,name))]
    [(named-symbol-form-signature 'tag form) => values]
    [(named-symbol-form-signature 'type form) => values]
    [(and (pair? form) (eq? (car form) 'rec))
     (rec-type-signature form)]
    [(pair? form)
     (list (car form) (length form))]
    [else form]))

;; stable-runtime-module-signature : list? -> datum?
;;   Return a cheap top-level shape signature for stable runtime cache keys.
(define (stable-runtime-module-signature module)
  `(stable-runtime-module
    ,@(for/list ([form (in-list (cdr module))])
        (stable-runtime-form-signature form))))

;; stable-runtime-analysis-cache-fingerprint :
;;   list? #:browser? boolean? #:runtime-source-fingerprint any/c
;;         #:active-ffi-foreigns list? #:active-ffi-imports-wat list?
;;         #:active-ffi-funcs-wat list? -> list?
;;   Build the cache fingerprint for stable runtime analysis.
(define (stable-runtime-analysis-cache-fingerprint
         runtime-module
         #:browser? browser?
         #:runtime-source-fingerprint runtime-source-fingerprint
         #:active-ffi-foreigns active-ffi-foreigns
         #:active-ffi-imports-wat active-ffi-imports-wat
         #:active-ffi-funcs-wat active-ffi-funcs-wat)
  `(stable-runtime-analysis-cache
    2
    ,(if browser? 'browser 'node)
    ,runtime-source-fingerprint
    ,(stable-runtime-module-signature runtime-module)
    ,(sort (map foreign-racket-name active-ffi-foreigns) symbol<?)
    ,(equal-hash-code active-ffi-imports-wat)
    ,(equal-hash-code active-ffi-funcs-wat)))

;; stable-runtime-analysis-cache-path : any/c #:cache-root (or/c path-string? #f) -> (or/c path? #f)
;;   Return the path for a stable runtime analysis cache entry.
(define (stable-runtime-analysis-cache-path fingerprint #:cache-root cache-root)
  (and cache-root
       (build-path cache-root
                   "runtime-analysis-v2"
                   (format "~x.fasl"
                           (abs (equal-hash-code fingerprint))))))

;; read-stable-runtime-analysis-cache : (or/c path? #f) any/c -> (or/c list? #f)
;;   Read a stable runtime analysis cache entry when present and current.
(define (read-stable-runtime-analysis-cache cache-path fingerprint)
  (and cache-path
       (file-exists? cache-path)
       (with-handlers ([exn:fail? (lambda (_exn) #f)])
         (match (call-with-input-file cache-path
                  (lambda (in)
                    (fasl->s-exp (port->bytes in))))
           [`(,cached-fingerprint ,analysis)
            (and (equal? cached-fingerprint fingerprint) analysis)]
           [_ #f]))))

;; write-stable-runtime-analysis-cache! : (or/c path? #f) any/c list? -> void?
;;   Write a stable runtime analysis cache entry.
(define (write-stable-runtime-analysis-cache! cache-path fingerprint analysis)
  (when cache-path
    (make-directory* (path-only cache-path))
    (call-with-output-file cache-path
      (lambda (out)
        (write-bytes
         (s-exp->fasl (list fingerprint analysis))
         out))
      #:exists 'truncate/replace)))

;; stable-runtime-analysis-form? : datum? -> boolean?
;;   Check whether a runtime form belongs in the stable analysis module.
(define (stable-runtime-analysis-form? form)
  (define global-name (module-global-name form))
  (define data-name (module-data-name form))
  (and (not (and global-name
                 (constant-global-name? global-name)))
       (not (and data-name
                 (constant-data-name? data-name)))))

;; stable-runtime-analysis-module : list? -> list?
;;   Remove runtime constant data/globals from the module before stable analysis.
(define (stable-runtime-analysis-module module)
  (forms->module
   (for/list ([form (in-list (cdr module))]
              #:when (stable-runtime-analysis-form? form))
     form)))

;; analyze-stable-runtime/cached :
;;   list? #:browser? boolean? #:runtime-source-fingerprint any/c
;;         #:active-ffi-foreigns list? #:active-ffi-imports-wat list?
;;         #:active-ffi-funcs-wat list? #:cache-root (or/c path-string? #f)
;;         #:primitive-func->symbol hasheq? #:primitive-global->symbol hasheq?
;;         #:described-primitives (listof symbol?)
;;         [#:cache-fingerprint any/c]
;;         [#:time-runtime-step (string? (-> any/c) -> any/c)] -> list?
;;   Return stable runtime analysis, using the runtime-analysis cache when available.
(define (analyze-stable-runtime/cached
         stable-runtime-module
         #:browser? browser?
         #:runtime-source-fingerprint runtime-source-fingerprint
         #:active-ffi-foreigns active-ffi-foreigns
         #:active-ffi-imports-wat active-ffi-imports-wat
         #:active-ffi-funcs-wat active-ffi-funcs-wat
         #:cache-root cache-root
         #:primitive-func->symbol primitive-func->symbol
         #:primitive-global->symbol primitive-global->symbol
         #:described-primitives described-primitives
         #:cache-fingerprint [cache-fingerprint #f]
         #:time-runtime-step [time-runtime-step default-time-runtime-step])
  (define stable-runtime-cache-fingerprint
    (or cache-fingerprint
        (time-runtime-step
         "tree-shake:stable-runtime-cache-fingerprint"
         (lambda ()
           (stable-runtime-analysis-cache-fingerprint
            stable-runtime-module
            #:browser? browser?
            #:runtime-source-fingerprint runtime-source-fingerprint
            #:active-ffi-foreigns active-ffi-foreigns
            #:active-ffi-imports-wat active-ffi-imports-wat
            #:active-ffi-funcs-wat active-ffi-funcs-wat)))))
  (runtime-metric-add! "runtime:stable-runtime-fingerprint"
                       (format "~x"
                               (abs (equal-hash-code
                                     stable-runtime-cache-fingerprint))))
  (define stable-runtime-cache-path
    (stable-runtime-analysis-cache-path
     stable-runtime-cache-fingerprint
     #:cache-root cache-root))
  (runtime-metric-add! "tree-shake:runtime-analysis-v2-cache-enabled?"
                       (if stable-runtime-cache-path "yes" "no"))
  (define cached-stable-runtime-analysis
    (time-runtime-step
     "tree-shake:runtime-analysis-v2-cache-lookup"
     (lambda ()
       (read-stable-runtime-analysis-cache stable-runtime-cache-path
                                           stable-runtime-cache-fingerprint))))
  (cond
    [cached-stable-runtime-analysis
     (runtime-metric-add! "tree-shake:runtime-analysis-v2-cache-hit?" "yes")
     (time-runtime-step
      "tree-shake:runtime-analysis-v2-cache-hit"
      (lambda ()
        cached-stable-runtime-analysis))]
    [else
     (runtime-metric-add! "tree-shake:runtime-analysis-v2-cache-hit?" "no")
     (define computed-stable-runtime-analysis
       (time-runtime-step
        "tree-shake:analyze-stable-runtime"
        (lambda ()
          (analyze-stable-runtime
           stable-runtime-module
           #:primitive-func->symbol primitive-func->symbol
           #:primitive-global->symbol primitive-global->symbol
           #:described-primitives described-primitives
           #:time-runtime-step time-runtime-step))))
     (time-runtime-step
      "tree-shake:runtime-analysis-v2-cache-write"
      (lambda ()
        (write-stable-runtime-analysis-cache! stable-runtime-cache-path
                                              stable-runtime-cache-fingerprint
                                              computed-stable-runtime-analysis)))
     computed-stable-runtime-analysis]))

;; analyze-and-prune-runtime-module :
;;   list? #:program-function-names (listof symbol?) #:result-global symbol?
;;         #:top-level-variable-declarations list? #:string-constants list?
;;         #:bytes-constants list? #:symbol-constants list?
;;         #:primitive-func->symbol hasheq? #:primitive-global->symbol hasheq?
;;         #:ffi-global->symbol hasheq? #:active-ffi-foreigns list?
;;         #:active-ffi-imports-wat list? #:active-ffi-funcs-wat list?
;;         [#:stable-runtime-active-ffi-foreigns list?]
;;         [#:stable-runtime-active-ffi-imports-wat list?]
;;         [#:stable-runtime-active-ffi-funcs-wat list?]
;;         [#:runtime-owned-constant-global-names list?]
;;         [#:runtime-owned-constant-data-names list?]
;;         [#:extra-program-function-names list?] [#:extra-program-global-names list?]
;;         #:described-primitives (listof symbol?) #:used-primitives (listof symbol?)
;;         #:console-bridge-primitive-names (listof symbol?)
;;         #:primitive-description? procedure?
;;         [#:time-runtime-step (string? (-> any/c) -> any/c)]
;;         [#:include-classified? boolean?] -> (or/c list? analyzed-runtime-module?)
;;   Split, analyze, report, and optionally prune a generated runtime module.
(define (analyze-and-prune-runtime-module
         full-module
         #:program-function-names program-function-names
         #:result-global result
         #:top-level-variable-declarations top-level-variable-declarations
         #:string-constants string-constants
         #:bytes-constants bytes-constants
         #:symbol-constants symbol-constants
         #:primitive-func->symbol primitive-func->symbol
         #:primitive-global->symbol primitive-global->symbol
         #:ffi-global->symbol ffi-global->symbol
         #:active-ffi-foreigns active-ffi-foreigns
         #:active-ffi-imports-wat active-ffi-imports-wat
         #:active-ffi-funcs-wat active-ffi-funcs-wat
         #:stable-runtime-active-ffi-foreigns
         [stable-runtime-active-ffi-foreigns active-ffi-foreigns]
         #:stable-runtime-active-ffi-imports-wat
         [stable-runtime-active-ffi-imports-wat active-ffi-imports-wat]
         #:stable-runtime-active-ffi-funcs-wat
         [stable-runtime-active-ffi-funcs-wat active-ffi-funcs-wat]
         #:runtime-owned-constant-global-names
         [runtime-owned-constant-global-names '()]
         #:runtime-owned-constant-data-names
         [runtime-owned-constant-data-names '()]
         #:extra-program-function-names [extra-program-function-names '()]
         #:extra-program-global-names [extra-program-global-names '()]
         #:described-primitives described-primitives
         #:used-primitives used-primitives
         #:console-bridge-primitive-names console-bridge-primitive-names
         #:primitive-description? primitive-description?
         #:time-runtime-step [time-runtime-step default-time-runtime-step]
         #:include-classified? [include-classified? #f])
  (time-runtime-step
   "runtime:record-built-module-metrics"
   (lambda ()
     (runtime-record-built-module-metrics! full-module)))
  (define-values (runtime-forms-before-prune program-forms-before-prune)
    (split-module-forms
     full-module
     #:program-function-names program-function-names
     #:result-global result
     #:top-level-variable-declarations top-level-variable-declarations
     #:string-constants string-constants
     #:bytes-constants bytes-constants
     #:symbol-constants symbol-constants
     #:runtime-owned-constant-global-names runtime-owned-constant-global-names
     #:runtime-owned-constant-data-names runtime-owned-constant-data-names
     #:extra-program-function-names extra-program-function-names
     #:extra-program-global-names extra-program-global-names))
  (runtime-record-split-module-metrics! runtime-forms-before-prune
                                        program-forms-before-prune
                                        program-function-names
                                        top-level-variable-declarations)
  (define runtime-only-module
    (forms->module runtime-forms-before-prune))
  (define stable-runtime-module
    (stable-runtime-analysis-module runtime-only-module))
  (define runtime-source-cache-fingerprint
    (runtime-source-fingerprint))
  (define stable-runtime-cache-fingerprint
    (time-runtime-step
     "tree-shake:stable-runtime-cache-fingerprint"
     (lambda ()
       (stable-runtime-analysis-cache-fingerprint
        stable-runtime-module
        #:browser? (current-browser?)
        #:runtime-source-fingerprint runtime-source-cache-fingerprint
        #:active-ffi-foreigns stable-runtime-active-ffi-foreigns
        #:active-ffi-imports-wat stable-runtime-active-ffi-imports-wat
        #:active-ffi-funcs-wat stable-runtime-active-ffi-funcs-wat))))
  (define stable-runtime-analysis
    (analyze-stable-runtime/cached
     stable-runtime-module
     #:browser? (current-browser?)
     #:runtime-source-fingerprint runtime-source-cache-fingerprint
     #:active-ffi-foreigns stable-runtime-active-ffi-foreigns
     #:active-ffi-imports-wat stable-runtime-active-ffi-imports-wat
     #:active-ffi-funcs-wat stable-runtime-active-ffi-funcs-wat
     #:cache-root (current-runtime-cache-dir)
     #:primitive-func->symbol primitive-func->symbol
     #:primitive-global->symbol primitive-global->symbol
     #:described-primitives described-primitives
     #:cache-fingerprint stable-runtime-cache-fingerprint
     #:time-runtime-step time-runtime-step))
  (define program-analysis
    (time-runtime-step
     "tree-shake:analyze-program-fragment"
     (lambda ()
       (analyze-program-fragment
        program-forms-before-prune
        stable-runtime-analysis
        #:primitive-func->symbol primitive-func->symbol
        #:primitive-global->symbol primitive-global->symbol
        #:used-primitives used-primitives
        #:console-bridge-primitive-names console-bridge-primitive-names
        #:primitive-description? primitive-description?))))
  (define analysis
    (time-runtime-step
     "tree-shake:combine-analysis"
     (lambda ()
       (append stable-runtime-analysis
               program-analysis))))
  (define-values (retained-primitives retained-functions)
    (time-runtime-step
     "tree-shake:retain-closure"
     (λ ()
       (retained-runtime-sets analysis
                              described-primitives
                              (current-tree-shake?)
                              primitive-func->symbol))))
  (runtime-record-tree-shake-retention-metrics! retained-primitives
                                                retained-functions)
  (time-runtime-step
   "tree-shake:write-report"
   (λ ()
     (write-runtime-primitive-report!
      (current-runtime-primitive-report-path)
      analysis
      retained-primitives
      described-primitives)))
  (define pruned-program-function-names
    (append program-function-names extra-program-function-names))
  (define (prune-forms forms)
    (prune-runtime-forms
     forms
     retained-primitives
     retained-functions
     #:program-function-names pruned-program-function-names
     #:program-driver-function-names program-driver-function-names
     #:primitive-global->symbol primitive-global->symbol
     #:ffi-global->symbol ffi-global->symbol
     #:active-ffi-foreigns active-ffi-foreigns))
  (define-values (final-module final-runtime-forms final-program-forms)
    (if (current-tree-shake?)
        (time-runtime-step
         "tree-shake:prune-runtime-module"
         (λ ()
           (define pruned-module-forms (prune-forms (cdr full-module)))
           (define pruned-runtime-forms
             (and include-classified?
                  (prune-forms (reverse runtime-forms-before-prune))))
           (define pruned-program-forms
             (and include-classified?
                  (prune-forms (reverse program-forms-before-prune))))
           (values (forms->module pruned-module-forms)
                   pruned-runtime-forms
                   pruned-program-forms)))
        (values full-module
                (and include-classified?
                     (reverse runtime-forms-before-prune))
                (and include-classified?
                     (reverse program-forms-before-prune)))))
  (time-runtime-step
   "tree-shake:record-final-metrics"
   (lambda ()
     (runtime-record-tree-shake-final-metrics! final-module
                                               described-primitives
                                               retained-primitives
                                               (current-tree-shake?))))
  (if include-classified?
      (analyzed-runtime-module final-module
                               final-runtime-forms
                               final-program-forms
                               stable-runtime-cache-fingerprint)
      final-module))

;; walk-symbol-refs : any/c hasheq? -> (listof symbol?)
;;   Find symbolic references represented by keys in `symbol->value`.
(define (walk-symbol-refs x symbol->value)
  (define refs (make-hasheq))
  (define (walk x)
    (cond
      [(symbol? x)
       (define v (hash-ref symbol->value x #f))
       (when v
         (hash-set! refs (if (eq? v #t) x v) #t))]
      [(pair? x)
       (walk (car x))
       (walk (cdr x))]
      [else (void)]))
  (walk x)
  (eq-set-keys refs))

;; analyze-stable-runtime :
;;   list? #:primitive-func->symbol hasheq? #:primitive-global->symbol hasheq?
;;         #:described-primitives (listof symbol?)
;;         [#:time-runtime-step (string? (-> any/c) -> any/c)] -> list?
;;   Build runtime function and primitive dependency graphs for stable forms.
(define (analyze-stable-runtime
         module
         #:primitive-func->symbol primitive-func->symbol
         #:primitive-global->symbol primitive-global->symbol
         #:described-primitives described-primitives
         #:time-runtime-step [time-runtime-step default-time-runtime-step])
  (define primitive-ref->symbol
    (time-runtime-step
     "tree-shake:build-primitive-ref-map"
     (lambda ()
       (let ([ht (make-hasheq)])
         (for ([(k v) (in-hash primitive-func->symbol)])
           (hash-set! ht k v))
         (for ([(k v) (in-hash primitive-global->symbol)])
           (hash-set! ht k v))
         ht))))
  (define named-funcs
    (time-runtime-step
     "tree-shake:collect-named-functions"
     (lambda ()
       (for/list ([form (in-list (cdr module))]
                  #:do [(define name (module-func-name form))]
                  #:when name)
         name))))
  (define (func-export-names form)
    (and (pair? form)
         (eq? (car form) 'func)
         (pair? (cdr form))
         (symbol? (cadr form))
         (for/list ([part (in-list (cddr form))]
                    #:when (and (pair? part)
                                (eq? (car part) 'export)
                                (pair? (cdr part))
                                (string? (cadr part))))
           (cadr part))))
  (define named-funcs-ht
    (for/hasheq ([name (in-list named-funcs)])
      (values name #t)))
  (define func->func-refs (make-hasheq))
  (define func->primitive-refs (make-hasheq))
  (time-runtime-step
   "tree-shake:build-call-graph"
   (lambda ()
     (for ([form (in-list (cdr module))])
       (define name (module-func-name form))
       (when name
         (define refs
           (for/list ([sym (in-list (walk-symbol-refs (cddr form) primitive-ref->symbol))]
                      #:when (not (eq? sym name)))
             sym))
         (hash-set! func->primitive-refs name refs)
         (hash-set! func->func-refs
                    name
                    (walk-symbol-refs (cddr form) named-funcs-ht))))))
  (define primitive-func-name?
    (lambda (name) (and (symbol? name) (hash-ref primitive-func->symbol name #f))))
  (define exported-runtime-functions
    (for/list ([form (in-list (cdr module))]
               #:do [(define name (module-func-name form))]
               #:when (and name
                           (pair? (func-export-names form))
                           (not (primitive-func-name? name))))
      name))
  (define (collect-nonprimitive-function-refs x)
    (define refs (make-hasheq))
    (define (walk x)
      (cond
        [(symbol? x)
         (when (and (hash-ref named-funcs-ht x #f)
                    (not (primitive-func-name? x)))
           (hash-set! refs x #t))]
        [(pair? x)
         (walk (car x))
         (walk (cdr x))]
        [else (void)]))
    (walk x)
    (eq-set-keys refs))
  (define module-root-funcs
    (time-runtime-step
     "tree-shake:seed-module-roots"
     (lambda ()
       (let ([roots (list->eq-set exported-runtime-functions)])
         (for ([form (in-list (cdr module))]
               #:unless (or (module-func-name form)
                            (and (pair? form)
                                 (eq? (car form) 'elem)
                                 (pair? (cdr form))
                                 (eq? (cadr form) 'declare)
                                 (pair? (cddr form))
                                 (eq? (caddr form) 'funcref))))
           (eq-set-add-all! roots (collect-nonprimitive-function-refs form)))
         (eq-set-keys roots)))))
  (define elem-root-functions
    (time-runtime-step
     "tree-shake:seed-elem-roots"
     (lambda ()
       (let ([roots (make-hasheq)])
         (for ([form (in-list (cdr module))]
               #:when (and (pair? form)
                           (eq? (car form) 'elem)
                           (pair? (cdr form))
                           (eq? (cadr form) 'declare)
                           (pair? (cddr form))
                           (eq? (caddr form) 'funcref)))
           (eq-set-add-all! roots
                            (filter (lambda (name) (not (primitive-func-name? name)))
                                    (walk-symbol-refs form named-funcs-ht))))
         (eq-set-keys roots)))))
  (define (reachable-runtime-funcs roots)
    (let loop ([pending roots] [seen (make-hasheq)])
      (match pending
        ['() (eq-set-keys seen)]
        [(cons name rest)
         (cond
           [(hash-ref seen name #f)
            (loop rest seen)]
           [(primitive-func-name? name)
            (loop rest seen)]
           [else
            (hash-set! seen name #t)
            (loop (append (hash-ref func->func-refs name '()) rest)
                  seen)])])))
  (define runtime-funcs
    (time-runtime-step
     "tree-shake:reach-runtime-roots"
     (lambda ()
       (reachable-runtime-funcs module-root-funcs))))
  (define runtime-root-primitives
    (time-runtime-step
     "tree-shake:collect-runtime-root-primitives"
     (lambda ()
       (let ([roots (make-hasheq)])
         (for ([name (in-list runtime-funcs)])
           (eq-set-add-all! roots (hash-ref func->primitive-refs name '())))
         (eq-set-keys/sorted roots)))))
  (define primitive-graph
    (time-runtime-step
     "tree-shake:build-primitive-graph"
     (lambda ()
       (for/list ([pr (in-list (sort described-primitives symbol<?))])
         (define start ($ pr))
         (define reachable
           (let loop ([pending (hash-ref func->func-refs start '())]
                      [seen (let ([ht (make-hasheq)])
                              (hash-set! ht start #t)
                              ht)])
             (match pending
               ['() (eq-set-keys seen)]
               [(cons name rest)
                (cond
                  [(hash-ref seen name #f)
                   (loop rest seen)]
                  [(primitive-func-name? name)
                   (loop rest seen)]
                  [else
                   (hash-set! seen name #t)
                   (loop (append (hash-ref func->func-refs name '()) rest)
                         seen)])])))
         (cons pr
               (let ([deps (make-hasheq)])
                 (for ([name (in-list reachable)])
                   (for ([dep (in-list (hash-ref func->primitive-refs name '()))]
                         #:unless (eq? dep pr))
                     (hash-set! deps dep #t)))
                 (eq-set-keys/sorted deps)))))))
  (define incoming-primitives
    (time-runtime-step
     "tree-shake:collect-incoming-primitives"
     (lambda ()
       (let ([incoming (make-hasheq)])
         (for ([entry (in-list primitive-graph)])
           (eq-set-add-all! incoming (cdr entry)))
         (eq-set-keys incoming)))))
  (define incoming-primitives-ht
    (list->eq-set incoming-primitives))
  (define runtime-root-primitives-ht
    (list->eq-set runtime-root-primitives))
  (define isolated-primitives
    (time-runtime-step
     "tree-shake:classify-isolated-primitives"
     (lambda ()
       (sort
        (for/list ([pr (in-list described-primitives)]
                   #:unless (or (hash-ref incoming-primitives-ht pr #f)
                                (hash-ref runtime-root-primitives-ht pr #f)))
          pr)
        symbol<?))))
  (list (cons 'primitive-graph primitive-graph)
        (cons 'function-graph
              (for/list ([name (in-list (sort named-funcs symbol<?))])
                (cons name (sort (hash-ref func->func-refs name '()) symbol<?))))
        (cons 'function-primitive-refs
              (for/list ([name (in-list (sort named-funcs symbol<?))])
                (cons name (sort (hash-ref func->primitive-refs name '()) symbol<?))))
        (cons 'exported-runtime-functions (sort exported-runtime-functions symbol<?))
        (cons 'module-root-functions (sort module-root-funcs symbol<?))
        (cons 'elem-root-functions (sort elem-root-functions symbol<?))
        (cons 'reachable-runtime-functions (sort runtime-funcs symbol<?))
        (cons 'reachable-runtime-function-primitive-refs
              (for/list ([name (in-list (sort runtime-funcs symbol<?))]
                         #:when (pair? (hash-ref func->primitive-refs name '())))
                (cons name (sort (hash-ref func->primitive-refs name '()) symbol<?))))
        (cons 'runtime-root-primitives runtime-root-primitives)
        (cons 'isolated-primitives isolated-primitives)))

;; analyze-program-fragment :
;;   list? list? #:primitive-func->symbol hasheq? #:primitive-global->symbol hasheq?
;;               #:used-primitives (listof symbol?)
;;               #:console-bridge-primitive-names (listof symbol?)
;;               #:primitive-description? (symbol? -> any/c) -> list?
;;   Analyze program forms for runtime-function and primitive roots.
(define (analyze-program-fragment
         program-forms
         runtime-analysis
         #:primitive-func->symbol primitive-func->symbol
         #:primitive-global->symbol primitive-global->symbol
         #:used-primitives used-primitives
         #:console-bridge-primitive-names console-bridge-primitive-names
         #:primitive-description? primitive-description?)
  (define runtime-function-names
    (for/list ([entry (in-list (primitive-graph-ref runtime-analysis 'function-graph))])
      (car entry)))
  (define runtime-function-name-set
    (list->eq-set runtime-function-names))
  (define primitive-ref->symbol
    (let ([ht (make-hasheq)])
      (for ([(k v) (in-hash primitive-func->symbol)])
        (hash-set! ht k v))
      (for ([(k v) (in-hash primitive-global->symbol)])
        (hash-set! ht k v))
      ht))
  (define runtime-root-functions
    (sort
     (remove-duplicates
      (for/fold ([roots '()]) ([form (in-list program-forms)])
        (append (walk-symbol-refs form runtime-function-name-set)
                roots)))
     symbol<?))
  (define program-root-primitives
    (sort
     (remove-duplicates
      (append
       (filter primitive-description?
               (remove-duplicates
                (append used-primitives
                        console-bridge-primitive-names)))
       (for/fold ([roots '()]) ([form (in-list program-forms)])
         (append (walk-symbol-refs form primitive-ref->symbol)
                 roots))))
     symbol<?))
  (list (cons 'program-root-functions runtime-root-functions)
        (cons 'program-root-primitives program-root-primitives)))

;; primitive-graph-ref : list? symbol? -> any/c
;;   Return an analysis entry by key.
(define (primitive-graph-ref analysis key)
  (cdr (assq key analysis)))

;; primitive-transitive-closure : (listof symbol?) list? -> (listof symbol?)
;;   Return primitive roots plus their transitive primitive dependencies.
(define (primitive-transitive-closure roots graph)
  (define graph-ht
    (for/hasheq ([entry (in-list graph)])
      (values (car entry) (cdr entry))))
  (let loop ([pending roots]
             [seen (make-hasheq)])
    (match pending
      ['() (eq-set-keys/sorted seen)]
      [(cons pr rest)
       (if (hash-ref seen pr #f)
           (loop rest seen)
           (begin
             (hash-set! seen pr #t)
             (loop (append (hash-ref graph-ht pr '())
                           rest)
                   seen)))])))

;; primitive-retained-set : list? -> (listof symbol?)
;;   Return primitives retained by runtime and program roots.
(define (primitive-retained-set analysis)
  (define graph          (primitive-graph-ref analysis 'primitive-graph))
  (define runtime-roots  (primitive-graph-ref analysis 'runtime-root-primitives))
  (define program-roots
    (primitive-graph-ref analysis 'program-root-primitives))
  (primitive-transitive-closure (append runtime-roots program-roots) graph))

;; primitive-refs-for-functions : list? (listof symbol?) -> (listof symbol?)
;;   Return primitive references reachable from the named functions.
(define (primitive-refs-for-functions analysis function-names)
  (define function-primitive-refs
    (primitive-graph-ref analysis 'function-primitive-refs))
  (define function-primitive-refs-ht
    (for/hasheq ([entry (in-list function-primitive-refs)])
      (values (car entry) (cdr entry))))
  (define refs (make-hasheq))
  (for ([name (in-list function-names)])
    (eq-set-add-all! refs (hash-ref function-primitive-refs-ht name '())))
  (eq-set-keys/sorted refs))

;; retained-function-set : list? (listof symbol?) #:primitive-func->symbol hasheq? -> (listof symbol?)
;;   Return runtime functions retained by module, program, and primitive roots.
(define (retained-function-set analysis retained-primitives #:primitive-func->symbol primitive-func->symbol)
  (define function-graph (primitive-graph-ref analysis 'function-graph))
  (define module-roots   (primitive-graph-ref analysis 'module-root-functions))
  (define elem-roots     (primitive-graph-ref analysis 'elem-root-functions))
  (define program-roots  (primitive-graph-ref analysis 'program-root-functions))
  (define retained-primitive-ht (make-hasheq))
  (for ([pr (in-list retained-primitives)])
    (hash-set! retained-primitive-ht pr #t))
  (define retained-primitive-funcs
    (for/list ([pr (in-list retained-primitives)])
      ($ pr)))
  (define function-graph-ht
    (for/hasheq ([entry (in-list function-graph)])
      (values (car entry) (cdr entry))))
  (let loop ([pending (append module-roots elem-roots program-roots retained-primitive-funcs)]
             [seen (make-hasheq)])
    (match pending
      ['() (eq-set-keys/sorted seen)]
      [(cons name rest)
       (cond
         [(hash-ref seen name #f)
          (loop rest seen)]
         [(and (hash-ref primitive-func->symbol name #f)
               (not (hash-ref retained-primitive-ht
                              (hash-ref primitive-func->symbol name)
                              #f)))
          (loop rest seen)]
         [else
          (hash-set! seen name #t)
          (loop (append (hash-ref function-graph-ht name '())
                        rest)
                seen)])])))

;; retained-runtime-sets : list? (listof symbol?) boolean? hasheq? -> (values list? list?)
;;   Return retained primitive and runtime function sets for tree-shaking.
(define (retained-runtime-sets analysis
                               described-primitives
                               tree-shake?
                               primitive-func->symbol)
  (if tree-shake?
      (let loop ([retained-primitives
                  (if (current-split-runtime?)
                      (sort described-primitives symbol<?)
                      (primitive-retained-set analysis))])
        (define retained-functions
          (if (current-split-runtime?)
              (sort
               (for/list ([entry (in-list (primitive-graph-ref analysis 'function-graph))])
                 (car entry))
               symbol<?)
              (retained-function-set
               analysis
               retained-primitives
               #:primitive-func->symbol primitive-func->symbol)))
        (define next-primitives
          (sort (remove-duplicates
                 (append retained-primitives
                         (primitive-refs-for-functions analysis retained-functions)))
                symbol<?))
        (if (equal? next-primitives retained-primitives)
            (values retained-primitives retained-functions)
            (loop next-primitives)))
      (values (sort described-primitives symbol<?)
              '())))

;; prune-runtime-forms :
;;   (listof datum?) (listof symbol?) (listof symbol?) #:program-function-names list?
;;   #:program-driver-function-names list? #:primitive-global->symbol hasheq?
;;   #:ffi-global->symbol hasheq? #:active-ffi-foreigns list? -> (listof datum?)
;;   Remove unretained runtime function/global forms from module body forms.
(define (prune-runtime-forms
         forms
         retained-primitives
         retained-functions
         #:program-function-names program-function-names
         #:program-driver-function-names program-driver-function-names
         #:primitive-global->symbol primitive-global->symbol
         #:ffi-global->symbol ffi-global->symbol
         #:active-ffi-foreigns active-ffi-foreigns)
  (define retained-ht
    (for/hasheq ([name (in-list (append program-function-names
                                        program-driver-function-names
                                        retained-functions))])
      (values name #t)))
  (define retained-primitive-ht (make-hasheq))
  (for ([pr (in-list retained-primitives)])
    (hash-set! retained-primitive-ht pr #t))
  (for ([f (in-list active-ffi-foreigns)])
    (hash-set! retained-primitive-ht (foreign-racket-name f) #t))
  (define (retained-primitive-global-name? name)
    (define pr
      (or (hash-ref primitive-global->symbol name #f)
          (hash-ref ffi-global->symbol name #f)))
    (or (not pr)
        (hash-ref retained-primitive-ht pr #f)))
  (define (primitive-global-init-form? x)
    (and (pair? x)
         (eq? (car x) 'global.set)
         (pair? (cdr x))
         (symbol? (cadr x))
         (or (hash-ref primitive-global->symbol (cadr x) #f)
             (hash-ref ffi-global->symbol (cadr x) #f))))
  (define (prune-elem-form form)
    (match form
      [`(elem declare funcref ,refs ...)
       `(elem declare funcref
              ,@(for/list ([ref (in-list refs)]
                           #:when (match ref
                                    [`(ref.func ,name)
                                     (hash-ref retained-ht name #f)]
                                    [_ #t]))
                  ref))]
      [_ form]))
  (define (prune-entry-form form)
    (match form
      [`(func $entry ,parts ...)
       `(func $entry
              ,@(for/list ([part (in-list parts)]
                           #:unless (and (primitive-global-init-form? part)
                                         (not (retained-primitive-global-name?
                                               (cadr part)))))
                  part))]
      [_ form]))
  (for/list ([form (in-list forms)]
             #:unless (let ([name (module-func-name form)])
                        (and name
                             (not (hash-ref retained-ht name #f))))
             #:unless (let ([name (module-global-name form)])
                        (and name
                             (not (retained-primitive-global-name? name)))))
    (cond
      [(eq? (module-func-name form) '$entry)
       (prune-entry-form form)]
      [(and (pair? form)
            (eq? (car form) 'elem))
       (prune-elem-form form)]
      [else form])))

;; prune-runtime-module :
;;   list? (listof symbol?) (listof symbol?) #:program-function-names list?
;;         #:program-driver-function-names list? #:primitive-global->symbol hasheq?
;;         #:ffi-global->symbol hasheq? #:active-ffi-foreigns list? -> list?
;;   Remove unretained runtime function/global forms from a module.
(define (prune-runtime-module
         module
         retained-primitives
         retained-functions
         #:program-function-names program-function-names
         #:program-driver-function-names program-driver-function-names
         #:primitive-global->symbol primitive-global->symbol
         #:ffi-global->symbol ffi-global->symbol
         #:active-ffi-foreigns active-ffi-foreigns)
  (forms->module
   (prune-runtime-forms
    (cdr module)
    retained-primitives
    retained-functions
    #:program-function-names program-function-names
    #:program-driver-function-names program-driver-function-names
    #:primitive-global->symbol primitive-global->symbol
    #:ffi-global->symbol ffi-global->symbol
    #:active-ffi-foreigns active-ffi-foreigns)))

;; write-runtime-primitive-report! :
;;   (or/c path-string? #f) list? (listof symbol?) (listof symbol?) -> void?
;;   Write the optional primitive-retention report.
(define (write-runtime-primitive-report! report-path
                                         analysis
                                         retained-primitives
                                         described-primitives)
  (when report-path
    (define program-root-primitives
      (primitive-graph-ref analysis 'program-root-primitives))
    (define program-root-functions
      (primitive-graph-ref analysis 'program-root-functions))
    (define isolated-primitives
      (primitive-graph-ref analysis 'isolated-primitives))
    (define runtime-root-primitives
      (primitive-graph-ref analysis 'runtime-root-primitives))
    (define total-primitives
      (length described-primitives))
    (define retained-count
      (length retained-primitives))
    (with-output-to-file report-path
      (lambda ()
        (pretty-write
         (list (list 'summary
                     (list 'total-primitives total-primitives)
                     (list 'program-root-count (length program-root-primitives))
                     (list 'program-root-function-count (length program-root-functions))
                     (list 'retained-count retained-count)
                     (list 'isolated-count (length isolated-primitives))
                     (list 'runtime-root-count (length runtime-root-primitives))
                     (list 'omitted-count (- total-primitives retained-count)))
               (cons 'program-root-primitives
                     program-root-primitives)
               (cons 'program-root-functions
                     program-root-functions)
               (cons 'retained-primitives retained-primitives)
               (cons 'isolated-primitives isolated-primitives)
               (cons 'module-root-functions
                     (primitive-graph-ref analysis 'module-root-functions))
               (cons 'reachable-runtime-functions
                     (primitive-graph-ref analysis 'reachable-runtime-functions))
               (cons 'reachable-runtime-function-primitive-refs
                     (primitive-graph-ref analysis
                                         'reachable-runtime-function-primitive-refs))
               (cons 'runtime-root-primitives runtime-root-primitives)
               (cons 'primitive-graph
                     (primitive-graph-ref analysis 'primitive-graph)))))
      #:exists 'replace)))

(module+ test
  (require rackunit
           (only-in "../private/parameters.rkt"
                    current-runtime-metric-rows))

  (define split-sample-module
    '(module
      (type $T (func))
      (func $runtime)
      (func $program)
      (func $entry)
      (global $runtime-global (mut (ref eq)) (ref.null eq))
      (global $program-global (mut (ref eq)) (ref.null eq))
      (data $string-data:program-string "program")
      (data $runtime-data "runtime")))

  (define-values (split-runtime-forms split-program-forms)
    (split-module-forms
     split-sample-module
     #:program-function-names '($program)
     #:result-global '$program-global
     #:top-level-variable-declarations
     '((global $program-global (mut (ref eq)) (ref.null eq)))
     #:string-constants '((program-string "program"))
     #:bytes-constants '()
     #:symbol-constants '()))

  (check-equal? split-runtime-forms
                '((data $runtime-data "runtime")
                  (global $runtime-global (mut (ref eq)) (ref.null eq))
                  (func $runtime)
                  (type $T (func))))
  (check-equal? split-program-forms
                '((data $string-data:program-string "program")
                  (global $program-global (mut (ref eq)) (ref.null eq))
                  (func $entry)
                  (func $program)))

  (define runtime-owned-constant-sample-module
    '(module
      (func $runtime
            (drop (global.get $symbol:check-list)))
      (func $entry
            (drop (global.get $symbol:check-list)))
      (data $symbol-data:check-list "check-list")
      (global $symbol:check-list (mut (ref eq)) (ref.i31 (i32.const 0)))))

  (define-values (runtime-owned-constant-runtime-forms
                  runtime-owned-constant-program-forms)
    (split-module-forms
     runtime-owned-constant-sample-module
     #:program-function-names '()
     #:result-global '$result
     #:top-level-variable-declarations '()
     #:string-constants '()
     #:bytes-constants '()
     #:symbol-constants '((check-list check-list))
     #:runtime-owned-constant-global-names '($symbol:check-list)
     #:runtime-owned-constant-data-names '($symbol-data:check-list)))

  (check-not-false
   (member '(data $symbol-data:check-list "check-list")
           runtime-owned-constant-runtime-forms))
  (check-not-false
   (member '(global $symbol:check-list (mut (ref eq)) (ref.i31 (i32.const 0)))
           runtime-owned-constant-runtime-forms))
  (check-false
   (member '(data $symbol-data:check-list "check-list")
           runtime-owned-constant-program-forms))
  (check-false
   (member '(global $symbol:check-list (mut (ref eq)) (ref.i31 (i32.const 0)))
           runtime-owned-constant-program-forms))

  (define split-extra-program-sample-module
    '(module
      (func $runtime-helper)
      (func $js-eval/imported (import "host" "js-eval"))
      (func $js-eval (call $js-eval/imported))
      (global $runtime-global (mut (ref eq)) (ref.null eq))
      (global $prim:js-eval (mut (ref eq)) (ref.null eq))))

  (define-values (split-extra-runtime-forms split-extra-program-forms)
    (split-module-forms
     split-extra-program-sample-module
     #:program-function-names '()
     #:result-global '$result
     #:top-level-variable-declarations '()
     #:string-constants '()
     #:bytes-constants '()
     #:symbol-constants '()
     #:extra-program-function-names '($js-eval/imported $js-eval)
     #:extra-program-global-names '($prim:js-eval)))

  (check-equal? split-extra-runtime-forms
                '((global $runtime-global (mut (ref eq)) (ref.null eq))
                  (func $runtime-helper)))
  (check-equal? split-extra-program-forms
                '((global $prim:js-eval (mut (ref eq)) (ref.null eq))
                  (func $js-eval (call $js-eval/imported))
                  (func $js-eval/imported (import "host" "js-eval"))))

  (define cache-fingerprint-a
    (stable-runtime-analysis-cache-fingerprint
     '(module (func $same (i32.const 1)))
     #:browser? #f
     #:runtime-source-fingerprint '(source a)
     #:active-ffi-foreigns '()
     #:active-ffi-imports-wat '()
     #:active-ffi-funcs-wat '()))
  (define cache-fingerprint-same-shape
    (stable-runtime-analysis-cache-fingerprint
     '(module (func $same (i32.const 2)))
     #:browser? #f
     #:runtime-source-fingerprint '(source a)
     #:active-ffi-foreigns '()
     #:active-ffi-imports-wat '()
     #:active-ffi-funcs-wat '()))
  (define cache-fingerprint-different-shape
    (stable-runtime-analysis-cache-fingerprint
     '(module (func $different (i32.const 1)))
     #:browser? #f
     #:runtime-source-fingerprint '(source a)
     #:active-ffi-foreigns '()
     #:active-ffi-imports-wat '()
     #:active-ffi-funcs-wat '()))
  (define cache-fingerprint-different-source
    (stable-runtime-analysis-cache-fingerprint
     '(module (func $same (i32.const 1)))
     #:browser? #f
     #:runtime-source-fingerprint '(source b)
     #:active-ffi-foreigns '()
     #:active-ffi-imports-wat '()
     #:active-ffi-funcs-wat '()))
  (check-match cache-fingerprint-a
    `(stable-runtime-analysis-cache 2 node ,_ ,_ ,_ ,_ ,_))
  (check-equal? cache-fingerprint-same-shape cache-fingerprint-a)
  (check-not-equal? cache-fingerprint-different-shape cache-fingerprint-a)
  (check-not-equal? cache-fingerprint-different-source cache-fingerprint-a)

  (define split-request-fingerprint-a
    (split-runtime-request-cache-fingerprint
     #:browser? #f
     #:runtime-source-fingerprint '(source a)
     #:active-ffi-foreigns '()
     #:active-ffi-imports-wat '((func $ffi/imported))
     #:active-ffi-funcs-wat '((func $ffi))))
  (define split-request-fingerprint-same
    (split-runtime-request-cache-fingerprint
     #:browser? #f
     #:runtime-source-fingerprint '(source a)
     #:active-ffi-foreigns '()
     #:active-ffi-imports-wat '((func $ffi/imported))
     #:active-ffi-funcs-wat '((func $ffi))))
  (define split-request-fingerprint-different-host
    (split-runtime-request-cache-fingerprint
     #:browser? #t
     #:runtime-source-fingerprint '(source a)
     #:active-ffi-foreigns '()
     #:active-ffi-imports-wat '((func $ffi/imported))
     #:active-ffi-funcs-wat '((func $ffi))))
  (define split-request-fingerprint-different-source
    (split-runtime-request-cache-fingerprint
     #:browser? #f
     #:runtime-source-fingerprint '(source b)
     #:active-ffi-foreigns '()
     #:active-ffi-imports-wat '((func $ffi/imported))
     #:active-ffi-funcs-wat '((func $ffi))))
  (define split-request-fingerprint-different-ffi
    (split-runtime-request-cache-fingerprint
     #:browser? #f
     #:runtime-source-fingerprint '(source a)
     #:active-ffi-foreigns '()
     #:active-ffi-imports-wat '((func $other/imported))
     #:active-ffi-funcs-wat '((func $ffi))))
  (check-match split-request-fingerprint-a
    `(split-runtime-request-cache 1 node ,_ ,_ ,_ ,_))
  (check-equal? split-request-fingerprint-same split-request-fingerprint-a)
  (check-not-equal? split-request-fingerprint-different-host
                    split-request-fingerprint-a)
  (check-not-equal? split-request-fingerprint-different-source
                    split-request-fingerprint-a)
  (check-not-equal? split-request-fingerprint-different-ffi
                    split-request-fingerprint-a)

  (define primitive-func->symbol
    (hasheq '$p 'p '$q 'q))

  (define primitive-global->symbol
    (hasheq '$prim:p 'p '$prim:q 'q))

  (define sample-runtime-module
    '(module
      (func $p)
      (func $q)
      (func $helper (call $p))
      (func $root (export "root") (call $helper))
      (global $prim:p (mut (ref eq)) (ref.null eq))
      (global $prim:q (mut (ref eq)) (ref.null eq))
      (data $string-data:constant "constant")
      (global $string:constant (mut (ref eq)) (ref.null eq))))

  (define analysis-module
    (stable-runtime-analysis-module sample-runtime-module))

  (check-false (member '(data $string-data:constant "constant")
                       (cdr analysis-module)))
  (check-false (member '(global $string:constant (mut (ref eq)) (ref.null eq))
                       (cdr analysis-module)))

  (define analysis
    (analyze-stable-runtime
     analysis-module
     #:primitive-func->symbol primitive-func->symbol
     #:primitive-global->symbol primitive-global->symbol
     #:described-primitives '(p q)))

  (check-equal? (primitive-graph-ref analysis 'runtime-root-primitives) '(p))
  (check-equal? (primitive-graph-ref analysis 'isolated-primitives) '(q))

  (define cache-root
    (make-temporary-file "runtime-analysis-cache-~a" 'directory))
  (dynamic-wind
    void
    (lambda ()
      (parameterize ([current-runtime-metric-rows '()])
        (define first-analysis
          (analyze-stable-runtime/cached
           analysis-module
           #:browser? #f
           #:runtime-source-fingerprint '(test-runtime-source)
           #:active-ffi-foreigns '()
           #:active-ffi-imports-wat '()
           #:active-ffi-funcs-wat '()
           #:cache-root cache-root
           #:primitive-func->symbol primitive-func->symbol
           #:primitive-global->symbol primitive-global->symbol
           #:described-primitives '(p q)))
        (check-equal? (primitive-graph-ref first-analysis 'runtime-root-primitives)
                      '(p))
        (define second-analysis
          (analyze-stable-runtime/cached
           analysis-module
           #:browser? #f
           #:runtime-source-fingerprint '(test-runtime-source)
           #:active-ffi-foreigns '()
           #:active-ffi-imports-wat '()
           #:active-ffi-funcs-wat '()
           #:cache-root cache-root
           #:primitive-func->symbol primitive-func->symbol
           #:primitive-global->symbol primitive-global->symbol
           #:described-primitives '(p q)))
        (check-equal? second-analysis first-analysis)
        (check-true
         (for/or ([row (in-list (current-runtime-metric-rows))])
           (equal? row
                   '("tree-shake:runtime-analysis-v2-cache-hit?" "yes"))))))
    (lambda ()
      (delete-directory/files cache-root)))

  (define combined-analysis
    (append analysis
            (list (cons 'program-root-primitives '(q))
                  (cons 'program-root-functions '()))))

  (check-equal? (primitive-retained-set combined-analysis) '(p q))

  (define-values (retained-primitives retained-functions)
    (retained-runtime-sets combined-analysis
                           '(q p)
                           #t
                           primitive-func->symbol))
  (check-equal? retained-primitives '(p q))
  (check-not-false (member '$root retained-functions))
  (check-not-false (member '$helper retained-functions))
  (check-not-false (member '$p retained-functions))

  (define split-stable-runtime-module
    '(module
      (func $p)
      (func $split-only-helper (call $p))
      (global $prim:p (mut (ref eq)) (ref.null eq))))
  (define split-stable-analysis
    (analyze-stable-runtime
     split-stable-runtime-module
     #:primitive-func->symbol primitive-func->symbol
     #:primitive-global->symbol primitive-global->symbol
     #:described-primitives '(p q)))
  (define split-stable-combined-analysis
    (append split-stable-analysis
            (list (cons 'program-root-primitives '())
                  (cons 'program-root-functions '()))))

  (define-values (normal-stable-primitives normal-stable-functions)
    (parameterize ([current-split-runtime? #f])
      (retained-runtime-sets split-stable-combined-analysis
                             '(q p)
                             #t
                             primitive-func->symbol)))
  (check-equal? normal-stable-primitives '())
  (check-equal? normal-stable-functions '())

  (define-values (split-stable-primitives split-stable-functions)
    (parameterize ([current-split-runtime? #t])
      (retained-runtime-sets split-stable-combined-analysis
                             '(q p)
                             #t
                             primitive-func->symbol)))
  (check-equal? split-stable-primitives '(p q))
  (check-equal? split-stable-functions '($p $split-only-helper))

  (define-values (unshaken-primitives unshaken-functions)
    (retained-runtime-sets combined-analysis
                           '(q p)
                           #f
                           primitive-func->symbol))
  (check-equal? unshaken-primitives '(p q))
  (check-equal? unshaken-functions '())

  (define pruned-module
    (prune-runtime-module
     sample-runtime-module
     '(p)
     '($p $helper $root)
     #:program-function-names '()
     #:program-driver-function-names '()
     #:primitive-global->symbol primitive-global->symbol
     #:ffi-global->symbol (hasheq)
     #:active-ffi-foreigns '()))

  (check-false (member '(func $q) (cdr pruned-module)))
  (check-false (member '(global $prim:q (mut (ref eq)) (ref.null eq))
                       (cdr pruned-module)))
  (check-not-false (member '(func $p) (cdr pruned-module)))
  (check-not-false (member '(global $prim:p (mut (ref eq)) (ref.null eq))
                           (cdr pruned-module)))

  (define pipeline-module
    '(module
      (func $p)
      (func $q)
      (func $helper (call $p))
      (func $root (export "root") (call $helper))
      (func $program)
      (func $entry (call $program))
      (global $prim:p (mut (ref eq)) (ref.null eq))
      (global $prim:q (mut (ref eq)) (ref.null eq))
      (global $program-global (mut (ref eq)) (ref.null eq))
      (data $string-data:program-string "program")))

  (define pipeline-final-module
    (parameterize ([current-tree-shake? #t]
                   [current-runtime-cache-dir #f]
                   [current-runtime-primitive-report-path #f]
                   [current-runtime-metric-rows '()])
      (analyze-and-prune-runtime-module
       pipeline-module
       #:program-function-names '($program)
       #:result-global '$program-global
       #:top-level-variable-declarations
       '((global $program-global (mut (ref eq)) (ref.null eq)))
       #:string-constants '((program-string "program"))
       #:bytes-constants '()
       #:symbol-constants '()
       #:primitive-func->symbol primitive-func->symbol
       #:primitive-global->symbol primitive-global->symbol
       #:ffi-global->symbol (hasheq)
       #:active-ffi-foreigns '()
       #:active-ffi-imports-wat '()
       #:active-ffi-funcs-wat '()
       #:described-primitives '(p q)
       #:used-primitives '()
       #:console-bridge-primitive-names '()
       #:primitive-description? (lambda (name) (memq name '(p q))))))

  (check-not-false (member '(func $p) (cdr pipeline-final-module)))
  (check-false (member '(func $q) (cdr pipeline-final-module)))
  (check-not-false (member '(func $program) (cdr pipeline-final-module)))
  (check-not-false (member '(func $entry (call $program))
                           (cdr pipeline-final-module)))
  (check-not-false (member '(global $prim:p (mut (ref eq)) (ref.null eq))
                           (cdr pipeline-final-module)))
  (check-false (member '(global $prim:q (mut (ref eq)) (ref.null eq))
                       (cdr pipeline-final-module)))

  (define pipeline-final-result
    (parameterize ([current-tree-shake? #t]
                   [current-runtime-cache-dir #f]
                   [current-runtime-primitive-report-path #f]
                   [current-runtime-metric-rows '()])
      (analyze-and-prune-runtime-module
       pipeline-module
       #:program-function-names '($program)
       #:result-global '$program-global
       #:top-level-variable-declarations
       '((global $program-global (mut (ref eq)) (ref.null eq)))
       #:string-constants '((program-string "program"))
       #:bytes-constants '()
       #:symbol-constants '()
       #:primitive-func->symbol primitive-func->symbol
       #:primitive-global->symbol primitive-global->symbol
       #:ffi-global->symbol (hasheq)
       #:active-ffi-foreigns '()
       #:active-ffi-imports-wat '()
       #:active-ffi-funcs-wat '()
       #:described-primitives '(p q)
       #:used-primitives '()
       #:console-bridge-primitive-names '()
       #:primitive-description? (lambda (name) (memq name '(p q)))
       #:include-classified? #t)))

  (check-true (analyzed-runtime-module? pipeline-final-result))
  (check-match
   (analyzed-runtime-module-stable-runtime-cache-fingerprint pipeline-final-result)
   `(stable-runtime-analysis-cache ,_ . ,_))
  (check-equal? (analyzed-runtime-module-module pipeline-final-result)
                pipeline-final-module)
  (check-not-false
   (member '(func $p)
           (analyzed-runtime-module-runtime-forms pipeline-final-result)))
  (check-false
   (member '(func $q)
           (analyzed-runtime-module-runtime-forms pipeline-final-result)))
  (check-not-false
   (member '(func $program)
           (analyzed-runtime-module-program-forms pipeline-final-result)))
  (check-not-false
   (member '(func $entry (call $program))
           (analyzed-runtime-module-program-forms pipeline-final-result))))

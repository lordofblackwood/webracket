                [(eq? dd <value>)  primitive-bypass-call]
                [(eq? dd <effect>) `(drop ,primitive-bypass-call)]
                [else              primitive-bypass-call]))]
         [tc
          `(return_call ,(Label l) (local.get $clos) ,args)]
         [else
          (cond
            [(eq? dd <value>)  `(call ,(Label l) (local.get $clos) ,args)]
            [(eq? dd <effect>) `(drop (call ,(Label l) (local.get $clos) ,args))]
            [else              `(call ,(Label l) (local.get $clos) ,args)])]))
     (match dd
       [(or '<effect> '<value>)  (match cd
                                   ['<return>           work]
                                   ['<expr>             work]
                                   ['<stat>             work])]
       [y                        (Store! y work)])]
    [(casearmapp ,s ,l ,ar ,i ,ae0 ,ae2 ...)
     (when (known0-only-direct-label? l)
       (error 'generate-code
              "known0-only helper must not use ordinary closure ABI casearmapp: ~a"
              (syntax-e (variable-id l))))
     (when (known1-only-direct-label? l)
       (error 'generate-code
              "known1-only helper must not use ordinary closure ABI casearmapp: ~a"
              (syntax-e (variable-id l))))
     (define tc (eq? cd '<return>))
     (define cclos
       `(ref.cast (ref $CaseClosure) ,(AExpr3 ae0 <value>)))
     (define clos
       `(ref.cast (ref $Closure)
                  (array.get $Array
                             (struct.get $CaseClosure $arms ,cclos)
                             (i32.const ,i))))
     (define raw-args
       `(array.new_fixed $Args ,(length ae2)
                         ,@(for/list ([ae (in-list ae2)])
                             (AExpr3 ae <value>))))
     (define args
       (if (negative? ar)
           `(call $repack-arguments ,raw-args (i32.const ,ar))
           raw-args))
     (define work
       (if tc
           `(return_call ,(Label l) ,clos ,args)
           (cond
             [(eq? dd <value>)  `(call ,(Label l) ,clos ,args)]
             [(eq? dd <effect>) `(drop (call ,(Label l) ,clos ,args))]
             [else              `(call ,(Label l) ,clos ,args)])))
     (match dd
       [(or '<effect> '<value>)  (match cd
                                   ['<return>           work]
                                   ['<expr>             work]
                                   ['<stat>             work])]
       [y                        (Store! y work)])]
    [(wcm ,s ,ae0 ,ae1 ,e)
     ;(displayln (list 'wcm 'dd dd 'cd cd s))
     (define-values (dest dest-declaration)
       (match dd
         [(or '<value> '<effect>) (let ([r (Var (new-var 'res))])
                                    (values r `(var [binding ,r '#f])))]
         [y                         (values y `(block))]))
     (let* ([key       (AExpr ae0)]
            [val       (AExpr ae1)]
            [result    (Expr e dest '<return>)] ; todo : is this correct?
            [enter     (match cd
                         ['<return>  `(sif ,_tc
                                           (app ,#'set-continuation-mark       ,key ,val)
                                           (app ,#'new-continuation-mark-frame ,key ,val))]
                         [_          `(app ,#'new-continuation-mark-frame ,key ,val)])]
            [leave     (match cd
                         ['<return> `(sif ,_tc
                                          (block) ; no frame to remove in tail position
                                          (app ,#'remove-continuation-mark-frame))]
                         [_         `(app ,#'remove-continuation-mark-frame)])]

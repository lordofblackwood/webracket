  (Expr2 : Expr  (e  dd [cd #f]) -> * ()  ; todo the #f default is a temporary fix
    [,ce (CExpr ce dd cd)]

    [(let-values ,s (((,x** ...) ,ce*) ...) ,e)
     (let ()
       (define initialize
         (for/list ([x* x**] [ce ce*])
           ; Declare x* as local variables in the enclosing `func`.
           ; Also handles initialization.
           (for-each emit-local (reverse x*))
           ; Evaluate the ce* and store the results in the x*
           (match x*
             ; A single target accepts either one ordinary value or a $Values bundle
             ; of length 1. Anything else must raise a value-count error.
             [(list x)         `(block
                                  ,(CExpr ce x <stat>)
                                  ,(Store! x `(call $expect-one-value ,(Reference x))))]
             ; multiple values are returned in an $Values array [v0,v1,...].
             ; Reuse x0 for the raw result, then unpack the validated $Values.
             [(list x0 x1 ...)  (define mv (emit-fresh-local 'mv  '(ref null $Values)))
                                (define n  (length (cons x0 x1)))
                                 `(block ,(CExpr ce x0 <stat>)
                                         ,(Store! mv `(call $expect-n-values ,(Reference x0) (i32.const ,n)))
                                         ,@(for/list ([x (cons x0 x1)]
                                                      [i (in-naturals)])
                                             (Store! x `(array.get $Values ,(Reference mv) (i32.const ,i)))))]
             ; no values are expected
             ['()              (define t (emit-fresh-local 'letv0))
                                `(block
                                  ,(CExpr ce t <stat>)
                                  (drop (call $expect-zero-values ,(Reference t))))])))
       (let* ([xs (map Var (append* x**))]            
              [e  (Expr e dd cd)])
         ; (displayln (list 'letv 'dd dd 'cd cd))
         `(block ,@(case cd
                     [(<stat>)          '()]
                     [(<expr> <return>) '((result (ref eq)))]
                     [else (error 'internal)])
           ,@initialize
           ,e)))]

    [(letrec-values ,s (((,x** ...) ,ce*) ...) ,e)
     ;; (displayln (list 'letrec-values (map list x** ce*) e) (current-error-port))
     ;; (displayln (list 'dd dd)                              (current-error-port))

     ; During the initial parsing we currently use this transform (ish):
     ;    (letrec-values ([(x ...) ce] ...) e)
     ; => (let ([x undefined] ... ...])
     ;      (letrec ([xl le] ...)              ; xl is an x bound to a λ-expresion
     ;        (let-values ([(t ...) ce])
     ;           (set! x t) ...)
     ;        ...
     ;        e)
     ; The idea is to make all right-hand sides of the `letrec` into lambda-abstractions.
     ; Closure conversion will turn these into closure allocations.
     ; The closures are built together and patched, so they can see each other.

     ; However, if `xl` is assigned to, then assignment conversion will turn the
     ; lambda-expression into (primapp boxed λ-expression). Also, references 
     ; to `xl` are turned into `(unboxed xl)`.


     ; At this point all right hand sides `ce` are closure allocations ... or `closedapp`s.
     ; Due to the scope of `letrec-values` the left hand
     ; variables `x` can occur as free variables at the
     ; `closure` expression at the right hand side.
     ; The strategy is thus to allocate closure shells,
     ; and fill in the free variables after.

     (unless (apply = (list* 1 1 (map length x**))) ; all clauses expect one value?
       (error 'generate-code "TODO support multiple values in letrec-values"))

     (define x* (map first x**)) ; assumes single value
     (define letrec-binders
       (map (λ (x) (syntax-e (variable-id x))) x*))

     ;; letrec-binder-index : variable? -> natural?
     ;;   Return the allocation order index of x in the current letrec group.
     (define (letrec-binder-index x)
       (hash-ref letrec-binder-index-ht
                 (syntax-e (variable-id x))
                 #f))

     ;; letrec-local-var? : variable? -> boolean?
     ;;   Check whether ae is one of this letrec group's local variables.
     (define (letrec-local-var? ae)
       (and (variable? ae)
           (for/or ([y (in-list x*)])
              (id=? ae y))))

     ;; letrec-link-needs-patch? : variable? AExpr -> boolean?
     ;;   Check whether ae is a recursive-group link that still needs patching
     ;;   when allocating the closure bound to current-x.
     ;;
     ;; Links to earlier group members can be installed immediately because
     ;; their closure shells have already been allocated. Links to the current
     ;; binder and to later group members must still be patched afterward.
     (define (letrec-link-needs-patch? current-x ae)
       (and (letrec-local-var? ae)
            (let ([current-i (and (variable? current-x)
                                  (letrec-binder-index current-x))]
                  [ae-i      (letrec-binder-index ae)])
              (or (not current-i)
                  (>= ae-i current-i)))))

     ;; letrec-local-free-vars : (listof any/c) -> (listof symbol?)
     ;;   Extract the closure-layout free variables that belong to this letrec group.
     (define (letrec-local-free-vars ae*)
       (for/list ([ae (in-list ae*)]
                  #:when (letrec-local-var? ae))
         (syntax-e (variable-id ae))))

     (define (letrec-closure-links/closure ca)
       (nanopass-case (LANF+closure AExpr) ca
         [(closure ,s ,k ,in ,l ,ar ,ae1 ...)
          (letrec-local-free-vars ae1)]
         [else
          '()]))

     (define letrec-edges
       (append*
        (for/list ([x  (in-list x*)]
                   [ce (in-list ce*)])
          (define from (syntax-e (variable-id x)))
          (for/list ([to (in-list (letrec-closure-links/closure ce))])
            (list from to)))))

     (define letrec-allocation-binders
       (direct-letrec-allocation-order letrec-binders letrec-edges))

     (define binder->clause
       (for/hasheq ([x (in-list x*)]
                    [ce (in-list ce*)])
         (values (syntax-e (variable-id x))
                 (list x ce))))

     (define ordered-clauses
       (for/list ([binder (in-list letrec-allocation-binders)])
         (hash-ref binder->clause binder)))

     (define letrec-binder-index-ht
       (for/hasheq ([binder (in-list letrec-allocation-binders)]
                    [i (in-naturals)])
         (values binder i)))

     ;; closure-payload-vars : (listof any/c) -> (listof symbol?)
     ;;   Extract all variable payload entries stored in a closure environment.
     (define (closure-payload-vars ae*)
       (for/list ([ae (in-list ae*)]
                  #:when (variable? ae))
         (syntax-e (variable-id ae))))

     ;; letrec-closure-allocation-info : symbol? variable? boolean? (listof any/c)
     ;;                                -> (values (listof symbol?) symbol? boolean? boolean? symbol?)
     ;;   Compute letrec allocation info for one closure payload in this letrec group.
     (define (letrec-closure-allocation-info k x ar ae*)
       (letrec-allocation-info/free-vars
        k
        (syntax-e (variable-id x))
        (and (integer? ar) (>= ar 0))
        (letrec-local-free-vars ae*)
        letrec-binders))

     ;; letrec-closure-allocation-mode : symbol? variable? integer? (listof any/c) -> symbol?
     ;;   Return the named letrec allocation mode for one closure payload.
     (define (letrec-closure-allocation-mode k x ar ae*)
       (define-values (_links _patching-kind _final-allocate? _representable? allocation-mode)
         (letrec-closure-allocation-info k x ar ae*))
       allocation-mode)

     ;; letrec-closure-allocation-mode/closure : LANF+closure AExpr variable? -> (or/c symbol? #f)
     ;;   Return the named letrec allocation mode for one closure rhs, or `#f`
     ;;   when ca is not an ordinary closure form.
     (define (letrec-closure-allocation-mode/closure ca x)
       (nanopass-case (LANF+closure AExpr) ca
         [(closure ,s ,k ,in ,l ,ar ,ae1 ...)
          (letrec-closure-allocation-mode k x ar ae1)]
         [else
          #f]))

     ;; final-allocate-letrec-closure? : LANF+closure AExpr variable? -> boolean?
     ;;   Check whether ca can be allocated directly as its final closure for
     ;;   binder x, without shell allocation and later patching.
     ;;
     ;; This is safe exactly when the current letrec allocation info says the
     ;; helper has no remaining recursive-group links to patch.
     (define (final-allocate-letrec-closure? ca x)
       (and (current-enable-cc-analysis?)
            (eq? (letrec-closure-allocation-mode/closure ca x) 'final-only)))

     (define (closure-debug-id-expr l)
       (label-debug-id-expr l))
     (define (inline-small-letrec-closure-arity-label l)
       (inline-small-closure-arity-label l))
     (define (closure-name-expr in)
       (cond
         [in (define name  (syntax-e (variable-id in)))
             (define $name (string->symbol (~a "$symbol:" name)))
             (add-symbol-constant name name) ; on purpose name twice
             `(global.get ,$name)]
         [else
          `(global.get $false)]))

     ;; letrec-closure-payload-plan : LANF+closure AExpr variable? -> (listof list?)
     ;;   Return `(index kind value)` entries for the current closure payload,
     ;;   where `kind` is `immediate` or `recursive`.
     (define (letrec-closure-payload-plan ca current-x)
       (nanopass-case (LANF+closure AExpr) ca
         [(closure ,s ,k ,in ,l ,ar ,ae1 ...)
          (for/list ([ae (in-list ae1)]
                     [v  (in-list (AExpr* ae1))]
                     [i  (in-naturals)])
            (list i
                  (if (letrec-link-needs-patch? current-x ae) 'recursive 'immediate)
                  v))]
         [else
          '()]))

     ;; in-order-final-allocate-letrec-closure? : LANF+closure AExpr variable? -> boolean?
     ;;   Check whether ca can be allocated directly in the current letrec
     ;;   lowering order because its remaining payload plan has no recursive
     ;;   slots left to patch.
     (define (in-order-final-allocate-letrec-closure? ca x)
       (and (current-enable-cc-analysis?)
            (eq? (letrec-closure-allocation-mode/closure ca x) 'patched)
            (for/and ([entry (in-list (letrec-closure-payload-plan ca x))])
              (match entry
                [(list _i kind _v)
                 (eq? kind 'immediate)]))))

     ;; active-letrec-closure-allocation-mode/closure : LANF+closure AExpr variable? -> symbol?
     ;;   Return the currently active lowering mode for one letrec rhs:
     ;;   `representation`, `final-only`, or `patched`.
     ;;
     ;; This is stricter than the analysis-side mode because the active
     ;; representation path also requires a label-based safety annotation from
     ;; closure conversion, but it may also be more permissive in lowering
     ;; order when a patched helper's remaining links all point backward.
     (define (active-letrec-closure-allocation-mode/closure ca x)
       (cond
         [(direct-letrec-representation? ca x)
          'representation]
         [(final-allocate-letrec-closure? ca x)
          'final-only]
         [(in-order-final-allocate-letrec-closure? ca x)
          'final-only]
         [else
          'patched]))

     (define (AllocateClosure ca dest) ; called by letrec-values
       ; Allocates a closure shell. For patched letrec closures, immediate
       ; payload entries are installed now and only recursive link slots are
       ; left as `undefined` for later patching.
       (nanopass-case (LANF+closure AExpr) ca
         [(closure ,s ,k ,in ,l ,ar ,ae1 ...)
          (define inline-small-arity (inline-small-letrec-closure-arity-label l))
          (define payload
            (for/list ([entry (in-list (letrec-closure-payload-plan ca dest))])
              (match entry
                [(list _i 'immediate v) v]
                [(list _i 'recursive _v) (Undefined)])))
          (let ([us payload])
            (Store! dest
	                    (if inline-small-arity
	                        `(struct.new ,(match inline-small-arity
	                                        [1 '$Closure1]
	                                        [2 '$Closure2]
	                                        [3 '$Closure3])
	                                     (i32.const 0)
                                     ,(closure-name-expr in)
                                     ,(Imm ar)
                                     (global.get $false)
                                     (ref.func $invoke-closure)
                                     ,(closure-debug-id-expr l)
                                     (ref.func ,(Label l))
                                     (global.get $empty-free)
                                     ,@us)
                        `(struct.new $Closure
                                     (i32.const 0)               ; hash
                                     ,(closure-name-expr in)     ; name:  #f or $Symbol
                                     ,(Imm ar)                   ; arity:
                                     (global.get $false)         ; realm: #f or $Symbol
                                     (ref.func $invoke-closure)  ; invoke (used by apply, map, etc.)
                                     ,(closure-debug-id-expr l)  ; debug-id
                                     (ref.func ,(Label l))
                                     (array.new_fixed $Free ,(length ae1) ,@us)))))]
         [(case-closure ,s ,in ,l [,ar ,ca*] ...)
          (define n (length ca*))
          (define ar* (canonicalize-arity-markers ar))
          (define arity-expr (arity-markers->eq-expr ar*))
          (Store! dest
                  `(struct.new $CaseClosure
                               (i32.const 0)
                               ,(closure-name-expr in)
                               ,arity-expr
                               (global.get $false)
                               (ref.func $invoke-case-closure)
                               ,(closure-debug-id-expr l)
                               (ref.func $code:case-lambda-dispatch)
                               (global.get $empty-free)
                               (array.new $I32Array (i32.const 0) (i32.const ,n))
                               (array.new $Array (global.get $null) (i32.const ,n))))]
         [else (error 'AllocateClosure "internal error, got: ~a" ca)]))

     ;; direct-letrec-representation-candidate/closure? : LANF+closure AExpr variable? -> boolean?
     ;;   Check whether ca fits the current conservative candidate shape for a
     ;;   future letrec helper representation.
     (define (direct-letrec-representation-candidate/closure? ca x)
       (nanopass-case (LANF+closure AExpr) ca
         [(closure ,s ,k ,in ,l ,ar ,ae1 ...)
          (and (eq? (letrec-closure-allocation-mode/closure ca x) 'representation)
               (hash-ref (current-direct-letrec-representation-labels)
                         (syntax-e (variable-id l))
                         #f))]
         [else
          #f]))

     ;; direct-letrec-representation? : LANF+closure AExpr variable? -> boolean?
     ;;   Check whether ca can reuse `$dummy-closure` instead of allocating a
     ;;   local closure object in this letrec group.
     (define (direct-letrec-representation? ca x)
       (direct-letrec-representation-candidate/closure? ca x))

     (define (FillClosure ca dd)
       ; Fill only the recursive link slots in the $free array.
       (nanopass-case (LANF+closure AExpr) ca
         [(closure ,s ,k ,in ,l ,ar ,ae1 ...)
          (define inline-small-arity (inline-small-letrec-closure-arity-label l))
          (define recursive-entries
            (for/list ([entry (in-list (letrec-closure-payload-plan ca dd))]
                       #:when (eq? (second entry) 'recursive))
              entry))
          (cond
            [(null? recursive-entries)
             '()]
            [inline-small-arity
             (for/list ([entry (in-list recursive-entries)])
               (match entry
	                 [(list i _kind v)
	                  `(struct.set ,(match inline-small-arity
	                                  [1 '$Closure1]
	                                  [2 '$Closure2]
	                                  [3 '$Closure3])
	                               ,(string->symbol (~a "$free" i))
	                               (ref.cast (ref ,(match inline-small-arity
	                                                 [1 '$Closure1]
	                                                 [2 '$Closure2]
	                                                 [3 '$Closure3]))
	                                         ,(Reference dd))
	                               ,v)]))]
            [else
             (define free-arr (emit-fresh-local 'free '(ref $Free) #f))
             (cons
              (Store! free-arr
                      `(struct.get $Closure $free (ref.cast (ref $Closure) ,(Reference dd))))
              (for/list ([entry (in-list recursive-entries)])
                (match entry
                  [(list i _kind v)
                   `(array.set $Free
                               ,(Reference free-arr)
                               (i32.const ,i)
                               ,v)])))])]
         [(case-closure ,s ,in ,l [,ar ,ca*] ...)
         (append*
          (for/list ([m  ar]
                     [arm-ca ca*]
                     [i  (in-naturals)])
             (define arm (emit-fresh-local 'case-arm '(ref $Closure)))
             (append
              (list (AllocateClosure arm-ca arm))
              (FillClosure arm-ca arm)
              (list `(array.set $I32Array
                                (struct.get $CaseClosure $arities
                                            (ref.cast (ref $CaseClosure) ,(Reference dd)))
                                (i32.const ,i)
                                (i32.const ,m))
                    `(array.set $Array
                                (struct.get $CaseClosure $arms
                                            (ref.cast (ref $CaseClosure) ,(Reference dd)))
                                (i32.const ,i)
                                ,(Reference arm))))))]))

     ; declare the `x` as a local variables
     (for ([x* x**])
       (for ([x x*])
         (emit-local x)))
     
     (let* ([u* (for/list ([x* x**]) (Undefined))]
            [e  (Expr e dd cd)])                     
       `(block ,@(match dd                               ; <--
                   ['<effect> (list)]
                   ['<value>  (list '(result (ref eq)))]
                   [x         (list)])
               ,@(for/list ([ce ce*] [x x*] [u u*])
                   (define allocation-mode
                     (active-letrec-closure-allocation-mode/closure ce x))
                    (cond
                      [(eq? allocation-mode 'representation)
                       (Store! x '(global.get $dummy-closure))]
                     [else
                      (Store! x u)]))
               ,@(append*
                   (for/list ([clause (in-list ordered-clauses)])
                    (match-define (list x ce) clause)
                    (define allocation-mode
                      (active-letrec-closure-allocation-mode/closure ce x))
                    (cond
                      [(eq? allocation-mode 'representation)
                       '()]
                      [(eq? allocation-mode 'final-only)
                       (list (ClosureAllocation ce x))]
                      [else
                       (list (AllocateClosure ce x))])))
               ,@(append*
                   (for/list ([clause (in-list ordered-clauses)])
                    (match-define (list x ce) clause)
                    (define allocation-mode
                      (active-letrec-closure-allocation-mode/closure ce x))
                    (cond
                      [(eq? allocation-mode 'representation)
                       '()]
                      [(eq? allocation-mode 'final-only)
                       '()]
                      [else
                       (FillClosure ce x)])))
               ,e))])
     
  (ConvertedAbstraction : ConvertedAbstraction (cab) -> * ()
    [(λ ,s ,ar (formals (,x ...)) ,e)
     ; Note: The arity `ar`  
     ;          +n means precisely n     (nothing special to do)
     ;          0 means precisely  0
     ;         -1 means at least   0     (convert extra arguments to list)
     ;         -2 means at least   1     (convert extra arguments to list)
     ;         -n means at least   n-1   (convert extra arguments to list)
     ; Note: The other cases in the code generator pass the original arity along,
     ;       and rewrites the arguments to (,x ...) so `ar` and `(,x ...)`
     ;       might not match at this point.     
     (parameterize ([*locals* '()])
       (let* ([x (map Var x)] [σ (Expr e <value> <return>)])
         (define-values (src line col pos span)
           (values (~a (syntax-source s)) (syntax-line s) (syntax-column s)
                   (syntax-position s) (syntax-span s)))
         ; 1. For each argument, we make an WebAssembly parameter.
         (define (Formal  x) `(param ,x (ref eq)))
         (define (Formal* xs) (map Formal xs))
         (define known-direct-env-arity (current-known-direct-env-arity))
         ; 2. 
         (define (Local  x)  (match x
                               [(list v t)      `(local ,(if (symbol? v) v (Var v)) ,t)]   ; let bound 
                               [(list v t init) `(local ,(if (symbol? v) v (Var v)) ,t)]   ; emitted local
                               [x               `(local ,x (ref eq))]))                    ; argument
         (define (Local* xs) (map Local xs))
         (define (Init  x)  
           (match x
             [(list v t)      (if (equal? t '(ref eq))
                                  `(local.set ,(if (symbol? v) v (Var v)) ,(Undefined))
                                  '(nop))]
             [(list v t #f)   `(local.set ,(if (symbol? v) v (Var v)))] ; #f = no init
             [(list v t init) #;(when (eq? init #f) (error 'here "here!"))
                              `(local.set ,(if (symbol? v) v (Var v)) ,init)]))
         (define (Init* xs) (map Init xs))
         (define (InitArgs* xs)
           (for/list ([x xs] [i (in-naturals)])
                `(local.set ,x (array.get $Args (local.get $args) (i32.const ,i)))))

         ; This list (whose head is 'converted-abstraction) will be turned into a
         ; a (func ...) by `define-label`.
         `(converted-abstraction ; ,(Formal* (list* '$free '$tc x)) ; arguments
                                 ; the parameter matches the type $ClosureCode, $KnownCode0, or $KnownCode1
                                 ,(case known-direct-env-arity
                                    [(0) '((param $args (ref $Args)))]
                                    [(1) '((param $env0 (ref eq))
                                           (param $args (ref $Args)))]
                                    [else
                                     '((param $clos (ref $Closure))
                                       (param $args (ref $Args)))])
                                 ,(append
                                   (if (or known-direct-env-arity
                                           (current-inline-small-closure-arity))
                                       '()
                                       '((local $free (ref $Free))))            ; array of free variables
                                   (Local* (append x                            ; argument
                                                   (reverse (*locals*)))))      ; declarations
                                 ,(append (list
                                           ; ARITY CHECK
                                           (cond
                                             ; precisely ar arguments expected
                                             [(>= ar 0) 
                                              `(if (i32.eqz (i32.eq (array.len (local.get $args))
                                                                    (i32.const ,ar)))
                                                   (then (call $raise-arity-mismatch/proc
                                                               ,(if known-direct-env-arity
                                                                    '(global.get $dummy-closure)
                                                                    '(local.get $clos))
                                                               (array.len (local.get $args)))
                                                         (unreachable)))]
                                             [else
                                              ; at least n expected
                                              (define n (- (- ar) 1))
                                             `(if (i32.lt_u (array.len (local.get $args))
                                                             (i32.const ,n))
                                                   (then (call $raise-arity-mismatch/proc
                                                               ,(if known-direct-env-arity
                                                                    '(global.get $dummy-closure)
                                                                    '(local.get $clos))
                                                               (array.len (local.get $args)))
                                                         (unreachable)))])
                                           )
                                          (if (or known-direct-env-arity
                                                  (current-inline-small-closure-arity))
                                              '()
                                              '((local.set $free (struct.get $Closure $free (local.get $clos)))))
                                          (Init* (*locals*))               ; initialization
                                          (InitArgs* x))
                                 ,σ)))
         #;`(func (param ,#'_free) (param ,#'_tc) (param ,@x))              
         #;`(lambda (,#'_free ,_tc ,x ...)
              (body (sif (app ,#'= ',(+ 2 ar) (ref ,#'arguments '"length")) ,#'VOID
                         (app ,#'raise-clos-arity-error* (app ,#'list ',src ',line ',col ',pos ',span)
                              ,#'_free ',ar ,#'arguments))
                    ,σ ,#'VOID))]
    [(λ ,s ,ar (formals ,x) ,e) ; variadic
     ; Note: the old arity is passed along, so ConvertedAbstraction
     ;       knows to insert an arguments-to-list conversion.
     (ConvertedAbstraction 
      (with-output-language (LANF+closure ConvertedAbstraction)
        `(λ ,s ,ar (formals (,x)) ,e)))]
     ;; ; todo
     ;; (let* ([x (Var x)] [σ (Expr e <value> <return>)])
     ;;   `(converted-abstraction ,ar (,@x) ,e)
     ;;   #;`(lambda (,#'_free ,_tc ,x)
     ;;      (body (:= ,x (app ,#'rest-args->list ,#'arguments '0))
     ;;            ,σ ,#'VOID)))]
    [(λ ,s ,ar (formals (,x0 ,x1 ... . ,xd)) ,e) ; rest arguments
     ; Note: the old arity is passed along, so ConvertedAbstraction
     ;       knows to insert an rest-arguments-to-list conversion for xd.
     (ConvertedAbstraction 
      (with-output-language (LANF+closure ConvertedAbstraction)
        `(λ ,s ,ar (formals (,x0 ,x1 ... ,xd)) ,e)))]
    ;; (let* ([x0 (Var x0)] [x1 (map Var x1)] [xd (Var xd)] [σ (Expr e <value> <return>)]
    ;;                       [ar (+ 1 (length x1))])
    ;;    (define-values (src line col pos span)
    ;;      (values (~a (syntax-source s)) (syntax-line s) (syntax-column s)
    ;;              (syntax-position s) (syntax-span s)))
    ;;    `(converted-abstraction ,ar (,x0 ,@x1 . ,xd) ,e)
    ;;    #;`(lambda (,#'_free ,_tc ,x0 ,x1 ... ,xd)
    ;;       (body (sif (app ,#'<= ',(+ 2 ar) (ref ,#'arguments '"length")) ,#'VOID
    ;;                  (app ,#'raise-clos-arity-error* (app ,#'list ',src ',line ',col ',pos ',span)
    ;;                       ,#'_free ',(- (+ ar 1)) ,#'arguments))
    ;;             (:= ,xd (app ,#'rest-args->list ,#'arguments ',(length (cons x0 x1))))
    ;;             ,σ ,#'VOID)))]
    [(λ ,s ,ar ,f ,e) (error 'fallthrough)])
  (GeneralTopLevelForm : GeneralTopLevelForm (g dd) -> * ()
    [,e                           (Expr e dd <stat>)]
    ; [(#%require     ,s ,rrs ...)  `(block) ] ; #;`'"ignored #%require"
    [(#%require     ,s ,rrs ...)  `(global.set $result (global.get $void)) ] ; #;`'"ignored #%require"    
    [(define-values ,s (,x ...)   ,e)
     ; Note: Initializing the top-level variables x ... with ($Boxed undefined)
     ;       here is too late. If the variables appear as free variables
     ;       they can be referenced during closure creation for earlier
     ;       `define-label` declarations.

     ; The variables x ... are initialized to (Boxed undefined) in $entry.
     ; That is, at this point the variables x ... are bound to a $Boxed instance.
     
     (match x
       ['()           (define vals (emit-fresh-local 'vals '(ref eq) '(global.get $undefined)))
                      `(block
                        ,(Expr e vals <stat>)
                        (drop (call $expect-zero-values ,(Reference vals))))]
       ; Until we implement namespaces, top-level variables are
       ; stored as boxed global variables.
       ;              (Expr e dd cd)
       ; A single target accepts either one ordinary value or a $Values bundle
       ; of length 1. Anything else must raise a value-count error.
       [(list x0)     (define vals (emit-fresh-local 'vals '(ref eq) '(global.get $undefined)))
                      `(block
                        ,(Expr e vals <stat>)
                        ,(Store! x0 `(call $expect-one-value ,(Reference vals))))]
       #;[(list x0)     `(block
                          (global.set ,($$ (variable-id x0)) 
                                    (ref.cast (ref eq) 
                                              (struct.new $Boxed
                                                          (global.get $undefined))))
                        ,(Expr e x0 <stat>))]
       [(list x ...)  (define vals (emit-fresh-local 'vals '(ref eq) '(global.get $undefined)))
                      (define mv   (emit-fresh-local 'mv '(ref $Values)))
                      `(block
                        #;,@(for/list ([x0 x])
                              `(global.set ,($$ (variable-id x0)) 
                                           (ref.cast (ref eq) 
                                                     (struct.new $Boxed
                                                                 (global.get $false)))))
                        ,(Expr e vals <stat>)
                        (local.set ,(LocalVar mv) (call $expect-n-values ,(Reference vals) (i32.const ,(length x))))
                        ,@(for/list ([x0 x] [i (in-naturals)])
                            (Store! x0 `(array.get $Values
                                                   ,(Reference mv)
                                                   (i32.const ,i)))))])]
    [(define-syntaxes ,s (,x ...) ,e)
     (error 'generate-code "TODO define-syntaxes")])

  (TopLevelForm : TopLevelForm (t dd) -> * ()
    [,g                             (GeneralTopLevelForm g dd)]
    [(#%expression ,s ,e)           (Expr e dd <stat>)]
    [(define-label ,l ,cab)
     (define (converted->func name type export-name conv)
       (match conv
         [(list 'converted-abstraction formals locals init-locals body-expr)
          `(func ,name
                 ,@(if export-name
                       `((export ,export-name))
                       '())
                 (type ,type)
                 ,@formals
                 (result (ref eq))
                 ,@locals
                 (global.set $debug-current-procedure-name ,(label-debug-id-expr l))
                 (global.set $debug-current-procedure (global.get $false))
                 (call $debug-invoke-tick)
                 ,@(watched-label-entry-probe l)
                 ,@init-locals
                 ,body-expr)]
         [x
          (pretty-print x)
          (error 'generate-code-Top "got: ~a" x)]))
     (define inline-small-arity
       (inline-small-closure-arity-label l))
     (define (known1-wrapper-func)
       (define env-index
         (known1-wrapper-env-index l))
       (define env0
         (match (list inline-small-arity env-index)
           [(list 1 0)
            '(struct.get $Closure1 $free0
                         (ref.cast (ref $Closure1) (local.get $clos)))]
           [(list 2 0)
            '(struct.get $Closure2 $free0
                         (ref.cast (ref $Closure2) (local.get $clos)))]
           [(list 2 1)
            '(struct.get $Closure2 $free1
                         (ref.cast (ref $Closure2) (local.get $clos)))]
           [(list 3 0)
            '(struct.get $Closure3 $free0
                         (ref.cast (ref $Closure3) (local.get $clos)))]
           [(list 3 1)
            '(struct.get $Closure3 $free1
                         (ref.cast (ref $Closure3) (local.get $clos)))]
           [(list 3 2)
            '(struct.get $Closure3 $free2
                         (ref.cast (ref $Closure3) (local.get $clos)))]
           [_
            `(array.get $Free
                        (struct.get $Closure $free (local.get $clos))
                        (i32.const ,env-index))]))
       `(func ,(Label l)
              (export ,(~a (syntax-e (variable-id l))))
              (type $ClosureCode)
              (param $clos (ref $Closure))
              (param $args (ref $Args))
              (result (ref eq))
              (global.set $debug-current-procedure-name ,(label-debug-id-expr l))
              (global.set $debug-current-procedure (local.get $clos))
              (call $debug-invoke-tick)
              ,@(watched-label-entry-probe l)
              (return_call ,(known1-code-label l) ,env0 (local.get $args))))
     (define base-func
       (if (and (known1-direct-label? l)
                (not (known1-only-direct-label? l)))
           (known1-wrapper-func)
           (let ([base-converted
                  (parameterize ([current-inline-small-closure-arity
                                  inline-small-arity]
                                 [current-known-direct-env-arity #f])
                    (ConvertedAbstraction cab))])
             (converted->func (Label l) '$ClosureCode (~a (syntax-e (variable-id l))) base-converted))))
     (cond
       [(known0-only-direct-label? l)
       (let* ([known0-converted
                (parameterize ([current-inline-small-closure-arity #f]
                               [current-known-direct-env-arity 0])
                  (ConvertedAbstraction cab))]
               [known0-func
                (converted->func (known0-code-label l)
                                 '$KnownCode0
                                 (~a (syntax-e (variable-id l)))
                                 known0-converted)])
          known0-func)]
       [(known1-only-direct-label? l)
        (let* ([known1-converted
                (parameterize ([current-inline-small-closure-arity #f]
                               [current-known-direct-env-arity 1])
                  (ConvertedAbstraction cab))]
               [known1-func
                (converted->func (known1-code-label l)
                                 '$KnownCode1
                                 (~a (syntax-e (variable-id l)))
                                 known1-converted)])
          known1-func)]
       [(known0-direct-label? l)
        (let* ([known0-converted
                (parameterize ([current-inline-small-closure-arity #f]
                               [current-known-direct-env-arity 0])
                  (ConvertedAbstraction cab))]
               [known0-func
                (converted->func (known0-code-label l) '$KnownCode0 #f known0-converted)])
          `(func-group ,base-func ,known0-func))]
       [(known1-direct-label? l)
        (let* ([known1-converted
                (parameterize ([current-inline-small-closure-arity #f]
                               [current-known-direct-env-arity 1])
                  (ConvertedAbstraction cab))]
               [known1-func
                (converted->func (known1-code-label l) '$KnownCode1 #f known1-converted)])
          `(func-group ,base-func ,known1-func))]
       [else
        base-func])]
    [(topmodule ,s ,mn ,mp ,mf ...) (let ([mf (map (λ (m) (ModuleLevelForm m dd)) mf)])
                                      `(topmodule ,mn ,mp ,mf ...))]
    [(topbegin ,s ,t ...)
     ; Note: We have flattened `topbegin` so no `t` is a `topbegin`.
     ; The data destination of `topbegin` is `$result`.
     ; The first forms are evaluated for effect.
     ; The last one stores the result in `$result`.
     (let ()
       (define (TopLevelForm* ts dd)
         (map (λ (t) (TopLevelForm t dd)) ts))
       (define (define-label? t)
         (nanopass-case (LANF+closure TopLevelForm) t
           [(define-label ,l ,cab) #t]
           [else                   #f]))
       (define (topmodule? t)
         (nanopass-case (LANF+closure TopLevelForm) t
           [(topmodule ,s ,mn ,mp ,mf ...) #t]
           [else                           #f]))

       (define-values (dls ts1) (partition define-label? t))
       (define-values (tms ts)  (partition topmodule?    ts1))

       ; (displayln (list 'topbegin 'dd dd))

       (values
        ; A `define-label` form becomes a function declaration in Web Assembly.
        (flatten-func-forms (TopLevelForm* dls dd))
        ; A `topmodule` becomes ...
        (TopLevelForm* tms dd)
        ; The expressions and general top-level form becomes
        ; part of the body of the `entry` function called from the host language.
        (match ts
          [(list)
           ; (displayln "HERE2")
           ; No expressions at the top-level: simply return void
           `(global.set $result (global.get $void))]
          [(list t0 ... tn)
           ; (displayln "HERE")
           (define (non-nop? x) (not (equal? x '(nop))))
           (let ([t0s (filter non-nop?
                              (TopLevelForm* t0 <effect>))]
                 [tn  (TopLevelForm  tn dd)])
             (if (null? t0s)
                 tn
                 `(block ,@t0s ,tn)))])))])

        #;(let ([ts (TopLevelForm* ts dd)])
          (match ts
            [(list t0)               t0]
            [(list t0 t1)            `(block #;(result (ref eq))
                                             ,t0
                                             ,t1)]
            [(list 'begin ts ... tn) `(block #;(result (ref eq))
                                             ,@ts
                                             ,tn)]
            [_ (error 'internal-here "got: ~a" ts)]))
  
  (ModuleLevelForm : ModuleLevelForm (mf dd) -> * ()
    [(#%provide ,rps ...)  
     (void)]                   ; todo : generate provide vars here
    [(define-label ,l ,cab)         
     `(define-label ,l ,(ConvertedAbstraction cab))
     #;`(var [binding ,(Label l) 
                      ,(ConvertedAbstraction cab)])]
    [,g
     (GeneralTopLevelForm g dd)])

  ;;;
  ;;; Integrating Host Runtime and Program
  ;;;

  ; The idea is to generate everything program specific here,
  ; and pass it along to `generate-host-runtime` which inserts
  ; the program specific parts into the runtime.

  
  (define (generate-global-declarations-for-top-level-variables)
    (define imported-names (current-imported-top-level-globals))
    (define exported-names (current-exported-top-level-globals))
    (define import-module-name
      (current-imported-top-level-global-module-name))
    (define (top-global-export-name x)
      (symbol->string (Var x)))
    (append*
     (for/list ([x (in-list (id-set->list top-vars))])
       (define sym (syntax-e (variable-id x)))
       (define wasm-name (Var x))
       (define exported? (and (symbol? sym)
                              (set-member? exported-names sym)))
       (define global-form
         (if (and (symbol? sym)
                  (set-member? imported-names sym))
             `(global ,wasm-name
                      (import ,import-module-name ,(top-global-export-name x))
                      (mut (ref eq)))
             `(global ,wasm-name (mut (ref eq)) ,(Undefined))))
       (if exported?
           (list global-form
                 `(export ,(top-global-export-name x) (global ,wasm-name)))
           (list global-form)))))
  
  (define result #'$result) ; holds result in $entry

  (define-values (dls tms entry-body)
    (time-gen "top-level-forms"
      (λ ()
        (TopLevelForm T result))))
  (define top-level-variable-declarations
    (time-gen "top-level-globals"
      (λ ()
        (generate-global-declarations-for-top-level-variables))))

  (define console-bridge-module-cells
    (current-console-bridge-module-cell-bindings))
  (define console-bridge-root-export-bindings
    (current-console-bridge-root-export-bindings))
  (define console-bridge-root-source-path
    (current-console-bridge-root-source-path))

  (define console-bridge-bindings
    (if (not (current-console-bridge?))
        '()
        (let* ([top-binding-names
                (list->seteq (current-console-bridge-top-binding-names))]
               [mutable-top-binding-names
                (list->seteq (current-console-bridge-mutable-top-binding-names))]
               [top-vars-by-name
                (for/hasheq ([x (in-list (id-set->list top-vars))]
                             #:do [(define sym (syntax-e (variable-id x)))]
                             #:when (symbol? sym))
                  (values sym x))]
               [root-export-bindings-by-name
                (for/hasheq ([entry (in-list (or console-bridge-root-export-bindings '()))])
                  (values (hash-ref entry 'name)
                          entry))]
               [module-binding-names
                (sort (hash-keys console-bridge-module-cells) symbol<?)]
               [root-export-binding-names
                (sort (hash-keys root-export-bindings-by-name) symbol<?)]
               [console-top-binding-names
                (for/list ([sym (in-list (set->list top-binding-names))]
                           #:when (hash-ref top-vars-by-name sym #f))
                  sym)]
               [exposed-names
                (sort (remove-duplicates
                       (cond
                         [(pair? root-export-binding-names)
                          root-export-binding-names]
                         [(pair? module-binding-names)
                           module-binding-names
                          console-top-binding-names]
                         [else
                          console-top-binding-names]))
                      symbol<?)])
          (add-string-constant 'wr-console-bridge-kind "top-level")
          (for/list ([sym (in-list exposed-names)])
            (define const-name (console-bridge-symbol-constant-name sym))
            (add-symbol-constant const-name sym)
            (cond
              [(hash-ref root-export-bindings-by-name sym #f)
               => (λ (binding)
                    (define binding-id
                      (hash-ref binding 'binding-id))
                    (define x
                      (hash-ref top-vars-by-name binding-id #f))
                    (unless x
                      (error 'console-bridge-bindings
                             "internal error: console bridge root export without runtime binding: ~s"
                             binding-id))
                    (define source-path
                      (or console-bridge-root-source-path
                          (current-console-bridge-program-source-path)))
                    (define origin-kind
                      (console-bridge-binding-origin-kind source-path))
                    (define origin-kind-const-name
                      (console-bridge-origin-kind-constant-name sym))
                    (define source-path-const-name
                      (console-bridge-source-path-constant-name sym))
                    (add-string-constant origin-kind-const-name origin-kind)
                    (when source-path
                      (add-string-constant source-path-const-name source-path))
                    (case (hash-ref binding 'binding-kind)
                      [(cell)
                       (list 'module-cell sym const-name x
                             (hash-ref binding 'mutable? #f)
                             origin-kind-const-name
                             (and source-path source-path-const-name))]
                      [(value)
                       (list 'top sym const-name x
                             #f
                             origin-kind-const-name
                             (and source-path source-path-const-name))]
                      [else
                       (error 'console-bridge-bindings
                              "internal error: unknown console bridge root export kind: ~s"
                              (hash-ref binding 'binding-kind))]))]
              [(hash-ref console-bridge-module-cells sym #f)
               => (λ (cell-sym)
                    (define x
                      (hash-ref top-vars-by-name cell-sym #f))
                    (unless x
                      (error 'console-bridge-bindings
                             "internal error: console bridge cell without runtime binding: ~s"
                             cell-sym))
                    (define source-path (current-console-bridge-program-source-path))
                    (define origin-kind
                      (console-bridge-binding-origin-kind source-path))
                    (define origin-kind-const-name
                      (console-bridge-origin-kind-constant-name sym))
                    (define source-path-const-name
                      (console-bridge-source-path-constant-name sym))
                    (add-string-constant origin-kind-const-name origin-kind)
                    (when source-path
                      (add-string-constant source-path-const-name source-path))
                    (list 'module-cell sym const-name x
                          (set-member? mutable-top-binding-names sym)
                          origin-kind-const-name
                          (and source-path source-path-const-name)))]
              [(hash-ref top-vars-by-name sym #f)
               => (λ (x)
                    (define source-path
                      (console-bridge-source->string
                       (and (variable? x)
                            (syntax-source (variable-id x)))))
                    (define origin-kind
                      (console-bridge-binding-origin-kind source-path))
                    (define origin-kind-const-name
                      (console-bridge-origin-kind-constant-name sym))
                    (define source-path-const-name
                      (console-bridge-source-path-constant-name sym))
                    (add-string-constant origin-kind-const-name origin-kind)
                    (when source-path
                      (add-string-constant source-path-const-name source-path))
                    (list 'top sym const-name x
                          (set-member? mutable-top-binding-names sym)
                          origin-kind-const-name
                          (and source-path source-path-const-name)))]
              [else
               (error 'console-bridge-bindings
                      "internal error: console bridge symbol without runtime binding: ~s"
                      sym)])))))

  ; variables bound by let-values and others at the top-level
  ; are represented in the runtime as local variables of a function `entry`.
  (define entry-locals (*locals*))

  (define primitives-also-declared-as-variables-at-top-level
    (time-gen "top-level-prim-vars"
      (λ ()
        (sort (set->list
               (set-intersect (list->set (map syntax-e (map variable-id (id-set->list top-vars))))
                              (list->set primitives)))
              symbol<?))))
  
  ;; (displayln "-- variables declared at top-level --")
  ;; (displayln (sort (map syntax-e (map variable-id (id-set->list top-vars))) symbol<?))
  ;; (displayln "-- primitives also declared as variables at top-level --")
  ;; (displayln primitives-also-declared-as-variables-at-top-level)
  
  (define-values (gen runtime-gen-rows runtime-metric-rows)
    (time-gen "generate-runtime"
      (λ ()
        (parameterize ([current-runtime-primitive-report-path
                        (or (current-runtime-primitive-report-path)
                            (and (current-pass-dump-dir)
                                 (build-path (current-pass-dump-dir)
                                             "runtime-primitives.sexp")))]
                       [current-runtime-timing-rows
                        (and (current-pass-timings?) '())]
                       [current-runtime-metric-rows
                        (and (current-pass-timings?) '())])
          (define mod
            (generate-runtime
             dls                              ; define-labels
             tms                              ; top modules
             entry-body                       ; expressions and general top-level forms
             result                           ; variable that holds the result (in $entry)
             ; program specific
             (id-set->list top-vars)          ; top level variables (list of variables)
             console-bridge-bindings          ; top-level bindings exposed through globalThis.WR
             top-level-variable-declarations  ; wasm code for declaring top-level variables
             entry-locals                     ; variables that are local to $entry
             ; general
             primitives                       ; primitives (list of symbols)
             (sort
              (remove-duplicates
               (append (hash-keys used-primitives-ht)
                       (current-runtime-extra-used-primitives)))
              symbol<?)
             string-constants                 ; (list (list name string) ...)
             bytes-constants                  ; (list (list name bytes) ...)
             symbol-constants                 ; (list (list name symbol) ...)
             ))
          (values mod
                  (current-runtime-timing-rows)
                  (current-runtime-metric-rows))))))
  (when (current-pass-timings?)
    (when runtime-gen-rows
      (set! gen-times (append runtime-gen-rows gen-times))))
  (when (current-pass-timings?)
    (define gen-table
      (format-timing-table (reverse gen-times)))
    (define runtime-detail-rows
      (filter (lambda (row)
                (or (string-prefix? (first row) "runtime:")
                    (string-prefix? (first row) "tree-shake:")))
              runtime-gen-rows))
    (define runtime-generation-rows
      (for/list ([row (in-list (reverse runtime-detail-rows))]
                 #:when (string-prefix? (first row) "runtime:"))
        (list (substring (first row) (string-length "runtime:"))
              (second row))))
    (define tree-shake-rows
      (for/list ([row (in-list (reverse runtime-detail-rows))]
                 #:when (string-prefix? (first row) "tree-shake:"))
        (list (substring (first row) (string-length "tree-shake:"))
              (second row))))
    (define runtime-generation-metrics
      (for/list ([row (in-list (reverse runtime-metric-rows))]
                 #:when (string-prefix? (first row) "runtime:"))
        (list (substring (first row) (string-length "runtime:"))
              (second row))))
    (define tree-shake-metrics
      (for/list ([row (in-list (reverse runtime-metric-rows))]
                 #:when (string-prefix? (first row) "tree-shake:"))
        (list (substring (first row) (string-length "tree-shake:"))
              (second row))))
    (current-gen-timing-table
     (string-join
      (filter values
              (list gen-table
                    (and (pair? runtime-generation-rows)
                         (string-append
                          "=== Runtime Generation Details ===\n"
                          (format-timing-table
                           (append runtime-generation-rows
                                   (list (list "total"
                                               (for/sum ([row (in-list runtime-generation-rows)])
                                                 (second row))))))))
                    (and (pair? runtime-generation-metrics)
                         (string-append
                          "=== Runtime Generation Metrics ===\n"
                          (format-metric-table runtime-generation-metrics)))
                    (and (pair? tree-shake-rows)
                         (string-append
                          "=== Tree-Shake Details ===\n"
                          (format-timing-table
                           (append tree-shake-rows
                                   (list (list "total"
                                               (for/sum ([row (in-list tree-shake-rows)])
                                                 (second row))))))))
                    (and (pair? tree-shake-metrics)
                         (string-append
                          "=== Tree-Shake Metrics ===\n"
                          (format-metric-table tree-shake-metrics)))))
      "\n")))
  gen
  )


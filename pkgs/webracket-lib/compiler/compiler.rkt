       (let loop ([aes aes])
         (if (null? aes)
             `(global.get $null)
             `(block (result (ref eq))
                     (call $debug-allocation-tick (i32.const 0))
                     (struct.new $Pair
                                 (i32.const 0)
                                 ,(first aes)
                                 ,(loop (rest aes)))))))
     

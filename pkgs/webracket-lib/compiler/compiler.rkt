        [(direct0app ,s ,l ,ar ,ae1 ...)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(selfapp ,s ,l ,ar ,ae1 ...)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(casearmapp ,s ,l ,ar ,i ,ae0 ,ae1 ...)
         (AExpr ae0)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(casearmapp ,s ,l ,ar ,i ,ae0 ,ae1 ...)
         (AExpr ae0)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(casearmapp ,s ,l ,ar ,i ,ae0 ,ae1 ...)
         (AExpr ae0)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(primapp ,s ,pr ,ae1 ...)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(begin ,s ,e0 ,e1 ...)
         (Expr e0)
         (for ([e (in-list e1)])
           (Expr e))]
        [(begin0 ,s ,e0 ,e1 ...)
         (Expr e0)
         (for ([e (in-list e1)])
           (Expr e))])
      (Expr : Expr (E) -> * ()
        [,ce
         (CExpr ce)]
        [(let-values ,s (((,x ...) ,ce*) ...) ,e)
         (for ([ce (in-list ce*)])
           (CExpr ce))
         (Expr e)]
        [(letrec-values ,s (((,x ...) ,ce*) ...) ,e)
         (for ([xs (in-list x)]
               [ce (in-list ce*)]
               #:when (= (length xs) 1))
           (nanopass-case (LANF+closure CExpr) ce
             [,ca
              (nanopass-case (LANF+closure AExpr) ca
                [,clos
                 (ClosureAllocation clos (car xs))]
                [else
                 (void)])]
             [else
              (void)]))
         (for ([ce (in-list ce*)])
           (CExpr ce))
         (Expr e)]))
    (collect cc)
    (reverse entries)))


(define (simplify-profile-inc-hash! ht key [delta 1])
  (hash-update! ht key (λ (n) (+ n delta)) 0))

(define (simplify-profile-shape-key datum)
  (cond
    [(pair? datum)
     (define head (car datum))
     (cond
       [(symbol? head) head]
       [else #f])]
    [(vector? datum) '<vector>]
    [(box? datum)    '<box>]
    [(syntax? datum) '<syntax>]
    [else            #f]))

(define simplify-profile-special-form-heads
  '(quote
    quote-syntax
    if
    begin
    begin0
    let-values
    letrec-values
    lambda
    λ
    case-lambda
    set!
    #%expression
    topbegin
    topmodule
    define-values
    define-syntaxes
    #%provide
    #%require
    top
    variable-reference))

(define (simplify-profile-app-operator-key datum)
  (match datum
    [(? symbol?) datum]
    [`(top ,_ ,(? symbol? sym)) sym]
    [(cons '#%top (? symbol? sym)) sym]
    [_ '<complex>]))

(define (collect-simplify-profile-datum! datum shape-ht app-ht)
  (define shape-key (simplify-profile-shape-key datum))
  (when shape-key
    (simplify-profile-inc-hash! shape-ht shape-key))
  (when (list? datum)
    (match datum
      [(list 'app _ op _ ...)
       (simplify-profile-inc-hash! app-ht (simplify-profile-app-operator-key op))]
      [_ (void)]))
  (when (and (pair? datum)
             (list? datum)
             (symbol? (car datum))
             (> (length datum) 1)
             (not (memq (car datum) simplify-profile-special-form-heads)))
    (simplify-profile-inc-hash! app-ht (car datum)))
  (cond
    [(pair? datum)
     (collect-simplify-profile-datum! (car datum) shape-ht app-ht)
     (collect-simplify-profile-datum! (cdr datum) shape-ht app-ht)]
    [(vector? datum)
     (for ([e (in-vector datum)])
       (collect-simplify-profile-datum! e shape-ht app-ht))]
    [(box? datum)
     (collect-simplify-profile-datum! (unbox datum) shape-ht app-ht)]
    [else
     (void)]))

(define (collect-simplify-profile-summary ast)
  (define datum (unparse-all (unparse-LFE ast)))
  (define shape-ht (make-hasheq))
  (define app-ht   (make-hasheq))
  (collect-simplify-profile-datum! datum shape-ht app-ht)
  (hash 'nodes  (count-sexp datum)
        'shapes shape-ht
        'apps   app-ht))

(define (top-simplify-profile-entries ht [limit 8])
  (take
   (sort (hash->list ht)
         (λ (a b)
           (define av (cdr a))
           (define bv (cdr b))
           (if (= av bv)
               (string<? (~a (car a)) (~a (car b)))
               (> av bv))))
   (min limit (hash-count ht))))

(define (format-simplify-profile-entry-list label entries)
  (if (null? entries)
      (format "~a\t-" label)
      (string-join
       (cons (format "~a\t~a\t~a" label (caar entries) (cdar entries))
             (for/list ([entry (in-list (cdr entries))])
               (format "~a\t~a" (car entry) (cdr entry))))
       "\n")))

(define (top-unsimplified-app-entries ht [limit 12])
  (take
   (sort (hash->list ht)
         (λ (a b)
           (define a-count (hash-ref (cdr a) 'count 0))
           (define b-count (hash-ref (cdr b) 'count 0))
           (if (= a-count b-count)
               (string<? (~a (car a)) (~a (car b)))
               (> a-count b-count))))
   (min limit (hash-count ht))))

(define (format-unsimplified-app-entry-list label ht [limit 12])
  (define entries
    (top-unsimplified-app-entries ht limit))
  (if (null? entries)
      (format "~a\t-" label)
      (string-join
       (for/list ([entry (in-list entries)])
         (define op (car entry))
         (define stats (cdr entry))
         (format "~a\t~a\tcount\t~a\tconstant-arg-count\t~a\tsimple-arg-count\t~a\tall-constant-arg-count\t~a\tall-simple-arg-count\t~a"
                 label
                 op
                 (hash-ref stats 'count 0)
                 (hash-ref stats 'constant-arg-count 0)
                 (hash-ref stats 'simple-arg-count 0)
                 (hash-ref stats 'all-constant-arg-count 0)
                 (hash-ref stats 'all-simple-arg-count 0)))
       "\n")))

(define (format-simplify-profile-report stats)
  (define before (hash-ref stats 'before))
  (define after  (hash-ref stats 'after))
  (define rule-ht (hash-ref stats 'rule-fires))
  (define delta-ht (hash-ref stats 'rule-deltas))
  (define (ref key [default 0]) (hash-ref stats key default))
  (define (ref-table key)
    (hash-ref stats key (make-hasheq)))
  (define lines
    (append
     (list
     (format "input-nodes\t~a" (hash-ref before 'nodes))
      (format "output-nodes\t~a" (hash-ref after 'nodes))
      (format "nodes-removed\t~a" (- (hash-ref before 'nodes)
                                     (hash-ref after 'nodes)))
      (format "let-unused-pure-candidates\t~a" (ref 'let-unused-pure-candidates))
      (format "let-unused-pure-membership-checks\t~a" (ref 'let-unused-pure-membership-checks))
      (format "let-unused-pure-fallback-scans\t~a" (ref 'let-unused-pure-fallback-scans))
      (format "free-var-summary-cache-hits\t~a" (ref 'free-var-summary-cache-hits))
      (format "free-var-summary-cache-misses\t~a" (ref 'free-var-summary-cache-misses))
      (format "free-var-summary-root-ms\t~a" (ref 'free-var-summary-root-ms 0.0))
      (format "free-var-summary-total-inclusive-ms\t~a" (ref 'free-var-summary-total-inclusive-ms 0.0))
      (format "free-var-summary-max-expression-nodes\t~a" (ref 'free-var-summary-max-expression-nodes))
      (format "free-var-summary-total-root-nodes\t~a" (ref 'free-var-summary-total-root-nodes))
      (format "same-expression-calls\t~a" (ref 'same-expression-calls))
      (format "same-expression-ms\t~a" (ref 'same-expression-ms 0.0)))
     (for/list ([family (in-list simplify-profile-rule-families)])
       (format "rule\t~a\tfires\t~a\tnode-delta\t~a"
               family
               (hash-ref rule-ht family 0)
               (hash-ref delta-ht family 0)))
     (list
      (format-simplify-profile-entry-list
       "shape-before"
       (top-simplify-profile-entries (hash-ref before 'shapes)))
      (format-simplify-profile-entry-list
       "shape-after"
       (top-simplify-profile-entries (hash-ref after 'shapes)))
      (format-simplify-profile-entry-list
       "app-operators-before"
       (top-simplify-profile-entries (hash-ref before 'apps)))
      (format-simplify-profile-entry-list
       "app-operators-after"
       (top-simplify-profile-entries (hash-ref after 'apps)))
      (format-unsimplified-app-entry-list
       "top-unsimplified-app-operators"
       (ref-table 'unsimplified-apps))
      (format-unsimplified-app-entry-list
       "top-unsimplified-pure-app-operators"
       (ref-table 'unsimplified-pure-apps))
      (format-unsimplified-app-entry-list
       "top-unsimplified-foldable-looking-app-operators"
       (ref-table 'unsimplified-foldable-looking-apps))
      (format-unsimplified-app-entry-list
       "top-unsimplified-arity-query-apps"
       (ref-table 'unsimplified-arity-query-apps))
      (format-unsimplified-app-entry-list
       "top-unsimplified-procedure-query-apps"
       (ref-table 'unsimplified-procedure-query-apps)))))
  (string-join lines "\n"))

(define (console-bridge-source->string src)
  (cond
    [(path? src)
     (path->string
      (simplify-path (path->complete-path src)))]
    [(string? src)
     (path->string
      (simplify-path (path->complete-path (string->path src))))]
    [(symbol? src) (symbol->string src)]
    [else          #f]))

(define (console-bridge-binding-origin-kind source-path)
  (cond
    [(not source-path) "generated"]
    [(regexp-match? #rx"/stdlib/" source-path) "stdlib"]
    [(regexp-match? #rx"/libs/" source-path) "library"]
    [else "program"]))

(define (console-bridge-origin-kind-constant-name sym)
  (string->symbol (~a "wr-origin-kind/" sym)))

(define (console-bridge-source-path-constant-name sym)
  (string->symbol (~a "wr-source-path/" sym)))

(define (comp+ stx)
  (run (comp stx)))

(define (comp stx)
  (reset-counter!)
  (reset-label-map!)
  (current-pass-timing-table #f)
  (current-gen-timing-table #f)
  (current-alpha-rename-profile-report #f)
  (current-simplify-profile-report #f)
  (current-console-bridge-top-binding-names '())
  (current-console-bridge-mutable-top-binding-names '())
  (current-console-bridge-module-cell-bindings (make-hasheq))
  (current-console-bridge-program-source-path
   (and (syntax? stx)
        (console-bridge-source->string (syntax-source stx))))
  (define dump-dir (current-pass-dump-dir))
  (define dump-limit (current-pass-dump-limit))
  (when dump-dir
    (make-directory* dump-dir))
  (define pass-times '())
  (define pass-counter 0)

  (define (sanitize-pass-label s)
    (list->string
     (for/list ([ch (in-string s)])
       (if (or (char-alphabetic? ch)
               (char-numeric? ch))
           ch
           #\-))))

  (define (dump-pass! label dump-fn v)
    (when (and dump-dir
               (or (not dump-limit) (< pass-counter dump-limit)))
      (define base-label (sanitize-pass-label label))
      (define dump-file  (build-path dump-dir
                           (format "~a-~a.sexp" pass-counter base-label)))
      (with-output-to-file dump-file
        (lambda ()
          (pretty-write (dump-fn v)))
        #:exists 'replace))
    (set! pass-counter (+ pass-counter 1)))

  ;; compiler-progress-port : -> output-port?
  ;;   Return the diagnostic port for coarse compiler-pass progress reports.
  (define (compiler-progress-port)
    (or (current-compiler-progress-port)
        (current-error-port)))

  ;; report-compiler-progress! : symbol? string? any/c -> void?
  ;;   Emit an opt-in pass-level heartbeat before and after expensive passes.
  (define (report-compiler-progress! event label detail)
    (when (current-compiler-progress?)
      (fprintf (compiler-progress-port)
               "compiler-progress: event=~a pass=~s detail=~s\n"
               event
               label
               detail)))

  ; The time-pass function also handles dumping if ncessary
  (define (time-pass label thunk [size-fn #f] [dump-fn #f])
    (define (finish-pass v ms)
      (when (current-pass-timings?)
        (define size (and size-fn (size-fn v)))
        (set! pass-times (cons (list label ms size) pass-times)))
      (report-compiler-progress! 'pass-done label (list (cons 'ms ms)))
      (when dump-fn
        (dump-pass! label dump-fn v))
      v)
    (report-compiler-progress! 'pass-start label '())
    (if (current-pass-timings?)
        (let-values ([(v ms) (with-timing thunk)])
          (finish-pass v ms))
        (finish-pass (thunk) #f)))

  (define (expand+unexpand)
    (define t
      (time-pass "topexpand"
        (λ ()
          (define t (topexpand stx))
          (when debug:print-passes?
            (displayln "--- topexpand ---")
            (displayln (pretty-print (syntax->datum t)) (current-error-port)))
          t)
        #f
        (λ (v) (if (syntax? v) (syntax->datum v) v))))
    (time-pass "unexpand"             (λ () (unexpand t))
               #f
               (λ (v) (if (syntax? v) (syntax->datum v) v))))

  (define u
    (if (current-frontend-cache-enabled?)
        (cached-unexpanded-syntax stx expand+unexpand time-pass)
        (expand+unexpand)))
  (define p0  (time-pass "parse"                (λ () (parse u))
                         (λ (v) (count-unparsed unparse-LFE v))
                         (λ (v) (unparse-all (unparse-LFE v)))))
  (define s0  (time-pass "simplify-LFE"
                         (λ ()
                           (if (current-enable-simplify?)
                               (let* ([profile? (current-simplify-profile?)]
                                      [stats    (and profile?
                                                     (let ([ht (make-hasheq)])
                                                       (hash-set! ht 'rule-fires (make-hasheq))
                                                       (hash-set! ht 'rule-deltas (make-hasheq))
                                                       ht))])
                                 (define before
                                   (and profile?
                                        (collect-simplify-profile-summary p0)))
                                 (define out
                                   (parameterize ([current-simplify-profile-stats stats])
                                     (simplify-LFE p0)))
                                 (when profile?
                                   (define after
                                     (collect-simplify-profile-summary out))
                                   (hash-set! stats 'before before)
                                   (hash-set! stats 'after after)
                                   (current-simplify-profile-report
                                    (format-simplify-profile-report stats)))
                                 out)
                               p0))
                         (λ (v) (count-unparsed unparse-LFE v))
                         (λ (v) (unparse-all (unparse-LFE v)))))
  (define p   (time-pass "print-top-level-results"
                         (λ () (if (current-print-top-level-results?)
                                   (print-top-level-results s0)
                                   s0))
                         (λ (v) (count-unparsed unparse-LFE v))
                         (λ (v) (unparse-all (unparse-LFE v)))))
  (define ft  (time-pass "flatten-topbegin"     (λ () (flatten-topbegin p))
                         (λ (v) (count-unparsed unparse-LFE v))
                         (λ (v) (unparse-all (unparse-LFE v)))))
  (define in  (time-pass "infer-names"          (λ () (infer-names ft))
                         (λ (v) (count-unparsed unparse-LFE v))
                         (λ (v) (unparse-all (unparse-LFE v)))))
  (define cq  (time-pass "convert-quotations"   (λ () (convert-quotations in))
                         (λ (v) (count-unparsed unparse-LFE v))
                         (λ (v) (unparse-all (unparse-LFE v)))))
  (define eb  (time-pass "explicit-begin"       (λ () (explicit-begin cq))
                         (λ (v) (count-unparsed unparse-LFE1 v))
                         (λ (v) (unparse-all (unparse-LFE1 v)))))
  (define ecl (time-pass "explicit-case-lambda" (λ () (explicit-case-lambda eb))
                         (λ (v) (count-unparsed unparse-LFE2 v))
                         (λ (v) (unparse-all (unparse-LFE2 v)))))
  (define ar+ρ
    (let ()
      (define ar1+ρ
        (time-pass "α-rename/pass1"
                   (λ () (call-with-values (λ () (α-rename/prepare ecl)) list))
                   (λ (vρ) (count-unparsed unparse-LFE2 (car vρ)))
                   (λ (vρ) (unparse-all (unparse-LFE2 (car vρ))))))
      (define ar1 (car ar1+ρ))
      (define ar-ρ (cadr ar1+ρ))
      (define ar
        (time-pass "α-rename/pass2"       (λ () (α-rename/finish ar1 ar-ρ))
                   (λ (v) (count-unparsed unparse-LFE2+ v))
                   (λ (v) (unparse-all (unparse-LFE2+ v)))))
      (cons ar ar-ρ)))
  (define ar (car ar+ρ))
  (define ua  (time-pass "uncover-assigned!"    (λ () (uncover-assigned! ar))))
  (define lr  (time-pass "lower-letrec-values"  (λ () (parameterize ([current-assigned-analysis ua])
                                                            (lower-letrec-values ar)))
                         (λ (v) (count-unparsed unparse-LFE2+ v))
                         (λ (v) (unparse-all (unparse-LFE2+ v)))))

  (define ac
    (time-pass "assignment-conversion"
      (λ ()
        (define a
          (parameterize ([current-assigned-analysis ua])
            (assignment-conversion lr)))
        (when debug:print-passes?
          (displayln "--- assignment conversion ---")
          (displayln (pretty-print a) (current-error-port)))
        a)
      (λ (v) (count-unparsed unparse-LFE2+ v))
      (λ (v) (unparse-all (unparse-LFE2+ v)))))

  (define ca  (time-pass "categorize-applications" (λ () (categorize-applications ac))
                         (λ (v) (count-unparsed unparse-LFE3 v))
                         (λ (v) (unparse-all (unparse-LFE3 v)))))
  (define an  (time-pass "anormalize"            (λ () (anormalize ca))
                         (λ (v) (count-unparsed unparse-LANF v))
                         (λ (v) (unparse-all (unparse-LANF v)))))
  (define cc  (time-pass "closure-conversion"    (λ () (closure-conversion an))
                         (λ (v) (count-unparsed unparse-LANF+closure v))
                         (λ (v) (unparse-all (unparse-LANF+closure v)))))
  (define fb  (time-pass "flatten-begin"         (λ () (flatten-begin cc))
                         (λ (v) (count-unparsed unparse-LANF+closure v))
                         (λ (v) (unparse-all (unparse-LANF+closure v)))))
  (define gen (time-pass "generate-code"         (λ () (generate-code fb))
                         (λ (_) (count-unparsed unparse-LANF+closure fb))
                         (λ (v) (strip v))))

  (define result (strip gen))
  (when debug:print-passes?
    (displayln "--- compiled ---")
    (displayln (pretty-print result) (current-error-port)))
  (when (current-pass-timings?)
    (current-pass-timing-table
     (format-timing-table/size (reverse pass-times))))
  result)


(define (comp- stx)
  (reset-counter!)
  (define ar
    (α-rename
     (explicit-case-lambda
      (explicit-begin
       (convert-quotations
        (infer-names
         (flatten-topbegin
          (parse
           (unexpand
            (topexpand stx))))))))))
  (define ua (uncover-assigned! ar))
  (define lr
    (parameterize ([current-assigned-analysis ua])
      (lower-letrec-values ar)))
  (define ac
    (parameterize ([current-assigned-analysis ua])
      (assignment-conversion lr)))
  (pretty-print
   (strip    
    (flatten-begin
     (closure-conversion
      (anormalize
       (categorize-applications
        ac)))))))

#| ;; closure-converted-direct-letrec-closure-summary : syntax? -> (listof list?)
;;   Summarize direct letrec closures after closure conversion.
(define (closure-converted-direct-letrec-closure-summary stx)
  (define (closure-converted stx [simplify? #t])
    (reset-counter!)
    (define p0  (parse (unexpand (topexpand stx))))
    (define s0  (if simplify?
                    (simplify-LFE p0)
                    p0))
    (define ft  (flatten-topbegin s0))
    (define in  (infer-names ft))
    (define cq  (convert-quotations in))
    (define eb  (explicit-begin cq))
    (define ecl (explicit-case-lambda eb))
    (define ar  (α-rename ecl))
    (define ua  (uncover-assigned! ar))
    (define lr  (parameterize ([current-assigned-analysis ua])
                  (lower-letrec-values ar)))
    (define ac  (parameterize ([current-assigned-analysis ua])
                  (assignment-conversion lr)))
    (define ca  (categorize-applications ac))
    (define an  (anormalize ca))
    (parameterize ([current-enable-cc-analysis? #t])
      (closure-conversion an)))
  (define entries '())
  (define cc (closure-converted stx))
  (define-pass collect : LANF+closure (T) -> * ()
    (TopLevelForm : TopLevelForm (T) -> * ()
      [(topbegin ,s ,t ...)
       (for ([t (in-list t)])
         (TopLevelForm t))]
      [(topmodule ,s ,mn ,mp ,mf ...)
       (for ([m (in-list mf)])
         (ModuleLevelForm m))]
      [(define-label ,l ,cab)
       (ConvertedAbstraction cab)]
      [(#%expression ,s ,e)
       (Expr e)]
      [,g
       (GeneralTopLevelForm g)])
    (ModuleLevelForm : ModuleLevelForm (M) -> * ()
      [(#%provide ,rps ...)
       (void)]
      [,g
       (GeneralTopLevelForm g)])
    (GeneralTopLevelForm : GeneralTopLevelForm (G) -> * ()
      [(define-values ,s (,x ...) ,e)
       (Expr e)]
      [(define-syntaxes ,s (,x ...) ,e)
       (Expr e)]
      [(#%require ,s ,rrs ...)
       (void)]
      [,e
       (Expr e)])
    (ConvertedAbstraction : ConvertedAbstraction (AB) -> * ()
      [(λ ,s ,ar ,f ,e)
       (Expr e)])
    (ClosureAllocation : ClosureAllocation (CA x) -> * ()
      [(closure ,s ,k ,in ,l ,ar ,ae1 ...)
       (when (eq? k 'direct)
         (set! entries
               (cons (list (syntax-e (variable-id x))
                           k
                           ar
                           (length ae1))
                     entries)))]
      [(case-closure ,s ,in ,l [,ar ,ca] ...)
       (for ([ca (in-list ca)])
         (ClosureAllocation ca x))])
    (AExpr : AExpr (AE) -> * ()
      [else
       (void)])
    (CExpr : CExpr (CE) -> * ()
      [,ae
       (AExpr ae)]
      [(set! ,s ,x ,ae)
       (AExpr ae)]
      [(if ,s ,ae0 ,e1 ,e2)
       (AExpr ae0)
       (Expr e1)
       (Expr e2)]
      [(wcm ,s ,ae0 ,ae1 ,e)
       (AExpr ae0)
       (AExpr ae1)
       (Expr e)]
      [(app ,s ,ae ,ae1 ...)
       (AExpr ae)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(closedapp ,s ,ca ,ae1 ...)
       (AExpr ca)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(directapp ,s ,l ,ar ,ae0 ,ae1 ...)
       (AExpr ae0)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(direct0app ,s ,l ,ar ,ae1 ...)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(selfapp ,s ,l ,ar ,ae1 ...)
        (for ([ae1 (in-list ae1)])
          (AExpr ae1))]
      [(casearmapp ,s ,l ,ar ,i ,ae0 ,ae1 ...)
       (AExpr ae0)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(primapp ,s ,pr ,ae1 ...)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(begin ,s ,e0 ,e1 ...)
       (Expr e0)
       (for ([e (in-list e1)])
         (Expr e))]
      [(begin0 ,s ,e0 ,e1 ...)
       (Expr e0)
       (for ([e (in-list e1)])
         (Expr e))])
    (Expr : Expr (E) -> * ()
      [,ce
       (CExpr ce)]
      [(let-values ,s (((,x ...) ,ce*) ...) ,e)
       (for ([ce (in-list ce*)])
         (CExpr ce))
       (Expr e)]
      [(letrec-values ,s (((,x ...) ,ce*) ...) ,e)
       (for ([xs (in-list x)]
             [ce (in-list ce*)]
             #:when (= (length xs) 1))
         (nanopass-case (LANF+closure CExpr) ce
           [,ca
            (nanopass-case (LANF+closure AExpr) ca
              [,clos
               (ClosureAllocation clos (car xs))]
              [else
               (void)])]
           [else
            (void)]))
       (for ([ce (in-list ce*)])
         (CExpr ce))
       (Expr e)]))
  (collect cc)
  (reverse entries)) |#

#| (module+ test
  (define (module-has-top-level-form? mod head name)
    (for/or ([form (in-list (cdr mod))])
      (and (pair? form)
           (eq? (car form) head)
           (pair? (cdr form))
           (equal? (cadr form) name))))

  (define (module-func-exports mod name)
    (for/or ([form (in-list (cdr mod))])
      (and (pair? form)
           (eq? (car form) 'func)
           (pair? (cdr form))
           (equal? (cadr form) name)
           (for/list ([part (in-list (cddr form))]
                      #:when (and (pair? part)
                                  (eq? (car part) 'export)
                                  (pair? (cdr part))
                                  (string? (cadr part))))
             (cadr part)))))

  (define (report-ref report key)
    (cdr (assq key report)))

  (define (sexp-any? pred x)
    (or (pred x)
        (cond
          [(pair? x)
           (or (sexp-any? pred (car x))
               (sexp-any? pred (cdr x)))]
          [(vector? x)
           (for/or ([e (in-vector x)])
             (sexp-any? pred e))]
          [else
           #f])))

  (define (module-has-direct-dummy-closure-call? mod)
    (define (direct-dummy-closure-call? x)
      (match x
        [(list 'call label '(global.get $dummy-closure) args)
         (and (symbol? label)
              (regexp-match? #rx"^\\$label\\." (symbol->string label))
              (pair? args)
              (eq? (car args) 'array.new_fixed))]
        [(list 'return_call label '(global.get $dummy-closure) args)
         (and (symbol? label)
              (regexp-match? #rx"^\\$label\\." (symbol->string label))
              (pair? args)
              (eq? (car args) 'array.new_fixed))]
        [_ #f]))
    (sexp-any? direct-dummy-closure-call? mod))

  (define (module-has-direct-label-call? mod)
    (define (direct-call-args? x)
      (match x
        [(list 'array.new_fixed '$Args _ ...) #t]
        [(list 'call '$repack-arguments inner _)
         (direct-call-args? inner)]
        [_ #f]))
    (define (direct-label-call? x)
      (match x
        [(list 'call label clos args)
         (and (symbol? label)
              (regexp-match? #rx"^\\$label\\." (symbol->string label))
              (direct-call-args? args)
              (not (eq? clos #f)))]
        [(list 'return_call label clos args)
         (and (symbol? label)
              (regexp-match? #rx"^\\$label\\." (symbol->string label))
              (direct-call-args? args)
              (not (eq? clos #f)))]
        [_ #f]))
    (sexp-any? direct-label-call? mod))

  (define (module-has-known0-label-call? mod)
    (define (direct-call-args? x)
      (match x
        [(list 'array.new_fixed '$Args _ ...) #t]
        [(list 'call '$repack-arguments inner _)
         (direct-call-args? inner)]
        [_ #f]))
    (define (known0-label-call? x)
      (match x
        [(list 'call label args)
         (and (symbol? label)
              (regexp-match? #rx"^\\$label\\..*\\.known0$" (symbol->string label))
              (direct-call-args? args))]
        [(list 'return_call label args)
         (and (symbol? label)
              (regexp-match? #rx"^\\$label\\..*\\.known0$" (symbol->string label))
              (direct-call-args? args))]
        [_ #f]))
    (sexp-any? known0-label-call? mod))

  (define (module-has-known1-label-call? mod)
    (define (direct-call-args? x)
      (match x
        [(list 'array.new_fixed '$Args _ ...) #t]
        [(list 'call '$repack-arguments inner _)
         (direct-call-args? inner)]
        [_ #f]))
    (define (known1-label-call? x)
      (match x
        [(list 'call label env0 args)
         (and (symbol? label)
              (regexp-match? #rx"^\\$label\\..*\\.known1$" (symbol->string label))
              (direct-call-args? args)
              (not (equal? env0 #f)))]
        [(list 'return_call label env0 args)
         (and (symbol? label)
              (regexp-match? #rx"^\\$label\\..*\\.known1$" (symbol->string label))
              (direct-call-args? args)
              (not (equal? env0 #f)))]
        [_ #f]))
    (sexp-any? known1-label-call? mod))

  (define (module-has-known1-base-sibling? mod)
    (define known1-stems
      (for/list ([form (in-list (cdr mod))]
                 #:when
                 (match form
                   [(list 'func label (list 'export export-name) _ ...)
                    (and (symbol? label)
                         (regexp-match? #rx"^(\\$label\\.[0-9]+)\\.known1$"
                                        (symbol->string label))
                         (string? export-name)
                         (regexp-match? #rx"^label\\.[0-9]+$" export-name))]
                   [_ #f]))
        (match form
          [(list 'func label _ ...)
           (string->symbol
            (second
             (regexp-match #rx"^(\\$label\\.[0-9]+)\\.known1$"
                           (symbol->string label))))])))
    (for/or ([stem (in-list known1-stems)])
      (for/or ([form (in-list (cdr mod))])
        (match form
          [(list 'func label _ ...)
           (and (symbol? label)
                (eq? label stem))]
          [_ #f]))))

  (define (module-has-local-closure-shell-allocation? mod)
    (define (undefined-slot? x)
      (or (equal? x '(global.get $undefined))
          (equal? x '(ref.i31 (i32.const 79)))))
    (define (local-closure-shell-allocation? x)
      (match x
        [(list 'local.set _
               (list 'struct.new '$Closure _ ... (list 'array.new_fixed '$Free _ slots ...) ))
         (ormap undefined-slot? slots)]
        [(list 'local.set _
               (list 'struct.new '$Closure1 _ ... slot))
         (undefined-slot? slot)]
        [(list 'local.set _
               (list 'struct.new '$Closure2 _ ... slot0 slot1))
         (or (undefined-slot? slot0)
             (undefined-slot? slot1))]
        [(list 'local.set _
               (list 'struct.new '$Closure3 _ ... slot0 slot1 slot2))
         (or (undefined-slot? slot0)
             (undefined-slot? slot1)
             (undefined-slot? slot2))]
        [_ #f]))
    (sexp-any? local-closure-shell-allocation? mod))

  (define (module-count-local-closure-shell-allocations mod)
    (define (undefined-slot? x)
      (or (equal? x '(global.get $undefined))
          (equal? x '(ref.i31 (i32.const 79)))))
    (define (count-shell-allocations x)
      (cond
        [(pair? x)
         (+ (match x
              [(list 'local.set _
                     (list 'struct.new '$Closure _ ...
                           (list 'array.new_fixed '$Free _ slots ...)))
               (if (ormap undefined-slot? slots) 1 0)]
              [(list 'local.set _
                     (list 'struct.new '$Closure1 _ ... slot))
               (if (undefined-slot? slot) 1 0)]
              [(list 'local.set _
                     (list 'struct.new '$Closure2 _ ... slot0 slot1))
               (if (or (undefined-slot? slot0)
                       (undefined-slot? slot1))
                   1
                   0)]
              [(list 'local.set _
                     (list 'struct.new '$Closure3 _ ... slot0 slot1 slot2))
               (if (or (undefined-slot? slot0)
                       (undefined-slot? slot1)
                       (undefined-slot? slot2))
                   1
                   0)]
              [_ 0])
            (count-shell-allocations (car x))
            (count-shell-allocations (cdr x)))]
        [(vector? x)
         (for/sum ([e (in-vector x)])
           (count-shell-allocations e))]
        [else
         0]))
    (count-shell-allocations mod))

  (define (module-has-local-closure-allocation? mod)
    (define (local-closure-allocation? x)
      (match x
        [(list 'local.set _
               (list 'struct.new '$Closure _ ...))
         #t]
        [(list 'local.set _
               (list 'struct.new '$Closure1 _ ...))
         #t]
        [(list 'local.set _
               (list 'struct.new '$Closure2 _ ...))
         #t]
        [(list 'local.set _
               (list 'struct.new '$Closure3 _ ...))
         #t]
        [_ #f]))
    (sexp-any? local-closure-allocation? mod))

  (define (module-count-local-closure-shell-allocations mod)
    (define (undefined-slot? x)
      (equal? x '(global.get $undefined)))
    (define (count-shell-allocations x)
      (cond
        [(pair? x)
         (+ (match x
              [(list 'local.set _
                     (list 'struct.new '$Closure _ ...
                           (list 'array.new_fixed '$Free _ slots ...)))
               (if (ormap undefined-slot? slots) 1 0)]
              [(list 'local.set _
                     (list 'struct.new '$Closure1 _ ... slot))
               (if (undefined-slot? slot) 1 0)]
              [(list 'local.set _
                     (list 'struct.new '$Closure2 _ ... slot0 slot1))
               (if (or (undefined-slot? slot0)
                       (undefined-slot? slot1))
                   1
                   0)]
              [(list 'local.set _
                     (list 'struct.new '$Closure3 _ ... slot0 slot1 slot2))
               (if (or (undefined-slot? slot0)
                       (undefined-slot? slot1)
                       (undefined-slot? slot2))
                   1
                   0)]
              [_ 0])
            (count-shell-allocations (car x))
            (count-shell-allocations (cdr x)))]
        [(vector? x)
         (for/sum ([e (in-vector x)])
           (count-shell-allocations e))]
        [else
         0]))
    (count-shell-allocations mod))

  (define (module-count-free-patch-writes mod)
    (define (count-free-patch-writes x)
      (cond
        [(pair? x)
         (+ (match x
              [(list 'array.set '$Free _ _ _) 1]
              [(list 'struct.set '$Closure1 '$free0 _ _) 1]
              [(list 'struct.set '$Closure2 '$free0 _ _) 1]
              [(list 'struct.set '$Closure2 '$free1 _ _) 1]
              [(list 'struct.set '$Closure3 '$free0 _ _) 1]
              [(list 'struct.set '$Closure3 '$free1 _ _) 1]
              [(list 'struct.set '$Closure3 '$free2 _ _) 1]
              [_ 0])
            (count-free-patch-writes (car x))
            (count-free-patch-writes (cdr x)))]
        [(vector? x)
         (for/sum ([e (in-vector x)])
           (count-free-patch-writes e))]
        [else
         0]))
    (count-free-patch-writes mod))


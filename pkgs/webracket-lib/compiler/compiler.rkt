;; Primitives with names special names.
;; The following primitives require special attention.
;; The identifiers +, -, ... can't be used as names for functions in the target language.
;; The compiler knows how to open code the operators.
;; References to a primitive + will be compiled into PRIM+ which
;; is exported from the runtime.

#;(define-primitives
  + - * /
  = < > <= >=)

; This list of macro introduced identifiers goes away when module support arrives.
; set these in compiler3.rkt instead.
; (define macro-introduced '(call-handled-body check-struct-type))

(define (primitive? v)
  (and (or (and (syntax? v)   (primitive? (syntax-e v)))
           (and (variable? v) (primitive? (variable-id v)))
           (and (current-internal-treelist-debug-shape?)
                (eq? v internal-treelist-debug-shape-symbol))
           (and (current-internal-immutable-hash-debug-shape?)
                (eq? v internal-immutable-hash-debug-shape-symbol))
           (and (current-internal-immutable-hash-debug-shape?)
                (eq? v internal-immutable-hamt-packed-bits-symbol))
           (and (current-internal-immutable-hash-debug-shape?)
                (eq? v internal-immutable-hash-root-metadata-symbol))
           (set-member? primitives-set v))
       #t))

;; primitive-symbol : any/c -> (or/c symbol? #f)
;;   Extract the surface symbol used for primitive ownership decisions.
(define (primitive-symbol v)
  (cond
    [(syntax? v)   (syntax-e v)]
    [(variable? v) (primitive-symbol (variable-id v))]
    [(symbol? v)   v]
    [else          #f]))

;; provider-owned-primitive-alias? : any/c -> boolean?
;;   Detect public primitive names deliberately shadowed by a provider export.
(define (provider-owned-primitive-alias? v)
  (define sym (primitive-symbol v))
  (and sym
       (set-member? (current-provider-owned-primitive-aliases) sym)
       #t))

;; provider-owned-runtime-primitive-alias? : any/c -> boolean?
;;   Detect provider-owned aliases that still have a runtime primitive fallback.
(define (provider-owned-runtime-primitive-alias? v)
  (define sym (primitive-symbol v))
  (and sym
       (provider-owned-primitive-alias? v)
       (primitive? sym)
       #t))

;; compiler-primitive? : any/c -> boolean?
;;   Check whether v should still compile as a direct runtime primitive.
(define (compiler-primitive? v)
  (and (primitive? v)
       (not (provider-owned-primitive-alias? v))))

;; These primitives are runtime protocols, not ordinary library exports, in the
;; current Webify expander bundle. If a provider wrapper shadows one of these
;; names, calls must still target WebRacket's primitive implementation.
(define runtime-preferred-primitive-aliases
  '(call-with-parameterization))
(define runtime-preferred-primitive-aliases-set
  (list->seteq runtime-preferred-primitive-aliases))

;; runtime-preferred-primitive-alias? : any/c -> boolean?
;;   Detect primitive names whose top-level aliases should not shadow runtime.
(define (runtime-preferred-primitive-alias? v)
  (define sym (primitive-symbol v))
  (and sym
       (set-member? runtime-preferred-primitive-aliases-set sym)
       (primitive? sym)
       #t))


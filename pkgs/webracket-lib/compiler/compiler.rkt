         (void)]
        [,e
         (Expr e)])
      (ClosureAllocation : ClosureAllocation (CA x) -> * ()
        [(closure ,s ,k ,in ,l ,ar ,ae1 ...)
         (when (eq? k 'direct)
           (set! entries
                 (cons (list (syntax-e (variable-id x))
                             k
                             ar
                             (length ae1))
                       entries)))]
        [(case-closure ,s ,in ,l [,ar ,ca] ...)
         (for ([ca (in-list ca)])
           (ClosureAllocation ca x))])
      (AExpr : AExpr (AE) -> * ()
        [else
         (void)])
      (CExpr : CExpr (CE) -> * ()
        [,ae
         (AExpr ae)]
        [(set! ,s ,x ,ae)
         (AExpr ae)]
        [(if ,s ,ae0 ,e1 ,e2)
         (AExpr ae0)
         (Expr e1)
         (Expr e2)]
        [(wcm ,s ,ae0 ,ae1 ,e)
         (AExpr ae0)
         (AExpr ae1)
         (Expr e)]
        [(app ,s ,ae ,ae1 ...)
         (AExpr ae)
         (for ([ae1 (in-list ae1)])

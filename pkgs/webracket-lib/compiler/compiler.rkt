(define (strip x)
  (cond
    [(variable? x) (variable-id x)]
    [(split-runtime-modules? x)
     (define core (split-runtime-modules-core x))
     (struct-copy split-runtime-modules x
                  [core (if (promise? core)
                            (delay (strip (force core)))
                            (strip core))]
                  [program (strip (split-runtime-modules-program x))]
                  [import-forms (strip (split-runtime-modules-import-forms x))]
                  [ffi-module (strip (split-runtime-modules-ffi-module x))]
                  [ffi-cache-key (strip (split-runtime-modules-ffi-cache-key x))])]
    [(pair? x)     (cons (strip (car x))
                         (strip (cdr x)))]
    [(null? x)     '()]
    [(syntax? x)   (syntax-e x)]
    [(datum? x)    (datum-value x)]
    
    [else          x]))

(define (strip* x)
  ; (displayln x)
  (cond
    [(variable? x)   (syntax-e (variable-id x))]
    [(pair? x)       (cons (strip* (car x))
                           (strip* (cdr x)))]
    [(null? x)      '()]
    [(syntax? x)    (syntax-e x)]
    [(datum? x)     (datum-value x)]
    
    [else           x]))


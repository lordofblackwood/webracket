;;;
;;; FINISH CLOSURE CONVERSION
;;;

;;; This chapter performs the actual closure-conversion rewrite.
;;;
;;; At this point the compiler already knows, for each abstraction:
;;; - its free variables
;;; - whether it is an ordinary closure or a direct helper
;;; - its current lifted-body env layout
;;; - its closure payload layout
;;; - any enabled known-helper lowering choices
;;;
;;; The pass turns local abstractions into labeled code, rewrites free-variable
;;; access through the chosen env view, and decides whether each helper remains
;;; closure-backed or can lower through one of the current known-helper paths.
;;; The closure-converted tree still preserves the ordinary closure ABI where
;;; required by procedure identity, generic calls, or unsupported helper cases.

;;; Step 1: Generate a label for each abstraction
;;;   label1:  (λ (x ...) e)
;;; Step 2:
;;;   Add a top-level-form for each abstraction:
;;;       (define-label label1  (λ (cl x ...) e))
;;;       where e has been closure converted
;;;   Rewrite each abstraction:
;;;       (λ (x ...) e)    =>  (closure in label1 f ...)
;;;                            where f ... are the free variables of the abstraction
;;;                            and `in` is an inferred name (if present)
;;;   Rewrite references to free variables:
;;;       f                =>  (free-ref cl i)
;;;                            where i is the index of f in the list of free variables

(define (closure-conversion T)
  (define labels-ht (make-hasheq))
  (define (add-label! ab) (hash-set! labels-ht ab (new-var "label")))
  (letv ((T free-ht abs kind-ht _direct-sites-ht _direct-candidate-ht disqualified-ht
            binder-ht
            extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (define-values (_base-needs-ht origin-ht)
      (determine-direct-helper-base-needs! T free-ht abs kind-ht))
    (current-direct-letrec-representation-labels (make-hasheq))
    (current-inline-small-closure-arities (make-hasheq))
    (current-known0-direct-labels (make-hasheq))
    (current-known0-only-labels (make-hasheq))
    (current-known1-direct-labels (make-hasheq))
    (current-known1-only-labels (make-hasheq))
    (current-known1-wrapper-env-indices (make-hasheq))
    #;(pretty-print free-ht)
    (for ([ab abs])
      (add-label! ab))
    (finish-closure-conversion T free-ht kind-ht binder-ht extended-ht direct-callees-ht disqualified-ht origin-ht labels-ht)))

(define (closure+primitive? v)
  (or (eq? v 'closure)
      (primitive? v)))

(define (natural? v) (and (integer? v) (not (negative? v))))

(define (lambda-kind? v)
  (memq v '(closed trivial-closed direct)))

(define (inferred-name? v)
  ; either #f or a variable
  (or (not v) (variable? v)))

(define arity? integer?)

(define-language LANF+closure (extends LANF)
  (terminals
   (- (primitive (pr)))
   (+ (closure+primitive (pr)))
   (+ (lambda-kind (k)))
   (+ (arity (ar)))
   (- (variable (x xd)))
   (+ (variable (x xd l)) => unparse-variable)  ; l for label
   (+ (natural (i)))                            ; i for index  
   (+ (inferred-name (in))))
  (Abstraction (ab)
    (- (λ s f e)))
  (CaseAbstraction (cab)
    (- (case-lambda s ab ...)))
  (ClosureAllocation (ca)
    (+ (closure s k in l ar ae1 ...)    => (closure k in l ae1 ...))) ; x is the inferred name
  (CaseClosureAllocation (cca)
    (+ (case-closure s in l [ar ca] ...) => (case-closure in [ar ca] ...)))
  (AExpr (ae)
    (- ab
       cab)
    (+ ca
       cca
       (free-ref x i)))
  (CExpr (ce)
    (- (closedapp s ab ae1 ...))
    (+ (closedapp s ca ae1 ...) => (closedapp ca ae1 ...)
       (directapp s l ar ae0 ae1 ...)  => (directapp l ar ae0 ae1 ...)
       (known0app s l ar ae1 ...)      => (known0app l ar ae1 ...)
       (known1app s l ar ae0 ae1 ...)  => (known1app l ar ae0 ae1 ...)
       (direct0app s l ar ae1 ...)     => (direct0app l ar ae1 ...)
       (selfapp s l ar ae1 ...)        => (selfapp l ar ae1 ...)
       (casearmapp s l ar i ae0 ae1 ...) => (casearmapp l ar i ae0 ae1 ...)))
  (ConvertedAbstraction (cab)
    (+ (λ s ar f e) => (λ f e)))
  #;(ConvertedCaseAbstraction (ccab)
      (+ (case-lambda s cab ...) => (case-lambda cab ...)))
  (TopLevelForm (t)
                (+ (define-label l cab)))
  (ModuleLevelForm (mf)
    (+ (define-label l cab))))


(define-pass finish-closure-conversion : LANF (T free-ht kind-ht binder-ht extended-ht direct-callees-ht disqualified-ht origin-ht labels-ht) -> LANF+closure ()
  (definitions
    (define h #'fcc)
    (define (label-of ab) (hash-ref labels-ht ab))
    (define (free-of ab)  (id-set->list (hash-ref free-ht ab)))
    (define (kind-of ab)  (hash-ref kind-ht ab 'closed))
    (define (binder-of ab) (hash-ref binder-ht ab #f))
    (define (extended-of ab)
      (id-set->list (hash-ref extended-ht ab empty-set)))

    ;; extended-layout-of : any/c -> (listof variable?)
    ;;   Return the authoritative direct-helper env layout derived from the
    ;;   analysis fixed point.
    (define (extended-layout-of ab)
      (extended-of ab))

    ;; remove-variable : (listof variable?) variable? -> (listof variable?)
    ;;   Remove x from xs using identifier equality.
    (define (remove-variable xs x)
      (filter (λ (y) (not (id=? x y))) xs))

    ;; self-binder-free-of : any/c -> (listof variable?)
    ;;   Return ab's free variables, excluding its own direct binder when known.
    (define (self-binder-free-of ab)
      (match (binder-of ab)
        [#f (free-of ab)]
        [x  (remove-variable (free-of ab) x)]))

    ;; direct-self-binder-removable/local? : any/c -> boolean?
    ;;   Check whether ab can drop its own binder from the closure layout.
    (define (direct-self-binder-removable/local? ab)
      (direct-self-binder-removable? ab kind-ht binder-ht))

    ;; current-body-layout-free-of : any/c -> (listof variable?)
    ;;   Return the variables currently carried as explicit env operands by the
    ;;   lifted body of ab.
    (define (current-body-layout-free-of ab)
      (define syms
        (direct-helper-layout-free-vars ab free-ht kind-ht binder-ht direct-callees-ht))
      (filter-map (λ (x)
                    (for/or ([y (in-list (free-of ab))])
                      (and (equal? (syntax-e (variable-id y)) x) y)))
                  syms))

    ;; current-closure-env-free-of : any/c -> (listof variable?)
    ;;   Return the variables currently stored in ab's closure payload.
    (define (current-closure-env-free-of ab)
      (current-body-layout-free-of ab))

    ;; current-migrated-body-layout-candidates : (parameter/c (listof any/c))
    ;;   Direct helpers in the current non-recursive group whose lifted bodies
    ;;   use `extended-layout-of` as their carried body layout. This affects
    ;;   lifted-body free-var indexing only; closure payload layout is still
    ;;   described separately by `closure-env-of`.
    (define current-migrated-body-layout-candidates
      (make-parameter '()))

    ;; migrated-body-layout-candidate? : any/c -> boolean?
    ;;   Check whether ab is one of the direct helpers whose lifted body uses
    ;;   `extended-layout-of` in the current non-recursive group.
    (define (migrated-body-layout-candidate? ab)
      (candidate-abstraction-label-member? ab
                                           (current-migrated-body-layout-candidates)))

    ;; body-layout-of : any/c -> (listof variable?)
    ;;   Return the environment layout used by the lifted body of ab.
    ;;
    ;; For most helpers this is the current carried layout. For selected direct
    ;; helpers it is `extended-layout-of`, so lifted-body env references follow
    ;; the propagated direct-helper env view instead of the older closure-shaped
    ;; layout.
    (define (body-layout-of ab)
      (if (migrated-body-layout-candidate? ab)
          (extended-layout-of ab)
          (current-body-layout-free-of ab)))

    ;; closure-env-of : any/c -> (listof variable?)
    ;;   Return the variables stored in ab's closure record.
    ;;
    ;; This is the closure payload layout used by closure allocation and the
    ;; ordinary closure-backed ABI. It is intentionally distinct from
    ;; `body-layout-of`, which describes the lifted body's env view.
    (define (closure-env-of ab)
      (current-closure-env-free-of ab))

    ;; closure-env-aexprs-of : any/c -> (listof any/c)
    ;;   Convert ab's closure environment variables to closure-converted aexprs.
    (define (closure-env-aexprs-of ab)
      (map AExpr (closure-env-of ab)))

    ;; direct-target-uses-dummy-closure/local? : any/c -> boolean?
    ;;   Check whether direct calls to ab can pass `$dummy-closure` because the
    ;;   lifted body currently uses no closure environment.
    (define (direct-target-uses-dummy-closure/local? ab)
      (and (eq? (kind-of ab) 'direct)
           (null? (body-layout-of ab))))

    ;; abstraction-formals-of : any/c -> LANF Formals
    ;;   Return the source-level formals for abstraction ab.
    (define (abstraction-formals-of ab)
      (nanopass-case (LANF AExpr) ab
        [(λ ,s ,f ,e) f]
        [else
         (error 'finish-closure-conversion
                "expected abstraction, got ~a"
                ab)]))

    ;; abstraction-formal-variables-of : any/c -> (listof variable?)
    ;;   Return the variables bound by ab's formals.
    (define (abstraction-formal-variables-of ab)
      (formals->variables (abstraction-formals-of ab)))

    ;; abstraction-provides-variable? : any/c variable? -> boolean?
    ;;   Check whether ab can source x from its current carried env or formals.
    (define (abstraction-provides-variable? ab x)
      (or (for/or ([y (in-list (body-layout-of ab))])
            (variable=? x y))
          (for/or ([y (in-list (abstraction-formal-variables-of ab))])
            (variable=? x y))))

    ;; known0-target-eligible/local? : any/c -> boolean?
    ;;   Check whether ab fits the first known-helper ABI bucket:
    ;;   fixed-arity direct helper with no authoritative env needs and no
    ;;   remaining carried-body layout under the current lowering.
    (define (known0-target-eligible/local? ab)
      (and (current-enable-cc-analysis?)
           (eq? (kind-of ab) 'direct)
           (abstraction-fixed-arity? ab)
           (not (direct-self-recursive? ab free-ht binder-ht))
           (null? (extended-layout-of ab))
           (null? (body-layout-of ab))))

    ;; known0-only-target-eligible/local? : any/c -> boolean?
    ;;   Check whether ab fits the first known-only helper bucket:
    ;;   a non-recursive, fixed-arity, plain lambda direct helper with
    ;;   empty environment layout and no closure payload needs.
    (define (known0-only-target-eligible/local? ab)
      (and (known0-target-eligible/local? ab)
           (null? (body-layout-of ab))
           (nanopass-case (LANF AExpr) ab
             [(λ ,s ,f ,e) #t]
             [else #f])))

    ;; known1-target-eligible/local? : any/c -> boolean?
    ;;   Check whether ab fits the unary known-helper ABI bucket:
    ;;   fixed-arity direct helper with exactly one authoritative env value and
    ;;   exactly one currently carried body-layout value, where the ordinary
    ;;   closure-backed wrapper can still source that env from closure payload.
    (define (known1-target-eligible/local? ab)
      (and (current-enable-cc-analysis?)
           (eq? (kind-of ab) 'direct)
           (abstraction-fixed-arity? ab)
           (not (direct-self-recursive? ab free-ht binder-ht))
           (= (length (extended-layout-of ab)) 1)
           (= (length (body-layout-of ab)) 1)
           (let ([x (car (extended-layout-of ab))])
             (index-of x (closure-env-of ab)))))

    ;; known1-only-target-eligible/local? : any/c -> boolean?
    ;;   Check whether ab fits the first known1-only helper bucket:
    ;;   a non-recursive, fixed-arity, direct helper with one authoritative env
    ;;   value and no remaining closure-identity requirements.
    (define (known1-only-deletion-candidate/local? ab)
      (and (known1-target-eligible/local? ab)
           (eq? (hash-ref origin-ht ab 'other) 'let-values)
           (not (hash-ref disqualified-ht ab #f))
           (not (nested-lift-sensitive-form-present? ab))
           (let ([x (car (extended-layout-of ab))])
             (and (not (nested-variable-capture-present? ab
                                                         (syntax-e (variable-id x))))
                  (for/and ([(caller callees) (in-hash direct-callees-ht)]
                            #:when (for/or ([candidate (in-list callees)])
                                     (eq? candidate ab)))
                    (and (eq? (kind-of caller) 'direct)
                         (abstraction-provides-variable? caller x)))))))
    (define (known1-only-target-eligible/local? ab)
      (known1-only-deletion-candidate/local? ab))

    ;; direct-callee-known-abi/local? : any/c -> boolean?
    ;;   Check whether callee can already lower through a known-helper ABI path.
    (define (direct-callee-known-abi/local? callee)
      (or (known0-target-eligible/local? callee)
          (known1-target-eligible/local? callee)))

    ;; migrated-body-layout-target-eligible/raw? : any/c -> boolean?
    ;;   Check whether ab can use `extended-layout-of` as its lifted body
    ;;   layout without changing closure payload layout or ordinary closure
    ;;   calling paths.
    ;;
    ;; We keep this deliberately small:
    ;; - direct, fixed-arity, non-recursive
    ;; - empty propagated env
    ;; - no nested lift-sensitive forms
    ;; - every direct callee already has a known-helper ABI path, so dropping
    ;;   carried helper binders does not force ordinary `directapp` fallback
    (define (migrated-body-layout-target-eligible/raw? ab)
      (and (current-enable-cc-analysis?)
           (eq? (kind-of ab) 'direct)
           (abstraction-fixed-arity? ab)
           (not (direct-self-recursive? ab free-ht binder-ht))
           (not (nested-lift-sensitive-form-present? ab))
           (zero? (length (extended-layout-of ab)))
           (for/and ([callee (in-list (hash-ref direct-callees-ht ab '()))])
             (direct-callee-known-abi/local? callee))))

    ;; direct-letrec-representation-eligible/local? : any/c -> boolean?
    ;;   Check whether ab fits the currently enabled tiny direct-letrec
    ;;   representation: fixed-arity, direct, self-recursive, and empty layout.
    (define (direct-letrec-representation-eligible/local? ab)
      (and (current-enable-cc-analysis?)
           (eq? (kind-of ab) 'direct)
           (abstraction-fixed-arity? ab)
           (direct-self-recursive? ab free-ht binder-ht)
           (direct-self-binder-removable/local? ab)
           (null? (body-layout-of ab))))

    ;; inline-small-closure-arity/local : any/c -> (or/c 1 2 3 #f)
    ;;   Return the small inline closure arity for ab when it can use the
    ;;   narrow flat representation, otherwise `#f`.
    (define (inline-small-closure-arity/local ab)
      (and (current-enable-cc-analysis?)
           (not (eq? (kind-of ab) 'trivial-closed))
           (match (length (closure-env-of ab))
             [1 1]
             [2 2]
             [3 3]
             [_ #f])))

    (define (index-of x free)
      (define (x? y) (id=? x y))
      (index-where free x?))
    ; the converted abstractions are lifted to the top-level,
    ; add the same time we store the arity for each abstraction.
    (define lifted-abstractions (make-hasheq))
    (define (formals->arity f)
      ; +n means precisely n
      ;  0 means precisely  0
      ; -1 means at least 0
      ; -2 means at least 1
      ; -n means at least n-1
      (nanopass-case (LANF+closure Formals) f
                     [(formals (,x ...))            (length x)]
                     [(formals (,x0 ,x1 ... . ,xd)) (- (+ 2 (length x1)))]
                     [(formals ,x)                  -1]))
    (define (source-formals->arity f)
      ; Same arity encoding as above, but over source-language formals.
      (nanopass-case (LANF Formals) f
                     [(formals (,x ...))            (length x)]
                     [(formals (,x0 ,x1 ... . ,xd)) (- (+ 2 (length x1)))]
                     [(formals ,x)                  -1]))
    (define lift-count 0)
    (define (report-lift-progress! event label)
      (when (current-closure-conversion-progress?)
        (define interval (closure-conversion-progress-interval))
        (when (or (= lift-count 1)
                  (zero? (modulo lift-count interval)))
          (report-closure-conversion-progress!
           event
           lift-count
           (unparse-variable label)))))
    (define (lift! s label formals body)
      (set! lift-count (add1 lift-count))
      (report-lift-progress! 'lift-start label)
      (record-label-map! label s)
      (report-lift-progress! 'lift-after-record-label-map label)
      (define cab
        (with-output-language (LANF+closure ConvertedAbstraction)
          `(λ ,s ,(formals->arity formals) ,formals ,body)))
      (hash-set! lifted-abstractions label cab))    
    (define (case-lift! label formals* body)
      (define ccab
        (with-output-language (LANF+closure ConvertedAbstraction)
          (let ([f (with-output-language  (LANF+closure Formals) `(formals ()))])
            `(λ ,h ,(formals->arity f) ,f ,body)))) ; TODO BUG TODO BUG
      (hash-set! lifted-abstractions label ccab))
    (define (abstraction-formals ab)
      (nanopass-case (LANF Abstraction) ab
        [(λ ,s ,f ,e) f]))
    (define (inferred-name s)
      ; The inferred name (if present) was added to the
      ; syntax object in the pass `infer-names`.
      (syntax-case s ()
        [(inferred-name? x s)
         (eq? (syntax-e #'inferred-name?) 'inferred-name)
         (syntax-e #'x)]
        [_ #f]))
    (define current-free (make-parameter '()))

    ;; env-empty : -> free-id-table?
    ;;   Build an empty environment for direct-callable local lambdas.
    (define (env-empty)
      (make-immutable-free-id-table))

    ;; env-ref : free-id-table? variable? -> (or/c any/c #f)
    ;;   Look up the abstraction bound to variable x in environment ρ.
    (define (env-ref ρ x)
      (free-id-table-ref ρ (variable-id x) #f))

    ;; env-bind : free-id-table? variable? any/c -> free-id-table?
    ;;   Extend environment ρ so x maps to abstraction ab.
    (define (env-bind ρ x ab)
      (free-id-table-set ρ (variable-id x) ab))

    ;; env-bind* : free-id-table? (listof variable?) (listof any/c) -> free-id-table?
    ;;   Extend environment ρ with parallel variable/abstraction bindings.
    (define (env-bind* ρ xs abs)
      (for/fold ([ρ ρ]) ([x  (in-list xs)]
                         [ab (in-list abs)])
        (env-bind ρ x ab)))

    ;; env-shadow* : free-id-table? (listof variable?) -> free-id-table?
    ;;   Shadow variables xs so outer direct-call bindings are hidden.
    (define (env-shadow* ρ xs)
      (for/fold ([ρ ρ]) ([x (in-list xs)])
        (free-id-table-set ρ (variable-id x) #f)))

    ;; formals->variables : LANF Formals -> (listof variable?)
    ;;   Collect the variables bound by formals f.
    (define (formals->variables f)
      (nanopass-case (LANF Formals) f
        [(formals (,x ...))            x]
        [(formals (,x0 ,x1 ... . ,xd)) (cons x0 (append x1 (list xd)))]
        [(formals ,x)                  (list x)]))

    ;; clause-bound-abstraction : LANF CExpr -> (or/c any/c #f)
    ;;   Recognize the simple local binding pattern x = λ or x = case-lambda.
    (define (clause-bound-abstraction ce)
      (nanopass-case (LANF CExpr) ce
        [,ae
         (nanopass-case (LANF AExpr) ae
           [,ab  ab]
           [,cab cab]
           [else #f])]
        [else #f]))

    ;; case-abstraction-arms : LANF CaseAbstraction -> (listof LANF Abstraction)
    ;;   Return the arms of case abstraction cab.
    (define (case-abstraction-arms cab)
      (nanopass-case (LANF CaseAbstraction) cab
        [(case-lambda ,s ,ab* ...)
         ab*]))

    ;; arity-accepts-count? : integer? natural? -> boolean?
    ;;   Check whether encoded arity ar accepts argc arguments.
    (define (arity-accepts-count? ar argc)
      (if (>= ar 0)
          (= ar argc)
          (>= argc (- (- ar) 1))))

    ;; unique-case-arm-match : LANF CaseAbstraction natural?
    ;;                      -> (or/c (list any/c natural? integer?) #f)
    ;;   Return the uniquely matching arm, its index, and arity marker for argc,
    ;;   or `#f` when no arm or multiple arms match.
    (define (unique-case-arm-match cab argc)
      (define matches
        (for/list ([ab (in-list (case-abstraction-arms cab))]
                   [i  (in-naturals)]
                   #:do [(define ar (source-formals->arity (abstraction-formals ab)))]
                   #:when (arity-accepts-count? ar argc))
          (list ab i ar)))
      (match matches
        [(list match) match]
        [_ #f]))

    ;; clause-direct-binding : (listof variable?) LANF CExpr -> (or/c (cons variable? any/c) #f)
    ;;   Recognize a single-variable clause bound to a direct lambda-like helper.
    ;;
    ;; The recognized binding is enough to put x in the local direct-helper
    ;; environment. Later lowering decides whether calls through x become
    ;; `directapp`, `direct0app`, `selfapp`, `known0app`, or `known1app`.
    (define (clause-direct-binding xs ce)
      (match xs
        [(list x)
         (define target (clause-bound-abstraction ce))
         (and (not (runtime-preferred-primitive-alias? x))
              target
              (eq? (kind-of target) 'direct)
              (cons x target))]
        [_ #f]))

    ;; clause-direct-bindings : (listof (listof variable?)) (listof LANF CExpr)
    ;;                      -> (listof (cons variable? any/c))
    ;;   Collect the direct-call bindings introduced by a let or letrec group.
    (define (clause-direct-bindings xss ces)
      (for/fold ([pairs '()]) ([xs (in-list xss)]
                               [ce (in-list ces)])
        (define pair (clause-direct-binding xs ce))
        (if pair
            (cons pair pairs)
            pairs)))

    ;; direct-binding-of : variable? -> (or/c any/c #f)
    ;;   Return the direct-callable abstraction bound to x, if any.
    (define (direct-binding-of x)
      (env-ref (current-direct-env) x))

    ;; known0-binding-of : variable? -> (or/c any/c #f)
    ;;   Return the env0-known direct helper bound to x, if any.
    (define (known0-binding-of x)
      (env-ref (current-known0-env) x))

    ;; known1-binding-of : variable? -> (or/c any/c #f)
    ;;   Return the env1-known direct helper bound to x, if any.
    (define (known1-binding-of x)
      (env-ref (current-known1-env) x))

    ;; known1-only-binding-of : variable? -> (or/c any/c #f)
    ;;   Return the known1-only direct helper bound to x, if any.
    (define (known1-only-binding-of x)
      (env-ref (current-known1-only-env) x))

    ;; known0-only-binding-of : variable? -> (or/c any/c #f)
    ;;   Return the known0-only direct helper bound to x, if any.
    (define (known0-only-binding-of x)
      (env-ref (current-known0-only-env) x))

    ;; current-direct-env : (parameter/c free-id-table?)
    ;;   Direct-callable local lambdas in lexical scope.
    (define current-direct-env
      (make-parameter (env-empty)))

    ;; current-known0-env : (parameter/c free-id-table?)
    ;;   Known env0 helpers introduced by non-recursive local bindings.
    (define current-known0-env
      (make-parameter (env-empty)))

    ;; current-known0-only-env : (parameter/c free-id-table?)
    ;;   Known0-only helpers introduced by non-recursive local bindings.
    (define current-known0-only-env
      (make-parameter (env-empty)))

    ;; current-known0-only-candidates : (parameter/c (listof any/c))
    ;;   Abstractions currently selected for the known0-only lowering class.
    (define current-known0-only-candidates
      (make-parameter '()))

    ;; current-known1-env : (parameter/c free-id-table?)
    ;;   Known env1 helpers introduced by non-recursive local bindings.
    (define current-known1-env
      (make-parameter (env-empty)))

    ;; current-known1-only-env : (parameter/c free-id-table?)
    ;;   Known1-only helpers introduced by non-recursive local bindings.
    (define current-known1-only-env
      (make-parameter (env-empty)))

    ;; current-known1-only-candidates : (parameter/c (listof any/c))
    ;;   Abstractions currently selected for the known1-only lowering class.
    (define current-known1-only-candidates
      (make-parameter '()))

    ;; candidate-abstraction-label-member? : any/c (listof any/c) -> boolean?
    ;;   Check whether ab has the same lifted label as one of cands.
    (define (candidate-abstraction-label-member? ab cands)
      (define l (syntax-e (variable-id (label-of ab))))
      (for/or ([cand (in-list cands)])
        (equal? l (syntax-e (variable-id (label-of cand))))))


    ;; current-direct-abstraction : (parameter/c (or/c any/c #f))
    ;;   The direct helper currently being closure-converted, if any.
    (define current-direct-abstraction
      (make-parameter #f))

    ;; current-abstraction : (parameter/c (or/c any/c #f))
    ;;   The abstraction currently being closure-converted, if any.
    (define current-abstraction
      (make-parameter #f))

    ;; current-direct-case-abstraction : (parameter/c (or/c any/c #f))
    ;;   The direct case-lambda currently being closure-converted, if any.
    (define current-direct-case-abstraction
      (make-parameter #f))

    ;; known1-env-variable-of : any/c -> (or/c variable? #f)
    ;;   Return the caller-relative unary env operand for ab when it is
    ;;   obviously available in the current caller context.
    ;;
    ;; For now, keep this conservative: non-lifted callers may source the
    ;; env operand directly, and lifted direct callers may do so only when
    ;; they already provide that same variable in their current layout or
    ;; formals.
    (define (known1-env-variable-of ab)
      (define env-var (car (extended-layout-of ab)))
      (cond
        [(current-direct-abstraction)
         (and (abstraction-provides-variable? (current-direct-abstraction) env-var)
              env-var)]
        [(current-direct-case-abstraction)
         (and (abstraction-provides-variable? (current-direct-case-abstraction) env-var)
              env-var)]
        [(current-abstraction)
         #f]
        [else env-var])))
  (TopLevelForm    : TopLevelForm    (T) -> TopLevelForm      ())
  (ModuleLevelForm : ModuleLevelForm (M) -> ModuleLevelForm   ())
  (CExpr : CExpr (CE) -> CExpr ()
    [,ae
     (AExpr ae)]
    [(set! ,s ,x ,ae)
     `(set! ,s ,x ,(AExpr ae))]
    [(if ,s ,ae0 ,e1 ,e2)
     `(if ,s ,(AExpr ae0) ,(Expr e1) ,(Expr e2))]
    [(wcm ,s ,ae0 ,ae1 ,e)
     `(wcm ,s ,(AExpr ae0) ,(AExpr ae1) ,(Expr e))]
    [(app ,s ,x ,ae1 ...)
     (guard (direct-binding-of x))
     (define target (direct-binding-of x))
     (define ae0 (AExpr x))
     (define ae* (map AExpr ae1))
     (cond
       [(and (nanopass-case (LANF CaseAbstraction) target
               [(case-lambda ,s ,ab* ...)
                (unique-case-arm-match target (length ae1))]
               [else #f]))
        => (λ (match)
             (match-define (list ab i ar) match)
             `(casearmapp ,s ,(label-of ab) ,ar ,i ,ae0 ,ae* ...))]
       [(nanopass-case (LANF CaseAbstraction) target
          [(case-lambda ,s ,ab* ...) #t]
          [else #f])
       `(app ,s ,ae0 ,ae* ...)]
       [else
        (define ab target)
        (define ar (source-formals->arity (abstraction-formals ab)))
        (cond
          [(known0-only-binding-of x)
           `(known0app ,s ,(label-of ab) ,ar ,ae* ...)]
          [(known1-only-binding-of x)
           (define env-var (known1-env-variable-of ab))
           (unless env-var
             (error 'finish-closure-conversion
                    "known1-only env unavailable in current caller context: ~a"
                    (syntax-e (variable-id x))))
           (define env0 (AExpr env-var))
           `(known1app ,s ,(label-of ab) ,ar ,env0 ,ae* ...)]
          [(known0-binding-of x)
           `(known0app ,s ,(label-of ab) ,ar ,ae* ...)]
          [(known1-binding-of x)
           (match (known1-env-variable-of ab)
             [#f `(directapp ,s ,(label-of ab) ,ar ,ae0 ,ae* ...)]
             [env-var
              (define env0 (AExpr env-var))
              `(known1app ,s ,(label-of ab) ,ar ,env0 ,ae* ...)])]
          [(eq? ab (current-direct-abstraction))
           `(selfapp ,s ,(label-of ab) ,ar ,ae* ...)]
          [(direct-target-uses-dummy-closure/local? ab)
           `(direct0app ,s ,(label-of ab) ,ar ,ae* ...)]
          [else
           `(directapp ,s ,(label-of ab) ,ar ,ae0 ,ae* ...)])])]
    [(app ,s ,ae ,ae1 ...)
     (define ae* (map AExpr ae1))
     `(app ,s ,(AExpr ae) ,ae* ...)]
    [(primapp ,s ,pr ,ae1 ...)
     (define ae* (map AExpr ae1))
     `(primapp ,s ,pr ,ae* ...)]
    [(closedapp ,s ,ab ,ae1 ...)
     (define ae* (map AExpr ae1))
     `(closedapp ,s ,(Abstraction ab) ,ae* ...)]
    [(begin ,s ,e0 ,e1 ...)
     (match (map Expr (cons e0 e1))
       [(list e0* e1* ...)
        `(begin ,s ,e0* ,e1* ...)])]
    [(begin0 ,s ,e0 ,e1 ...)
     (match (map Expr (cons e0 e1))
       [(list e0* e1* ...)
        `(begin0 ,s ,e0* ,e1* ...)])])
  (Expr : Expr (E) -> Expr ()
    [,ce
     (CExpr ce)]
    [(let-values ,s (((,x ...) ,ce*) ...) ,e)
     (define pairs (reverse (clause-direct-bindings x ce*)))
     (define xs    (map car pairs))
     (define abs   (map cdr pairs))
     (define migrated-body-layout-pairs
       (for/list ([pair (in-list pairs)]
                  #:when (migrated-body-layout-target-eligible/raw? (cdr pair)))
         pair))
     (define migrated-body-layout-abs (map cdr migrated-body-layout-pairs))
     (define known0-only-pairs
       (parameterize ([current-migrated-body-layout-candidates
                       migrated-body-layout-abs])
         (for/list ([pair (in-list pairs)]
                    #:when (known0-only-target-eligible/local? (cdr pair)))
           pair)))
     (define known0-only-xs  (map car known0-only-pairs))
     (define known0-only-abs (map cdr known0-only-pairs))
     (define known0-pairs
       (parameterize ([current-migrated-body-layout-candidates
                       migrated-body-layout-abs])
         (for/list ([pair (in-list pairs)]
                    #:when (known0-target-eligible/local? (cdr pair)))
           pair)))
     (define known0-xs  (map car known0-pairs))
     (define known0-abs (map cdr known0-pairs))
     (define known1-pairs
       (parameterize ([current-migrated-body-layout-candidates
                       migrated-body-layout-abs])
         (for/list ([pair (in-list pairs)]
                    #:when (known1-target-eligible/local? (cdr pair)))
           pair)))
     (define known1-xs  (map car known1-pairs))
     (define known1-abs (map cdr known1-pairs))
     (define known1-only-pairs
       (parameterize ([current-migrated-body-layout-candidates
                       migrated-body-layout-abs])
         (for/list ([pair (in-list pairs)]
                    #:when (known1-only-target-eligible/local? (cdr pair)))
           pair)))
     (define known1-only-xs  (map car known1-only-pairs))
     (define known1-only-abs (map cdr known1-only-pairs))
     (define (known0-only-clause? xs ce)
       (match (clause-direct-binding xs ce)
         [(cons x ab)
          (and (known0-only-target-eligible/local? ab)
               (for/or ([y (in-list known0-only-xs)])
                 (id=? x y)))]
         [_ #f]))
     (define (known1-only-clause? xs ce)
       (match (clause-direct-binding xs ce)
         [(cons x ab)
          (and (known1-only-target-eligible/local? ab)
               (for/or ([y (in-list known1-only-xs)])
                 (id=? x y)))]
         [_ #f]))
     (define ce**
       (parameterize ([current-migrated-body-layout-candidates migrated-body-layout-abs]
                      [current-known0-only-candidates known0-only-abs]
                      [current-known1-only-candidates known1-only-abs])
         (for/list ([xs (in-list x)]
                    [ce (in-list ce*)])
           (cond
             [(known0-only-clause? xs ce)
              (begin
                (match (clause-direct-binding xs ce)
                  [(cons _ ab) (Abstraction ab)]
                  [_ (void)])
                (with-output-language (LANF+closure CExpr)
                  `(quote ,#'h ,(datum #f (void)))))]
             [(known1-only-clause? xs ce)
              (begin
                (match (clause-direct-binding xs ce)
                  [(cons _ ab) (Abstraction ab)]
                  [_ (void)])
                (with-output-language (LANF+closure CExpr)
                  `(quote ,#'h ,(datum #f (void)))))]
             [else
              (CExpr ce)]))))
     `(let-values ,s
        ([(,x ...) ,ce**] ...)
        ,(parameterize ([current-direct-env
                         (env-bind* (current-direct-env) xs abs)]
                        [current-migrated-body-layout-candidates
                         migrated-body-layout-abs]
                        [current-known0-only-env
                         (env-bind* (current-known0-only-env)
                                    known0-only-xs
                                    known0-only-abs)]
                        [current-known1-only-env
                         (env-bind* (current-known1-only-env)
                                    known1-only-xs
                                    known1-only-abs)]
                        [current-known0-env
                         (env-bind* (current-known0-env) known0-xs known0-abs)]
                        [current-known1-env
                         (env-bind* (current-known1-env) known1-xs known1-abs)])
           (Expr e)))]
    [(letrec-values ,s (((,x ...) ,ce*) ...) ,e)
     (define pairs (reverse (clause-direct-bindings x ce*)))
     (define xs    (map car pairs))
     (define abs   (map cdr pairs))
     (parameterize ([current-direct-env
                     (env-bind* (current-direct-env) xs abs)])
       (define ce**  (map CExpr ce*))
       `(letrec-values ,s
          ([(,x ...) ,ce**] ...)
          ,(Expr e)))])
  (Abstraction     : Abstraction    (AB) -> ClosureAllocation ()
    [(λ ,s ,[f] ,e)
     (define l  (label-of AB))
     (define k  (kind-of AB))
     (when (direct-letrec-representation-eligible/local? AB)
       (hash-set! (current-direct-letrec-representation-labels)
                  (syntax-e (variable-id l))
                  #t))
     (when (known0-target-eligible/local? AB)
       (hash-set! (current-known0-direct-labels)
                  (syntax-e (variable-id l))
                  #t))
     (when (and (known0-only-target-eligible/local? AB)
                (candidate-abstraction-label-member? AB
                                                    (current-known0-only-candidates)))
       (hash-set! (current-known0-only-labels)
                  (syntax-e (variable-id l))
                  #t))
     (when (known1-target-eligible/local? AB)
       (hash-set! (current-known1-direct-labels)
                  (syntax-e (variable-id l))
                  #t)
       (define env-var (car (extended-layout-of AB)))
       (hash-set! (current-known1-wrapper-env-indices)
                  (syntax-e (variable-id l))
                  (index-of env-var (closure-env-of AB))))
     (when (and (known1-only-target-eligible/local? AB)
                (candidate-abstraction-label-member? AB
                                                    (current-known1-only-candidates)))
       (hash-set! (current-known1-only-labels)
                  (syntax-e (variable-id l))
                  #t))
     (define inline-small-arity
       (inline-small-closure-arity/local AB))
     (when inline-small-arity
       (hash-set! (current-inline-small-closure-arities)
                  (syntax-e (variable-id l))
                  inline-small-arity))
     (let ([xs (closure-env-aexprs-of AB)]
            [e  (parameterize ([current-free (body-layout-of AB)]
                              [current-abstraction AB]
                              [current-direct-abstraction
                               (and (eq? k 'direct) AB)]
                              [current-direct-env
                               (env-shadow* (current-direct-env)
                                            (formals->variables (abstraction-formals AB)))])
                 (Expr e))])
       (lift! s l f e)
       (define name (inferred-name s))
       `(closure ,h ,k ,name ,l ,(formals->arity f) ,xs ...))])
  (CaseAbstraction : CaseAbstraction (CAB) -> CaseClosureAllocation ()
    [(case-lambda ,s ,ab ...)
     (define (formals->arity f)
       ; +n means precisely n
       ;  0 means precisely  0
       ; -1 means at least 0
       ; -2 means at least 1
       ; -n means at least n-1
       (nanopass-case (LANF Formals) f
         [(formals (,x ...))            (length x)]
         [(formals (,x0 ,x1 ... . ,xd)) (- (+ 2 (length x1)))]
         [(formals ,x)                  -1]))     
     (define (abstraction->formals ab)
       (nanopass-case (LANF Abstraction) ab [(λ ,s ,f ,e) f]))
     (define l  (label-of CAB))
     (let* ([fs*  (map abstraction-formals ab)]
            [ar   (map formals->arity fs*)]
            [ab   (parameterize ([current-direct-case-abstraction
                                  (and (eq? (kind-of CAB) 'direct) CAB)])
                    (map Abstraction ab))]           
            [E    (with-output-language (LANF+closure AExpr)
                    `(quote ,#'h ,(datum #'42 42)))]) ; TODO TODO 
       #;(case-lift! l fs* E)  ; TODO <---- is uncommenting this correct?
       (define name (inferred-name s))
       `(case-closure ,h ,name ,l [,ar ,ab] ...))])
  (AExpr : AExpr (AE) -> AExpr ()
    [,x ; note: x is kept for debugging purposes
     (define xs (current-free))  ; set by the enclosing abstraction
     (match (index-of x xs)
       [#f x] ; refers to argument
       [i `(free-ref ,x ,(index-of x xs))])])
  (begin
    (parameterize ([current-closure-conversion-progress-start-ms
                    (current-inexact-milliseconds)])
      (report-closure-conversion-progress!
       'start
       #f
       (list (cons 'free (hash-count free-ht))
             (cons 'kind (hash-count kind-ht))
             (cons 'labels (hash-count labels-ht))))
      (define T^ (TopLevelForm T))
      (report-closure-conversion-progress!
       'done
       lift-count
       (list (cons 'lifted (hash-count lifted-abstractions))))
      (with-output-language (LANF+closure TopLevelForm)
        ; the lifted (converted) abstractions are added to the top-level
        (define dl (for/list ([(l cab) lifted-abstractions])
                     `(define-label ,l ,cab)))
        `(topbegin ,h ,dl ... ,T^)))))



(define-pass flatten-begin : LANF+closure (T) ->  LANF+closure ()
  (definitions)

  (ModuleLevelForm  : ModuleLevelForm     (M) -> ModuleLevelForm ())
  (GeneralLevelForm : GeneralTopLevelForm (G) -> GeneralTopLevelForm ())
  (AExpr : AExpr (AE) -> AExpr ())
  (Expr  :  Expr (E)  ->  Expr ())

  (TopLevelForm     : TopLevelForm        (T) -> TopLevelForm ()
    [(topbegin ,s ,t0 ...)
     (let ()
       (define (topbegin? t)
         (nanopass-case (LANF+closure TopLevelForm) t
           [(topbegin ,s ,t0 ...) #t]
           [else                  #f]))

       (let loop ([ts t0])
         ; we loop until there are no `topbegin`s left
         (cond
           [(memf topbegin? ts)
            ; for each t we return a list of `TopLevelForm`.
            (define tss
              (for/list ([t ts])
                (nanopass-case (LANF+closure TopLevelForm) t
                  [(topbegin ,s ,t0  ...) t0]
                  [else                   (list t)])))
           (loop (append* tss))]
           [else
            `(topbegin ,s ,(map TopLevelForm ts) ...)])))])


  (CExpr : CExpr (CE) -> CExpr ()
    [(begin ,s ,e0 ,e1 ...)
     (let ()
       (define (begin? ce)
         (nanopass-case (LANF+closure CExpr) ce
           [(begin ,s ,e0 ,e1 ...) #t]
           [else                   #f]))
     
       (let loop ([es (cons e0 e1)])
         ; we loop until there are no `begin`s left
         (cond
           [(memf begin? es)
            ; for each e we return a list of `CExpr`.
            (define ess
              (for/list ([e es])
                (nanopass-case (LANF+closure CExpr) e
                  [(begin ,s ,e0  ,e1 ...) (cons e0 e1)]
                  [else                    (list e)])))
            (loop (append* ess))]
           [else
            (if (null? (cdr es))
                (car es)
                `(begin ,s
                        ,(Expr (car es))
                        ,(map Expr (cdr es)) ...))])))]))


;;;
;;; SIMPLIFY FORMALS 
;;;

; expr     ::=  ... | (#%plain-lambda formals body ...+) | ...

; formals  ::=   (id ...)            ; fixed number of arguments
;              | (id ...+ . id)      ; fixed, followed by rest argument
;              | id                  ; arguments passed as list

; Note: Since the input to this compiler is "fully expanded",
;       we don't need to handle optional arguments (the expander
;       rewrites them to `case-lambda` or keyword arguments
;       (also rewritten by the expander).

; In WebAssembly there is only one type of function namely the first.
; Let's rewrite (id ...+ . id) to (id ...+ id).
; Example    f == (λ (x y . z) ...)
;    becomes      (λ (x y z)   ...).
;    A call like  (f 1 2 3 4)
;    becomes      (f 1 2 (cons 3 (cons 4 '()))).
; For known procedures we can do this rewrite.
; For a call to an unknow procedure, the invoker needs to do the rewrite.

; For the last case, where arguments are passed as list, we will do this
; rewrite:   f == (λ x ...)
;    becomes      (λ (x) ...).
;    A call like  (f 1 2 3)
;    becomes      (f (cons 1 (cons 2 (cons 3 '())))).

;; (Formals (f)
;;   (formals (x ...))            => (x ...)
;;   (formals (x0 x1 ... . xd))   => (x0 x1 ... . xd)
;;   (formals x)                  => x)




;;;
;;; CATEGORIZE VARIABLES 
;;;

; The goal of this pass is to categorize variables according to the
; variable type: top-level, module-level, local.

; This pass is local to the pass `generate-code`.

(define-pass classify-variables : LANF+closure (T) -> * ()
  ;; Assumption: α-conversion has been done
  (definitions
    (define (TopLevelForm*         Ts)  (for-each TopLevelForm         Ts))
    (define (ModuleLevelForm*      Ms)  (for-each ModuleLevelForm      Ms))
    (define (Expr*                 Es)  (for-each Expr                 Es))
    (define (CExpr*                CEs) (for-each CExpr                CEs))
    (define (AExpr*                AEs) (for-each AExpr                AEs))
    (define (ConvertedAbstraction* ABs) (for-each ConvertedAbstraction ABs))
    (define (ClosureAllocation*    CAs) (for-each ClosureAllocation    CAs))
    (define (RawProvideSpec*      RPSs) (for-each RawProvideSpec      RPSs))

    (define top
      (top-level-global-interface-variables
       (current-imported-top-level-globals))) ; top (outside modules)
    (define mod '()) ; modules
    (define loc '()) ; locals  (argument or let/letrec bound
    (define lab '()) ; label
    (define (top! x)   (set! top (cons x top)))
    (define (mod! x)   (set! mod (cons x mod)))
    (define (loc! x)   (set! loc (cons x loc)))
    (define (lab! x)   (set! lab (cons x lab)))
    (define (top!* xs) (for-each top! xs))
    (define (mod!* xs) (for-each mod! xs))
    (define (loc!* xs) (for-each loc! xs))
    (define (lab!* xs) (for-each lab! xs))

    ; variable x is provided from module with name mn
    (define provides '())
    (define (provide! mn x-from x-to)
      ; x-from : original name
      ; x-to   : name after alpha-renaming
      (set! provides (cons (list mn x-from x-to) provides)))
    
    (define prov! (make-parameter #f))    ; begin at top-level
    (define add!  (make-parameter top!*)))
    
  (TopLevelForm : TopLevelForm (T) -> * ()
    [(define-label ,l ,cab)         (lab! l) (ConvertedAbstraction cab)]
    [(topbegin ,s ,t ...)           (TopLevelForm* t)]
    [(#%expression ,s ,e)           (Expr e)]
    [(topmodule ,s ,mn ,mp ,mf ...) (parameterize ([add!  mod!*]
                                                   [prov! (λ (x0 x1) (provide! mn x0 x1))])
                                      (ModuleLevelForm* mf))]
    [,g                             (GeneralTopLevelForm g)])
  (ModuleLevelForm : ModuleLevelForm (M) -> * ()
    [(#%provide ,rps ...)           (RawProvideSpec* rps)] ; todo : collect provided vars
    [(define-label ,l ,cab)         (lab! l) (ConvertedAbstraction cab)]
    [,g                             (GeneralTopLevelForm g)])
  (GeneralTopLevelForm : GeneralTopLevelForm (G) -> * ()
    [,e                                 (Expr e)]
    [(define-values   ,s (,x ...) ,e)   ((add!) x) (Expr e)]
    [(define-syntaxes ,s (,x ...) ,e)   ((add!) x) (Expr e)]
    [(#%require       ,s ,rrs ...)      empty-set])
  (ConvertedAbstraction : ConvertedAbstraction (CAB) -> * ()
    [(λ ,s ,ar ,f ,e)                   (parameterize ([add! loc!*])
                                          (Formals f)
                                          (Expr e))])
  (Formals : Formals (F) -> * ()
    [(formals (,x ...))            ((add!) x)]
    [(formals (,x0 ,x1 ... . ,xd)) ((add!) (cons x0 (cons xd x1)))]
    [(formals ,x)                  ((add!) (list x))])

  (AExpr : AExpr (AE) -> * ()
    [,x                      #f]
    [,cca                    (CaseClosureAllocation cca)]
    [,ca                     (ClosureAllocation ca)]
    [(quote ,s ,d)           #f]
    [(quote-syntax ,s ,d)    #f]
    ; Note: Top-level variables are stored in a namespace.
    ;       In this pass we are only looking for variables that
    ;       need to be stored in closures.
    [(top ,s ,x)                  #f]
    [(variable-reference ,s ,vrx) #f]
    [(free-ref ,x ,i)             #f])

  (CExpr : CExpr (CE) -> * ()
    [,ae                           (AExpr ae)]
    [(set! ,s ,x ,ae)              (AExpr ae)]
    [(if  ,s ,ae0 ,e1  ,e2)        (AExpr ae0) (Expr e1)   (Expr e2)]
    [(wcm ,s ,ae0 ,ae1 ,e)         (AExpr ae0) (AExpr ae1) (Expr e)]
    [(app ,s ,ae  ,ae1 ...)        (AExpr* (cons ae ae1))]
    [(directapp ,s ,l ,ar ,ae0 ,ae1 ...)  (AExpr* (cons ae0 ae1))]
    [(known0app ,s ,l ,ar ,ae1 ...)       (AExpr* ae1)]
    [(known1app ,s ,l ,ar ,ae0 ,ae1 ...)  (AExpr* (cons ae0 ae1))]
    [(direct0app ,s ,l ,ar ,ae1 ...)      (AExpr* ae1)]
    [(selfapp ,s ,l ,ar ,ae1 ...)         (AExpr* ae1)]
    [(casearmapp ,s ,l ,ar ,i ,ae0 ,ae1 ...) (AExpr* (cons ae0 ae1))]
    [(primapp   ,s ,pr ,ae1 ...)   (AExpr* ae1)]
    [(closedapp ,s ,ca ,ae1 ...)   (ClosureAllocation ca) (AExpr* ae1)]
    [(begin     ,s ,e0 ,e1 ...)    (Expr* (cons e0 e1))]
    [(begin0    ,s ,e0 ,e1 ...)    (Expr* (cons e0 e1))])

  (Expr : Expr (E) -> * ()
     [(let-values    ,s ([(,x ...) ,ce] ...) ,e) (for-each loc!* x) (CExpr* ce) (Expr e)]
     [(letrec-values ,s ([(,x ...) ,ce] ...) ,e) (for-each loc!* x) (CExpr* ce) (Expr e)]
     [,ce (CExpr ce)])

  (ClosureAllocation : ClosureAllocation (CA) -> * ()
    [(closure ,s ,k ,in ,l ,ar ,ae ...) (AExpr* ae)])

  (CaseClosureAllocation : CaseClosureAllocation (CCA) -> * ()
    [(case-closure ,s ,in ,l [,ar ,ca] ...) (ClosureAllocation* ca)])

  (RawProvideSpec : RawProvideSpec (RPS) -> * ()
    [,ps (PhaselessSpec ps)])

  (PhaselessSpec : PhaselessSpec (PS) -> * ()
    [,sls (SpacelessSpec sls)])

  (SpacelessSpec : SpacelessSpec (SS) -> * ()
    [[,x0 ,x1]  ((prov!) x0 x1)])


  ; Fill in `top`, `mod` and `loc`
  (parameterize ([add! top!*])
    (TopLevelForm T))
  ; Convert to set
  (define sets (map (λ (xs) (apply make-id-set xs))
                    (list top mod loc)))
  
  (define (group-provides)
    (define grouped (group-by first (reverse provides)))
    (define (same-module-name? x y) (eq? (car x) (car y)))
    (define slices (slice-by same-module-name? grouped))
    (for/list ([slice slices])
       (define mod-name (first (first (car slice))))
       (cons mod-name (map rest (car slice)))))

  ; Output:
  ;   (list
  ;      (cons module-name0  (list from-name alpha-renamed-name) ...)
  ;      (cons module-name1  (list from-name alpha-renamed-name) ...)
  ;      ...)
  
  ; (displayln sets)
  (values (first  sets)
          (second sets)
          (third  sets)
          (group-provides)))

;;;
;;; Representation of immediates
;;;

;; Racket being a dynamic language, we will use a uniform representation for all
;; values. On platforms like x86 and arm64 most often tagged pointers are used 
;; for a uniform representation. On Web Assembly we do not have pointers.
;; Instead we have references. Heap allocated objects (arrays, structs) are
;; referred to by reference. In order to use references to represent other
;; immediates such as fixnums, booleans, null, etc. we will use `i31` which
;; denotes unboxed scalars.
;;
;; The specifications says:
;;   > The abstract type `i31` denotes unboxed scalars, that is, integers
;;   > injected into references. Their observable value range is limited to 31 bits.
;;
;;   > An `i31` is not actually allocated in the store, but represented in a way
;;   > that allows them to be mixed with actual references into the store
;;   > without ambiguity. Engines need to perform some form of pointer
;;   > tagging to achieve this, which is why 1 bit is reserved.
;;
;; That is, an `i31` is in effect a "tagged pointer" with a 1-bit tag.
;; Like `struct` and `array` we have that `i31` also is a heaptype.
;; We can therefore use `(ref eq)` for our uniform representation.
;;
;; We will use the lower bits of an `i31` as tags, so we can have other
;; immediates besides fixnums. We have 31 bits to work with.

;; Data Representation
;;   Fixnums:   Lower 1 bits are 0. Upper bits are an 30-bit integer.
;;   Immediate: Lower 1 bits are 1. Upper 30 bits contain data and a subtag.

;; Immediate Values (non-fixnum)
;;   Characters: Lower 8 bits are  cc...cc 0000 1111. The 21 bits marked c are a unicode scalar value.
;;   Booleans:   Lower 7 bits are          b001 1111. Bit b is 1 for true and 0 for false.
;;   Void:       Lower 8 bits are          0010 1111. Upper bits are zero.
;;   Empty:      Lower 8 bits are          0011 1111. Upper bits are zero.
;;   Undefined:  Lower 8 bits are          0100 1111. Upper bits are zero.
;;   Unsafe und: Lower 8 bits are        1 0100 1111. Upper bits are zero.
;;   Eof:        Lower 8 bits are          0101 1111. Upper bits are zero.
;;   Missing [*] All bits are 1.   1 ...   1111 1111. 

;; Note: We do not have tags for pairs, vectors, etc. since they need to heap allocated.
;; The missing value is not a Racket value. It is an immediate used to indicate
;; "not found" in hash tables. It needs to distinct from all valid Racket values.
;; [The missing immediates was introduced to avoid the null type in WebAssembly.]

; this information was also needed by "runtime-wasm.rkt" and "wasm-utils.rkt"
(require "private/immediates.rkt")

;;;
;;; CODE GENERATOR
;;;

;;; This code generator is inspired by "Destination-driven Code Generation"
;;; by Dybvig, Hieb and Butler. There are som differences however. The code
;;; generator in the paper generates "flat" code (assembler) whereas we
;;; generate nested Web Assembly instructions.

;;; The code generator for an expression takes a data destination (dd) and a control destionation (cd)
;;; as arguments. The data destination determines where the value of the expression is to be placed.
;;;
;;;    dd in Data Destination  is  #f or a location (identifier),
;;;
;;; here #f means the expression is evaluated for its effect.

;;; If the data destination is #f (an effect) the value of the expression does not need to be stored.
;;; The control destination
;;;
;;;    cd in ControlDestination  is  label  or  label x label
;;;
;;; If the label is #f (return) it means that the value is to be returned from the function.
;;; If two labels are given, then there are two branches according to the expression value.

; Data destinations (also an identifier)
(define <effect> '<effect>)
(define <value>  '<value>)
; Control destinations
(define <return> '<return>)  
(define <expr>   '<expr>)    
(define <stat>   '<stat>)    ; a statement (i.e. no value result)
; identifier used to hold tail call flag
(define _tc      #'_tc) ; not used


;; A few helpers for generating WebAssembly is placed in:
(require "private/wasm-utils.rkt")
;; Helpers like $, $$, prim:, Imm, Var, etc.

; The helpers allow us to follow these conventions:

; Convention:
;   1. WebAssembly requires all identifiers to begin with $.
;   2. We prefix all program identifiers with $$.
;   3. The compiler is free to control all identifiers that begin with a single $.

; a symbol `name` turns into "$string:name"
(define string-constants '())  ; (list (list name string) ...)
(define (add-string-constant name string)
  (set! string-constants (cons (list name string) string-constants)))
(define (reset-string-constants)  ; called in parse
  (set! string-constants '()))

; a bytestring with the name `name` turns into "$bytes:name"
(define bytes-constants '())  ; (list (list name bytes) ...)
(define (add-bytes-constant name bytes)
  (set! bytes-constants (cons (list name bytes) bytes-constants)))
(define (reset-bytes-constants)  ; called in parse
  (set! bytes-constants '()))

(define symbol-constants '())  ; (list (list name symbol) ...)
(define (add-symbol-constant name symbol)
  (set! symbol-constants (cons (list name symbol) symbol-constants)))
(define (reset-symbol-constants)  ; called in parse
  (set! symbol-constants '()))

(define (reset-runtime-constants)
  (reset-string-constants)
  (reset-bytes-constants)
  (reset-symbol-constants))

(define (console-bridge-symbol-constant-name sym)
  (string->symbol (~a "wr-top-level/" (symbol->string sym))))

(define current-label-map (make-parameter '()))
(define current-label-form-ht (make-parameter (make-hash)))
(define current-label-map-include-form? (make-parameter #f))
(define current-label-map-default-include-form? (make-parameter #f))
(define current-label-map-form-labels (make-parameter #f))
(define current-direct-letrec-representation-labels (make-parameter (make-hasheq)))
(define current-inline-small-closure-arities (make-parameter (make-hasheq)))
(define current-known0-direct-labels (make-parameter (make-hasheq)))
(define current-known0-only-labels (make-parameter (make-hasheq)))
(define current-known1-direct-labels (make-parameter (make-hasheq)))
(define current-known1-only-labels (make-parameter (make-hasheq)))
(define current-known1-wrapper-env-indices (make-parameter (make-hasheq)))
(define current-runtime-preferred-selfapp-bypasses (make-parameter (make-hasheq)))
(define (reset-label-map!)
  (current-label-map '())
  (current-label-form-ht (make-hash))
  (current-runtime-preferred-selfapp-bypasses (make-hasheq))
  (current-label-map-include-form? (current-label-map-default-include-form?)))

(define (label-map-include-form? v)
  (current-label-map-default-include-form? (and v #t))
  (current-label-map-include-form? (and v #t)))

(define (label-map-form-labels labels)
  (current-label-map-form-labels
   (and labels
        (for/set ([label (in-list labels)])
          (cond
            [(symbol? label) (symbol->string label)]
            [else           (~a label)])))))

(define (source-stx s)
  (if (and (syntax? s) (syntax-property s 'source-stx))
      (syntax-property s 'source-stx)
      s))

(define (label-map-source->datum src)
  (cond
    [(path? src) (path->string src)]
    [else        src]))

;; datum-mentions-symbol? : any/c symbol? -> boolean?
;;   Check whether a recorded source form mentions a symbol anywhere.
(define (datum-mentions-symbol? v sym)
  (cond
    [(eq? v sym) #t]
    [(pair? v)   (or (datum-mentions-symbol? (car v) sym)
                     (datum-mentions-symbol? (cdr v) sym))]
    [(vector? v) (for/or ([x (in-vector v)])
                   (datum-mentions-symbol? x sym))]
    [(box? v)    (datum-mentions-symbol? (unbox v) sym)]
    [else        #f]))

;; runtime-preferred-alias-mentions : any/c -> (listof symbol?)
;;   Report runtime-preferred primitive names mentioned by a source form.
(define (runtime-preferred-alias-mentions datum)
  (for/list ([sym (in-list runtime-preferred-primitive-aliases)]
             #:when (datum-mentions-symbol? datum sym))
    sym))

;; runtime-preferred-callee-symbol : any/c -> (or/c symbol? #f)
;;   Extract a runtime-preferred primitive name from common callee shapes.
(define (runtime-preferred-callee-symbol v)
  (define sym
    (match v
      [(? symbol? s) s]
      [`(#%top . ,s) #:when (symbol? s) s]
      [`(top ,_ ,s)  #:when (symbol? s) s]
      [_ #f]))
  (and sym
       (set-member? runtime-preferred-primitive-aliases-set sym)
       sym))

;; runtime-preferred-wrapper-target : any/c -> (or/c symbol? #f)
;;   Detect tiny provider wrappers that validate arguments and tail-call a
;;   runtime-preferred primitive. This avoids brittle label-number checks.
(define (runtime-preferred-wrapper-target datum)
  (match datum
    [`(lambda (,a ,b) ,body ... ,tail)
     #:when (and (symbol? a) (symbol? b))
     (match tail
       [`(#%plain-app ,callee ,_args ...)
        (runtime-preferred-callee-symbol callee)]
       [_ #f])]
    [_ #f]))

;; runtime-preferred-wrapper-target/stx : syntax? -> (or/c symbol? #f)
;;   Cheap syntax-level version of runtime-preferred-wrapper-target.
(define (runtime-preferred-wrapper-target/stx stx)
  (define e (syntax-e stx))
  (and (list? e)
       (>= (length e) 3)
       (identifier? (car e))
       (eq? (syntax-e (car e)) 'lambda)
       (let ([formals-e (syntax-e (cadr e))]
             [tail-e    (syntax-e (last e))])
         (and (list? formals-e)
              (= (length formals-e) 2)
              (andmap identifier? formals-e)
              (list? tail-e)
              (>= (length tail-e) 2)
              (identifier? (car tail-e))
              (eq? (syntax-e (car tail-e)) '#%plain-app)
              (let ([callee (cadr tail-e)])
                (and (identifier? callee)
                     (runtime-preferred-callee-symbol
                      (syntax-e callee))))))))

(define (record-label-map! l stx)
  (define id (unparse-variable l))
  (define id-str (format "~a" id))
  (define s (source-stx stx))
  (define source-datum
    (and (or (current-label-map-include-form?)
             (let ([labels (current-label-map-form-labels)])
               (and labels (set-member? labels id-str))))
         (syntax? s)
         (syntax->datum s)))
  (define src (and (syntax? s) (label-map-source->datum (syntax-source s))))
  (define line (and (syntax? s) (syntax-line s)))
  (define col (and (syntax? s) (syntax-column s)))
  (define span (and (syntax? s) (syntax-span s)))
  (define form-str
    (and (or (current-label-map-include-form?)
             (let ([labels (current-label-map-form-labels)])
               (and labels (set-member? labels id-str))))
         source-datum
         (format "~s" source-datum)))
  (define alias-mentions
    (if (and form-str source-datum)
        (runtime-preferred-alias-mentions source-datum)
        '()))
  (define alias-entry
    (if (null? alias-mentions)
        '()
        `((runtime-preferred-primitive-aliases ,@alias-mentions))))
  (define wrapper-target
    (and (syntax? s)
         (runtime-preferred-wrapper-target/stx s)))
  (when wrapper-target
    (hash-set! (current-runtime-preferred-selfapp-bypasses)
               (syntax-e (variable-id l))
               wrapper-target))
  (define entry
    (let ([base `(label ,id-str
                        (src ,(or src 'unknown)
                             ,(or line 0)
                             ,(or col 0)
                             ,(or span 0))
                        ,@alias-entry)])
      (cond
        [(not form-str) base]
        [else
         (let* ([key (list src line col span form-str)]
                [seen (hash-ref (current-label-form-ht) key #f)])
           (if seen
               `(label ,id-str
                       (src ,(or src 'unknown)
                            ,(or line 0)
                            ,(or col 0)
                            ,(or span 0))
                       ,@alias-entry
                       (same-as ,seen))
               (begin
                 (hash-set! (current-label-form-ht) key id-str)
                 `(label ,id-str
                         (src ,(or src 'unknown)
                              ,(or line 0)
                              ,(or col 0)
                              ,(or span 0))
                         ,@alias-entry
                         (form ,form-str)))))])))
  (current-label-map (cons entry (current-label-map))))

(define (label-map->sexp)
  `(wasm-label-map ,@(reverse (current-label-map))))
  

(define-pass generate-code : LANF+closure (T) -> * ()
  (definitions
    (define current-inline-small-closure-arity
      (make-parameter #f))
    (define current-known-direct-env-arity
      (make-parameter #f))
    (define (inline-small-closure-arity-label l)
      (hash-ref (current-inline-small-closure-arities)
                (syntax-e (variable-id l))
                #f))
    (define (known0-direct-label? l)
      (hash-ref (current-known0-direct-labels)
                (syntax-e (variable-id l))
                #f))
    (define (known0-only-direct-label? l)
      (hash-ref (current-known0-only-labels)
                (syntax-e (variable-id l))
                #f))
    (define (known1-direct-label? l)
      (hash-ref (current-known1-direct-labels)
                (syntax-e (variable-id l))
                #f))
    (define (known1-only-direct-label? l)
      (hash-ref (current-known1-only-labels)
                (syntax-e (variable-id l))
                #f))
    (define (known1-wrapper-env-index l)
      (hash-ref (current-known1-wrapper-env-indices)
                (syntax-e (variable-id l))
                0))
    (define (runtime-preferred-selfapp-bypass l)
      (hash-ref (current-runtime-preferred-selfapp-bypasses)
                (syntax-e (variable-id l))
                #f))
    (define (known0-code-label l)
      (string->symbol (~a (Label l) ".known0")))
    (define (known1-code-label l)
      (string->symbol (~a (Label l) ".known1")))
    (define (flatten-func-forms xs)
      (append*
       (for/list ([x (in-list xs)])
         (match x
           [(list 'func-group fs ...) fs]
           [_ (list x)]))))
    (define gen-times '())
    (define (time-gen label thunk)
      (if (current-pass-timings?)
          (let-values ([(vals ms)
                        (with-timing
                          (λ ()
                            (call-with-values thunk list)))])
            (set! gen-times (cons (list label ms) gen-times))
            (apply values vals))
          (thunk)))
    ;; 1. Classify variables
    (define-values (top-vars module-vars local-vars provides)
      (time-gen "classify-variables"
        (λ ()
          (classify-variables T))))
    ;; (displayln "-- Provides --"           (current-error-port))
    ;; (displayln provides                   (current-error-port))
    ;; (displayln "-- Top-vars --"           (current-error-port))
    ;; (displayln (sort (map syntax->datum (map variable-id (id-set->list top-vars)))
    ;;                  symbol<?)
    ;;            (current-error-port))

    (define top-names
      (for/seteq ([x (in-list (id-set->list top-vars))])
        (syntax-e (variable-id x))))
    (define (top-variable? v)
      (set-member? top-names (syntax-e (variable-id v))))   ; top-level: match by symbol name
    (define (module-variable? v) (set-in? v module-vars)) ; free-identifier=?
    (define (local-variable? v)  (set-in? v local-vars))  ; free-identifier=?
    (define (ffi-variable? v)    (set-member? ffi-primitives-set
                                              (if (symbol? v) v (syntax-e (variable-id v)))))
    #;(displayln (list 'top? (top-variable? (variable #'sxml->dom))) (current-error-port))
    
    (define (global-variable? v)
      ; a global (wasm) varible is unboxed
      (non-literal-constant? (syntax-e (variable-id v))))
    (define (top-reference-symbol-expr v)
      (define sym (syntax-e (variable-id v)))
      (define name (console-bridge-symbol-constant-name sym))
      (add-symbol-constant name sym)
      `(global.get ,(string->symbol (~a "$symbol:" name))))
    (define (CheckedTopReference v)
      (define val (emit-fresh-local 'top-val '(ref eq)))
      `(block (result (ref eq))
        (local.set ,(LocalVar val)
                   (struct.get $Boxed $v
                               (ref.cast (ref $Boxed) (global.get ,(TopVar v)))))
        (if (ref.eq (local.get ,(LocalVar val)) (global.get $undefined))
            (then
             (drop (call $raise-unbound-variable-reference ,(top-reference-symbol-expr v)))))
        (local.get ,(LocalVar val))))
    (define (classify v)
      #;(displayln (list 'clas v))
      #;(when (symbol? v) (error 'classify "got: ~a" v))
      ;; (displayln (list 'top (top-variable?    v)))
      ;; (displayln (list 'mod (module-variable? v)))
      ;; (displayln (list 'loc (and (local-variable?  v) #t)))
      ;; (displayln (list 'ffi (ffi-variable?    v)))
      ;; (displayln (list 'glo (global-variable? v)))
      (cond
        [(global-variable? v) 'global]
        [(runtime-preferred-primitive-alias? v) 'runtime-primitive]
        [(top-variable?    v) 'top]
        [(module-variable? v) 'module]
        [(local-variable?  v) 'local]
        ;; In support-provider glue, provider-owned names such as `read` can be
        ;; bare primitive imports rather than staged provider aliases. If alpha
        ;; renaming did not find a real top/module/local binding, keep the old
        ;; primitive fallback.
        [(provider-owned-runtime-primitive-alias? v) 'runtime-primitive]
        [(ffi-variable?    v) 'ffi]
        [else
         ;; (displayln (list 'top (map unparse-variable (id-set->list top-vars))))
         ;; (displayln (list 'mod (map unparse-variable module-vars)))
         ;; (displayln (list 'loc (map unparse-variable local-vars)))

         ;; Note: In full Racket a reference to an unbound variable at the top-level
         ;;       will go through the current namespace.
         (when (variable? v)
           (define id (variable-id v))
           (raise-syntax-error (syntax-e id)
                               "unbound identifier"
                               id))
         (error 'classify "got: ~a" v)]))
    ;; 2. References to variable according to their type
    (define (Reference v)
      #;(displayln (list 'ref (list v (classify v))) (current-error-port))
      #;(when (symbol? v)
          (error 'Reference "got: ~a" v))
      ; reference to non-free variable
      ;   global refers to a Web Assembly global variable
      (case (classify v)
        ; [(top)        `(global.get ,(TopVar v))]   ; unboxed
        [(top)        (if (top-symbol-needs-defined-check? v)
                          (CheckedTopReference v)
                          `(struct.get $Boxed $v
                                       (ref.cast (ref $Boxed) (global.get ,(TopVar v)))))]
        [(global)     `(global.get ,($ (syntax-e (variable-id v))))]
        [(runtime-primitive)
         (record-used-primitive! (syntax-e (variable-id v)))
         (PrimRef v)]
        [(local)      `(local.get  ,(LocalVar v))]
        [(module)     `(module.get ,(ModuleVar v))]
        [(ffi)        'TODO]
        [else (error 'Reference "got: ~a" v)]))
    ;; 3. Variables assignments according to type.
    (define (Store! v e)
      (cond
        [(variable? v)
         (case (classify v)
           ; [(top)    `(global.set ,(TopVar    v) ,e)]
           [(top)    `(struct.set $Boxed $v (ref.cast (ref $Boxed) (global.get ,(TopVar v))) ,e)]
           [(runtime-primitive)
            `(drop ,e)]
           [(local)  `(local.set  ,(LocalVar  v) ,e)]
           [(module) `(module.set ,(ModuleVar v) ,e)]
           [(ffi)        'TODO]
           [else (error 'Store! "got: ~a" v)])]
        [(identifier? v)
         ; (displayln (list 'Store! v))
         ; variables like: $closedapp-clos and $result 
         ; global
         `(global.set ,(syntax-e v) ,e)]
        [else (displayln v)
              (error 'Store! "got: ~a" v)]))
    
    (define (Expr e dd cd)           (Expr2 e dd cd))
    (define (AExpr2 ae [dd #f])      (AExpr3 ae dd))                    ; destination dd
    (define (AExpr ae)               (AExpr2 ae #f))                    ; for effect
    (define (AExpr* aes)             (map (λ (ae) (AExpr2 ae #f)) aes)) ; for effect 
    (define (Expr* es dd cd)         (map (λ (e)  (Expr e dd cd)) es))
    (define (CExpr ce dd cd)         (CExpr2 ce dd cd))      
    (define f-tmp                    (Var (new-var 'f))) ; used by app
    (define used-primitives-ht       (make-hasheq))

    (define (record-used-primitive! pr)
      (hash-set! used-primitives-ht pr #t))

    (define primitive-func->symbol
      (for/hasheq ([pr (in-list primitives)])
        (values ($ pr) pr)))

    (define primitive-global->symbol
      (for/hasheq ([pr (in-list primitives)])
        (values ($ (prim: pr)) pr)))

    ;; Record primitive roots after inlining so the runtime shaker sees the
    ;; primitive references that survive code generation.
    (define (record-used-primitives-in-wat! wat)
      (define (walk x)
        (cond
          [(symbol? x)
           (cond
             [(hash-ref primitive-func->symbol x #f)
              => record-used-primitive!]
             [(hash-ref primitive-global->symbol x #f)
              => record-used-primitive!]
             [else (void)])]
          [(pair? x)
           (walk (car x))
           (walk (cdr x))]
          [else (void)]))
      (walk wat))

    ;; with-debug-allocation-tick : exact-nonnegative-integer? any/c any/c -> any/c
    ;;   Wrap generated allocation forms so probe budgets can stop runaway code.
    (define (with-debug-allocation-tick kind result-type expr)
      `(block (result ,result-type)
              (call $debug-allocation-tick (i32.const ,kind))
              ,expr))

    ;; generated-args-array : natural? (listof any/c) -> any/c
    ;;   Allocate an instrumented generated $Args array.
    (define (generated-args-array n args)
      (with-debug-allocation-tick
       5
       '(ref $Args)
       `(array.new_fixed $Args ,n ,@args)))

    ;; generated-values-array : natural? (listof any/c) -> any/c
    ;;   Allocate an instrumented generated $Values array.
    (define (generated-values-array n values)
      (with-debug-allocation-tick
       8
       '(ref $Values)
       `(array.new_fixed $Values ,n ,@values)))

    ;; generated-free-array : natural? (listof any/c) -> any/c
    ;;   Allocate an instrumented generated $Free array.
    (define (generated-free-array n values)
      (with-debug-allocation-tick
       9
       '(ref $Free)
       `(array.new_fixed $Free ,n ,@values)))

    ;; generated-closure : symbol? (listof any/c) -> any/c
    ;;   Allocate an instrumented generated closure-like structure.
    (define (generated-closure closure-type fields)
      (with-debug-allocation-tick
       4
       `(ref ,closure-type)
       `(struct.new ,closure-type ,@fields)))

    ;; generated-case-closure : (listof any/c) -> any/c
    ;;   Allocate an instrumented generated case-closure structure.
    (define (generated-case-closure fields)
      (with-debug-allocation-tick
       4
       '(ref $CaseClosure)
       `(struct.new $CaseClosure ,@fields)))

    ;; label-debug-id-expr : variable? -> any/c
    ;;   Return the runtime symbol used as a generated closure/function debug id.
    (define (label-debug-id-expr l)
      (define debug-id (syntax-e (variable-id l)))
      (define $debug-id (string->symbol (~a "$symbol:" debug-id)))
      (add-symbol-constant debug-id debug-id)
      `(global.get ,$debug-id))

    ;; watched-label102683? : variable? -> boolean?
    ;;   Recognize the current expander frontier wrapper for focused probes.
    (define (watched-label102683? l)
      (eq? (syntax-e (variable-id l)) 'label.102683))

    ;; watched-label-entry-probe : variable? -> (listof any/c)
    ;;   Emit raw-argument diagnostics only for the focused expander frontier.
    (define (watched-label-entry-probe l)
      (if (watched-label102683? l)
          '((call $debug-watch-label102683 (local.get $args)))
          '()))

    ;; Some expressions (e.g. let-values, letrec-values) need local
    ;; variables to hold values.
    ;; In Web Assembly the only place to declare local variables
    ;; are in functions `(func ...)`.

    ;; When compiling the body of a function, we set the parameter
    ;; *locals* to the empty list. Any expressions that require
    ;; a local variable, will use `emit-local`. After the body is
    ;; compiled, the locals are added to the `func`.

    ;; The local variables needed at the top-level end up in `$entry`.
    (define *locals* (make-parameter '()))
    (define (emit-local x [type '(ref eq)] [init #f])
      (*locals* (cons (if init
                          (list x type init)
                          (list x type))
                      (*locals*))))
    (define (emit-fresh-local t [type '(ref eq)] [init #f])
      (define v (new-var t))
      (emit-local v type init)
      (set! local-vars (set-add local-vars v))
      v)
    ;; quoted strings
    (define quoted-string-counter 0)
    (define quoted-strings-ht (make-hash))
    (define (add-quoted-string string)
      (cond
        [(hash-ref quoted-strings-ht string #f)
         => values]
        [else
         (define name (string->symbol (~a "quoted-string" quoted-string-counter)))
         (hash-set! quoted-strings-ht string name)
         (set! quoted-string-counter (+ quoted-string-counter 1))
         (add-string-constant name string)
         name]))
    ;; quoted bytes
    (define quoted-bytes-counter 0)
    (define (add-quoted-bytes bytes)
      (define name (string->symbol (~a "quoted-bytes" quoted-bytes-counter)))
      (set! quoted-bytes-counter (+ quoted-bytes-counter 1))
      (add-bytes-constant name bytes)
      name)
    ;; quoted symbols
    (define quoted-symbol-counter 0)
    (define quoted-symbols-ht (make-hasheq))
    (define (add-quoted-symbol symbol)
      (cond
        [(hash-ref quoted-symbols-ht symbol #f)
         => values]
        [else
         (define name (string->symbol (~a "quoted-symbol" quoted-symbol-counter)))
         (hash-set! quoted-symbols-ht symbol name)
         (set! quoted-symbol-counter (+ quoted-symbol-counter 1))         
         (add-symbol-constant name symbol)
         name]))
    (define (canonicalize-arity-markers markers)
      (define (dedup xs)
        (reverse
         (for/fold ([acc '()]) ([x (in-list xs)])
           (if (member x acc) acc (cons x acc)))))
      (define exacts
        (for/list ([m (in-list markers)]
                   #:when (>= m 0))
          m))
      (define at-least-starts
        (for/list ([m (in-list markers)]
                   #:when (< m 0))
          (- (- m) 1)))
      (define min-at-least
        (and (pair? at-least-starts)
             (apply min at-least-starts)))
      (define exacts-dedup (dedup exacts))
      (define exacts-usable
        (if min-at-least
            (filter (λ (n) (< n min-at-least)) exacts-dedup)
            exacts-dedup))
      (define exacts-sorted (sort exacts-usable <))
      (cond
        [min-at-least
         (define m (- (- min-at-least) 1))
         (if (null? exacts-sorted)
             (list m)
             (append exacts-sorted (list m)))]
        [else exacts-sorted]))

	(define (arity-markers->eq-expr markers)
	  (match markers
	    ['()       `(ref.cast (ref eq) (array.new_fixed $I32Array 0))]
	    [(list m)  (Imm m)]
	    [_
	     `(ref.cast (ref eq)
	                (array.new_fixed $I32Array
	                                 ,(length markers)
	                                 ,@(for/list ([m (in-list markers)])
	                                     `(i32.const ,m))))]))

    (define (real-number-literal->expr v)
      (cond
        [(wr-signed-fixnum? v)
         (Imm v)]
        [(exact-integer? v)
         (bignum-literal->expr v)]
        [(and (rational? v) (exact? v))
         (rational-literal->expr v)]
        [(flonum? v)
         (define l (case v
                     [(+nan.0) 'nan] [(-nan.0) '-nan]
                     [(+inf.0) 'inf] [(-inf.0) '-inf]
                     [else v]))
         `(struct.new $Flonum (i32.const 0) (f64.const ,l))]
        [(and (real? v) (inexact? v))
         `(struct.new $Flonum (i32.const 0) (f64.const ,(* 1.0 v)))]
        [else
         (raise-arguments-error 'webify
                                "expected a real numeric literal"
                                "literal" v)]))

    (define (complex-number-literal->expr v)
      `(call $make-rectangular/canonical
             ,(real-number-literal->expr (real-part v))
             ,(real-number-literal->expr (imag-part v))))
	    )

  (ClosureAllocation : ClosureAllocation (ca dd) -> * ()
    [(closure ,s ,k ,in ,l ,ar ,ae1 ...)
     (when (known0-only-direct-label? l)
       (error 'ClosureAllocation
              "known0-only helper must not allocate an ordinary closure: ~a"
              (syntax-e (variable-id l))))
     (when (known1-only-direct-label? l)
       (error 'ClosureAllocation
              "known1-only helper must not allocate an ordinary closure: ~a"
              (syntax-e (variable-id l))))
     ; Note: We need to allocate the closure and then fill the free slots
     ;       in order to handle recursive references to the closure.
     ; If one of the ae1 ... are equal to dd,
     ; then the closure has a recursive reference.

     ;; (type $Args      (array (mut (ref eq))))
     ;; (type $Free      (array (mut (ref eq))))
     ;; (rec
     ;;  (type $Closure       (struct
     ;;                         (field $code (ref $ClosureCode))
     ;;                         (field $free (ref $Free))))
     ;;  (type $ClosureCode  (func (param $clos (ref $Closure))
     ;;                         (param $args (ref $Args))
     ;;                         (result (ref eq)))))

     ;; Inferred name for the closure
     (define get-name
       (cond
         [in   (define name  (syntax-e (variable-id in)))
               (define $name (string->symbol (~a "$symbol:" name)))
               (add-symbol-constant name name) ; on purpose name twice
               `(global.get ,$name)]

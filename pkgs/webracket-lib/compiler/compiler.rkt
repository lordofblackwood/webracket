    (check-true
     (regexp-match?
      #rx"^\\(let-values \\(\\(\\(a\\) \\(quote unsafe-undefined[0-9]+\\)\\) \\(\\(b\\) \\(quote unsafe-undefined[0-9]+\\)\\) \\(\\(x\\) \\(quote unsafe-undefined[0-9]+\\)\\) \\(\\(y\\) \\(quote unsafe-undefined[0-9]+\\)\\)\\) \\(begin \\(let-values \\(\\(\\(a[.0-9]+ b[.0-9]+\\) \\(values \\(cons \\(quote 1\\) \\(quote 2\\)\\) \\(quote 3\\)\\)\\)\\) \\(begin \\(set! a a[.0-9]+\\) \\(set! b b[.0-9]+\\) \\(quote 0\\)\\)\\) \\(let-values \\(\\(\\(x[.0-9]+ y[.0-9]+\\) \\(values a b\\)\\)\\) \\(begin \\(set! x x[.0-9]+\\) \\(set! y y[.0-9]+\\) \\(quote 0\\)\\)\\) \\(cons x y\\)\\)\\)$"
      (format "~s"
              (lower-test #'(letrec-values ([(x y) (let-values ([(a b) (values (cons 1 2) 3)])
                                                   (values a b))])
                              (cons x y))
                          'waddell))))
    (check-equal? (lower-test #'(letrec-values ([(f g) (letrec-values ([(a b) (values (λ () 1)
                                                                                         (λ () 2))])
                                                  (values a b))])
                                 (list (f) (g)))
                              'waddell)
                  '(letrec-values (((f) (λ () '1))
                                   ((g) (λ () '2)))
                     (list (f) (g))))
    (check-equal? (lower-test #'(letrec-values ([(f g) (letrec-values ([(a b) (values (case-lambda
                                                                                          [() 1])
                                                                                         (case-lambda
                                                                                           [() 2]))])
                                                   (values a b))])
                                 (list (f) (g)))
                              'waddell)
                  '(letrec-values (((f) (case-lambda
                                          (λ () '1)))
                                   ((g) (case-lambda
                                          (λ () '2))))
                     (list (f) (g))))
    (check-equal? (lower-test #'(letrec ([x (letrec ([v (lambda () x)])
                                            v)])
                                  x)
                              'waddell)
                  '(letrec-values (((x) (λ () x)))
                     x))
    (check-equal? (lower-test #'(letrec ([x (let-values ([(v) (lambda () x)])
                                            v)])
                                  x)
                              'waddell)
                  '(letrec-values (((x) (λ () x)))
                     x))
    (check-equal? (lower-test #'(letrec ([x (letrec ([v (lambda () x)])
                                            v)])
                                  x)
                              'scc)
                  '(letrec-values (((x) (λ () x)))
                     x))
    (check-equal? (lower-test #'(letrec ([x (let-values ([(v) (lambda () x)])
                                            v)])
                                  x)
                              'scc)
                  '(letrec-values (((x) (λ () x)))
                     x))
    (check-equal? (lower-test #'(letrec ([x (let-values ([(a) 1]) a)])
                                  x)
                              'waddell)
                  '(let-values (((a) '1))
                     (let-values (((x) a))
                       x)))
    (check-equal? (lower-test #'(letrec ([f (let-values ([(a) 1]) (λ () a))])
                                  (f))
                              'waddell)
                  '(let-values (((a) '1))
                     (letrec-values (((f) (λ () a)))
                       (f))))
    (check-true
     (regexp-match?
      #rx"^\\(let-values \\(\\(\\(a\\) \\(quote unsafe-undefined[0-9]+\\)\\) \\(\\(x\\) \\(quote unsafe-undefined[0-9]+\\)\\)\\) \\(begin \\(let-values \\(\\(\\(a[.0-9]+\\) \\(cons \\(quote 1\\) \\(quote 2\\)\\)\\)\\) \\(begin \\(set! a a[.0-9]+\\) \\(quote 0\\)\\)\\) \\(let-values \\(\\(\\(x[.0-9]+\\) a\\)\\) \\(begin \\(set! x x[.0-9]+\\) \\(quote 0\\)\\)\\) x\\)\\)$"
      (format "~s"
              (lower-test #'(letrec ([x (let-values ([(a) (cons 1 2)]) a)])
                              x)
                          'waddell))))
    (check-equal? (lower-test #'(letrec ([f (letrec ([a (λ () 1)])
                                               (λ () a))])
                                  (f))
                              'waddell)
                  '(letrec-values (((a) (λ () '1))
                                   ((f) (λ () a)))
                     (f)))
    (check-true
     (regexp-match?
      #rx"^\\(let-values \\(\\(\\(x\\) \\(quote unsafe-undefined[0-9]+\\)\\)\\) \\(letrec-values \\(\\(\\(a\\) \\(λ \\(\\) \\(quote 1\\)\\)\\)\\) \\(begin \\(let-values \\(\\(\\(x[.0-9]+\\) \\(cons \\(a\\) \\(quote 2\\)\\)\\)\\) \\(begin \\(set! x x[.0-9]+\\) \\(quote 0\\)\\)\\) x\\)\\)\\)$"
      (format "~s"
              (lower-test #'(letrec ([x (letrec ([a (λ () 1)])
                                          (cons (a) 2))])
                              x)
                          'waddell))))
    (check-complex-waddell #'(letrec ([x (random)]) x)
                           "\\(random\\)")
    (check-complex-waddell #'(letrec ([x (gensym)]) x)
                           "\\(gensym\\)")
    (check-complex-waddell #'(letrec ([x (current-directory)]) x)
                           "\\(current-directory\\)")
    (check-complex-waddell #'(letrec ([x (current-input-port)]) x)
                           "\\(current-input-port\\)")
    (check-complex-waddell #'(letrec ([x (cons 1 2)]) x)
                           "\\(cons \\(quote 1\\) \\(quote 2\\)\\)")
    (check-complex-waddell #'(letrec ([x (list 1 2)]) x)
                           "\\(list \\(quote 1\\) \\(quote 2\\)\\)")
    (check-complex-waddell #'(letrec ([x (vector 1 2)]) x)
                           "\\(vector \\(quote 1\\) \\(quote 2\\)\\)")
    (check-complex-waddell #'(letrec ([x (car '(1 . 2))]) x)
                           (regexp-quote "(car (quote (1 . 2)))"))
    (check-equal? (test #'(module t webracket (fx+ 1 (fx+ 2 3))))
                  '(module t webracket
                     (#%plain-module-begin
                      (let-values (((t.1) (primapp fx+ '2 '3)))
                        (primapp fx+ '1 t.1)))))))

(module+ test
  (define (letrec-scc-summary stx kinds)
    (define (as-variable x)
      (cond
        [(variable? x) x]
        [(identifier? x) (variable x)]
        [else x]))
    (define (name-of x)
      (cond
        [(variable? x) (syntax-e (variable-id x))]
        [(identifier? x) (syntax-e x)]
        [else x]))
    (reset-counter!)
    (parameterize ([α-rename-mode 'simple])
      (define ar
        (α-rename
         (explicit-case-lambda
          (explicit-begin
           (infer-names
            (flatten-topbegin
             (parse
              (expand-syntax stx))))))))
      (nanopass-case (LFE2+ Expr) ar
        [(letrec-values ,s0 ([(,x ...) ,e] ...) ,e0)
         (let ([classified
                (for/list ([kind (in-list kinds)]
                           [xs (in-list x)]
                           [rhs (in-list e)])
                  (list kind (map as-variable xs) rhs))])
           (for/list ([scc (in-list (letrec-classified-clauses->sccs classified))])
             (for/list ([binding (in-list (sort scc <
                                                 #:key letrec-scc-binding-pos))])
               (for/list ([x (in-list (letrec-scc-binding-xs binding))])
                 (name-of x)))))]
        [else
         (error 'letrec-scc-summary "expected a top-level letrec expression")])))
  (check-equal? (letrec-scc-summary #'(letrec ([a 1]
                                               [b a]
                                               [c b])
                                        c)
                                    '(simple-pure simple-pure simple-pure))
                '(((a)) ((b)) ((c))))
  (check-equal? (letrec-scc-summary #'(letrec ([f (λ () (g))]
                                               [g (λ () (f))]
                                               [x (f)])
                                        x)
                                    '(lambda lambda complex))
                '(((f) (g)) ((x))))
  (check-equal? (letrec-scc-summary #'(letrec ([a (cons 1 2)]
                                               [b (cons 3 4)]
                                               [c (cons 5 6)])
                                        c)
                                    '(simple-allocates simple-allocates simple-allocates))
                '(((a)) ((b)) ((c)))))

;;;
;;; FREE VARIABLE ANALYSIS
;;;

;; The goal of this pass is to determine the set of free variables
;; in each abstraction. The next pass, closure conversion, will use
;; this information to turn lambda abstractions into closures.

;; Rather than defining a new language with a variation of the
;; nonterminal λ with a field to store the free variables,
;; we use a hashtable to associate abstractions with sets of free variables.

;; Each nonterminal transformation produces two values: the form and the set of free variables
;; When a catamorphism is used as in (λ ,s ,f ,[e xs]) then
;; the Expr transformations is called and its output values are bound to e and xs.

;; There ought to be no free variables in top-level-forms, but we compute them
;; anyway to catch any internal errors.

(define-pass determine-free-variables : LANF (T) -> LANF (free-ht abstractions)
  (definitions
    ; list of all abstractions
    (define abs '())
    (define (seen-abstraction! ab) (set! abs (cons ab abs)))
    ; hash table from an abstraction to its free variables
    (define ht (make-hasheq))
    (define (add! ab xs) (hash-set! ht ab xs))
    (define (get ab)     (hash-ref  ht ab))
    (define (formal-variables F)
      (nanopass-case (LANF Formals) F
        [(formals (,x ...))            (ids->id-set x)]
        [(formals (,x0 ,x1 ... . ,xd)) (set-union (make-id-set x0 xd) (ids->id-set x1))]
        [(formals ,x)                  (make-id-set x)]))
    (define bound-at-top #f)
    (define (bound-at-top-level ts)
      ; return the set of all xs occuring in a 
      ;     (define-values   ,s (,x ...) ,[e xs])
      ; Note: The method of collecting below assumes that `topbegin`
      ;       has been flattened.
      (for/fold ([bound empty-set]) ([t ts])
        (define newly-bound
          (nanopass-case (LANF TopLevelForm) t
            [,g (nanopass-case (LANF GeneralTopLevelForm) g
                  [(define-values ,s (,x ...) ,e) (ids->id-set x)]
                  [else empty-set])]
            [else empty-set]))
        (set-union bound newly-bound)))
    (define (primitives->id-set)
      (ids->id-set (map (λ (sym) (variable (datum->syntax #'dfv sym)))
                        primitives)))
    (define (non-literal-constants->id-set)
      (ids->id-set (map (λ (sym) (variable (datum->syntax #'dfv sym)))
                        non-literal-constants))))
  
  (Formals : Formals (F) -> Formals ())
  (TopLevelForm : TopLevelForm (T xs) -> TopLevelForm (xs)
    [(topbegin ,s ,[t xs] ...)      (values T (set-difference
                                               (set-union* xs)
                                               (set-union bound-at-top #;(bound-at-top-level t)
                                                          ; todo: only import primitives that are declared
                                                          (set-union (primitives->id-set)
                                                                     (non-literal-constants->id-set)))))]
    [(topmodule ,s ,mn ,mp ,mf ...) (for ([m mf]) ; todo: find all identifiers defined at the module level
                                      (ModuleLevelForm m empty-set)) ; mark abstractions in the module
                                    (values T empty-set)]            ; no free variables in module
    [(#%expression ,s ,[e xs])      (values T xs)]
    [,g                             (GeneralTopLevelForm g xs)])
  (ModuleLevelForm : ModuleLevelForm (M xs) -> ModuleLevelForm (xs)
    [,g                        (GeneralTopLevelForm g xs)])
  (GeneralTopLevelForm : GeneralTopLevelForm (G xs) -> GeneralTopLevelForm (xs)
    [(define-values   ,s (,x ...) ,[e xs]) (values G (set-difference xs (ids->id-set x)))]
    [(define-syntaxes ,s (,x ...) ,[e xs]) (values G (set-difference xs (ids->id-set x)))] ; todo
    [,e (Expr e xs)])
  (Abstraction : Abstraction (AB xs) -> Abstraction (xs)
    [(λ ,s ,f ,[e xs])        (let ([xs (set-difference xs 
                                                        (set-union (formal-variables f)
                                                                   bound-at-top))])
                                (add! AB xs)
                                (seen-abstraction! AB)
                                (values AB xs))])
  (CaseAbstraction : CaseAbstraction (CAB xs) -> CaseAbstraction (xs)
    ; the free variables of a case-lambda is the union of the free variables of the clauses
    [(case-lambda ,s ,ab* ...) (define xs* (set-union*
                                            (for/list ([ab ab*])
                                              (letv ((ab xs) (Abstraction ab xs))
                                                xs))))
                               (add! CAB xs*)
                               (seen-abstraction! CAB)
                               (values CAB xs*)])
  (AExpr : AExpr (AE xs) -> AExpr (xs)
    [,x       (define sym (variable-id x))
              (cond
                [(compiler-primitive? sym)   (values AE empty-set)]         ; immediate constants
                [(provider-owned-primitive-alias? sym)
                 ;; Provider aliases such as `read` can also be introduced as
                 ;; lexical imports by the module bridge. Keep them visible to
                 ;; the ordinary scope subtraction below so nested lambdas
                 ;; capture local aliases instead of becoming unbound later.
                 ;; Bare aliases fall back only when there is a runtime primitive
                 ;; underneath; provider-only names like `write` must be resolved
                 ;; to real imported top bindings.
                 (values AE (if (or (lexical-bound-variable? x)
                                    (not (primitive? (primitive-symbol sym))))
                                (make-id-set x)
                                empty-set))]
                [(and (syntax? sym)
                      (non-literal-constant? (syntax-e sym)))
                 (values AE empty-set)]         ; value stored in a global
                [else                        (values AE (make-id-set x))])] ; non-primitive
    [,ab                  (Abstraction AE xs)]
    [,cab                 (CaseAbstraction AE xs)]
    [(quote ,s ,d)        (values AE empty-set)]
    [(quote-syntax ,s ,d) (values AE empty-set)]
    ; Note: Top-level variables are stored in a namespace.
    ;       In this pass we are only looking for variables that need to be stored in closures.
    [(top ,s ,x)                  (values AE empty-set)]
    [(variable-reference ,s ,vrx) (values AE empty-set)]) ; todo 
  (CExpr : CExpr (CE xs) -> CExpr (xs)
    [,ae                                      (AExpr ae xs)]
    [(if  ,s ,[ae0 xs0] ,[e1  xs1] ,[e2 xs2]) (values CE (set-union* (list xs0 xs1 xs2)))]
    [(wcm ,s ,[ae0 xs0] ,[ae1 xs1] ,[e  xs2]) (values CE (set-union* (list xs0 xs1 xs2)))]
    [(app ,s ,[ae  xs]  ,[ae1 xs1] ...)       (if (special-primitive? ae)
                                                  (values CE (set-union* xs1))
                                                  (values CE (set-union* (cons xs xs1))))]
    [(primapp   ,s ,pr      ,[ae1 xs1] ...)   (values CE (set-union* xs1))]
    [(closedapp ,s ,[ab xs] ,[ae1 xs1] ...)   (values CE (set-union* (cons xs xs1)))]
    [(begin     ,s ,[e0 xs0] ,[e1 xs] ...)    (values CE (set-union* (cons xs0 xs)))]
    [(begin0    ,s ,[e0 xs0] ,[e1 xs] ...)    (values CE (set-union* (cons xs0 xs)))])
  (Expr : Expr (E xs) -> Expr (xs)
    [,ce (CExpr E xs)]
    [(let-values    ,s (((,x ...) ,[ce rhs-xs]) ...) ,[e xs])
     (values E (set-union (set-union* rhs-xs) ; the ((x ...) ...) are not bound in ce ...
                          (set-difference xs  ; the free variables of e except those bound here
                                          (set-union* (map ids->id-set x)))))]
    [(letrec-values ,s (((,x ...) ,[ce rhs-xs]) ...) ,[e xs])
     (values E (set-difference (set-union* (cons xs rhs-xs)) (set-union* (map ids->id-set x))))])

  ;; 1. Find all top-level variables  
  (set! bound-at-top
        (set-union
         (ids->id-set
          (top-level-global-interface-variables
           (current-imported-top-level-globals)))
         (let loop ([T T])
           (nanopass-case (LANF TopLevelForm) T
             [(topbegin ,s ,t ...)
              (set-union* (map loop t))]
             [,g
              (bound-at-top-level (list g))]
             [else
              ; #%expresion and topmodule
              empty-set]))))
  
  ;; 2. Compute free variables
  (letv ((T xs) (TopLevelForm T (make-id-set)))    
    (unless (set-empty? xs)
      (displayln "\n---\n")
      (displayln bound-at-top)
      ; (displayln "\n---\n")
      ; (pretty-print (unparse-LANF T)) (newline)
      (displayln "\n---\n") (displayln xs) (newline)
      (error 'determine-free-variables "detected free variables (shouldn't be possible)"))
    (values T ht abs)))


;;;
;;; CLASSIFY LAMBDAS
;;;

;; classify-lambdas! : LANF (hasheq/c any/c id-set?) (listof any/c)
;;                  -> (values (hasheq/c any/c symbol?)
;;                             (hasheq/c any/c (listof syntax?))
;;                             (hasheq/c any/c boolean?)
;;                             (hasheq/c any/c boolean?)
;;                             (hasheq/c any/c (or/c variable? #f)))
;;   Compute conservative helper-classification metadata for abstractions
;;   without rewriting the AST.
;;
;; The returned tables record:
;; - kind-ht            : abstraction -> 'closed | 'trivial-closed | 'direct
;; - direct-sites-ht    : abstraction -> recorded direct call sites
;; - direct-candidate-ht: abstraction -> locally bound in a direct-eligible shape
;; - disqualified-ht    : abstraction -> seen in a non-operator/value use
;; - binder-ht          : abstraction -> local binder when known
;;
;; The classification policy is intentionally conservative:
;; - every abstraction starts as 'closed, or 'trivial-closed when its
;;   ordinary free-variable set is empty
;; - an abstraction is upgraded to 'direct only when it is bound by a
;;   recognized local binding and every observed use stays in operator
;;   position
;;
;; Later analyses use the binder and direct-site metadata to compute
;; direct-helper env layouts, extended env needs, and known-helper
;; summaries.
(define (classify-lambdas! T free-ht abs)
  (define kind-ht         (make-hasheq)) ; hasheq: abstraction -> symbol, current lambda kind
  (define direct-sites-ht (make-hasheq)) ; hasheq: abstraction -> (listof syntax?), recorded direct call sites
  (define disqualified-ht (make-hasheq)) ; hasheq: abstraction -> boolean, seen in a non-operator use
  (define binder-ht       (make-hasheq)) ; hasheq: abstraction -> (or/c variable? #f), local binder when known
  (define direct-candidate-ht
    (make-hasheq))                      ; hasheq: abstraction -> boolean, bound in a direct-eligible local binding

  ;; free-set-of : any/c -> id-set?
  ;;   Return the free-variable set recorded for abstraction ab.
  (define (free-set-of ab)
    (hash-ref free-ht ab empty-set))

  ;; free-of : any/c -> (listof variable?)
  ;;   Return the free variables recorded for abstraction ab.
  (define (free-of ab)
    (id-set->list (free-set-of ab)))

  ;; empty-free? : any/c -> boolean?
  ;;   Check whether abstraction ab has no free variables.
  (define (empty-free? ab)
    (set-empty? (free-set-of ab)))

  ;; initialize-kind! : any/c -> void?
  ;;   Seed kind table with the conservative initial classification.
  (define (initialize-kind! ab)
    (hash-set! kind-ht ab (if (empty-free? ab) 'trivial-closed 'closed))
    (hash-set! direct-sites-ht ab '())
    (hash-set! binder-ht ab #f)
    (hash-set! direct-candidate-ht ab #f))

  ;; kind-of : any/c -> symbol?
  ;;   Read the current kind for abstraction ab.
  (define (kind-of ab)
    (hash-ref kind-ht ab 'closed))

  ;; mark-kind! : any/c symbol? -> void?
  ;;   Overwrite the current kind recorded for abstraction ab.
  (define (mark-kind! ab kind)
    (hash-set! kind-ht ab kind))

  ;; note-direct-call! : any/c syntax? -> void?
  ;;   Record one direct call site for abstraction ab.
  (define (note-direct-call! ab s)
    (hash-set! direct-sites-ht ab
               (cons s (hash-ref direct-sites-ht ab '()))))

  ;; disqualify-direct! : any/c -> void?
  ;;   Mark abstraction ab as ineligible for the 'direct classification.
  (define (disqualify-direct! ab)
    (hash-set! disqualified-ht ab #t))

  ;; direct-disqualified? : any/c -> boolean?
  ;;   Check whether abstraction ab has been seen in a non-operator use.
  (define (direct-disqualified? ab)
    (hash-ref disqualified-ht ab #f))

  ;; direct-candidate? : any/c -> boolean?
  ;;   Check whether abstraction ab is still eligible for the 'direct classification.
  (define (direct-candidate? ab)
    (and (hash-ref direct-candidate-ht ab #f)
         (not (direct-disqualified? ab))
         (pair? (hash-ref direct-sites-ht ab '()))))

  ;; mark-direct-candidate! : any/c -> void?
  ;;   Mark abstraction ab as eligible for the conservative 'direct classification.
  (define (mark-direct-candidate! x ab)
    (hash-set! binder-ht ab x)
    (hash-set! direct-candidate-ht ab #t))

  ;; finalize-kind! : any/c -> void?
  ;;   Upgrade abstraction ab to 'direct when the conservative checks pass.
  (define (finalize-kind! ab)
    (when (direct-candidate? ab)
      (mark-kind! ab 'direct)))

  ;; env-empty : -> free-id-table?
  ;;   Build an empty lexical environment for lambda-bound abstractions.
  (define (env-empty)
    (make-immutable-free-id-table))

  ;; env-ref : free-id-table? variable? -> (or/c any/c #f)
  ;;   Look up the abstraction bound to variable x in environment ρ.
  (define (env-ref ρ x)
    (free-id-table-ref ρ (variable-id x) #f))

  ;; env-bind : free-id-table? variable? any/c -> free-id-table?
  ;;   Extend environment ρ so x maps to abstraction ab.
  (define (env-bind ρ x ab)
    (free-id-table-set ρ (variable-id x) ab))

  ;; env-bind* : free-id-table? (listof variable?) (listof any/c) -> free-id-table?
  ;;   Extend environment ρ with parallel variable/abstraction bindings.
  (define (env-bind* ρ xs abs)
    (for/fold ([ρ ρ]) ([x  (in-list xs)]
                       [ab (in-list abs)])
      (env-bind ρ x ab)))

  ;; env-shadow* : free-id-table? (listof variable?) -> free-id-table?
  ;;   Shadow variables xs so outer lambda bindings are hidden.
  (define (env-shadow* ρ xs)
    (for/fold ([ρ ρ]) ([x (in-list xs)])
      (free-id-table-set ρ (variable-id x) #f)))

  (define current-lambda-env
    (make-parameter (env-empty)))
  (define current-use-context
    (make-parameter 'value))
  (define current-call-site
    (make-parameter #f))

  ;; formals->variables : LANF Formals -> (listof variable?)
  ;;   Collect the variables bound by formals f.
  (define (formals->variables f)
    (nanopass-case (LANF Formals) f
      [(formals (,x ...))            x]
      [(formals (,x0 ,x1 ... . ,xd)) (cons x0 (append x1 (list xd)))]
      [(formals ,x)                  (list x)]))

  ;; abstraction-formals : LANF Abstraction -> LANF Formals
  ;;   Extract the formals of abstraction ab.
  (define (abstraction-formals ab)
    (nanopass-case (LANF Abstraction) ab
      [(λ ,s ,f ,e) f]))

  ;; case-abstraction-formals* : LANF CaseAbstraction -> (listof LANF Formals)
  ;;   Extract the formals of each clause in case abstraction cab.
  (define (case-abstraction-formals* cab)
    (nanopass-case (LANF CaseAbstraction) cab
      [(case-lambda ,s ,ab* ...)
       (map abstraction-formals ab*)]))

  ;; clause-bound-abstraction : LANF Expr/CExpr/AExpr -> (or/c any/c #f)
  ;;   Recognize the simple local binding pattern x = λ or x = case-lambda.
  (define (clause-bound-abstraction ce)
    (nanopass-case (LANF CExpr) ce
      [,ae
       (nanopass-case (LANF AExpr) ae
         [,ab  ab]
         [,cab cab]
         [else #f])]
      [else #f]))

  ;; clause-local-binding : (listof variable?) LANF CExpr -> (or/c (cons variable? any/c) #f)
  ;;   Recognize a single-variable clause whose rhs is a lambda-like expression.
  (define (clause-local-binding xs ce)
    (match xs
      [(list x)
       (define ab (clause-bound-abstraction ce))
       (and ab (cons x ab))]
      [_ #f]))

  ;; direct-binding-candidate? : (listof variable?) LANF CExpr -> boolean?
  ;;   Check whether clause xs = ce is eligible for the conservative 'direct classification.
  (define (direct-binding-candidate? xs ce)
    (match xs
      [(list x)
       (and (not (runtime-preferred-primitive-alias? x))
            (clause-local-binding xs ce)
            #t)]
      [_ #f]))

  ;; clause-local-bindings : (listof (listof variable?)) (listof LANF CExpr)
  ;;                      -> (listof (cons variable? any/c))
  ;;   Collect the local lambda bindings introduced by a let or letrec group.
  (define (clause-local-bindings xss ces)
    (for/fold ([pairs '()]) ([xs (in-list xss)]
                             [ce (in-list ces)])
      (define pair (clause-local-binding xs ce))
      (if pair
          (cons pair pairs)
          pairs)))

  ;; use-as-value! : variable? free-id-table? -> void?
  ;;   A reference to x in value position rules out the 'direct classification.
  (define (use-as-value! x)
    (match (env-ref (current-lambda-env) x)
      [#f (void)]
      [ab (disqualify-direct! ab)]))

  ;; use-as-operator! : syntax? variable? free-id-table? -> void?
  ;;   A reference to x in operator position counts as a direct call site.
  (define (use-as-operator! s x)
    (match (env-ref (current-lambda-env) x)
      [#f (void)]
      [ab (note-direct-call! ab s)]))

  (for ([ab (in-list abs)])
    (initialize-kind! ab))

  (define-pass classify : LANF (T) -> * ()
    (TopLevelForm : TopLevelForm (T) -> * ()
      [(topbegin ,s ,t ...)
       (for ([t (in-list t)])
         (TopLevelForm t))]
      [(topmodule ,s ,mn ,mp ,mf ...)
       (for ([m (in-list mf)])
         (ModuleLevelForm m))]
      [(#%expression ,s ,e)
       (Expr e)]
      [,g
       (GeneralTopLevelForm g)])
    (ModuleLevelForm : ModuleLevelForm (M) -> * ()
      [(#%provide ,rps ...)
       (void)]
      [,g
       (GeneralTopLevelForm g)])
    (GeneralTopLevelForm : GeneralTopLevelForm (G) -> * ()
      [(define-values ,s (,x ...) ,e)
       (Expr e)]
      [(define-syntaxes ,s (,x ...) ,e)
       (Expr e)]
      [(#%require ,s ,rrs ...)
       (void)]
      [,e
       (Expr e)])
    (Abstraction : Abstraction (AB) -> * ()
      [(λ ,s ,f ,e)
       (define ρ* (env-shadow* (current-lambda-env) (formals->variables f)))
       (parameterize ([current-lambda-env ρ*])
         (Expr e))])
    (CaseAbstraction : CaseAbstraction (CAB) -> * ()
      [(case-lambda ,s ,ab* ...)
       (for ([ab (in-list ab*)])
         (Abstraction ab))])
    (AExpr : AExpr (AE) -> * ()
      [,x
       (case (current-use-context)
         [(operator) (use-as-operator! (current-call-site) x)]
         [else       (use-as-value! x)])]
      [,ab
       (Abstraction ab)]
      [,cab
       (CaseAbstraction cab)]
      [(quote ,s ,d)
       (void)]
      [(quote-syntax ,s ,d)
       (void)]
      [(top ,s ,x)
       (void)]
      [(variable-reference ,s ,vrx)
       (void)])
    (CExpr : CExpr (CE) -> * ()
      [,ae
       (AExpr ae)]
      [(set! ,s ,x ,ae)
       (AExpr ae)]
      [(if ,s ,ae0 ,e1 ,e2)
       (AExpr ae0)
       (Expr e1)
       (Expr e2)]
      [(wcm ,s ,ae0 ,ae1 ,e)
       (AExpr ae0)
       (AExpr ae1)
       (Expr e)]
      [(app ,s ,ae ,ae1 ...)
       (parameterize ([current-use-context 'operator]
                      [current-call-site s])
         (AExpr ae))
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(primapp ,s ,pr ,ae1 ...)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(closedapp ,s ,ab ,ae1 ...)
       (Abstraction ab)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(begin ,s ,e0 ,e1 ...)
       (Expr e0)
       (for ([e (in-list e1)])
         (Expr e))]
      [(begin0 ,s ,e0 ,e1 ...)
       (Expr e0)
       (for ([e (in-list e1)])
         (Expr e))])
    (Expr : Expr (E) -> * ()
      [,ce
       (CExpr ce)]
      [(let-values ,s (((,x ...) ,ce*) ...) ,e)
       (for ([ce (in-list ce*)])
           (CExpr ce))
       (for ([xs (in-list x)]
             [ce (in-list ce*)]
             #:when (direct-binding-candidate? xs ce))
         (match (clause-local-binding xs ce)
           [(cons x ab) (mark-direct-candidate! x ab)]
           [_           (void)]))
       (define pairs (reverse (clause-local-bindings x ce*)))
       (define xs    (map car pairs))
       (define abs   (map cdr pairs))
       (parameterize ([current-lambda-env
                       (env-bind* (current-lambda-env) xs abs)])
         (Expr e))]
      [(letrec-values ,s (((,x ...) ,ce*) ...) ,e)
       (for ([xs (in-list x)]
             [ce (in-list ce*)]
             #:when (direct-binding-candidate? xs ce))
         (match (clause-local-binding xs ce)
           [(cons x ab) (mark-direct-candidate! x ab)]
           [_           (void)]))
       (define pairs (reverse (clause-local-bindings x ce*)))
       (define xs    (map car pairs))
       (define abs   (map cdr pairs))
       (parameterize ([current-lambda-env
                       (env-bind* (current-lambda-env) xs abs)])
         (for ([ce (in-list ce*)])
           (CExpr ce))
         (Expr e))]))

  (parameterize ([current-lambda-env (env-empty)])
    (classify T))
  (for ([ab (in-list abs)])
    (finalize-kind! ab))
  (values kind-ht direct-sites-ht direct-candidate-ht disqualified-ht binder-ht))

;; determine-extended-free-variables! : LANF
;;                                   (hasheq/c any/c id-set?)
;;                                   (listof any/c)
;;                                   (hasheq/c any/c symbol?)
;;                                -> (values (hasheq/c any/c id-set?)
;;                                           (hasheq/c any/c (listof any/c)))
;;   Compute extended env needs for direct helpers together with their
;;   direct-callee graph.
;;
;; For abstractions classified as `direct`, this pass computes:
;; - base extended free variables for each abstraction, excluding free variables
;;   that are themselves direct helper bindings in lexical scope
;; - direct callee edges between abstractions
;; - a fixed point that propagates extended needs from direct callees to callers
;;
;; This pass is still conservative, but its result is part of the current
;; closure-conversion pipeline: later analyses inspect it, and
;; `finish-closure-conversion` uses it when choosing lifted-body env layouts
;; and known-helper lowering paths.
(define (determine-extended-free-variables! T free-ht abs kind-ht)
  (define extended-ht      (make-hasheq)) ; hasheq: abstraction -> id-set, current extended free-variable set
  (define direct-callees-ht
    (make-hasheq))                        ; hasheq: abstraction -> (listof abstraction), direct helper callees

  ;; free-set-of : any/c -> id-set?
  ;;   Return the free-variable set recorded for abstraction ab.
  (define (free-set-of ab)
    (hash-ref free-ht ab empty-set))

  ;; kind-of : any/c -> symbol?
  ;;   Return the current classification kind of abstraction ab.
  (define (kind-of ab)
    (hash-ref kind-ht ab 'closed))

  ;; direct-helper? : any/c -> boolean?
  ;;   Check whether abstraction ab is classified as a direct helper.
  (define (direct-helper? ab)
    (eq? (kind-of ab) 'direct))

  ;; env-empty : -> free-id-table?
  ;;   Build an empty lexical environment for direct helper bindings.
  (define (env-empty)
    (make-immutable-free-id-table))

  ;; env-ref : free-id-table? variable? -> (or/c any/c #f)
  ;;   Look up the abstraction bound to variable x in environment ρ.
  (define (env-ref ρ x)
    (free-id-table-ref ρ (variable-id x) #f))

  ;; env-bind : free-id-table? variable? any/c -> free-id-table?
  ;;   Extend environment ρ so x maps to abstraction ab.
  (define (env-bind ρ x ab)
    (free-id-table-set ρ (variable-id x) ab))

  ;; env-bind* : free-id-table? (listof variable?) (listof any/c) -> free-id-table?
  ;;   Extend environment ρ with parallel variable/abstraction bindings.
  (define (env-bind* ρ xs abs)
    (for/fold ([ρ ρ]) ([x  (in-list xs)]
                       [ab (in-list abs)])
      (env-bind ρ x ab)))

  ;; env-shadow* : free-id-table? (listof variable?) -> free-id-table?
  ;;   Shadow variables xs so outer helper bindings are hidden.
  (define (env-shadow* ρ xs)
    (for/fold ([ρ ρ]) ([x (in-list xs)])
      (free-id-table-set ρ (variable-id x) #f)))

  ;; formals->variables : LANF Formals -> (listof variable?)
  ;;   Collect the variables bound by formals f.
  (define (formals->variables f)
    (nanopass-case (LANF Formals) f
      [(formals (,x ...))            x]
      [(formals (,x0 ,x1 ... . ,xd)) (cons x0 (append x1 (list xd)))]
      [(formals ,x)                  (list x)]))

  ;; abstraction-formals : LANF Abstraction -> LANF Formals
  ;;   Extract the formals of abstraction ab.
  (define (abstraction-formals ab)
    (nanopass-case (LANF Abstraction) ab
      [(λ ,s ,f ,e) f]))

  ;; clause-bound-abstraction : LANF CExpr -> (or/c any/c #f)
  ;;   Recognize the simple local binding pattern x = λ or x = case-lambda.
  (define (clause-bound-abstraction ce)
    (nanopass-case (LANF CExpr) ce
      [,ae
       (nanopass-case (LANF AExpr) ae
         [,ab  ab]
         [,cab cab]
         [else #f])]
      [else #f]))

  ;; clause-local-binding : (listof variable?) LANF CExpr -> (or/c (cons variable? any/c) #f)
  ;;   Recognize a single-variable clause whose rhs is a lambda-like expression.
  (define (clause-local-binding xs ce)
    (match xs
      [(list x)
       (define ab (clause-bound-abstraction ce))
       (and ab (cons x ab))]
      [_ #f]))

  ;; clause-local-bindings : (listof (listof variable?)) (listof LANF CExpr)
  ;;                      -> (listof (cons variable? any/c))
  ;;   Collect the local lambda bindings introduced by a let or letrec group.
  (define (clause-local-bindings xss ces)
    (for/fold ([pairs '()]) ([xs (in-list xss)]
                             [ce (in-list ces)])
      (define pair (clause-local-binding xs ce))
      (if pair
          (cons pair pairs)
          pairs)))

  ;; direct-free-base-of : any/c free-id-table? -> id-set?
  ;;   Remove locally known direct helper bindings from ab's ordinary free vars.
  (define (direct-free-base-of ab ρ)
    (for/fold ([xs (free-set-of ab)]) ([x (in-list (id-set->list (free-set-of ab)))])
      (match (env-ref ρ x)
        [bound-ab (if (and bound-ab (direct-helper? bound-ab))
                      (set-remove xs x)
                      xs)]
        [_ xs])))

  ;; initialize-extended! : any/c id-set? -> void?
  ;;   Seed the extended set for abstraction ab.
  (define (initialize-extended! ab xs)
    (hash-set! extended-ht ab xs)
    (hash-set! direct-callees-ht ab '()))

  ;; note-direct-callee! : any/c any/c -> void?
  ;;   Record that caller directly invokes callee.
  (define (note-direct-callee! caller callee)
    (hash-set! direct-callees-ht caller
               (cons callee (hash-ref direct-callees-ht caller '()))))

  ;; extended-of : any/c -> id-set?
  ;;   Return the current extended free-variable set for abstraction ab.
  (define (extended-of ab)
    (hash-ref extended-ht ab empty-set))

  ;; current-helper-env : (parameter/c free-id-table?)
  ;;   Local direct helper bindings in lexical scope.
  (define current-helper-env
    (make-parameter (env-empty)))

  ;; current-abstraction : (parameter/c (or/c any/c #f))
  ;;   The abstraction whose body is currently being analyzed.
  (define current-abstraction
    (make-parameter #f))

  (define-pass analyze : LANF (T) -> * ()
    (TopLevelForm : TopLevelForm (T) -> * ()
      [(topbegin ,s ,t ...)
       (for ([t (in-list t)])
         (TopLevelForm t))]
      [(topmodule ,s ,mn ,mp ,mf ...)
       (for ([m (in-list mf)])
         (ModuleLevelForm m))]
      [(#%expression ,s ,e)
       (Expr e)]
      [,g
       (GeneralTopLevelForm g)])
    (ModuleLevelForm : ModuleLevelForm (M) -> * ()
      [(#%provide ,rps ...)
       (void)]
      [,g
       (GeneralTopLevelForm g)])
    (GeneralTopLevelForm : GeneralTopLevelForm (G) -> * ()
      [(define-values ,s (,x ...) ,e)
       (Expr e)]
      [(define-syntaxes ,s (,x ...) ,e)
       (Expr e)]
      [(#%require ,s ,rrs ...)
       (void)]
      [,e
       (Expr e)])
    (Abstraction : Abstraction (AB) -> * ()
      [(λ ,s ,f ,e)
       (initialize-extended! AB
                             (direct-free-base-of AB (current-helper-env)))
       (parameterize ([current-abstraction AB]
                      [current-helper-env
                       (env-shadow* (current-helper-env) (formals->variables f))])
         (Expr e))])
    (CaseAbstraction : CaseAbstraction (CAB) -> * ()
      [(case-lambda ,s ,ab* ...)
       (for ([ab (in-list ab*)])
         (Abstraction ab))])
    (AExpr : AExpr (AE) -> * ()
      [,x
       (void)]
      [,ab
       (Abstraction ab)]
      [,cab
       (CaseAbstraction cab)]
      [(quote ,s ,d)
       (void)]
      [(quote-syntax ,s ,d)
       (void)]
      [(top ,s ,x)
       (void)]
      [(variable-reference ,s ,vrx)
       (void)])
    (CExpr : CExpr (CE) -> * ()
      [,ae
       (AExpr ae)]
      [(set! ,s ,x ,ae)
       (AExpr ae)]
      [(if ,s ,ae0 ,e1 ,e2)
       (AExpr ae0)
       (Expr e1)
       (Expr e2)]
      [(wcm ,s ,ae0 ,ae1 ,e)
       (AExpr ae0)
       (AExpr ae1)
       (Expr e)]
      [(app ,s ,ae ,ae1 ...)
       (nanopass-case (LANF AExpr) ae
         [,x
          (match (env-ref (current-helper-env) x)
            [callee
             (when (and callee
                        (current-abstraction)
                        (direct-helper? callee))
               (note-direct-callee! (current-abstraction) callee))]
            [_ (void)])]
         [else
          (AExpr ae)])
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(primapp ,s ,pr ,ae1 ...)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(closedapp ,s ,ab ,ae1 ...)
       (Abstraction ab)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(begin ,s ,e0 ,e1 ...)
       (Expr e0)
       (for ([e (in-list e1)])
         (Expr e))]
      [(begin0 ,s ,e0 ,e1 ...)
       (Expr e0)
       (for ([e (in-list e1)])
         (Expr e))])
    (Expr : Expr (E) -> * ()
      [,ce
       (CExpr ce)]
      [(let-values ,s (((,x ...) ,ce*) ...) ,e)
       (for ([ce (in-list ce*)])
         (CExpr ce))
       (define pairs (reverse (clause-local-bindings x ce*)))
       (define direct-pairs
         (filter (λ (pair) (direct-helper? (cdr pair))) pairs))
       (define xs  (map car direct-pairs))
       (define abs (map cdr direct-pairs))
       (parameterize ([current-helper-env
                       (env-bind* (current-helper-env) xs abs)])
         (Expr e))]
      [(letrec-values ,s (((,x ...) ,ce*) ...) ,e)
       (define pairs (reverse (clause-local-bindings x ce*)))
       (define direct-pairs
         (filter (λ (pair) (direct-helper? (cdr pair))) pairs))
       (define xs  (map car direct-pairs))
       (define abs (map cdr direct-pairs))
       (parameterize ([current-helper-env
                       (env-bind* (current-helper-env) xs abs)])
         (for ([ce (in-list ce*)])
           (CExpr ce))
         (Expr e))]))

  (for ([ab (in-list abs)])
    (initialize-extended! ab empty-set))
  (parameterize ([current-helper-env (env-empty)]
                 [current-abstraction #f])
    (analyze T))

  ;; Propagate extended needs from direct callees back to direct callers.
  (let loop ()
    (define changed? #f)
    (for ([ab (in-list abs)])
      (define next
        (for/fold ([xs (extended-of ab)])
                  ([callee (in-list (hash-ref direct-callees-ht ab '()))])
          (set-union xs (extended-of callee))))
      (unless (equal? next (extended-of ab))
        (hash-set! extended-ht ab next)
        (set! changed? #t)))
    (when changed?
      (loop)))

  (values extended-ht direct-callees-ht))

;;;
;;; Closure-Conversion Analysis And Reports
;;;

;;; This chapter computes and inspects the analysis state that closure
;;; conversion uses, without rewriting the program yet.
;;;
;;; The core analysis establishes:
;;; - raw free variables for each abstraction
;;; - a lambda classification:
;;;   - `closed`:         not treated as a direct helper
;;;   - `trivial-closed`: `closed` with an empty ordinary free-variable set
;;;   - `direct`:         locally bound and used only in operator position, so it is
;;;                       eligible for direct-helper analysis and lowering
;;; - direct-call sites:
;;;   operator-position uses of a `direct` helper binder
;;; - direct-candidate status:
;;;   a conservative local-binding shape that may later finalize to `direct`
;;; - value-use disqualification:
;;;   the helper binder was seen in a non-operator use, so it cannot be
;;;   treated as `direct`
;;; - binder/origin information:
;;;   which local binder names the helper, and whether it came from
;;;   `let-values`, `letrec-values`, or another binding context
;;; - extended env needs:
;;;   the propagated direct-helper env set, which may be larger than the
;;;   helper's ordinary free-variable set because it also includes direct
;;;   callee needs
;;; - direct-callee relationships:
;;;   the direct-helper call graph used for that propagation
;;;
;;; The summaries below are analysis-only reports. They are used for tests,
;;; measurement scripts, and migration experiments, and they should describe
;;; the current compiler state conservatively instead of predicting future
;;; lowering changes.

;; closure-conversion-analysis :
;; LANF -> (values LANF
;;                 (hasheq/c any/c id-set?)             ; free-ht
;;                 (listof any/c)                       ; abs
;;                 (hasheq/c any/c symbol?)             ; kind-ht
;;                 (hasheq/c any/c (listof syntax?))    ; direct-sites-ht
;;                 (hasheq/c any/c boolean?)            ; direct-candidate-ht
;;                 (hasheq/c any/c boolean?)            ; disqualified-ht
;;                 (hasheq/c any/c (or/c variable? #f)) ; binder-ht
;;                 (hasheq/c any/c id-set?)             ; extended-ht
;;                 (hasheq/c any/c (listof any/c)))     ; direct-callees-ht
;;   Run the analysis stages used by closure conversion without rewriting the AST.
(define (closure-conversion-analysis T)
  (letv ((T free-ht abs) (determine-free-variables T))
    (define-values (kind-ht direct-sites-ht direct-candidate-ht disqualified-ht binder-ht)
      (if (current-enable-cc-analysis?)
          (classify-lambdas! T free-ht abs)
          (let ()
            (define kind-ht             (make-hasheq))
            (define direct-sites-ht     (make-hasheq))
            (define direct-candidate-ht (make-hasheq))
            (define disqualified-ht     (make-hasheq))
            (define binder-ht           (make-hasheq))
            (for ([ab (in-list abs)])
              (hash-set! kind-ht ab
                         (if (set-empty? (hash-ref free-ht ab empty-set))
                             'trivial-closed
                             'closed))
              (hash-set! direct-sites-ht ab '())
              (hash-set! direct-candidate-ht ab #f)
              (hash-set! disqualified-ht ab #f)
              (hash-set! binder-ht ab #f))
            (values kind-ht direct-sites-ht direct-candidate-ht disqualified-ht binder-ht))))
    (define-values (extended-ht direct-callees-ht)
      (if (current-enable-cc-analysis?)
          (determine-extended-free-variables! T free-ht abs kind-ht)
          (let ()
            (define extended-ht      (make-hasheq))
            (define direct-callees-ht (make-hasheq))
            (for ([ab (in-list abs)])
              (hash-set! extended-ht ab (hash-ref free-ht ab empty-set))
              (hash-set! direct-callees-ht ab '()))
            (values extended-ht direct-callees-ht))))
    (values T free-ht abs kind-ht direct-sites-ht direct-candidate-ht disqualified-ht binder-ht
            extended-ht direct-callees-ht)))

;; summarize-closure-conversion-analysis
;; : LANF -> (listof
;;             (list symbol?          ; label
;;                   symbol?          ; kind
;;                   boolean?         ; direct-candidate?
;;                   boolean?         ; disqualified?
;;                   (or/c symbol? #f) ; binder
;;                   (listof symbol?) ; free-vars
;;                   (listof any/c))) ; direct-sites
;;   Return one summary row per abstraction.
;;
;; Each row has the form:
;;   (list label kind direct-candidate? disqualified? binder free-vars direct-sites)
;; where:
;; - label:             a fresh readable name used only in the summary
;; - kind:              one of `closed`, `trivial-closed`, or `direct`
;; - direct-candidate?: whether the abstraction was seen in a binding shape
;;                      that may later finalize to `direct`
;; - disqualified?:     whether its binder was also seen in a non-operator use
;; - binder:            the local binder naming the abstraction, or `#f`
;; - free-vars:         the ordinary free-variable set of the abstraction
;; - direct-sites:      the recorded operator-position uses of the binder
;;
;; This summary is the compact “what did lambda classification discover?”
;; view. It reports the basic closure-conversion analysis state before
;; extended direct-helper env propagation is taken into account.
;;
;; Example:
;;
;;   (let ([x 10])
;;     (let ([f (lambda (y) (+ x y))])
;;       (f 2)))
;;
;; Conceptually, the row for `f` is:
;;
;;   (list 'label-f 'direct #t #f 'f '(x) '(line-or-position-of-(f 2)))

(define (summarize-closure-conversion-analysis T)
  (define (label-name labels-ht ab)
    (syntax-e (variable-id (hash-ref labels-ht ab))))
  (define (site-source s)
    (cond
      [(syntax? s)
       (or (syntax-line s)
           (syntax-position s)
           'unknown)]
      [else
       s]))
  (letv ((T free-ht abs kind-ht direct-sites-ht direct-candidate-ht disqualified-ht
            binder-ht
            _extended-ht _direct-callees-ht)
         (closure-conversion-analysis T))
    (define labels-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! labels-ht ab (new-var "label")))
    (for/list ([ab (in-list abs)])
      (list (label-name labels-ht ab)
            (hash-ref kind-ht ab 'closed)
            (hash-ref direct-candidate-ht ab #f)
            (hash-ref disqualified-ht ab #f)
            (match (hash-ref binder-ht ab #f)
              [#f #f]
              [x  (syntax-e (variable-id x))])
            (map syntax-e (map variable-id (id-set->list (hash-ref free-ht ab empty-set))))
            (map site-source (hash-ref direct-sites-ht ab '()))))))

;; summarize-extended-closure-conversion-analysis
;; : LANF  -> (listof
;;              (list symbol?          ; label
;;                    symbol?          ; kind
;;                    (listof symbol?) ; free-vars
;;                    (listof symbol?) ; extended-vars
;;                    (listof symbol?))) ; direct-callees
;;   Return one summary row per abstraction.
;;
;; Each row has the form:
;;   (list label kind free-vars extended-vars direct-callees)
;; where:
;; - label:          a fresh readable name used only in the summary
;; - kind:           one of `closed`, `trivial-closed`, or `direct`
;; - free-vars:      the ordinary free-variable set of the abstraction
;; - extended-vars:  the propagated direct-helper env set
;; - direct-callees: the abstractions this helper directly calls, reported by summary label
;;
;; This summary is the compact “what did extended-env analysis discover?”
;; view. It extends the ordinary free-variable summary with the propagated
;; env needs and the direct-helper call graph used to compute them.
;;
;; Example:
;;
;;   (let ([x 1])
;;     (let ([f (lambda () x)])
;;       (let ([g (lambda () (f))])
;;         (g))))
;;
;; Conceptually, the summary contains rows like:
;;
;;   (list 'label-f 'direct '(x) '(x) '())
;;   (list 'label-g 'direct '()  '(x) '(label-f))
;;
;; Here `g` has no ordinary free variables of its own, but its
;; `extended-vars` still include `x` because `g` directly calls `f`,
;; and `f` needs `x`.
(define (summarize-extended-closure-conversion-analysis T)
  (define (label-name labels-ht ab)
    (syntax-e (variable-id (hash-ref labels-ht ab))))
  (letv ((T free-ht abs kind-ht _direct-sites-ht _direct-candidate-ht _disqualified-ht
            _binder-ht
            extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (define labels-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! labels-ht ab (new-var "label")))
    (for/list ([ab (in-list abs)])
      (list (label-name labels-ht ab)
            (hash-ref kind-ht ab 'closed)
            (map syntax-e (map variable-id (id-set->list (hash-ref free-ht ab empty-set))))
            (map syntax-e (map variable-id (id-set->list (hash-ref extended-ht ab empty-set))))
            (map (λ (callee) (label-name labels-ht callee))
                 (hash-ref direct-callees-ht ab '()))))))

;; summarize-direct-layout-closure-conversion-analysis
;; : LANF -> (listof
;;             (list symbol?          ; label
;;                   (listof symbol?) ; free-vars
;;                   (listof symbol?) ; extended-vars
;;                   boolean?))       ; same-layout?
;;   Return one summary row for each abstraction currently classified as `direct`.
;;
;; Each row has the form:
;;   (list label free-vars extended-vars same-layout?)
;; where:
;; - label:         a fresh readable name used only in the summary
;; - free-vars:     the ordinary free-variable set of the direct helper
;; - extended-vars: the propagated direct-helper env set
;; - same-layout?:  whether the ordinary free-variable set and the extended
;;                  env set are equal
;;
;; This summary is a compact “does direct-helper env propagation change the
;; layout?” view. It is useful for spotting helpers where extended env needs
;; differ from ordinary free variables.
;;
;; Example:
;;
;;   (let ([x 1])
;;     (let ([f (lambda () x)])
;;       (let ([g (lambda () (f))])
;;         (g))))
;;
;; Conceptually, the summary contains rows like:
;;
;;   (list 'label-f '(x) '(x) #t)
;;   (list 'label-g '()  '(x) #f)
;;
;; Here `f` has the same ordinary and extended env needs, but `g` does not:
;; `g` has no ordinary free variables of its own, while its extended env set
;; still contains `x` because `g` directly calls `f`.
(define (summarize-direct-layout-closure-conversion-analysis T)
  (define (label-name labels-ht ab)
    (syntax-e (variable-id (hash-ref labels-ht ab))))
  (define (vars-of xs)
    (map syntax-e (map variable-id (id-set->list xs))))
  (letv ((T free-ht abs kind-ht _direct-sites-ht _direct-candidate-ht _disqualified-ht
            _binder-ht
            extended-ht _direct-callees-ht)
         (closure-conversion-analysis T))
    (define labels-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! labels-ht ab (new-var "label")))
    (for/list ([ab (in-list abs)]
               #:when (eq? (hash-ref kind-ht ab 'closed) 'direct))
      (define free-vars     (vars-of (hash-ref free-ht ab empty-set)))
      (define extended-vars (vars-of (hash-ref extended-ht ab empty-set)))
      (list (label-name labels-ht ab)
            free-vars
            extended-vars
            (equal? free-vars extended-vars)))))

;; summarize-direct-helper-environment-closure-conversion-analysis
;; : LANF -> (listof
;;             (list symbol?            ; label
;;                   (or/c symbol? #f)  ; binder
;;                   (listof symbol?)   ; raw-free-vars
;;                   (listof symbol?)   ; extended-vars
;;                   (listof symbol?)   ; body-layout
;;                   (listof symbol?))) ; closure-env
;;   Return one summary row for each abstraction currently classified as `direct`.
;;
;; Each row has the form:
;;   (list label binder raw-free-vars extended-vars body-layout closure-env)
;; where:
;; - label:         a fresh readable name used only in the summary
;; - binder:        the local binder naming the helper, or `#f`
;; - raw-free-vars: the ordinary free-variable set of the helper
;; - extended-vars: the propagated direct-helper env set
;; - body-layout:   the variables currently carried as lifted-body env operands
;; - closure-env:   the variables currently stored in the closure payload
;;
;; This summary makes the environment views explicit for direct helpers.
;; In the current compiler, `body-layout` and `closure-env` may still keep some
;; direct-helper bindings that `extended-vars` has dropped, because the
;; compiler still supports ordinary closure-backed direct calls alongside the
;; `known0`, `known1`, and known-only helper paths.
(define (summarize-direct-helper-environment-closure-conversion-analysis T)
  (define (label-name labels-ht ab)
    (syntax-e (variable-id (hash-ref labels-ht ab))))
  (define (vars-of xs)
    (map syntax-e (map variable-id (id-set->list xs))))
  (letv ((T free-ht abs kind-ht _direct-sites-ht _direct-candidate-ht _disqualified-ht
            binder-ht
            extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (define labels-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! labels-ht ab (new-var "label")))
    (for/list ([ab (in-list abs)]
               #:when (eq? (hash-ref kind-ht ab 'closed) 'direct))
      (define raw-free-vars (vars-of (hash-ref free-ht ab empty-set)))
      (define extended-vars (vars-of (hash-ref extended-ht ab empty-set)))
      (define layout-vars   (direct-helper-layout-free-vars ab free-ht kind-ht binder-ht direct-callees-ht))
      (list (label-name labels-ht ab)
            (match (hash-ref binder-ht ab #f)
              [#f #f]
              [x  (syntax-e (variable-id x))])
            raw-free-vars
            extended-vars
            layout-vars
            layout-vars))))

;; summarize-closure-layout-arity-closure-conversion-analysis
;; : LANF -> (listof
;;             (list symbol?           ; label
;;                   (or/c symbol? #f) ; binder
;;                   symbol?           ; kind
;;                   exact-nonnegative-integer? ; closure-layout-arity
;;                   (or/c 0 1 2 3 '4+))) ; bucket
;;   Return one summary row per abstraction.
;;
;; Each row has the form:
;;   (list label binder kind closure-layout-arity bucket)
;; where:
;; - label:                a fresh readable name used only in the summary
;; - binder:               the local binder naming the abstraction, or `#f`
;; - kind:                 one of `closed`, `trivial-closed`, or `direct`
;; - closure-layout-arity: the number of values currently stored in the
;;                         abstraction's closure payload
;; - bucket:               the coarse arity bucket `0`, `1`, `2`, `3`, or `4+`
;;
;; This summary is the compact “how large are the current closure payloads?”
;; view. It is useful when comparing ordinary closure storage against
;; direct-helper env layouts and the inline `$Closure1`/`$Closure2`/`$Closure3`
;; representations.
(define (summarize-closure-layout-arity-closure-conversion-analysis T)
  (define (label-name labels-ht ab)
    (syntax-e (variable-id (hash-ref labels-ht ab))))
  (letv ((T free-ht abs kind-ht _direct-sites-ht _direct-candidate-ht _disqualified-ht
            binder-ht
            _extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (define labels-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! labels-ht ab (new-var "label")))
    (for/list ([ab (in-list abs)])
      (define kind (hash-ref kind-ht ab 'closed))
      (define closure-layout-vars
        (if (eq? kind 'direct)
            (direct-helper-layout-free-vars ab free-ht kind-ht binder-ht direct-callees-ht)
            (id-set->list (hash-ref free-ht ab empty-set))))
      (define closure-layout-arity (length closure-layout-vars))
      (list (label-name labels-ht ab)
            (match (hash-ref binder-ht ab #f)
              [#f #f]
              [x  (syntax-e (variable-id x))])
            kind
            closure-layout-arity
            (cond
              [(<= closure-layout-arity 3) closure-layout-arity]
              [else                        '4+])))))

;; summarize-closure-layout-arity-counts-closure-conversion-analysis
;; : LANF -> (listof
;;             (list (or/c 0 1 2 3 '4+) ; bucket
;;                   exact-nonnegative-integer?)) ; count
;;   Return histogram counts for current closure-layout payload sizes.
;;
;; Each row has the form:
;;   (list bucket count)
;; where:
;; - bucket: one of `0`, `1`, `2`, `3`, or `4+`
;; - count:  the number of abstractions whose current closure payload arity
;;           falls into that bucket
(define (summarize-closure-layout-arity-counts-closure-conversion-analysis T)
  (define counts
    (make-hasheq '((0 . 0) (1 . 0) (2 . 0) (3 . 0) (4+ . 0))))
  (for ([entry (in-list (summarize-closure-layout-arity-closure-conversion-analysis T))])
    (match entry
      [(list _label _binder _kind _arity bucket)
       (hash-set! counts bucket (add1 (hash-ref counts bucket 0)))]))
  (for/list ([bucket '(0 1 2 3 4+)])
    (list bucket (hash-ref counts bucket 0))))

;; summarize-known-helper-abi-plan-closure-conversion-analysis
;; : LANF -> (listof
;;             (list symbol?            ; label
;;                   (or/c symbol? #f)  ; binder
;;                   symbol?            ; kind
;;                   boolean?           ; fixed-arity?
;;                   (listof symbol?)   ; layout-vars
;;                   (listof symbol?)   ; extended-vars
;;                   symbol?            ; plan
;;                   (listof symbol?))) ; blockers
;;   Return one summary row per abstraction.
;;
;; Each row has the form:
;;   (list label binder kind fixed-arity? layout-vars extended-vars plan blockers)
;; where:
;; - label:         a fresh readable name used only in the summary
;; - binder:        the local binder naming the abstraction, or `#f`
;; - kind:          one of `closed`, `trivial-closed`, or `direct`
;; - fixed-arity?:  whether the abstraction has fixed-arity source formals
;; - layout-vars:   the current env layout considered for helper lowering
;; - extended-vars: the propagated direct-helper env set
;; - plan:          a conservative ABI plan such as `known/env0`, `known/env1`,
;;                  `known/env2`, `generic-closure`, or `not-eligible`
;; - blockers:      reasons the helper cannot currently use the planned ABI
;;
;; This summary is the compact “what known-helper ABI shape looks plausible?”
;; view. It is conservative and is meant for inspection and measurement, not
;; as a direct promise of current lowering behavior.
(define (summarize-known-helper-abi-plan-closure-conversion-analysis T)
  (define (label-name labels-ht ab)
    (syntax-e (variable-id (hash-ref labels-ht ab))))
  (define (vars-of xs)
    (map syntax-e (map variable-id (id-set->list xs))))
  (define (plan-of kind fixed-arity? layout-vars extended-vars self-recursive?)
    (define blockers
      (append
       (if fixed-arity?
           '()
           '(non-fixed-arity))
       (if (equal? layout-vars extended-vars)
           '()
           '(layout-extended-mismatch))
       (if self-recursive?
           '(self-recursive)
           '())
       (if (<= (length layout-vars) 2)
           '()
           '(env-too-large))))
    (cond
      [(not (eq? kind 'direct))
       (values 'generic-closure '(non-direct))]
      [(pair? blockers)
       (values 'not-eligible blockers)]
      [else
       (values (case (length layout-vars)
                 [(0) 'known/env0]
                 [(1) 'known/env1]
                 [(2) 'known/env2]
                 [else 'not-eligible])
               '())]))
  (letv ((T free-ht abs kind-ht _direct-sites-ht _direct-candidate-ht _disqualified-ht
            binder-ht
            extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (define labels-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! labels-ht ab (new-var "label")))
    (for/list ([ab (in-list abs)])
      (define kind (hash-ref kind-ht ab 'closed))
      (define fixed-arity? (abstraction-fixed-arity? ab))
      (define layout-vars
        (if (eq? kind 'direct)
            (direct-helper-layout-free-vars ab free-ht kind-ht binder-ht direct-callees-ht)
            (vars-of (hash-ref free-ht ab empty-set))))
      (define extended-vars (vars-of (hash-ref extended-ht ab empty-set)))
      (define self-recursive?
        (and (eq? kind 'direct)
             (direct-self-recursive? ab free-ht binder-ht)))
      (define-values (plan blockers)
        (plan-of kind fixed-arity? layout-vars extended-vars self-recursive?))
      (list (label-name labels-ht ab)
            (match (hash-ref binder-ht ab #f)
              [#f #f]
              [x  (syntax-e (variable-id x))])
            kind
            fixed-arity?
            layout-vars
            extended-vars
            plan
            blockers))))

;;;
;;; Direct-Helper Base Needs And Origin
;;;

;;; This pass computes two analysis tables for abstractions:
;;; - base env needs for direct helpers
;;; - binding origin (`let-values`, `letrec-values`, or `other`)
;;;
;;; Base needs are the helper's own env demand before propagated
;;; direct-callee needs are added by extended-env analysis.

;; determine-direct-helper-base-needs!
;; : LANF
;;   (hasheq/c any/c id-set?)   ; free-ht
;;   (listof any/c)             ; abs
;;   (hasheq/c any/c symbol?)   ; kind-ht
;;   -> (values (hasheq/c any/c id-set?)   ; base-needs-ht
;;              (hasheq/c any/c symbol?))  ; origin-ht
;;   Compute direct-helper base needs and binding origin, without rewriting
;;   the program.
;;
;; The returned tables record:
;; - base-needs-ht:  abstraction -> base env needs
;; - origin-ht:      abstraction -> `let-values`, `letrec-values`, or `other`
;;
;; A helper's base needs are its ordinary free variables after removing
;; locally known direct-helper binders from lexical scope. In other words,
;; this is the helper's own env demand before propagated direct-callee
;; needs are added by extended-env analysis.

(define (determine-direct-helper-base-needs! T free-ht abs kind-ht)
  (define base-needs-ht (make-hasheq))
  (define origin-ht     (make-hasheq))

  (define (free-set-of ab)
    (hash-ref free-ht ab empty-set))

  (define (kind-of ab)
    (hash-ref kind-ht ab 'closed))

  (define (direct-helper? ab)
    (eq? (kind-of ab) 'direct))

  (define (env-empty)
    (make-immutable-free-id-table))

  (define (env-ref ρ x)
    (free-id-table-ref ρ (variable-id x) #f))

  (define (env-bind ρ x ab)
    (free-id-table-set ρ (variable-id x) ab))

  (define (env-bind* ρ xs abs)
    (for/fold ([ρ ρ]) ([x  (in-list xs)]
                       [ab (in-list abs)])
      (env-bind ρ x ab)))

  (define (env-shadow* ρ xs)
    (for/fold ([ρ ρ]) ([x (in-list xs)])
      (free-id-table-set ρ (variable-id x) #f)))

  (define (formals->variables f)
    (nanopass-case (LANF Formals) f
      [(formals (,x ...))            x]
      [(formals (,x0 ,x1 ... . ,xd)) (cons x0 (append x1 (list xd)))]
      [(formals ,x)                  (list x)]))

  (define (clause-bound-abstraction ce)
    (nanopass-case (LANF CExpr) ce
      [,ae
       (nanopass-case (LANF AExpr) ae
         [,ab  ab]
         [,cab cab]
         [else #f])]
      [else #f]))

  (define (clause-local-binding xs ce)
    (match xs
      [(list x)
       (define ab (clause-bound-abstraction ce))
       (and ab (cons x ab))]
      [_ #f]))

  (define (clause-local-bindings xss ces)
    (for/fold ([pairs '()]) ([xs (in-list xss)]
                             [ce (in-list ces)])
      (define pair (clause-local-binding xs ce))
      (if pair
          (cons pair pairs)
          pairs)))

  (define (direct-free-base-of ab ρ)
    (for/fold ([xs (free-set-of ab)]) ([x (in-list (id-set->list (free-set-of ab)))])
      (match (env-ref ρ x)
        [bound-ab (if (and bound-ab (direct-helper? bound-ab))
                      (set-remove xs x)
                      xs)]
        [_ xs])))

  (define current-helper-env
    (make-parameter (env-empty)))

  (for ([ab (in-list abs)])
    (hash-set! base-needs-ht ab (free-set-of ab))
    (hash-set! origin-ht ab 'other))

  (define-pass analyze : LANF (T) -> * ()
    (TopLevelForm : TopLevelForm (T) -> * ()
      [(topbegin ,s ,t ...)
       (for ([t (in-list t)])
         (TopLevelForm t))]
      [(topmodule ,s ,mn ,mp ,mf ...)
       (for ([m (in-list mf)])
         (ModuleLevelForm m))]
      [(#%expression ,s ,e)
       (Expr e)]
      [,g
       (GeneralTopLevelForm g)])
    (ModuleLevelForm : ModuleLevelForm (M) -> * ()
      [(#%provide ,rps ...)
       (void)]
      [,g
       (GeneralTopLevelForm g)])
    (GeneralTopLevelForm : GeneralTopLevelForm (G) -> * ()
      [(define-values ,s (,x ...) ,e)
       (Expr e)]
      [(define-syntaxes ,s (,x ...) ,e)
       (Expr e)]
      [(#%require ,s ,rrs ...)
       (void)]
      [,e
       (Expr e)])
    (Abstraction : Abstraction (AB) -> * ()
      [(λ ,s ,f ,e)
       (hash-set! base-needs-ht AB
                  (direct-free-base-of AB (current-helper-env)))
       (parameterize ([current-helper-env
                       (env-shadow* (current-helper-env) (formals->variables f))])
         (Expr e))])
    (CaseAbstraction : CaseAbstraction (CAB) -> * ()
      [(case-lambda ,s ,ab* ...)
       (for ([ab (in-list ab*)])
         (Abstraction ab))])
    (AExpr : AExpr (AE) -> * ()
      [,x (void)]
      [,ab (Abstraction ab)]
      [,cab (CaseAbstraction cab)]
      [(quote ,s ,d) (void)]
      [(quote-syntax ,s ,d) (void)]
      [(top ,s ,x) (void)]
      [(variable-reference ,s ,vrx) (void)])
    (CExpr : CExpr (CE) -> * ()
      [,ae
       (AExpr ae)]
      [(set! ,s ,x ,ae)
       (AExpr ae)]
      [(if ,s ,ae0 ,e1 ,e2)
       (AExpr ae0)
       (Expr e1)
       (Expr e2)]
      [(wcm ,s ,ae0 ,ae1 ,e)
       (AExpr ae0)
       (AExpr ae1)
       (Expr e)]
      [(app ,s ,ae ,ae1 ...)
       (AExpr ae)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(primapp ,s ,pr ,ae1 ...)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(closedapp ,s ,ab ,ae1 ...)
       (Abstraction ab)
       (for ([ae1 (in-list ae1)])
         (AExpr ae1))]
      [(begin ,s ,e0 ,e1 ...)
       (Expr e0)
       (for ([e (in-list e1)])
         (Expr e))]
      [(begin0 ,s ,e0 ,e1 ...)
       (Expr e0)
       (for ([e (in-list e1)])
         (Expr e))])
    (Expr : Expr (E) -> * ()
      [,ce
       (CExpr ce)]
      [(let-values ,s (((,x ...) ,ce*) ...) ,e)
       (for ([ce (in-list ce*)])
         (CExpr ce))
       (define pairs (reverse (clause-local-bindings x ce*)))
       (define xs    (map car pairs))
       (define abs   (map cdr pairs))
       (for ([ab (in-list abs)])
         (hash-set! origin-ht ab 'let-values))
       (define direct-pairs
         (filter (λ (pair) (direct-helper? (cdr pair))) pairs))
       (define dxs  (map car direct-pairs))
       (define dabs (map cdr direct-pairs))
       (parameterize ([current-helper-env
                       (env-bind* (current-helper-env) dxs dabs)])
         (Expr e))]
      [(letrec-values ,s (((,x ...) ,ce*) ...) ,e)
       (define pairs (reverse (clause-local-bindings x ce*)))
       (define xs    (map car pairs))
       (define abs   (map cdr pairs))
       (for ([ab (in-list abs)])
         (hash-set! origin-ht ab 'letrec-values))
       (define direct-pairs
         (filter (λ (pair) (direct-helper? (cdr pair))) pairs))
       (define dxs  (map car direct-pairs))
       (define dabs (map cdr direct-pairs))
       (parameterize ([current-helper-env
                       (env-bind* (current-helper-env) dxs dabs)])
         (for ([ce (in-list ce*)])
           (CExpr ce))
         (Expr e))]))

  (parameterize ([current-helper-env (env-empty)])
    (analyze T))
  (values base-needs-ht origin-ht))

;; summarize-direct-helper-env-plan-closure-conversion-analysis
;; : LANF -> (listof
;;             (list symbol?            ; label
;;                   (or/c symbol? #f)  ; binder
;;                   symbol?            ; kind
;;                   symbol?            ; origin
;;                   boolean?           ; fixed-arity?
;;                   boolean?           ; direct-candidate?
;;                   boolean?           ; disqualified?
;;                   (listof symbol?)   ; base-vars
;;                   (listof symbol?)   ; extended-vars
;;                   (listof symbol?)   ; direct-callees
;;                   symbol?            ; plan
;;                   (listof symbol?))) ; blockers
;;   Return one summary row per abstraction.
;;
;; Each row has the form:
;;   (list label binder kind origin fixed-arity? direct-candidate?
;;         disqualified? base-vars extended-vars direct-callees plan blockers)
;; where:
;; - base-vars:      the abstraction's direct-helper base needs before
;;                   propagated callee needs are added
;; - extended-vars:  the propagated direct-helper env set
;; - direct-callees: the helper's direct callees, reported by binder name when
;;                   available
;; - plan/blockers:  a conservative ABI plan together with reasons it may not
;;                   be usable
;;
;; This summary is the compact “what env-propagation shape does each helper
;; have?” view. It combines the direct-helper base-needs analysis with the
;; propagated extended env and a conservative ABI plan.
(define (summarize-direct-helper-env-plan-closure-conversion-analysis T)
  (define (label-name labels-ht ab)
    (syntax-e (variable-id (hash-ref labels-ht ab))))
  (define (vars-of xs)
    (sort (map syntax-e (map variable-id (id-set->list xs))) symbol<?))
  (define (binder-name binder)
    (match binder
      [#f #f]
      [x  (syntax-e (variable-id x))]))
  (define (callee-binder-names callees binder-ht)
    (sort
     (for/list ([callee (in-list callees)])
       (match (hash-ref binder-ht callee #f)
         [#f 'anonymous]
         [x  (syntax-e (variable-id x))]))
     symbol<?))
  (define (planned-abi kind fixed-arity? extended-vars)
    (cond
      [(not (eq? kind 'direct)) 'generic-closure]
      [(not fixed-arity?)       'generic-closure]
      [else
       (case (length extended-vars)
         [(0) 'known/env0]
         [(1) 'known/env1]
         [(2) 'known/env2]
         [else 'generic-closure])]))
  (define (blockers kind candidate? disqualified? fixed-arity? origin extended-vars)
    (append
     (if candidate? '() '(not-direct-candidate))
     (if disqualified? '(value-use) '())
     (if (eq? kind 'direct) '() '(non-direct))
     (if fixed-arity? '() '(non-fixed-arity))
     (if (eq? origin 'letrec-values) '(letrec-origin) '())
     (if (<= (length extended-vars) 2) '() '(env-too-large))))
  (letv ((T free-ht abs kind-ht direct-sites-ht direct-candidate-ht disqualified-ht
            binder-ht
            extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (define-values (base-needs-ht origin-ht)
      (determine-direct-helper-base-needs! T free-ht abs kind-ht))
    (define labels-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! labels-ht ab (new-var "label")))
    (for/list ([ab (in-list abs)])
      (define kind         (hash-ref kind-ht ab 'closed))
      (define candidate?   (hash-ref direct-candidate-ht ab #f))
      (define disqualified? (hash-ref disqualified-ht ab #f))
      (define fixed-arity? (abstraction-fixed-arity? ab))
      (define base-vars    (vars-of (hash-ref base-needs-ht ab empty-set)))
      (define extended-vars (vars-of (hash-ref extended-ht ab empty-set)))
      (define plan         (planned-abi kind fixed-arity? extended-vars))
      (define blockers*    (blockers kind candidate? disqualified? fixed-arity?
                                     (hash-ref origin-ht ab 'other)
                                     extended-vars))
      (list (label-name labels-ht ab)
            (binder-name (hash-ref binder-ht ab #f))
            kind
            (hash-ref origin-ht ab 'other)
            fixed-arity?
            candidate?
            disqualified?
            base-vars
            extended-vars
            (callee-binder-names (hash-ref direct-callees-ht ab '()) binder-ht)
            plan
            blockers*))))

;; summarize-direct-helper-env-availability-closure-conversion-analysis
;; : LANF -> (listof
;;             (list (or/c symbol? #f) ; caller
;;                   (or/c symbol? #f) ; callee
;;                   symbol?           ; caller-kind
;;                   (listof symbol?)  ; caller-formals
;;                   (listof symbol?)  ; caller-layout
;;                   (listof symbol?)  ; available
;;                   (listof symbol?)  ; needed
;;                   (listof symbol?)  ; missing
;;                   boolean?))        ; all-available?
;;   Return one summary row per direct caller/callee edge.
;;
;; Each row has the form:
;;   (list caller callee caller-kind caller-formals caller-layout
;;         available needed missing all-available?)
;; where:
;; - caller-layout:   the caller's current carried layout
;; - available:       the variables currently available to the caller from its
;;                    layout plus formals
;; - needed:          the callee's extended env needs
;; - missing:         the subset of `needed` not present in `available`
;; - all-available?:  whether the caller can currently source every needed env
;;                    variable for this direct edge
;;
;; This summary intentionally compares each direct callee's extended needs to
;; the caller's current available vars, not the future ideal layout. It is the
;; compact “which direct edges are blocked by current env availability?” view.
(define (summarize-direct-helper-env-availability-closure-conversion-analysis T)
  (define (label-name labels-ht ab)
    (syntax-e (variable-id (hash-ref labels-ht ab))))
  (define (binder-name binder)
    (match binder
      [#f #f]
      [x  (syntax-e (variable-id x))]))
  (define (symbols-of-id-set xs)
    (sort (map syntax-e (map variable-id (id-set->list xs))) symbol<?))
  (define (symbols-of-variables xs)
    (sort (map syntax-e (map variable-id xs)) symbol<?))
  (define (formals->variables f)
    (nanopass-case (LANF Formals) f
      [(formals (,x ...))            x]
      [(formals (,x0 ,x1 ... . ,xd)) (cons x0 (append x1 (list xd)))]
      [(formals ,x)                  (list x)]))
  (define (abstraction-formals ab)
    (nanopass-case (LANF AExpr) ab
      [(λ ,s ,f ,e) f]
      [else (error 'summarize-direct-helper-env-availability
                   "expected abstraction, got ~a" ab)]))
  (define (caller-layout-vars ab free-ht kind-ht binder-ht direct-callees-ht)
    (if (eq? (hash-ref kind-ht ab 'closed) 'direct)
        (direct-helper-layout-free-vars ab free-ht kind-ht binder-ht direct-callees-ht)
        (symbols-of-id-set (hash-ref free-ht ab empty-set))))
  (letv ((T free-ht abs kind-ht _direct-sites-ht _direct-candidate-ht _disqualified-ht
            binder-ht
            extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (define labels-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! labels-ht ab (new-var "label")))
    (for*/list ([caller (in-list abs)]
                [callee (in-list (hash-ref direct-callees-ht caller '()))]
                #:when (eq? (hash-ref kind-ht callee 'closed) 'direct))
      (define caller-kind (hash-ref kind-ht caller 'closed))
      (define caller-layout (caller-layout-vars caller free-ht kind-ht binder-ht direct-callees-ht))
      (define caller-formals (symbols-of-variables (formals->variables (abstraction-formals caller))))
      (define available
        (remove-duplicates
         (append caller-layout caller-formals)
         equal?))
      (define needed (symbols-of-id-set (hash-ref extended-ht callee empty-set)))
      (define missing
        (filter (λ (x)
                  (not (member x available)))
                needed))
      (list (binder-name (hash-ref binder-ht caller #f))
            (binder-name (hash-ref binder-ht callee #f))
            caller-kind
            caller-formals
            (sort caller-layout symbol<?)
            (sort available symbol<?)
            needed
            (sort missing symbol<?)
            (null? missing)))))

;; summarize-direct-helper-layout-concepts-closure-conversion-analysis
;; : LANF -> (listof
;;             (list (or/c symbol? #f) ; binder
;;                   symbol?           ; kind
;;                   (listof symbol?)  ; body-layout
;;                   (listof symbol?)  ; closure-env
;;                   (listof symbol?)  ; extended-vars
;;                   boolean?))        ; same-layout?
;;   Return one summary row per abstraction.
;;
;; Each row has the form:
;;   (list binder kind body-layout closure-env extended-vars same-layout?)
;; where:
;; - body-layout:   the variables currently carried as lifted-body env operands
;; - closure-env:   the variables currently stored in the closure payload
;; - extended-vars: the propagated direct-helper env set
;; - same-layout?:  whether the current carried layout already matches the
;;                  propagated direct-helper env set
;;
;; This summary keeps the two layout roles explicit even when they are backed
;; by the same current computation. It is the compact “how do the current body
;; and closure layouts compare to the propagated env target?” view.
(define (summarize-direct-helper-layout-concepts-closure-conversion-analysis T)
  (define (binder-name binder)
    (match binder
      [#f #f]
      [x  (syntax-e (variable-id x))]))
  (define (symbols-of-id-set xs)
    (sort (map syntax-e (map variable-id (id-set->list xs))) symbol<?))
  (define (layout-vars-of ab free-ht kind-ht binder-ht direct-callees-ht)
    (sort
     (direct-helper-layout-free-vars ab free-ht kind-ht binder-ht direct-callees-ht)
     symbol<?))
  (letv ((T free-ht abs kind-ht _direct-sites-ht _direct-candidate-ht _disqualified-ht
            binder-ht
            extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (for/list ([ab (in-list abs)])
      (define layout-vars   (layout-vars-of ab free-ht kind-ht binder-ht direct-callees-ht))
      (define extended-vars (symbols-of-id-set (hash-ref extended-ht ab empty-set)))
      (list (binder-name (hash-ref binder-ht ab #f))
            (hash-ref kind-ht ab 'closed)
            layout-vars    ; current body-layout
            layout-vars    ; current closure-env
            extended-vars
            (equal? layout-vars extended-vars)))))

(struct known-helper-summary-state
  (label binder kind origin fixed-arity? plain-lambda? formals
         direct-candidate? disqualified?
         direct-self-recursive? nested-lift-sensitive? nested-capture-vars
         extended-layout body-layout closure-env
         incoming-callers outgoing-callees
         current-known-abi current-known-only env-sourceable-for-known-abi?)
  #:transparent)

;; compute-known-helper-summary-state : LANF
;;                                   -> (values (listof any/c)
;;                                              (hasheq/c any/c known-helper-summary-state?))
;;   Compute the shared current known-helper view used by analysis summaries.
(define (compute-known-helper-summary-state T)
  (define (label-name labels-ht ab)
    (syntax-e (variable-id (hash-ref labels-ht ab))))
  (define (binder-name binder)
    (match binder
      [#f #f]
      [x  (syntax-e (variable-id x))]))
  (define (sorted-vars xs)
    (sort xs symbol<?))
  (define (symbols-of-id-set xs)
    (sorted-vars (map syntax-e (map variable-id (id-set->list xs)))))
  (define (symbols-of-variables xs)
    (sorted-vars (map syntax-e (map variable-id xs))))
  (define (index-of x free)
    (index-where free (λ (y) (equal? x y))))
  (define (formals->variables f)
    (nanopass-case (LANF Formals) f
      [(formals (,x ...))            x]
      [(formals (,x0 ,x1 ... . ,xd)) (cons x0 (append x1 (list xd)))]
      [(formals ,x)                  (list x)]))
  (define (abstraction-formals ab who)
    (nanopass-case (LANF AExpr) ab
      [(λ ,s ,f ,e) f]
      [else (error who "expected abstraction, got ~a" ab)]))
  (define (plain-lambda? ab)
    (nanopass-case (LANF AExpr) ab
      [(λ ,s ,f ,e) #t]
      [else #f]))
  (define (abstraction-formals/safe ab who)
    (and (plain-lambda? ab)
         (abstraction-formals ab who)))
  (define (abstraction-fixed-arity?/safe ab)
    (and (plain-lambda? ab)
         (abstraction-fixed-arity? ab)))
  (letv ((T free-ht abs kind-ht _direct-sites-ht direct-candidate-ht disqualified-ht
            binder-ht
            extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (define-values (_base-needs-ht origin-ht)
      (determine-direct-helper-base-needs! T free-ht abs kind-ht))
    (define labels-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! labels-ht ab (new-var "label")))
    (define closure-env-vars-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! closure-env-vars-ht
                 ab
                 (if (eq? (hash-ref kind-ht ab 'closed) 'direct)
                     (direct-helper-layout-free-vars ab free-ht kind-ht binder-ht direct-callees-ht)
                     (id-set->list (hash-ref free-ht ab empty-set)))))
    (define current-body-layout-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! current-body-layout-ht ab (hash-ref closure-env-vars-ht ab '())))
    (define (current-body-layout-of ab)
      (hash-ref current-body-layout-ht ab '()))
    (define (closure-env-of ab)
      (hash-ref closure-env-vars-ht ab '()))
    (define (extended-layout-of ab)
      (symbols-of-id-set (hash-ref extended-ht ab empty-set)))
    (define (direct-self-recursive? ab)
      (let ([binder (hash-ref binder-ht ab #f)])
        (and binder
             (for/or ([x (in-list (symbols-of-id-set (hash-ref free-ht ab empty-set)))])
               (equal? x (syntax-e (variable-id binder)))))))
    (define (known0-current? ab)
      (and (eq? (hash-ref kind-ht ab 'closed) 'direct)
           (abstraction-fixed-arity?/safe ab)
           (not (direct-self-recursive? ab))
           (null? (extended-layout-of ab))
           (null? (current-body-layout-of ab))))
    (define (known1-current? ab)
      (and (eq? (hash-ref kind-ht ab 'closed) 'direct)
           (abstraction-fixed-arity?/safe ab)
           (not (direct-self-recursive? ab))
           (= (length (extended-layout-of ab)) 1)
           (= (length (current-body-layout-of ab)) 1)
           (let ([x (car (extended-layout-of ab))])
             (index-of x (closure-env-of ab)))))
    (define (callee-known-abi-current? callee)
      (or (known0-current? callee)
          (known1-current? callee)))
    (define changed? #t)
    (let loop ()
      (when changed?
        (set! changed? #f)
        (for ([ab (in-list abs)]
              #:when (eq? (hash-ref kind-ht ab 'closed) 'direct))
          (when (and (current-enable-cc-analysis?)
                     (abstraction-fixed-arity?/safe ab)
                     (not (direct-self-recursive? ab))
                     (not (nested-lift-sensitive-form-present? ab))
                     (zero? (length (extended-layout-of ab)))
                     (for/and ([callee (in-list (hash-ref direct-callees-ht ab '()))])
                       (callee-known-abi-current? callee)))
            (unless (equal? (current-body-layout-of ab) (extended-layout-of ab))
              (hash-set! current-body-layout-ht ab (extended-layout-of ab))
              (set! changed? #t)))))
        (when changed?
          (loop)))
    (define incoming-callers-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! incoming-callers-ht ab '()))
    (for ([(caller callees) (in-hash direct-callees-ht)])
      (for ([callee (in-list callees)])
        (hash-set! incoming-callers-ht
                   callee
                   (cons caller (hash-ref incoming-callers-ht callee '())))))
    (define state-ht (make-hasheq))
    (define (caller-sourceable? caller env-vars)
      (define caller-state (hash-ref state-ht caller #f))
      (define caller-formals
        (if caller-state
            (known-helper-summary-state-formals caller-state)
            (match (abstraction-formals/safe caller 'compute-known-helper-summary-state)
              [#f '()]
              [f  (symbols-of-variables (formals->variables f))])))
      (define caller-layout
        (if caller-state
            (known-helper-summary-state-body-layout caller-state)
            (current-body-layout-of caller)))
      (define available
        (remove-duplicates
         (append caller-layout caller-formals)
         equal?))
      (for/and ([x (in-list env-vars)])
        (for/or ([y (in-list available)])
          (equal? x y))))
    (for ([ab (in-list abs)])
      (define plain? (plain-lambda? ab))
      (define formals
        (match (abstraction-formals/safe ab 'compute-known-helper-summary-state)
          [#f '()]
          [f  (symbols-of-variables (formals->variables f))]))
      (define extended-layout (extended-layout-of ab))
      (define current-known-abi
        (cond
          [(known0-current? ab) 'known0]
          [(known1-current? ab) 'known1]
          [(and (eq? (hash-ref kind-ht ab 'closed) 'direct)
                (abstraction-fixed-arity?/safe ab)
                (not (direct-self-recursive? ab))
                (= (length extended-layout) 2))
           'possible-known2]
          [else
           'generic]))
      (define env-sourceable-for-known-abi?
        (cond
          [(eq? current-known-abi 'known0) #t]
          [(eq? current-known-abi 'known1)
           (let ([x (car extended-layout)])
             (for/and ([caller (in-list (hash-ref incoming-callers-ht ab '()))])
               (and (eq? (hash-ref kind-ht caller 'closed) 'direct)
                    (caller-sourceable? caller (list x)))))]
          [else #f]))
      (define nested-capture-vars
        (for/list ([x (in-list extended-layout)]
                   #:when (nested-variable-capture-present? ab x))
          x))
      (define current-known-only
        (cond
          [(and (eq? current-known-abi 'known0)
                plain?
                (eq? (hash-ref origin-ht ab 'other) 'let-values)
                (not (hash-ref disqualified-ht ab #f)))
           'known0-only]
          [(and (eq? current-known-abi 'known1)
                plain?
                (eq? (hash-ref origin-ht ab 'other) 'let-values)
                (not (hash-ref disqualified-ht ab #f))
                (not (nested-lift-sensitive-form-present? ab))
                (let ([x (car extended-layout)])
                  (and (not (nested-variable-capture-present? ab x))
                       (for/and ([caller (in-list (hash-ref incoming-callers-ht ab '()))])
                         (and (eq? (hash-ref kind-ht caller 'closed) 'direct)
                              (caller-sourceable? caller (list x)))))))
           'known1-only]
          [(and (eq? (hash-ref kind-ht ab 'closed) 'direct)
                plain?
                (eq? (hash-ref origin-ht ab 'other) 'let-values)
                (not (hash-ref disqualified-ht ab #f))
                (not (direct-self-recursive? ab))
                (not (nested-lift-sensitive-form-present? ab))
                (= (length extended-layout) 2)
                (for/and ([caller (in-list (hash-ref incoming-callers-ht ab '()))])
                  (and (eq? (hash-ref kind-ht caller 'closed) 'direct)
                       (caller-sourceable? caller extended-layout))))
           'possible-future-only]
          [else
           'none]))
      (hash-set! state-ht ab
                 (known-helper-summary-state
                  (label-name labels-ht ab)
                  (binder-name (hash-ref binder-ht ab #f))
                  (hash-ref kind-ht ab 'closed)
                  (hash-ref origin-ht ab 'other)
                  (abstraction-fixed-arity?/safe ab)
                  plain?
                  formals
                  (hash-ref direct-candidate-ht ab #f)
                  (hash-ref disqualified-ht ab #f)
                  (direct-self-recursive? ab)
                  (nested-lift-sensitive-form-present? ab)
                  nested-capture-vars
                  extended-layout
                  (current-body-layout-of ab)
                  (closure-env-of ab)
                  (hash-ref incoming-callers-ht ab '())
                  (hash-ref direct-callees-ht ab '())
                  current-known-abi
                  current-known-only
                  env-sourceable-for-known-abi?)))
    (values abs state-ht)))

;; summarize-direct-helper-payoff-frontier-closure-conversion-analysis
;; : LANF -> (listof
;;             (list symbol?            ; label
;;                   (or/c symbol? #f)  ; binder
;;                   symbol?            ; kind
;;                   symbol?            ; origin
;;                   boolean?           ; fixed-arity?
;;                   exact-nonnegative-integer? ; current-body-layout-size
;;                   exact-nonnegative-integer? ; current-closure-env-size
;;                   exact-nonnegative-integer? ; extended-layout-size
;;                   symbol?            ; current-known-abi
;;                   symbol?            ; known-only-class
;;                   boolean?           ; delete-closure-allocation?
;;                   boolean?           ; delete-ordinary-closure-code?
;;                   boolean?           ; only-change-body-layout?
;;                   exact-nonnegative-integer? ; direct-in-degree
;;                   exact-nonnegative-integer? ; direct-out-degree
;;                   (listof symbol?))) ; blockers
;;   Return one summary row for each abstraction on the current helper frontier.
;;
;; Each row reports whether a future change would delete something costly
;; (closure allocation or the ordinary closure-backed entry) or would only
;; change carried/body-layout shape.
(define (summarize-direct-helper-payoff-frontier-closure-conversion-analysis T)
  (define (frontier-abstraction? ab kind candidate? disqualified?)
    (or (eq? kind 'direct)
        candidate?
        disqualified?))
  (define-values (abs state-ht)
    (compute-known-helper-summary-state T))
    (define (blockers-of ab)
      (define state (hash-ref state-ht ab))
      (append
       (if (known-helper-summary-state-disqualified? state) '(value-use) '())
       (if (eq? (known-helper-summary-state-origin state) 'letrec-values) '(letrec) '())
       (if (known-helper-summary-state-direct-self-recursive? state) '(recursive) '())
       (if (> (length (known-helper-summary-state-extended-layout state)) 2) '(env-too-large) '())
       (if (known-helper-summary-state-plain-lambda? state) '() '(case-lambda))
       (if (and (positive? (length (known-helper-summary-state-extended-layout state)))
                (not (known-helper-summary-state-env-sourceable-for-known-abi? state))
                (memq (known-helper-summary-state-current-known-abi state)
                      '(known0 known1 possible-known2)))
           '(unavailable-env)
           '())
       (if (pair? (known-helper-summary-state-nested-capture-vars state))
           '(nested-capture)
           '())))
    (for/list ([ab (in-list abs)]
               #:when (frontier-abstraction? ab
                                            (known-helper-summary-state-kind (hash-ref state-ht ab))
                                            (known-helper-summary-state-direct-candidate? (hash-ref state-ht ab))
                                            (known-helper-summary-state-disqualified? (hash-ref state-ht ab))))
      (define state (hash-ref state-ht ab))
      (define current-body-layout-vars    (known-helper-summary-state-body-layout state))
      (define current-closure-env-vars    (known-helper-summary-state-closure-env state))
      (define extended-layout-vars        (known-helper-summary-state-extended-layout state))
      (define known-only-class            (known-helper-summary-state-current-known-only state))
      (define direct-out-degree           (length (known-helper-summary-state-outgoing-callees state)))
      (define direct-in-degree            (length (known-helper-summary-state-incoming-callers state)))
      (define delete-closure-allocation?  (not (eq? known-only-class 'none)))
      (define delete-ordinary-closure-code?
        delete-closure-allocation?)
      (define only-change-body-layout?
        (and (eq? known-only-class 'none)
             (> (length current-body-layout-vars) (length extended-layout-vars))))
      (list (known-helper-summary-state-label state)
            (known-helper-summary-state-binder state)
            (known-helper-summary-state-kind state)
            (known-helper-summary-state-origin state)
            (known-helper-summary-state-fixed-arity? state)
            (length current-body-layout-vars)
            (length current-closure-env-vars)
            (length extended-layout-vars)
            (known-helper-summary-state-current-known-abi state)
            known-only-class
            delete-closure-allocation?
            delete-ordinary-closure-code?
            only-change-body-layout?
            direct-in-degree
            direct-out-degree
            (blockers-of ab))))

;; summarize-known-helper-deletion-opportunities-closure-conversion-analysis
;; : LANF -> (listof
;;             (list symbol?            ; label
;;                   (or/c symbol? #f)  ; binder
;;                   symbol?            ; origin
;;                   symbol?            ; current-known-abi
;;                   symbol?            ; current-known-only
;;                   boolean?           ; closure-allocation-remains?
;;                   boolean?           ; ordinary-closure-code-remains?
;;                   boolean?           ; value-use?
;;                   boolean?           ; env-sourceable?
;;                   boolean?           ; nested-lift-sensitive?
;;                   (listof symbol?)   ; nested-capture-vars
;;                   boolean?           ; letrec?
;;                   boolean?           ; recursive?
;;                   boolean?           ; deletion-produced?
;;                   (listof symbol?))) ; blockers
;;   Return one summary row for helpers already in the `known0` / `known1`
;;   ABI families.
;;
;; This summary focuses on remaining closure-backed transition tax:
;; which helpers already delete allocation and base labels, and which helpers
;; stay in sibling `known0` / `known1` because of specific blockers.
(define (summarize-known-helper-deletion-opportunities-closure-conversion-analysis T)
  (define-values (abs state-ht)
    (compute-known-helper-summary-state T))
  (define (blockers-of ab)
    (define state (hash-ref state-ht ab))
    (append
     (if (known-helper-summary-state-disqualified? state) '(value-use) '())
     (if (eq? (known-helper-summary-state-origin state) 'letrec-values) '(letrec) '())
     (if (known-helper-summary-state-direct-self-recursive? state) '(recursive) '())
     (if (known-helper-summary-state-plain-lambda? state) '() '(case-lambda))
     (if (known-helper-summary-state-nested-lift-sensitive? state) '(nested-lift-sensitive) '())
     (if (null? (known-helper-summary-state-nested-capture-vars state)) '() '(nested-capture))
     (if (known-helper-summary-state-env-sourceable-for-known-abi? state) '() '(unavailable-env))))
  (for/list ([ab (in-list abs)]
             #:when (memq (known-helper-summary-state-current-known-abi (hash-ref state-ht ab))
                          '(known0 known1)))
    (define state (hash-ref state-ht ab))
    (define current-known-only (known-helper-summary-state-current-known-only state))
    (define deletion-produced?
      (not (eq? current-known-only 'none)))
    (list (known-helper-summary-state-label state)
          (known-helper-summary-state-binder state)
          (known-helper-summary-state-origin state)
          (known-helper-summary-state-current-known-abi state)
          current-known-only
          (not deletion-produced?)
          (not deletion-produced?)
          (known-helper-summary-state-disqualified? state)
          (known-helper-summary-state-env-sourceable-for-known-abi? state)
          (known-helper-summary-state-nested-lift-sensitive? state)
          (known-helper-summary-state-nested-capture-vars state)
          (eq? (known-helper-summary-state-origin state) 'letrec-values)
          (known-helper-summary-state-direct-self-recursive? state)
          deletion-produced?
          (blockers-of ab))))

;; summarize-direct-helper-known2-frontier-closure-conversion-analysis
;; : LANF -> (listof
;;             (list symbol?            ; label
;;                   (or/c symbol? #f)  ; binder
;;                   symbol?            ; origin
;;                   boolean?           ; fixed-arity?
;;                   symbol?            ; kind
;;                   boolean?           ; value-use?
;;                   boolean?           ; self-recursive?
;;                   boolean?           ; letrec?
;;                   boolean?           ; plain-lambda?
;;                   boolean?           ; nested-lift-sensitive?
;;                   (listof symbol?)   ; nested-capture-vars
;;                   (listof symbol?)   ; body-layout
;;                   (listof symbol?)   ; closure-env
;;                   (listof symbol?)   ; extended-layout
;;                   boolean?           ; body-layout-equals-extended?
;;                   boolean?           ; extended-needs-in-closure-env?
;;                   exact-nonnegative-integer? ; incoming-direct-callers
;;                   boolean?           ; all-callers-can-source-both-envs?
;;                   boolean?           ; would-be-sibling-only-safe?
;;                   (listof symbol?))) ; blockers
;;   Return one summary row for each binary-env helper frontier case.
;;
;; This summary is the compact “would a strictly sibling-only `known2` look
;; safe here?” view. It intentionally avoids making any lowering changes and
;; instead records why a binary-env helper is or is not a plausible `known2`
;; candidate under the current representation.
(define (summarize-direct-helper-known2-frontier-closure-conversion-analysis T)
  (define-values (abs state-ht)
    (compute-known-helper-summary-state T))
  (define (all-callers-can-source-both-envs? ab)
    (define state (hash-ref state-ht ab))
    (for/and ([caller (in-list (known-helper-summary-state-incoming-callers state))])
      (define caller-state (hash-ref state-ht caller))
      (and (eq? (known-helper-summary-state-kind caller-state) 'direct)
           (let ([available
                  (remove-duplicates
                   (append (known-helper-summary-state-body-layout caller-state)
                           (known-helper-summary-state-formals caller-state))
                   equal?)])
             (for/and ([x (in-list (known-helper-summary-state-extended-layout state))])
               (member x available))))))
  (define (extended-needs-in-closure-env? ab)
    (define state (hash-ref state-ht ab))
    (for/and ([x (in-list (known-helper-summary-state-extended-layout state))])
      (index-where (known-helper-summary-state-closure-env state)
                   (λ (y) (equal? x y)))))
  (define (would-be-sibling-only-safe? ab)
    (define state (hash-ref state-ht ab))
    (and (eq? (known-helper-summary-state-kind state) 'direct)
         (known-helper-summary-state-fixed-arity? state)
         (not (known-helper-summary-state-direct-self-recursive? state))
         (not (eq? (known-helper-summary-state-origin state) 'letrec-values))
         (not (known-helper-summary-state-disqualified? state))
         (known-helper-summary-state-plain-lambda? state)
         (not (known-helper-summary-state-nested-lift-sensitive? state))
         (null? (known-helper-summary-state-nested-capture-vars state))
         (equal? (known-helper-summary-state-body-layout state)
                 (known-helper-summary-state-extended-layout state))
         (extended-needs-in-closure-env? ab)
         (all-callers-can-source-both-envs? ab)))
  (define (blockers-of ab)
    (define state (hash-ref state-ht ab))
    (append
     (if (eq? (known-helper-summary-state-kind state) 'direct) '() '(non-direct))
     (if (known-helper-summary-state-fixed-arity? state) '() '(non-fixed-arity))
     (if (known-helper-summary-state-disqualified? state) '(value-use) '())
     (if (eq? (known-helper-summary-state-origin state) 'letrec-values) '(letrec) '())
     (if (known-helper-summary-state-direct-self-recursive? state) '(recursive) '())
     (if (known-helper-summary-state-plain-lambda? state) '() '(case-lambda))
     (if (known-helper-summary-state-nested-lift-sensitive? state) '(nested-lift-sensitive) '())
     (if (null? (known-helper-summary-state-nested-capture-vars state)) '() '(nested-capture))
     (if (equal? (known-helper-summary-state-body-layout state)
                 (known-helper-summary-state-extended-layout state))
         '()
         '(layout-mismatch))
     (if (extended-needs-in-closure-env? ab)
         '()
         '(env-not-in-closure))
     (if (all-callers-can-source-both-envs? ab)
         '()
         '(unavailable-env))))
  (for/list ([ab (in-list abs)]
             #:when (= (length (known-helper-summary-state-extended-layout (hash-ref state-ht ab))) 2))
    (define state (hash-ref state-ht ab))
    (list (known-helper-summary-state-label state)
          (known-helper-summary-state-binder state)
          (known-helper-summary-state-origin state)
          (known-helper-summary-state-fixed-arity? state)
          (eq? (known-helper-summary-state-kind state) 'direct)
          (known-helper-summary-state-disqualified? state)
          (known-helper-summary-state-direct-self-recursive? state)
          (eq? (known-helper-summary-state-origin state) 'letrec-values)
          (known-helper-summary-state-plain-lambda? state)
          (known-helper-summary-state-nested-lift-sensitive? state)
          (known-helper-summary-state-nested-capture-vars state)
          (known-helper-summary-state-body-layout state)
          (known-helper-summary-state-closure-env state)
          (known-helper-summary-state-extended-layout state)
          (equal? (known-helper-summary-state-body-layout state)
                  (known-helper-summary-state-extended-layout state))
          (extended-needs-in-closure-env? ab)
          (sort (filter values
                        (map (λ (caller)
                               (known-helper-summary-state-binder
                                (hash-ref state-ht caller)))
                             (known-helper-summary-state-incoming-callers state)))
                symbol<?)
          (all-callers-can-source-both-envs? ab)
          (would-be-sibling-only-safe? ab)
          (blockers-of ab))))

;; nested-variable-capture-present? : any/c symbol? -> boolean?
;;   Check whether a nested lambda or case-lambda inside ab captures var-sym.
(define (nested-variable-capture-present? ab var-sym)
  (define (sexp-any? pred x)
    (or (pred x)
        (cond
          [(pair? x)
           (or (sexp-any? pred (car x))
               (sexp-any? pred (cdr x)))]
          [(vector? x)
           (for/or ([e (in-vector x)])
             (sexp-any? pred e))]
          [else
           #f])))
  (define (variable-appears? x)
    (equal? x var-sym))
  (define (captures-binder? x)
    (match x
      [(list 'λ _ body ...)
       (sexp-any? variable-appears? body)]
      [(list 'case-lambda arms ...)
       (sexp-any? variable-appears? arms)]
      [_ #f]))
  (nanopass-case (LANF AExpr) ab
    [(λ ,s ,f ,e)
     (sexp-any? captures-binder? (unparse-all (unparse-LANF e)))]
    [else
     #f]))

;; nested-lift-sensitive-form-present? : any/c -> boolean?
;;   Check whether ab contains nested forms that can introduce additional
;;   lifted code with their own environment expectations.
(define (nested-lift-sensitive-form-present? ab)
  (define (sexp-any? pred x)
    (or (pred x)
        (cond
          [(pair? x)
           (or (sexp-any? pred (car x))
               (sexp-any? pred (cdr x)))]
          [(vector? x)
           (for/or ([e (in-vector x)])
             (sexp-any? pred e))]
          [else
           #f])))
  (define (sensitive-form? x)
    (match x
      [(list 'λ _ _ ...) #t]
      [(list 'case-lambda _ ...) #t]
      [(list 'letrec-values _ _ _ ...) #t]
      [_ #f]))
  (nanopass-case (LANF AExpr) ab
    [(λ ,s ,f ,e)
     (sexp-any? sensitive-form? (unparse-all (unparse-LANF e)))]
    [else
     #f]))

;; direct-self-binder-removable? : any/c (hasheq/c any/c symbol?) (hasheq/c any/c (or/c variable? #f)) -> boolean?
;;   Check whether direct helper ab can drop its own binder from closure layout.
(define (direct-self-binder-removable? ab kind-ht binder-ht)
  (and (eq? (hash-ref kind-ht ab 'closed) 'direct)
       (match (hash-ref binder-ht ab #f)
         [#f #f]
         [x  (not (nested-variable-capture-present? ab (syntax-e (variable-id x))))])))

;; direct-helper-layout-base-free-vars : any/c
;;                                       (hasheq/c any/c id-set?)
;;                                       (hasheq/c any/c symbol?)
;;                                       (hasheq/c any/c (or/c variable? #f))
;;                                    -> (listof symbol?)
;;   Return the current direct-helper layout before label-only direct-call
;;   reductions for empty-layout direct callees.
(define (direct-helper-layout-base-free-vars ab free-ht kind-ht binder-ht)
  (define xs
    (map syntax-e
         (map variable-id
              (id-set->list (hash-ref free-ht ab empty-set)))))
  (cond
    [(direct-self-binder-removable? ab kind-ht binder-ht)
     (match (hash-ref binder-ht ab #f)
       [#f xs]
       [x  (filter (λ (y) (not (equal? y (syntax-e (variable-id x)))))
                   xs)])]
    [else
     xs]))

;; direct-helper-layout-free-vars : any/c
;;                                  (hasheq/c any/c id-set?)
;;                                  (hasheq/c any/c symbol?)
;;                                  (hasheq/c any/c (or/c variable? #f))
;;                                  (hasheq/c any/c (listof any/c))
;;                               -> (listof symbol?)
;;   Return the current closure-layout free variables for abstraction ab.
(define (direct-helper-layout-free-vars ab free-ht kind-ht binder-ht direct-callees-ht)
  (define xs
    (direct-helper-layout-base-free-vars ab free-ht kind-ht binder-ht))
  (define (callee-direct0-binder-sym callee)
    (nanopass-case (LANF AExpr) callee
      [(λ ,s ,f ,e)
       (and (eq? (hash-ref kind-ht callee 'closed) 'direct)
            (null? (direct-helper-layout-base-free-vars callee free-ht kind-ht binder-ht))
            (match (hash-ref binder-ht callee #f)
              [#f #f]
              [x  (and (not (nested-variable-capture-present? ab (syntax-e (variable-id x))))
                       (syntax-e (variable-id x))) ]))]
      [else
       #f]))
  (define removable-syms
    (filter values
            (map callee-direct0-binder-sym
                 (hash-ref direct-callees-ht ab '()))))
  (filter (λ (y) (not (member y removable-syms)))
          xs))

;; direct-self-recursive? : any/c (hasheq/c any/c id-set?) (hasheq/c any/c (or/c variable? #f)) -> boolean?
;;   Check whether ab's own binder occurs in its raw free-variable set.
(define (direct-self-recursive? ab free-ht binder-ht)
  (match (hash-ref binder-ht ab #f)
    [#f #f]
    [x  (define binder-sym (syntax-e (variable-id x)))
        (member binder-sym
                (map syntax-e
                     (map variable-id
                          (id-set->list (hash-ref free-ht ab empty-set)))))]))

;; direct-letrec-layout-links : (listof symbol?) (listof symbol?) -> (listof symbol?)
;;   Return the current closure-layout links from a helper back into its letrec group.
(define (direct-letrec-layout-links free-vars letrec-binders)
  (filter (λ (y) (member y letrec-binders))
          free-vars))

;; direct-letrec-patching-kind : symbol? (or/c symbol? #f) (listof symbol?) -> symbol?
;;   Classify the current letrec patching need for one helper.
(define (direct-letrec-patching-kind kind binder links)
  (cond
    [(not (eq? kind 'direct)) 'non-direct]
    [(null? links)            'none]
    [(and binder
          (equal? links (list binder)))
     'self-only]
    [else
     'cross-linked]))

;; direct-letrec-allocation-eligible? : symbol? (or/c symbol? #f) (listof symbol?) -> boolean?
;;   Check whether a direct letrec helper can skip shell allocation.
(define (direct-letrec-allocation-eligible? kind binder links)
  (eq? (direct-letrec-patching-kind kind binder links) 'none))

;; letrec-final-closure-allocation-eligible? : (listof symbol?) -> boolean?
;;   Check whether a letrec closure can be allocated directly with its final
;;   payload, without shell allocation and later patching.
(define (letrec-final-closure-allocation-eligible? links)
  (null? links))

;; letrec-immediate-payload/free-vars : (listof symbol?) (listof symbol?) -> (listof symbol?)
;;   Return the payload entries that can be installed immediately, preserving
;;   the current closure-layout order.
(define (letrec-immediate-payload/free-vars free-vars links)
  (for/list ([x (in-list free-vars)]
             #:unless (member x links))
    x))

;; letrec-recursive-payload/free-vars : (listof symbol?) (listof symbol?) -> (listof symbol?)
;;   Return the payload entries that still require recursive-group patching.
(define (letrec-recursive-payload/free-vars free-vars links)
  links)

;; letrec-closure-payload-split/free-vars : (listof symbol?) (listof symbol?)
;;                                       -> (values (listof symbol?) (listof symbol?))
;;   Split the current closure-layout payload into immediate and recursive parts.
(define (letrec-closure-payload-split/free-vars free-vars links)
  (values (letrec-immediate-payload/free-vars free-vars links)
          (letrec-recursive-payload/free-vars free-vars links)))

;; letrec-allocation-mode : boolean? boolean? -> symbol?
;;   Classify the current letrec closure-allocation strategy.
(define (letrec-allocation-mode final-allocate? representable?)
  (cond
    [representable? 'representation]
    [final-allocate? 'final-only]
    [else           'patched]))

;; direct-letrec-shell-allocation-needed? : symbol? (or/c symbol? #f) (listof symbol?) -> boolean?
;;   Check whether a direct letrec helper still needs shell allocation and patching.
(define (direct-letrec-shell-allocation-needed? kind binder links)
  (not (direct-letrec-allocation-eligible? kind binder links)))

;; direct-letrec-allocation-info/free-vars
;;   : symbol? (or/c symbol? #f) (listof symbol?) (listof symbol?)
;;  -> (values (listof symbol?) symbol? boolean?)
;;   Compute letrec layout links, patching kind, and allocation eligibility.
(define (direct-letrec-allocation-info/free-vars kind binder free-vars letrec-binders)
  (define links
    (direct-letrec-layout-links free-vars letrec-binders))
  (define patching-kind
    (direct-letrec-patching-kind kind binder links))
  (define eligible?
    (direct-letrec-allocation-eligible? kind binder links))
  (values links patching-kind eligible?))

;; letrec-allocation-info/free-vars
;;   : symbol? (or/c symbol? #f) boolean? (listof symbol?) (listof symbol?)
;;  -> (values (listof symbol?) symbol? boolean? boolean? symbol?)
;;   Compute letrec links, patching kind, final-allocation eligibility,
;;   representation eligibility, and named allocation mode.
(define (letrec-allocation-info/free-vars kind binder fixed-arity? free-vars letrec-binders)
  (define-values (links patching-kind _direct-eligible?)
    (direct-letrec-allocation-info/free-vars kind binder free-vars letrec-binders))
  (define final-allocate?
    (letrec-final-closure-allocation-eligible? links))
  (define representable?
    (direct-letrec-representation-candidate? kind fixed-arity? free-vars patching-kind))
  (values links
          patching-kind
          final-allocate?
          representable?
          (letrec-allocation-mode final-allocate? representable?)))

;; fixed-arity-formals? : LANF Formals -> boolean?
;;   Check whether source-language formals describe a fixed-arity function.
(define (fixed-arity-formals? f)
  (nanopass-case (LANF Formals) f
    [(formals (,x ...))            #t]
    [(formals (,x0 ,x1 ... . ,xd)) #f]
    [(formals ,x)                  #f]))

;; abstraction-fixed-arity? : LANF Abstraction -> boolean?
;;   Check whether ab has fixed-arity source formals.
(define (abstraction-fixed-arity? ab)
  (nanopass-case (LANF Abstraction) ab
    [(λ ,s ,f ,e)
     (fixed-arity-formals? f)]
    [else
     #f]))

;; direct-letrec-representation-candidate? : symbol? boolean? (listof symbol?) symbol? -> boolean?
;;   Check whether a helper fits the current conservative candidate shape for
;;   a future letrec representation that bypasses ordinary closure allocation.
(define (direct-letrec-representation-candidate? kind fixed-arity? free-vars patching-kind)
  (and (eq? kind 'direct)
       fixed-arity?
       (null? free-vars)
       (eq? patching-kind 'none)))

;; summarize-direct-self-binder-closure-conversion-analysis
;; : LANF -> (listof
;;             (list symbol?            ; label
;;                   (or/c symbol? #f)  ; binder
;;                   (listof symbol?)   ; current-layout
;;                   boolean?))         ; removable?
;;   Return one summary row for each abstraction currently classified as `direct`.
;;
;; Each row has the form:
;;   (list label binder current-layout removable?)
;; where:
;; - current-layout: the current direct-helper layout variables
;; - removable?:     whether the helper can drop its own binder from that
;;                   layout without changing the current direct-helper model
(define (summarize-direct-self-binder-closure-conversion-analysis T)
  (define (label-name labels-ht ab)
    (syntax-e (variable-id (hash-ref labels-ht ab))))
  (letv ((T free-ht abs kind-ht _direct-sites-ht _direct-candidate-ht _disqualified-ht
            binder-ht
            _extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (define labels-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! labels-ht ab (new-var "label")))
    (for/list ([ab (in-list abs)]
               #:when (eq? (hash-ref kind-ht ab 'closed) 'direct))
      (define binder
        (match (hash-ref binder-ht ab #f)
          [#f #f]
          [x  (syntax-e (variable-id x))]))
      (list (label-name labels-ht ab)
            binder
            (direct-helper-layout-free-vars ab free-ht kind-ht binder-ht direct-callees-ht)
            (direct-self-binder-removable? ab kind-ht binder-ht)))))

;; collect-direct-letrec-summary-entries : LANF -> (listof list?)
;;   Collect direct-letrec summary entries with allocation and patching fields.
(define (collect-direct-letrec-summary-entries T)
  (define (label-name labels-ht ab)
    (syntax-e (variable-id (hash-ref labels-ht ab))))
  (letv ((T free-ht abs kind-ht _direct-sites-ht _direct-candidate-ht _disqualified-ht
            binder-ht
            _extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (define labels-ht (make-hasheq))
    (for ([ab (in-list abs)])
      (hash-set! labels-ht ab (new-var "label")))
    (define entries '())
    (define (record-letrec-entry! x ab letrec-binders)
      (define binder-sym (syntax-e (variable-id x)))
      (define free-vars  (direct-helper-layout-free-vars ab free-ht kind-ht binder-ht direct-callees-ht))
      (define fixed-arity? (abstraction-fixed-arity? ab))
      (define kind (hash-ref kind-ht ab 'closed))
      (define-values (links patching-kind final-allocate? representable? allocation-mode)
        (letrec-allocation-info/free-vars kind binder-sym fixed-arity? free-vars letrec-binders))
      (set! entries
            (cons (list binder-sym
                        (label-name labels-ht ab)
                        kind
                        fixed-arity?
                        free-vars
                        links
                        patching-kind
                        final-allocate?
                        representable?
                        allocation-mode)
                  entries)))
    (define-pass collect : LANF (T) -> * ()
      (TopLevelForm : TopLevelForm (T) -> * ()
        [(topbegin ,s ,t ...)
         (for ([t (in-list t)])
           (TopLevelForm t))]
        [(topmodule ,s ,mn ,mp ,mf ...)
         (for ([m (in-list mf)])
           (ModuleLevelForm m))]
        [(#%expression ,s ,e)
         (Expr e)]
        [,g
         (GeneralTopLevelForm g)])
      (ModuleLevelForm : ModuleLevelForm (M) -> * ()
        [(#%provide ,rps ...)
         (void)]
        [,g
         (GeneralTopLevelForm g)])
      (GeneralTopLevelForm : GeneralTopLevelForm (G) -> * ()
        [(define-values ,s (,x ...) ,e)
         (Expr e)]
        [(define-syntaxes ,s (,x ...) ,e)
         (Expr e)]
        [(#%require ,s ,rrs ...)
         (void)]
        [,e
         (Expr e)])
      (Abstraction : Abstraction (AB) -> * ()
        [(λ ,s ,f ,e)
         (Expr e)])
      (CaseAbstraction : CaseAbstraction (CAB) -> * ()
        [(case-lambda ,s ,ab* ...)
         (for ([ab (in-list ab*)])
           (Abstraction ab))])
      (AExpr : AExpr (AE) -> * ()
        [,ab
         (Abstraction ab)]
        [,cab
         (CaseAbstraction cab)]
        [else
         (void)])
      (CExpr : CExpr (CE) -> * ()
        [,ae
         (AExpr ae)]
        [(set! ,s ,x ,ae)
         (AExpr ae)]
        [(if ,s ,ae0 ,e1 ,e2)
         (AExpr ae0)
         (Expr e1)
         (Expr e2)]
        [(wcm ,s ,ae0 ,ae1 ,e)
         (AExpr ae0)
         (AExpr ae1)
         (Expr e)]
        [(app ,s ,ae ,ae1 ...)
         (AExpr ae)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(primapp ,s ,pr ,ae1 ...)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(closedapp ,s ,ab ,ae1 ...)
         (Abstraction ab)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(begin ,s ,e0 ,e1 ...)
         (Expr e0)
         (for ([e (in-list e1)])
           (Expr e))]
        [(begin0 ,s ,e0 ,e1 ...)
         (Expr e0)
         (for ([e (in-list e1)])
           (Expr e))])
      (Expr : Expr (E) -> * ()
        [,ce
         (CExpr ce)]
        [(let-values ,s (((,x ...) ,ce*) ...) ,e)
         (for ([ce (in-list ce*)])
           (CExpr ce))
         (Expr e)]
        [(letrec-values ,s (((,x ...) ,ce*) ...) ,e)
         (define letrec-binders
           (for/list ([xs (in-list x)]
                      #:when (= (length xs) 1))
             (syntax-e (variable-id (car xs)))))
         (for ([xs (in-list x)]
               [ce (in-list ce*)]
               #:when (= (length xs) 1))
           (nanopass-case (LANF CExpr) ce
             [,ae
              (nanopass-case (LANF AExpr) ae
                [,ab  (record-letrec-entry! (car xs) ab letrec-binders)]
                [else (void)])]
             [else (void)]))
         (for ([ce (in-list ce*)])
           (CExpr ce))
         (Expr e)]))
    (collect T)
    (reverse entries)))

;; summarize-direct-letrec-allocation-closure-conversion-analysis : LANF
;;                                                             -> (listof list?)
;;   Return a compact summary of current direct-letrec allocation eligibility.
(define (summarize-direct-letrec-allocation-closure-conversion-analysis T)
  (collect-direct-letrec-summary-entries T))

;; summarize-direct-letrec-patching-closure-conversion-analysis : LANF
;;                                                           -> (listof list?)
;;   Return a compact summary of current letrec cross-links that still need patching.
(define (summarize-direct-letrec-patching-closure-conversion-analysis T)
  (for/list ([entry (in-list (collect-direct-letrec-summary-entries T))])
    (match entry
      [(list binder label kind _fixed-arity? free-vars links patching-kind _final-allocate? _representable? _allocation-mode)
       (list binder label kind free-vars links patching-kind)])))

;; summarize-direct-letrec-representation-closure-conversion-analysis : LANF
;;                                                                 -> (listof list?)
;;   Return a compact summary of current candidates for a future direct-letrec
;;   representation that bypasses ordinary closure allocation.
(define (summarize-direct-letrec-representation-closure-conversion-analysis T)
  (for/list ([entry (in-list (collect-direct-letrec-summary-entries T))])
    (match entry
      [(list binder label kind fixed-arity? free-vars links patching-kind final-allocate? representable? allocation-mode)
       (list binder
             label
             kind
             fixed-arity?
             free-vars
             links
             patching-kind
             final-allocate?
             representable?)])))

;; summarize-letrec-final-allocation-closure-conversion-analysis : LANF
;;                                                             -> (listof list?)
;;   Return a compact summary of letrec helpers that can allocate their final
;;   closure directly, along with whether they also qualify for the active
;;   direct-letrec representation. Each entry ends with one of:
;;     `representation`, `final-only`, or `patched`.
(define (summarize-letrec-final-allocation-closure-conversion-analysis T)
  (for/list ([entry (in-list (collect-direct-letrec-summary-entries T))])
    (match entry
      [(list binder label kind fixed-arity? free-vars links _patching-kind final-allocate? representable? allocation-mode)
       (list binder
             label
             kind
             fixed-arity?
             free-vars
             links
             final-allocate?
             representable?
             allocation-mode)])))

;; direct-letrec-dependency-kind : (listof symbol?) (listof (list/c symbol? symbol?)) -> symbol?
;;   Classify one direct-letrec group's current recursive dependency shape.
(define (direct-letrec-dependency-kind binders edges)
  (define distinct-binders (remove-duplicates binders))
  (define self-edge?       (λ (edge) (equal? (first edge) (second edge))))
  (define cross-edges      (filter (λ (edge) (not (self-edge? edge))) edges))
  (cond
    [(null? edges)
     'none]
    [(andmap self-edge? edges)
     'self-only]
    [(and (= (length distinct-binders) 2)
          (= (length cross-edges) 2)
          (let* ([a (first distinct-binders)]
                 [b (second distinct-binders)])
            (and (member (list a b) cross-edges)
                 (member (list b a) cross-edges))))
     'mutual]
    [else
     'complex]))

;; direct-letrec-neighbors : symbol? (listof (list/c symbol? symbol?)) -> (listof symbol?)
;;   Return the direct successors of binder in the dependency edge set.
(define (direct-letrec-neighbors binder edges)
  (for/list ([edge (in-list edges)]
             #:when (equal? (first edge) binder))
    (second edge)))

;; direct-letrec-reachable : symbol? (listof (list/c symbol? symbol?)) -> (listof symbol?)
;;   Return the binders reachable from start in the dependency graph.
(define (direct-letrec-reachable start edges)
  (define seen '())
  (define (visit x)
    (unless (member x seen)
      (set! seen (cons x seen))
      (for ([y (in-list (direct-letrec-neighbors x edges))])
        (visit y))))
  (visit start)
  (reverse seen))

;; direct-letrec-sccs : (listof symbol?) (listof (list/c symbol? symbol?)) -> (listof (listof symbol?))
;;   Compute strongly connected components of the direct-letrec dependency graph.
(define (direct-letrec-sccs binders edges)
  (define reverse-edges
    (for/list ([edge (in-list edges)])
      (list (second edge) (first edge))))
  (define components '())
  (define remaining binders)
  (let loop ()
    (unless (null? remaining)
      (define start   (car remaining))
      (define forward (direct-letrec-reachable start edges))
      (define back    (direct-letrec-reachable start reverse-edges))
      (define scc
        (for/list ([x (in-list binders)]
                   #:when (and (member x forward)
                               (member x back)))
          x))
      (set! components (cons scc components))
      (set! remaining
            (filter (λ (x) (not (member x scc)))
                    remaining))
      (loop)))
  (reverse components))

;; direct-letrec-scc-kind : (listof (listof symbol?)) -> symbol?
;;   Classify the SCC structure of one direct-letrec dependency graph.
(define (direct-letrec-scc-kind sccs)
  (define nontrivial-sccs
    (filter (λ (scc) (> (length scc) 1)) sccs))
  (cond
    [(null? nontrivial-sccs)
     'trivial]
    [(= (length nontrivial-sccs) 1)
     'single-nontrivial]
    [else
     'multiple-nontrivial]))

;; direct-letrec-allocation-order : (listof symbol?) (listof (list/c symbol? symbol?))
;;                               -> (listof symbol?)
;;   Return a source-stable SCC-aware allocation order that places dependency
;;   providers before helpers that store links to them.
(define (direct-letrec-allocation-order binders edges)
  (define binder-rank-ht
    (for/hasheq ([binder (in-list binders)]
                 [i (in-naturals)])
      (values binder i)))
  (define (source-stable-order bs)
    (sort bs < #:key (λ (binder) (hash-ref binder-rank-ht binder))))
  (define (permutations xs)
    (cond
      [(null? xs) '(())]
      [else
       (append*
        (for/list ([x (in-list xs)])
          (for/list ([rest (in-list (permutations (remove x xs)))])
            (cons x rest))))]))
  (define (scc-order-cost order scc-edges)
    (define index-ht
      (for/hasheq ([binder (in-list order)]
                   [i      (in-naturals)])
        (values binder i)))
    (for/sum ([edge (in-list scc-edges)])
      (if (<= (hash-ref index-ht (first edge))
              (hash-ref index-ht (second edge)))
          1
          0)))
  (define (optimize-scc-order scc)
    (define source-order
      (source-stable-order scc))
    (cond
      [(<= (length source-order) 1)
       source-order]
      [(> (length source-order) 6)
       source-order]
      [else
       (define scc-set source-order)
       (define scc-edges
         (for/list ([edge (in-list edges)]
                    #:when (and (member (first edge) scc-set)
                                (member (second edge) scc-set)))
           edge))
       (define (order-key order)
         (list (scc-order-cost order scc-edges)
               (for/list ([binder (in-list order)])
                 (hash-ref binder-rank-ht binder))))
       (let loop ([best-order source-order]
                  [best-key   (order-key source-order)]
                  [rest       (cdr (permutations source-order))])
         (cond
           [(null? rest)
            best-order]
           [else
            (define order (car rest))
            (define key   (order-key order))
            (if (or (< (first key) (first best-key))
                    (and (= (first key) (first best-key))
                         (string<? (format "~s" (second key))
                                   (format "~s" (second best-key)))))
                (loop order key (cdr rest))
                (loop best-order best-key (cdr rest)))]))]))
  (define sccs
    (direct-letrec-sccs binders edges))
  (define scc-index-ht
    (for*/hasheq ([(scc i) (in-indexed (in-list sccs))]
                  [binder (in-list scc)])
      (values binder i)))
  (define scc-rank
    (for/vector #:length (length sccs) ([scc (in-list sccs)])
      (apply min
             (for/list ([binder (in-list scc)])
               (hash-ref binder-rank-ht binder)))))
  (define precedence-edges
    (remove-duplicates
     (for/list ([edge (in-list edges)]
                #:do [(define from-i (hash-ref scc-index-ht (first edge)))
                      (define to-i   (hash-ref scc-index-ht (second edge)))]
                #:when (not (= from-i to-i)))
       (list to-i from-i))))
  (define indegree
    (make-vector (length sccs) 0))
  (for ([edge (in-list precedence-edges)])
    (vector-set! indegree
                 (second edge)
                 (add1 (vector-ref indegree (second edge)))))
  (define ordered-sccs '())
  (define ready
    (sort
     (for/list ([i (in-range (length sccs))]
                #:when (zero? (vector-ref indegree i)))
       i)
     <
     #:key (λ (i) (vector-ref scc-rank i))))
  (let loop ([ready ready]
             [seen  0]
             [ordered-sccs '()])
    (cond
      [(null? ready)
       (unless (= seen (length sccs))
         (error 'direct-letrec-allocation-order
                "internal error: cyclic SCC condensation graph"))
       (append*
        (for/list ([scc-i (in-list (reverse ordered-sccs))])
          (optimize-scc-order (list-ref sccs scc-i))))]
      [else
       (define i (car ready))
       (define ready-rest (cdr ready))
       (define newly-ready
         (for/list ([edge (in-list precedence-edges)]
                    #:when (= (first edge) i)
                    #:do [(define j (second edge))
                          (define new-degree (sub1 (vector-ref indegree j)))
                          (vector-set! indegree j new-degree)]
                    #:when (zero? (vector-ref indegree (second edge))))
           (second edge)))
       (loop (sort (remove-duplicates (append ready-rest newly-ready))
                   <
                   #:key (λ (idx) (vector-ref scc-rank idx)))
             (add1 seen)
             (cons i ordered-sccs))])))

;; direct-letrec-recursive-edges : (listof symbol?) (listof (list/c symbol? symbol?))
;;                              -> (listof (list/c symbol? symbol?))
;;   Return the edges that still point to the current or a later binder in the
;;   given allocation order, and therefore still require post-allocation patching.
(define (direct-letrec-recursive-edges allocation-order edges)
  (define binder-index-ht
    (for/hasheq ([binder (in-list allocation-order)]
                 [i      (in-naturals)])
      (values binder i)))
  (for/list ([edge (in-list edges)]
             #:when (<= (hash-ref binder-index-ht (first edge))
                        (hash-ref binder-index-ht (second edge))))
    edge))

;; direct-letrec-allocation-order-proven-optimal? : (listof (listof symbol?)) -> boolean?
;;   Check whether the current SCC-order search proves optimality for all SCCs
;;   in the group under the current brute-force size cap.
(define (direct-letrec-allocation-order-proven-optimal? sccs)
  (for/and ([scc (in-list sccs)])
    (<= (length scc) 6)))

;; summarize-direct-letrec-dependency-closure-conversion-analysis : LANF
;;                                                             -> (listof list?)
;;   Return a compact summary of current direct-letrec dependency graphs, using
;;   current closure-layout links inside each letrec group.
(define (summarize-direct-letrec-dependency-closure-conversion-analysis T)
  (letv ((T free-ht abs kind-ht _direct-sites-ht _direct-candidate-ht _disqualified-ht
            binder-ht
            _extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (define (direct-entry xs ce)
      (and (= (length xs) 1)
           (let ([x (car xs)])
             (nanopass-case (LANF CExpr) ce
               [,ae
                (nanopass-case (LANF AExpr) ae
                  [,ab
                   (define kind (hash-ref kind-ht ab 'closed))
                   (and (eq? kind 'direct)
                        (list (syntax-e (variable-id x))
                              (direct-helper-layout-free-vars ab free-ht kind-ht binder-ht direct-callees-ht)))]
                  [else #f])]
               [else #f]))))
    (define entries '())
    (define-pass collect : LANF (T) -> * ()
      (TopLevelForm : TopLevelForm (T) -> * ()
        [(topbegin ,s ,t ...)
         (for ([t (in-list t)])
           (TopLevelForm t))]
        [(topmodule ,s ,mn ,mp ,mf ...)
         (for ([m (in-list mf)])
           (ModuleLevelForm m))]
        [(#%expression ,s ,e)
         (Expr e)]
        [,g
         (GeneralTopLevelForm g)])
      (ModuleLevelForm : ModuleLevelForm (M) -> * ()
        [(#%provide ,rps ...)
         (void)]
        [,g
         (GeneralTopLevelForm g)])
      (GeneralTopLevelForm : GeneralTopLevelForm (G) -> * ()
        [(define-values ,s (,x ...) ,e)
         (Expr e)]
        [(define-syntaxes ,s (,x ...) ,e)
         (Expr e)]
        [(#%require ,s ,rrs ...)
         (void)]
        [,e
         (Expr e)])
      (Abstraction : Abstraction (AB) -> * ()
        [(λ ,s ,f ,e)
         (Expr e)])
      (CaseAbstraction : CaseAbstraction (CAB) -> * ()
        [(case-lambda ,s ,ab* ...)
         (for ([ab (in-list ab*)])
           (Abstraction ab))])
      (AExpr : AExpr (AE) -> * ()
        [,ab
         (Abstraction ab)]
        [,cab
         (CaseAbstraction cab)]
        [else
         (void)])
      (CExpr : CExpr (CE) -> * ()
        [,ae
         (AExpr ae)]
        [(set! ,s ,x ,ae)
         (AExpr ae)]
        [(if ,s ,ae0 ,e1 ,e2)
         (AExpr ae0)
         (Expr e1)
         (Expr e2)]
        [(wcm ,s ,ae0 ,ae1 ,e)
         (AExpr ae0)
         (AExpr ae1)
         (Expr e)]
        [(app ,s ,ae ,ae1 ...)
         (AExpr ae)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(primapp ,s ,pr ,ae1 ...)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(closedapp ,s ,ab ,ae1 ...)
         (Abstraction ab)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(begin ,s ,e0 ,e1 ...)
         (Expr e0)
         (for ([e (in-list e1)])
           (Expr e))]
        [(begin0 ,s ,e0 ,e1 ...)
         (Expr e0)
         (for ([e (in-list e1)])
           (Expr e))])
      (Expr : Expr (E) -> * ()
        [,ce
         (CExpr ce)]
        [(let-values ,s (((,x ...) ,ce*) ...) ,e)
         (for ([ce (in-list ce*)])
           (CExpr ce))
         (Expr e)]
        [(letrec-values ,s (((,x ...) ,ce*) ...) ,e)
         (define direct-entries
           (for/list ([xs (in-list x)]
                      [ce (in-list ce*)]
                      #:do [(define entry (direct-entry xs ce))]
                      #:when entry)
             entry))
         (unless (null? direct-entries)
           (define binders
             (map first direct-entries))
           (define edges
             (append*
              (for/list ([entry (in-list direct-entries)])
                (match entry
                  [(list from free-vars)
                   (for/list ([to (in-list free-vars)]
                              #:when (member to binders))
                     (list from to))]))))
           (set! entries
                 (cons (list binders
                             edges
                             (direct-letrec-dependency-kind binders edges))
                       entries)))
         (for ([ce (in-list ce*)])
           (CExpr ce))
         (Expr e)]))
    (collect T)
    (reverse entries)))

;; summarize-direct-letrec-group-allocation-closure-conversion-analysis : LANF
;;                                                                   -> (listof list?)
;;   Return a compact summary of direct-letrec groups, including the current
;;   dependency shape and each helper's allocation mode.
(define (summarize-direct-letrec-group-allocation-closure-conversion-analysis T)
  (letv ((T free-ht abs kind-ht _direct-sites-ht _direct-candidate-ht _disqualified-ht
            binder-ht
            _extended-ht direct-callees-ht)
         (closure-conversion-analysis T))
    (define (direct-entry xs ce)
      (and (= (length xs) 1)
           (let ([x (car xs)])
             (nanopass-case (LANF CExpr) ce
               [,ae
                (nanopass-case (LANF AExpr) ae
                  [,ab
                   (define kind (hash-ref kind-ht ab 'closed))
                   (and (eq? kind 'direct)
                        (let* ([binder-sym   (syntax-e (variable-id x))]
                               [free-vars     (direct-helper-layout-free-vars ab free-ht kind-ht binder-ht direct-callees-ht)]
                               [fixed-arity?  (abstraction-fixed-arity? ab)])
                          (list binder-sym free-vars fixed-arity? kind)))]
                  [else #f])]
               [else #f]))))
    (define entries '())
    (define-pass collect : LANF (T) -> * ()
      (TopLevelForm : TopLevelForm (T) -> * ()
        [(topbegin ,s ,t ...)
         (for ([t (in-list t)])
           (TopLevelForm t))]
        [(topmodule ,s ,mn ,mp ,mf ...)
         (for ([m (in-list mf)])
           (ModuleLevelForm m))]
        [(#%expression ,s ,e)
         (Expr e)]
        [,g
         (GeneralTopLevelForm g)])
      (ModuleLevelForm : ModuleLevelForm (M) -> * ()
        [(#%provide ,rps ...)
         (void)]
        [,g
         (GeneralTopLevelForm g)])
      (GeneralTopLevelForm : GeneralTopLevelForm (G) -> * ()
        [(define-values ,s (,x ...) ,e)
         (Expr e)]
        [(define-syntaxes ,s (,x ...) ,e)
         (Expr e)]
        [(#%require ,s ,rrs ...)
         (void)]
        [,e
         (Expr e)])
      (Abstraction : Abstraction (AB) -> * ()
        [(λ ,s ,f ,e)
         (Expr e)])
      (CaseAbstraction : CaseAbstraction (CAB) -> * ()
        [(case-lambda ,s ,ab* ...)
         (for ([ab (in-list ab*)])
           (Abstraction ab))])
      (AExpr : AExpr (AE) -> * ()
        [,ab
         (Abstraction ab)]
        [,cab
         (CaseAbstraction cab)]
        [else
         (void)])
      (CExpr : CExpr (CE) -> * ()
        [,ae
         (AExpr ae)]
        [(set! ,s ,x ,ae)
         (AExpr ae)]
        [(if ,s ,ae0 ,e1 ,e2)
         (AExpr ae0)
         (Expr e1)
         (Expr e2)]
        [(wcm ,s ,ae0 ,ae1 ,e)
         (AExpr ae0)
         (AExpr ae1)
         (Expr e)]
        [(app ,s ,ae ,ae1 ...)
         (AExpr ae)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(primapp ,s ,pr ,ae1 ...)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(closedapp ,s ,ab ,ae1 ...)
         (Abstraction ab)
         (for ([ae1 (in-list ae1)])
           (AExpr ae1))]
        [(begin ,s ,e0 ,e1 ...)
         (Expr e0)
         (for ([e (in-list e1)])
           (Expr e))]
        [(begin0 ,s ,e0 ,e1 ...)
         (Expr e0)
         (for ([e (in-list e1)])
           (Expr e))])
      (Expr : Expr (E) -> * ()
        [,ce
         (CExpr ce)]
        [(let-values ,s (((,x ...) ,ce*) ...) ,e)
         (for ([ce (in-list ce*)])
           (CExpr ce))
         (Expr e)]
        [(letrec-values ,s (((,x ...) ,ce*) ...) ,e)
         (define direct-entries
           (for/list ([xs (in-list x)]
                      [ce (in-list ce*)]
                      #:do [(define entry (direct-entry xs ce))]
                      #:when entry)
             entry))
         (unless (null? direct-entries)
           (define binders
             (map first direct-entries))
           (define edges
             (append*
              (for/list ([entry (in-list direct-entries)])
                (match entry
                  [(list from free-vars _fixed-arity? _kind)
                   (for/list ([to (in-list free-vars)]
                              #:when (member to binders))
                     (list from to))]))))
           (define modes
             (for/list ([entry (in-list direct-entries)])
               (match entry
                 [(list binder-sym free-vars fixed-arity? kind)
                  (define-values (_links _patching-kind _final-allocate? _representable? allocation-mode)
                    (letrec-allocation-info/free-vars kind binder-sym fixed-arity? free-vars binders))
                  (list binder-sym allocation-mode)])))
           (set! entries
                 (cons (list binders
                             edges
                             (direct-letrec-dependency-kind binders edges)
                             modes)
                       entries)))
         (for ([ce (in-list ce*)])
           (CExpr ce))
         (Expr e)]))
    (collect T)
    (reverse entries)))

;; summarize-direct-letrec-scc-closure-conversion-analysis : LANF -> (listof list?)
;;   Return a compact summary of direct-letrec SCC structure.
(define (summarize-direct-letrec-scc-closure-conversion-analysis T)
  (for/list ([entry (in-list (summarize-direct-letrec-dependency-closure-conversion-analysis T))])
    (match entry
      [(list binders edges dependency-kind)
       (define sccs
         (direct-letrec-sccs binders edges))
       (list binders
             edges
             dependency-kind
             sccs
             (direct-letrec-scc-kind sccs))])))

;; summarize-direct-letrec-patching-target-closure-conversion-analysis : LANF
;;                                                                   -> (listof list?)
;;   Return a compact summary of direct-letrec groups that still contain
;;   patched helpers after the current closure-allocation simplifications.
(define (summarize-direct-letrec-patching-target-closure-conversion-analysis T)
  (define scc-summary
    (summarize-direct-letrec-scc-closure-conversion-analysis T))
  (define group-summary
    (summarize-direct-letrec-group-allocation-closure-conversion-analysis T))
  (for/list ([scc-entry   (in-list scc-summary)]
             [group-entry (in-list group-summary)]
             #:do [(match-define (list binders edges dependency-kind sccs scc-kind) scc-entry)
                   (match-define (list _binders _edges _dependency-kind modes) group-entry)
                   (define patched-binders
                     (for/list ([mode-entry (in-list modes)]
                                #:when (eq? (second mode-entry) 'patched))
                       (first mode-entry)))]
             #:when (pair? patched-binders))
    (list binders
          edges
          dependency-kind
          sccs
          scc-kind
          patched-binders)))

;; summarize-direct-letrec-scc-patch-plan-closure-conversion-analysis : LANF
;;                                                                  -> (listof list?)
;;   Return a compact summary of the current SCC-aware patch plan for each
;;   direct-letrec group. Each per-binder plan splits same-group links into
;;   `immediate-links` and `recursive-links` according to the current
;;   allocation order.
(define (summarize-direct-letrec-scc-patch-plan-closure-conversion-analysis T)
  (define entry-table
    (for/hasheq ([entry (in-list (collect-direct-letrec-summary-entries T))])
      (match entry
        [(list binder _label kind fixed-arity? free-vars links patching-kind final-allocate? representable? allocation-mode)
         (values binder
                 (list kind fixed-arity? free-vars links patching-kind final-allocate? representable? allocation-mode))])))
  (for/list ([group (in-list (summarize-direct-letrec-scc-closure-conversion-analysis T))])
    (match group
      [(list binders edges dependency-kind sccs scc-kind)
       (define allocation-order
         (direct-letrec-allocation-order binders edges))
       (define binder-index-ht
         (for/hasheq ([binder (in-list allocation-order)]
                      [i      (in-naturals)])
           (values binder i)))
       (define plans
         (for/list ([binder (in-list allocation-order)])
           (match-define (list _kind _fixed-arity? _free-vars links _patching-kind _final-allocate? _representable? allocation-mode)
             (hash-ref entry-table binder))
           (define immediate-links
             (for/list ([to (in-list links)]
                        #:when (< (hash-ref binder-index-ht to)
                                  (hash-ref binder-index-ht binder)))
               to))
           (define recursive-links
             (for/list ([to (in-list links)]
                        #:unless (< (hash-ref binder-index-ht to)
                                    (hash-ref binder-index-ht binder)))
               to))
           (list binder immediate-links recursive-links allocation-mode)))
       (list binders
             edges
             dependency-kind
             sccs
             scc-kind
             allocation-order
             plans)])))

;; summarize-direct-letrec-scc-core-closure-conversion-analysis : LANF
;;                                                             -> (listof list?)
;;   Return a compact summary of the remaining SCC-core patch edges after the
;;   current allocation-order optimization.
(define (summarize-direct-letrec-scc-core-closure-conversion-analysis T)
  (for/list ([group (in-list (summarize-direct-letrec-scc-closure-conversion-analysis T))])
    (match group
      [(list binders edges dependency-kind sccs scc-kind)
       (define allocation-order
         (direct-letrec-allocation-order binders edges))
       (define recursive-edges
         (direct-letrec-recursive-edges allocation-order edges))
       (list binders
             edges
             dependency-kind
             sccs
             scc-kind
             allocation-order
             recursive-edges
             (length recursive-edges)
             (direct-letrec-allocation-order-proven-optimal? sccs))])))

(module+ test
  (require rackunit
           "expander.rkt")

  ;; analyze-with-cc-summary : syntax? (LANF -> any/c) -> any/c
  ;;   Run the frontend pipeline up to LANF with cc-analysis enabled, then summarize.
  (define (analyze-with-cc-summary stx summarize)
    (reset-counter!)
    (define p0  (parse (unexpand (topexpand stx))))
    (define s0  (simplify-LFE p0))
    (define ft  (flatten-topbegin s0))
    (define in  (infer-names ft))
    (define cq  (convert-quotations in))
    (define eb  (explicit-begin cq))
    (define ecl (explicit-case-lambda eb))
    (define ar  (α-rename ecl))
    (define ua  (uncover-assigned! ar))
    (define lr  (parameterize ([current-assigned-analysis ua])
                  (lower-letrec-values ar)))
    (define ac  (parameterize ([current-assigned-analysis ua])
                  (assignment-conversion lr)))
    (define ca  (categorize-applications ac))
    (define an  (anormalize ca))
    (parameterize ([current-enable-cc-analysis? #t])
      (summarize an)))

  ;; closure-analysis-summary : syntax? -> (listof list?)
  ;;   Run the pipeline up to LANF and summarize closure-conversion analysis.
  (define (closure-analysis-summary stx)
    (analyze-with-cc-summary stx
      summarize-closure-conversion-analysis))

  ;; extended-closure-analysis-summary : syntax? -> (listof list?)
  ;;   Run the pipeline up to LANF and summarize extended free-variable analysis.
  (define (extended-closure-analysis-summary stx)
    (analyze-with-cc-summary stx
      summarize-extended-closure-conversion-analysis))

  ;; direct-layout-analysis-summary : syntax? -> (listof list?)
  ;;   Run the pipeline up to LANF and summarize direct-helper layout compatibility.
  (define (direct-layout-analysis-summary stx)
    (analyze-with-cc-summary stx
      summarize-direct-layout-closure-conversion-analysis))

  ;; direct-helper-environment-analysis-summary : syntax? -> (listof list?)
  ;;   Run the pipeline up to LANF and summarize direct-helper environment views.
  (define (direct-helper-environment-analysis-summary stx)
    (analyze-with-cc-summary stx
      summarize-direct-helper-environment-closure-conversion-analysis))

  ;; closure-layout-arity-analysis-summary : syntax? -> (listof list?)
  ;;   Run the pipeline up to LANF and summarize closure-layout payload sizes.
  (define (closure-layout-arity-analysis-summary stx)
    (analyze-with-cc-summary stx
      summarize-closure-layout-arity-closure-conversion-analysis))

  ;; closure-layout-arity-counts-analysis-summary : syntax? -> (listof list?)
  ;;   Run the pipeline up to LANF and summarize closure-layout payload-size counts.
  (define (closure-layout-arity-counts-analysis-summary stx)
    (analyze-with-cc-summary stx
      summarize-closure-layout-arity-counts-closure-conversion-analysis))

  ;; known-helper-abi-plan-analysis-summary : syntax? -> (listof list?)
  ;;   Run the pipeline up to LANF and summarize conservative known-helper ABI plans.
  (define (known-helper-abi-plan-analysis-summary stx)
    (analyze-with-cc-summary stx
      summarize-known-helper-abi-plan-closure-conversion-analysis))

  ;; direct-helper-env-plan-analysis-summary : syntax? -> (listof list?)
  ;;   Run the pipeline up to LANF and summarize direct-helper env propagation.

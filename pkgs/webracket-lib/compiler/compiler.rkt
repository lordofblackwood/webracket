                          [else
                           (Reference x)]))] ; reference to non-free variable
    [(free-ref ,x ,i)
     (cond
       [(eq? (current-known-direct-env-arity) 1)
        (if (zero? i)
            '(local.get $env0)
            (error 'AExpr3 "known1 helper expected only one free-ref"))]
       [else
        (match (current-inline-small-closure-arity)
       [1
        (if (zero? i)
            `(struct.get $Closure1 $free0
                         (ref.cast (ref $Closure1) (local.get $clos)))
            `(array.get $Free (local.get $free) (i32.const ,i)))]
       [2
        (match i
          [0 `(struct.get $Closure2 $free0
                          (ref.cast (ref $Closure2) (local.get $clos)))]
          [1 `(struct.get $Closure2 $free1
                          (ref.cast (ref $Closure2) (local.get $clos)))]
          [_ `(array.get $Free (local.get $free) (i32.const ,i))])]
       [3
        (match i
          [0 `(struct.get $Closure3 $free0
                          (ref.cast (ref $Closure3) (local.get $clos)))]
          [1 `(struct.get $Closure3 $free1
                          (ref.cast (ref $Closure3) (local.get $clos)))]
          [2 `(struct.get $Closure3 $free2
                          (ref.cast (ref $Closure3) (local.get $clos)))]
          [_ `(array.get $Free (local.get $free) (i32.const ,i))])]
       [_ `(array.get $Free (local.get $free) (i32.const ,i))])]) ] ; x is the name
    [,ca              (ClosureAllocation ca dd)]
    [(quote ,s ,d)    (cond
                        [(eq? dd '<effect>)
                         `(nop)]
                        [else
                         (let ([v (datum-value d)])
                           (cond
	                             ; We keep these for now, to get a more readable output.
	                             ; In all likelyhood (Imm '()), (Imm (void)), etc. are better.
                             [(and (number? v)
	                                   (not (real? v)))
	                              (complex-number-literal->expr v)]
                             [(and (exact-integer? v)
                                   (not (wr-signed-fixnum? v)))
                              (bignum-literal->expr v)]
                             [(and (number? v)
                                   (rational? v)
                                   (exact? v))
                              (rational-literal->expr v)]
                             [(and (real? v)
                                   (inexact? v)
                                   (not (flonum? v)))
                              (define l (* 1.0 v))
                              `(struct.new $Flonum (i32.const 0) (f64.const ,l))]
                             [(flonum? v)     (define l (case v
                                                          [(+nan.0) 'nan] [(-nan.0) '-nan]
                                                          [(+inf.0) 'inf] [(-inf.0) '-inf]
                                                          [else v]))
                                              `(struct.new $Flonum (i32.const 0) (f64.const ,l))]
                             [(null? v)       '(global.get $null)]
                             [(void? v)       '(global.get $void)]
                             [(eq? v #t)      '(global.get $true)]  
                             [(eq? v #f)      '(global.get $false)]
                             [(eof-object? v) '(global.get $eof)]
                             [(wr-signed-fixnum? v) (Imm v)]
                             [(char? v)       (Imm v)]
                             [(undefined? v)  (Imm v)]
                             [(unsafe-undefined? v) (Imm v)]
                             [(string? v)     (define name         (add-quoted-string v))
                                              (define $string:name (string->symbol (~a "$string:" name)))
                                              `(global.get ,$string:name)]
                             [(bytes? v)      (define name         (add-quoted-bytes v))
                                              (define $bytes:name  (string->symbol (~a "$bytes:" name)))
                                              `(global.get ,$bytes:name)]
                             [(symbol? v)     (define name         (add-quoted-symbol v))
                                              (define $symbol:name (string->symbol (~a "$symbol:" name)))
                                              `(global.get ,$symbol:name)]
                             [else            (displayln (list 'sigh: v) (current-error-port)) `',v]))])]
    [(top ,s ,x)
     ; Note: Until namespaces are implemented we represented top-level variables as using `$Boxed`.
     ;       Note that if x is present in a top-level define-values
     ;       then (top x) will become x anyway.
     #;(displayln (list 'top (variable-id x)) (current-error-port))
     (define sym (and (variable? x) (syntax-e (variable-id x))))
     (cond
       [(eq? s 'empty-treelist)
        '(global.get $empty-treelist)]
       [(eq? sym 'empty-treelist)
        '(global.get $empty-treelist)]
       [(non-literal-constant? s)
        `(global.get ,($ s))]
       [(non-literal-constant? sym)
        `(global.get ,($ sym))]
       [(maybe-console-bridge-non-literal-constant s)
        => (lambda (unwrapped)
             `(global.get ,($ unwrapped)))]
       [(maybe-console-bridge-non-literal-constant sym)
        => (lambda (unwrapped)
             `(global.get ,($ unwrapped)))]
       [(maybe-console-bridge-primitive s)
        => (lambda (unwrapped)
             (record-used-primitive! unwrapped)
             (PrimRef (variable (datum->syntax (variable-id x) unwrapped))))]
       [(maybe-console-bridge-primitive sym)
        => (lambda (unwrapped)
             (record-used-primitive! unwrapped)
             (PrimRef (variable (datum->syntax (variable-id x) unwrapped))))]
       [(compiler-primitive? s)
        (record-used-primitive! s)
        (PrimRef x)]
       [(compiler-primitive? sym)
        (record-used-primitive! sym)
        (PrimRef x)]
       [(top-variable? x)
        (Reference x)]
       [else
        `(block (result (ref eq))
           (call $raise-unbound-variable-reference
                 ,(top-reference-symbol-expr x)))])
     #;`(app ,#'namespace-variable-value (app ,#'string->symbol ',(symbol->string (syntax-e (variable-id x)))))
     ; ',#f ; use-mapping? TODO: this should be #t but that isn't implemented yet in runtime
     ]

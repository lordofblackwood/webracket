     (define-values (constant? from-unsafe?)
       (nanopass-case (LANF+closure VariableReferenceId) vrx
         [(anonymous ,s0)        (values #f #f)]
         [(non-top ,s0 ,x0)      (values #t #f)]
         [(top ,s0 ,x0)          (values #f #f)]))

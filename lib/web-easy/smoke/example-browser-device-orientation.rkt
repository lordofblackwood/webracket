#lang webracket/base

(require browser/dom
         device-orientation
         js/promise)

(define (set-status! text)
  (js-set! (js-document-body) "textContent" text))

(define ordinary-count 0)
(define absolute-count 0)
(define motion-count 0)
(define audit-count 0)
(define ordinary-fields-ok? #f)
(define absolute-fields-ok? #f)
(define motion-fields-ok? #f)

(define (ordinary-orientation raw-event)
  (define event (device-orientation-event-wrap raw-event))
  (define alpha (device-orientation-event-alpha event))
  (define beta (device-orientation-event-beta event))
  (define gamma (device-orientation-event-gamma event))
  (define heading (device-orientation-event-compass-heading event))
  (define accuracy (device-orientation-event-compass-accuracy event))
  ;; A headless browser can emit a genuine all-null sensor event before the
  ;; deterministic fixture sample. Only the fixture's populated sample counts.
  (when (and (real? alpha)
             (real? beta)
             (real? gamma)
             (real? heading)
             (real? accuracy)
             (= alpha 12.5)
             (= beta -45)
             (= gamma 18)
             (not (device-orientation-event-absolute? event))
             (= heading 271.5)
             (= accuracy 3))
    (set! ordinary-count (add1 ordinary-count))
    (set! ordinary-fields-ok? #t)
    (when (= ordinary-count 1)
      (device-orientation-remove-listener! ordinary-orientation)))
  (void))

(define (absolute-orientation raw-event)
  (define event (device-orientation-event-wrap raw-event))
  (define alpha (device-orientation-event-alpha event))
  (when (and (real? alpha)
             (device-orientation-event-absolute? event)
             (= alpha 272))
    (set! absolute-count (add1 absolute-count))
    (set! absolute-fields-ok? #t)
    (when (= absolute-count 1)
      (device-orientation-remove-absolute-listener! absolute-orientation)))
  (void))

(define (motion-received raw-event)
  (define event (device-motion-event-wrap raw-event))
  (define acceleration-x (device-motion-event-acceleration-x event))
  (define acceleration-y (device-motion-event-acceleration-y event))
  (define acceleration-z (device-motion-event-acceleration-z event))
  (define gravity-x (device-motion-event-gravity-acceleration-x event))
  (define gravity-y (device-motion-event-gravity-acceleration-y event))
  (define gravity-z (device-motion-event-gravity-acceleration-z event))
  (define rotation-alpha (device-motion-event-rotation-alpha event))
  (define rotation-beta (device-motion-event-rotation-beta event))
  (define rotation-gamma (device-motion-event-rotation-gamma event))
  (define interval (device-motion-event-interval event))
  (when (and (real? acceleration-x)
             (not acceleration-y)
             (real? acceleration-z)
             (real? gravity-x)
             (real? gravity-y)
             (real? gravity-z)
             (real? rotation-alpha)
             (real? rotation-beta)
             (real? rotation-gamma)
             (real? interval)
             (= acceleration-x 1)
             (= acceleration-z -2)
             (= gravity-x 9.8)
             (= gravity-y 0)
             (= gravity-z 1)
             (= rotation-alpha .5)
             (= rotation-beta -1)
             (= rotation-gamma 3)
             (= interval 16))
    (set! motion-count (add1 motion-count))
    (set! motion-fields-ok? #t)
    (when (= motion-count 1)
      (device-motion-remove-listener! motion-received)))
  (void))

(define (audit-orientation raw-event)
  (define event (device-orientation-event-wrap raw-event))
  (define alpha (device-orientation-event-alpha event))
  (when (and (real? alpha) (= alpha 99))
    (set! audit-count (add1 audit-count))
    (when (= audit-count 1)
      (if (and (= alpha 99)
               (= ordinary-count 1)
               (= absolute-count 1)
               (= motion-count 1)
               ordinary-fields-ok?
               absolute-fields-ok?
               motion-fields-ok?)
          (set-status! "PASS: static Device Orientation and Motion permissions, fields, and listeners")
          (set-status! "FAIL: Device Orientation fixture results did not match"))))
  (void))

(define (install-listeners!)
  (device-orientation-add-listener! ordinary-orientation)
  (device-orientation-add-listener! audit-orientation)
  (device-orientation-add-absolute-listener! absolute-orientation)
  (device-motion-add-listener! motion-received)
  (void))

(define (motion-permission-granted raw-status)
  (if (eq? (device-orientation-permission-status raw-status) 'granted)
      (install-listeners!)
      (set-status! "FAIL: Device Motion permission was not granted"))
  (void))

(define (orientation-permission-granted raw-status)
  (if (eq? (device-orientation-permission-status raw-status) 'granted)
      (js-promise-then (device-motion-request-permission)
                       motion-permission-granted
                       (lambda (_reason)
                         (set-status! "FAIL: Device Motion permission rejected")
                         (void)))
      (set-status! "FAIL: Device Orientation permission was not granted"))
  (void))

(cond
  [(and (device-orientation-supported?)
        (device-motion-supported?)
        (device-orientation-permission-requestable?)
        (device-motion-permission-requestable?))
   (js-promise-then (device-orientation-request-permission #t)
                    orientation-permission-granted
                    (lambda (_reason)
                      (set-status! "FAIL: Device Orientation permission rejected")
                      (void)))
   (void)]
  [else
   (set-status! "FAIL: Device Orientation fixture was not installed")])
